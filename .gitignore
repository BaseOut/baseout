# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
.astro/
.wrangler/
.turbo/
.trigger/

# App-level artifacts (apps/* + packages/*)
apps/*/test-results/
apps/*/.superpowers/
packages/*/test-results/

# OpenSpec rotating-symlink marker (apps/server picks one of multiple in-flight changes)
apps/server/.openspec-target

# Personal / ephemeral
meeting.link
brainstorm-agenda.html
.tmp/
.cursor/

# Environment + secrets (NEVER commit)
.dev.vars
.dev.vars.prev
.dev.vars.local
.env
.env.local
.env.*.local
.env.development
.env.staging
.env.production

# Personal working notes — never commit
boss-todo.md
admin_requests.md
worklog-*.md

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Claude Code
.claude/worktrees/
/.superpowers/

# OS / editor
.DS_Store
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo

# Test output
coverage/
*.lcov

# TypeScript build info
*.tsbuildinfo

# Misc cache
.cache/
.parcel-cache
.eslintcache
.npm

# Comp AI — internal compliance working files, kept entirely out of the repo
shared/internal/comp-ai*

# Regenerable portal screenshots (scripts/support-snapshots.mjs)
apps/support/snapshots/

# Per-app staging/production secret bundles fed to `wrangler secret bulk`.
# Real credential values — never commit. The canonical name is
# apps/<app>/.env.secrets, already covered by each app's own `.env.*` rule;
# these no-slash patterns are belt-and-braces and also catch the other spelling
# anywhere in the tree.
secrets.env
.env.secrets
.wrangler-bootstrap-secrets.json
