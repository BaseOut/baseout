# OpenSpec rotating-symlink marker (apps/server picks one of multiple in-flight changes)
apps/server/.openspec-target

# Personal / ephemeral
meeting.link
brainstorm-agenda.html
.tmp/
.cursor/

# Environment + secrets (NEVER commit)
.dev.vars
.dev.vars.prev
# Timestamped backups of .dev.vars — same live credentials as the original, so
# they need the same protection. Created by ad-hoc edits (2026-09-04).
.dev.vars.bak-*
.dev.vars.bak.*
.dev.vars.local
.env
.env.local
.env.*.local
.env.development
.env.staging
.env.production

# Personal working notes — never commit
boss-todo.md
admin_requests.md
worklog-*.md

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Claude Code
.claude/worktrees/
/.superpowers/

