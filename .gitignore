coverage/
*.lcov

# TypeScript build info
*.tsbuildinfo

# Misc cache
.cache/
.parcel-cache
.eslintcache
.npm

# Comp AI — internal compliance working files, kept entirely out of the repo
shared/internal/comp-ai*

# Regenerable portal screenshots (scripts/support-snapshots.mjs)
apps/support/snapshots/

# Per-app staging/production secret bundles fed to `wrangler secret bulk`.
# Real credential values — never commit. The canonical names are
# apps/<app>/.env.secrets.<env> (staging | production). web/admin are already
# covered by their own `.env.*` rule, but api/hooks/server/sql have no such rule,
# so these no-slash patterns are the ONLY thing protecting them.
#
# The trailing * is load-bearing: a bare `.env.secrets` is an exact-name match and
# does NOT cover `.env.secrets.production`. That gap existed until 2026-09-03.
secrets.env
.env.secrets*
