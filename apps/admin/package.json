{
  "name": "@baseout/admin",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Internal Astro SSR admin app. See openspec/changes/admin-foundation/proposal.md (tracer slice) and openspec/changes/admin/proposal.md (full console, deferred).",
  "scripts": {
    "dev": "node --env-file-if-exists=.dev.vars scripts/launch.mjs dev",
    "build": "pnpm run build:dev",
    "secrets:sync": "node scripts/sync-secrets.mjs --config dist/server/wrangler.json",
    "preview": "astro preview",
    "astro": "astro",
    "typecheck": "astro check",
    "lint": "eslint .",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "build:dev": "CLOUDFLARE_ENV=dev node --env-file-if-exists=.dev.vars scripts/launch.mjs build",
    "deploy:dev": "wrangler deploy --env dev && pnpm run secrets:sync",
    "build:staging": "CLOUDFLARE_ENV=staging node --env-file-if-exists=.dev.vars scripts/launch.mjs build",
    "deploy:staging": "node ../../db/scripts/deploy-bootstrap.mjs --worker baseout-admin -- deploy --env staging",
    "build:production": "CLOUDFLARE_ENV=production node --env-file-if-exists=.dev.vars scripts/launch.mjs build",
    "deploy:production": "wrangler deploy --env production"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^13.1.10",
    "@baseout/db-schema": "workspace:*",
    "@fortawesome/fontawesome-free": "^6.7.2",
    "@opensided/theme": "file:../web/vendor/@opensided/theme",
    "@tailwindcss/vite": "^4.2.2",
    "astro": "^6.1.2",
    "daisyui": "^5.5.19",
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.9",
    "tailwindcss": "^4.2.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.8",
    "@cloudflare/workers-types": "^4.20250906.0",
    "@iconify-json/lucide": "^1.2.105",
    "@iconify/tailwind4": "^1.2.3",
    "@types/node": "^25.5.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.5",
    "wrangler": "^4.124.0"
  }
}
