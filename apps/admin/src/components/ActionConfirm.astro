---
// Shared confirm dialog for staff actions (shared-admin-actions). Native
// daisyUI <dialog class="modal"> — deliberately NOT a ported web ConfirmModal;
// promote to a proper shared component when a fourth action lands. Pages
// include this once and mark trigger buttons with data-action-* attributes
// (see src/lib/action-confirm.ts for the contract).
interface Props {
  title?: string
}
const { title = 'Confirm staff action' } = Astro.props
---

<dialog id="action-confirm" class="modal">
  <div class="modal-box">
    <h3 class="text-lg font-semibold">{title}</h3>
    <p class="py-3 text-sm" data-confirm-label></p>
    <p class="text-sm text-error hidden" data-confirm-error></p>
    <p class="text-xs text-base-content/50">
      This action is recorded in the admin audit log before it executes.
    </p>
    <div class="modal-action">
      <form method="dialog">
        <button class="btn btn-ghost btn-sm">Cancel</button>
      </form>
      <button class="btn btn-error btn-sm" data-confirm-button>Confirm</button>
    </div>
  </div>
  <form method="dialog" class="modal-backdrop"><button>close</button></form>
</dialog>

<script>
  import { initActionConfirm } from '../lib/action-confirm'
  initActionConfirm()
</script>
