---
// Cross-org backup run viewer (PRD §16.1 — "backup run status" across all
// Organizations). Read-only; gated to role='super' by src/middleware.ts.
// Absorbs the web /ops page, improved with org/space names.
import { desc, eq } from 'drizzle-orm';
import SidebarLayout from '../../layouts/SidebarLayout.astro';
import PageHeader from '@web/components/ui/PageHeader.astro';
import Badge from '@web/components/ui/Badge.astro';
import EmptyState from '@web/components/ui/EmptyState.astro';
import { backupRuns, spaces, organizations } from '../../db/schema';
import {
  summarizeRuns,
  filterByStatus,
  formatDuration,
  RUN_STATUS_BADGE,
  type RunRow,
} from '../../lib/backup-runs';

const { db } = Astro.locals;

const rows: RunRow[] = await db
  .select({
    id: backupRuns.id,
    status: backupRuns.status,
    kind: backupRuns.kind,
    isTrial: backupRuns.isTrial,
    triggeredBy: backupRuns.triggeredBy,
    recordCount: backupRuns.recordCount,
    tableCount: backupRuns.tableCount,
    attachmentCount: backupRuns.attachmentCount,
    startedAt: backupRuns.startedAt,
    completedAt: backupRuns.completedAt,
    errorMessage: backupRuns.errorMessage,
    deletedAt: backupRuns.deletedAt,
    createdAt: backupRuns.createdAt,
    spaceName: spaces.name,
    orgName: organizations.name,
  })
  .from(backupRuns)
  .leftJoin(spaces, eq(spaces.id, backupRuns.spaceId))
  .leftJoin(organizations, eq(organizations.id, spaces.organizationId))
  .orderBy(desc(backupRuns.createdAt))
  .limit(100);

const statusFilter = Astro.url.searchParams.get('status');
const summaries = summarizeRuns(rows, new Date());
const visible = filterByStatus(rows, statusFilter);

const FILTERS = ['failed', 'running', 'queued', 'succeeded'];
const fmt = (d: Date | null) => (d ? d.toISOString().replace('T', ' ').slice(0, 19) : '—');
---

<SidebarLayout title="Admin — Backup Runs">
  <div class="mx-auto max-w-[1200px] space-y-6">
    <PageHeader
      title="Backup runs"
      description="100 most-recent runs across all organizations (PRD §16.1)."
    >
      {/* Status filter — daisyUI segmented tabs. Kept as <a> links so the SSR
          ?status filter drives the render (no primitive covers href-tabs; the
          @web Tabs primitive is radio-based). */}
      <div slot="actions" role="tablist" class="tabs tabs-box tabs-sm">
        <a role="tab" href="/backups" aria-selected={!statusFilter} class={`tab ${!statusFilter ? 'tab-active' : ''}`}>all</a>
        {FILTERS.map((s) => (
          <a
            role="tab"
            href={`/backups?status=${s}`}
            aria-selected={statusFilter === s}
            class={`tab ${statusFilter === s ? 'tab-active' : ''}`}
          >{s}</a>
        ))}
      </div>
    </PageHeader>

    <div class="stats stats-horizontal bg-base-100 border border-base-300">
      {summaries.map((s) => (
        <>
          <div class="stat py-3">
            <div class="stat-title">Runs · {s.window}</div>
            <div class="stat-value text-2xl">{s.total}</div>
          </div>
          <div class="stat py-3">
            <div class="stat-title">Failed · {s.window}</div>
            <div class={`stat-value text-2xl ${s.failed > 0 ? 'text-error' : ''}`}>{s.failed}</div>
            <div class="stat-desc">{s.succeeded} succeeded · {s.active} active</div>
          </div>
        </>
      ))}
    </div>

    {visible.length === 0 ? (
      <EmptyState
        icon="lucide--database-backup"
        title="No backup runs"
        description={`No backup runs${statusFilter ? ` with status “${statusFilter}”` : ''} yet.`}
      />
    ) : (
      <div class="overflow-x-auto rounded-box border border-base-300 bg-base-100">
        <table class="table table-zebra table-sm">
          <thead>
            <tr>
              <th>Created</th>
              <th>Organization</th>
              <th>Space</th>
              <th>Status</th>
              <th>Kind</th>
              <th>Trigger</th>
              <th>Records</th>
              <th>Tables</th>
              <th>Duration</th>
              <th>Error</th>
            </tr>
          </thead>
          <tbody>
            {visible.map((r) => (
              <tr>
                <td class="font-mono text-xs whitespace-nowrap">
                  <a href={`/backups/${r.id}`} class="link link-hover">{fmt(r.createdAt)}</a>
                </td>
                <td>{r.orgName ?? '—'}</td>
                <td>{r.spaceName ?? '—'}</td>
                <td>
                  <span class="flex items-center gap-1">
                    <Badge variant={RUN_STATUS_BADGE[r.status] ?? 'default'} size="sm">{r.status}</Badge>
                    {r.isTrial && <Badge variant="default" size="sm">trial</Badge>}
                    {r.deletedAt && <Badge variant="default" size="sm">pruned</Badge>}
                  </span>
                </td>
                <td>{r.kind}</td>
                <td>{r.triggeredBy}</td>
                <td class="text-right">{r.recordCount ?? '—'}</td>
                <td class="text-right">{r.tableCount ?? '—'}</td>
                <td class="whitespace-nowrap">{formatDuration(r.startedAt, r.completedAt)}</td>
                <td class="max-w-xs truncate text-error text-xs" title={r.errorMessage ?? ''}>
                  {r.errorMessage ?? ''}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}
  </div>
</SidebarLayout>
