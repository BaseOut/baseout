---
// Connection health (PRD §16.1 — "OAuth connections dashboard"). Gated to
// role='super' by src/middleware.ts. Staff action: "Invalidate" per non-invalid
// row (POST /api/actions/invalidate-connection, audit-logged, cancels in-flight
// runs). Webhook renewal state is not instrumented yet (no table, renewal cron
// unbuilt) — noted below rather than faked.
import { desc, eq, lt, sql } from 'drizzle-orm';
import { env } from 'cloudflare:workers';
import SidebarLayout from '../layouts/SidebarLayout.astro';
import PageHeader from '@web/components/ui/PageHeader.astro';
import Badge from '@web/components/ui/Badge.astro';
import Button from '@web/components/ui/Button.astro';
import EmptyState from '@web/components/ui/EmptyState.astro';
import ConfirmModal from '@web/components/ui/ConfirmModal.astro';
import {
  connections,
  connectionSessions,
  organizations,
  platforms,
  spaces,
  storageDestinations,
} from '../db/schema';
import {
  summarizeHealth,
  classifyDestination,
  filterByHealth,
  HEALTH_FILTERS,
  HEALTH_BADGE,
  type ConnectionRow,
  type DestinationRow,
} from '../lib/connection-health';
import { createAdminEngine, type EngineTokenHealthResult } from '../lib/backup-engine';
import { truncationNote } from '../lib/ui';

const { db } = Astro.locals;
const now = new Date();
const CONN_LIMIT = 500;
const DEST_LIMIT = 200;

// Engine token-health snapshot — best-effort (web's banner idiom): a dead or
// unconfigured engine degrades to a quiet note, never a broken page.
let tokenHealth: EngineTokenHealthResult | null = null;
try {
  const engine = createAdminEngine({
    binding: env.BACKUP_ENGINE,
    internalToken: env.BACKUP_ENGINE_INTERNAL_TOKEN,
  });
  tokenHealth = engine ? await engine.tokenHealth() : null;
} catch {
  tokenHealth = null;
}
const tokenHealthOk = tokenHealth?.ok === true ? tokenHealth : null;

const [connRows, staleSessions, destRows] = await Promise.all([
  db
    .select({
      id: connections.id,
      orgName: organizations.name,
      platformName: platforms.name,
      displayName: connections.displayName,
      scope: connections.scope,
      status: connections.status,
      tokenExpiresAt: connections.tokenExpiresAt,
      invalidatedAt: connections.invalidatedAt,
      lastUsedAt: connections.lastUsedAt,
      oauthRefreshClaimId: connections.oauthRefreshClaimId,
      oauthRefreshClaimedAt: connections.oauthRefreshClaimedAt,
      oauthRefreshLastError: connections.oauthRefreshLastError,
      createdAt: connections.createdAt,
    })
    .from(connections)
    .leftJoin(organizations, eq(organizations.id, connections.organizationId))
    .leftJoin(platforms, eq(platforms.id, connections.platformId))
    .orderBy(desc(connections.createdAt))
    .limit(CONN_LIMIT) as Promise<ConnectionRow[]>,
  db
    .select({ count: sql<number>`count(*)::int` })
    .from(connectionSessions)
    .where(lt(connectionSessions.expiresAt, sql`${now.toISOString()}::timestamptz`)),
  db
    .select({
      type: storageDestinations.type,
      orgName: organizations.name,
      spaceName: spaces.name,
      oauthAccountEmail: storageDestinations.oauthAccountEmail,
      oauthExpiresAt: storageDestinations.oauthExpiresAt,
      connectedAt: storageDestinations.connectedAt,
      lastValidatedAt: storageDestinations.lastValidatedAt,
    })
    .from(storageDestinations)
    .leftJoin(spaces, eq(spaces.id, storageDestinations.spaceId))
    .leftJoin(organizations, eq(organizations.id, spaces.organizationId))
    .limit(DEST_LIMIT) as Promise<DestinationRow[]>,
]);

const { classified, summary } = summarizeHealth(connRows, now);

// ?health= slices the table (post-classification — health is derived); the
// summary stats stay computed over everything fetched.
const healthFilter = Astro.url.searchParams.get('health');
const visibleConnections = filterByHealth(classified, healthFilter);
const staleSessionCount = staleSessions[0]?.count ?? 0;
const destinations = destRows.map((d) => ({ ...d, health: classifyDestination(d, now) }));

const fmt = (d: Date | null) => (d ? d.toISOString().replace('T', ' ').slice(0, 16) : '—');
const broken = summary.total - summary.byHealth.healthy;
---

<SidebarLayout title="Admin — Connections">
  <div class="mx-auto max-w-[1200px] space-y-6">
    <PageHeader
      title="Connection health"
      description={`OAuth connection status across all organizations (PRD §16.1). Webhook renewal state is not yet instrumented — no renewal cron or table exists (phase-2).${truncationNote(connRows.length, CONN_LIMIT)}`}
    >
      <div slot="actions" role="tablist" class="tabs tabs-box tabs-sm">
        <a role="tab" href="/connections" aria-selected={!healthFilter} class={`tab ${!healthFilter ? 'tab-active' : ''}`}>all</a>
        {HEALTH_FILTERS.map((h) => (
          <a
            role="tab"
            href={`/connections?health=${h}`}
            aria-selected={healthFilter === h}
            class={`tab ${healthFilter === h ? 'tab-active' : ''}`}
          >{h.replace('_', ' ')}</a>
        ))}
      </div>
    </PageHeader>

    <div class="stats stats-horizontal bg-base-100 border border-base-300">
      <div class="stat py-3">
        <div class="stat-title">Connections</div>
        <div class="stat-value text-2xl">{summary.total}</div>
      </div>
      <div class="stat py-3">
        <div class="stat-title">Needing attention</div>
        <div class={`stat-value text-2xl ${broken > 0 ? 'text-error' : ''}`}>{broken}</div>
        <div class="stat-desc">
          {summary.byHealth.invalid} invalid · {summary.byHealth.pending_reauth} reauth ·
          {summary.byHealth.refresh_stuck} stuck · {summary.byHealth.refresh_error} refresh err ·
          {summary.byHealth.token_expired} expired
        </div>
      </div>
      <div class="stat py-3">
        <div class="stat-title">Stale session locks</div>
        <div class={`stat-value text-2xl ${staleSessionCount > 0 ? 'text-warning' : ''}`}>{staleSessionCount}</div>
        <div class="stat-desc">connection_sessions past expires_at</div>
      </div>
      {tokenHealthOk ? (
        <>
          <div class="stat py-3">
            <div class="stat-title">Expired access tokens</div>
            <div class={`stat-value text-2xl ${tokenHealthOk.activeExpired > 0 ? 'text-error' : ''}`}>{tokenHealthOk.activeExpired}</div>
            <div class="stat-desc">active connections, per engine</div>
          </div>
          <div class="stat py-3">
            <div class="stat-title">Refresh tokens expiring soon</div>
            <div class={`stat-value text-2xl ${tokenHealthOk.refreshExpiringSoon > 0 ? 'text-warning' : ''}`}>{tokenHealthOk.refreshExpiringSoon}</div>
            <div class="stat-desc">per engine token-health probe</div>
          </div>
        </>
      ) : (
        <div class="stat py-3">
          <div class="stat-title">Engine token health</div>
          <div class="stat-value text-2xl text-base-content/40">—</div>
          <div class="stat-desc">engine token-health unavailable</div>
        </div>
      )}
    </div>

    {visibleConnections.length === 0 ? (
      <EmptyState
        icon="lucide--plug"
        title={healthFilter ? 'No matches' : 'No connections yet'}
        description={healthFilter
          ? `No connections with health “${healthFilter.replace('_', ' ')}”.`
          : 'No OAuth connections across any organization.'}
      />
    ) : (
      <div class="overflow-x-auto rounded-box border border-base-300 bg-base-100">
        <table class="table table-zebra table-sm">
          <thead>
            <tr>
              <th>Organization</th>
              <th>Platform</th>
              <th>Name / scope</th>
              <th>Status</th>
              <th>Health</th>
              <th>Token expires</th>
              <th>Last used</th>
              <th>Last refresh error</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            {visibleConnections.map((c) => (
              <tr>
                <td>{c.orgName ?? '—'}</td>
                <td>{c.platformName ?? '—'}</td>
                <td>
                  <div>{c.displayName ?? '—'}</div>
                  <div class="text-xs text-base-content/50">{c.scope}</div>
                </td>
                <td><Badge variant="default" size="sm">{c.status}</Badge></td>
                <td><Badge variant={HEALTH_BADGE[c.health]} size="sm">{c.health.replace('_', ' ')}</Badge></td>
                <td class="font-mono text-xs whitespace-nowrap">{fmt(c.tokenExpiresAt)}</td>
                <td class="font-mono text-xs whitespace-nowrap">{fmt(c.lastUsedAt)}</td>
                <td class="max-w-xs truncate text-error text-xs" title={c.oauthRefreshLastError ?? ''}>
                  {c.oauthRefreshLastError ?? ''}
                </td>
                <td class="text-right">
                  {c.status !== 'invalid' && (
                    <Button
                      variant="outline"
                      size="sm"
                      class="text-error"
                      data-action-path="/api/actions/invalidate-connection"
                      data-action-payload={JSON.stringify({ connectionId: c.id })}
                      data-action-label={`Invalidate the ${c.platformName ?? ''} connection "${c.displayName ?? c.id}" for ${c.orgName ?? 'unknown org'}. In-flight backup runs are cancelled, new backups are refused, and the customer sees a reconnect banner until they re-authorize.`}
                    >Invalidate</Button>
                  )}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}

    <div>
      <h2 class="text-lg font-semibold">Storage destinations (BYOS OAuth)</h2>
      {destinations.length === 0 ? (
        <p class="text-sm text-base-content/50 mt-2">No storage destinations yet.</p>
      ) : (
        <div class="overflow-x-auto rounded-box border border-base-300 bg-base-100 mt-2">
          <table class="table table-zebra table-sm">
            <thead>
              <tr>
                <th>Organization</th>
                <th>Space</th>
                <th>Provider</th>
                <th>Account</th>
                <th>OAuth health</th>
                <th>Connected</th>
                <th>Last validated</th>
              </tr>
            </thead>
            <tbody>
              {destinations.map((d) => (
                <tr>
                  <td>{d.orgName ?? '—'}</td>
                  <td>{d.spaceName ?? '—'}</td>
                  <td><Badge variant="default" size="sm">{d.type}</Badge></td>
                  <td class="text-xs">{d.oauthAccountEmail ?? '—'}</td>
                  <td>
                    <Badge
                      variant={d.health === 'token_expired' ? 'warning' : d.health === 'ok' ? 'success' : 'default'}
                      size="sm"
                    >
                      {d.health === 'no_oauth' ? 'n/a' : d.health.replace('_', ' ')}
                    </Badge>
                  </td>
                  <td class="font-mono text-xs whitespace-nowrap">{fmt(d.connectedAt)}</td>
                  <td class="font-mono text-xs whitespace-nowrap">{fmt(d.lastValidatedAt)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
    </div>
  </div>

  <ConfirmModal id="action-confirm" title="Invalidate connection" confirmLabel="Invalidate" confirmClass="btn-error">
    <p class="text-sm" data-confirm-label></p>
    <p class="mt-2 text-sm text-error hidden" data-confirm-error></p>
    <p class="mt-2 text-xs text-base-content/50">
      This action is recorded in the admin audit log before it executes.
    </p>
    <button slot="confirm" type="button" class="btn btn-error" data-confirm-button>Confirm</button>
  </ConfirmModal>
</SidebarLayout>
