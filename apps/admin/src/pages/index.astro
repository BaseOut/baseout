---
// Organizations → Spaces tracker (admin-foundation tracer surface).
//
// PRD §5.4 / §16.1: which provisioned databases (= Spaces in the V1 tier
// model) belong to which Organizations. Gated to role='super' by
// src/middleware.ts. Staff action: "Force backup" per Space (POST
// /api/actions/force-backup, audit-logged, run appears on /backups).
import { desc, eq, ilike, inArray, or } from 'drizzle-orm';
import SidebarLayout from '../layouts/SidebarLayout.astro';
import PageHeader from '@web/components/ui/PageHeader.astro';
import Card from '@web/components/ui/Card.astro';
import Badge from '@web/components/ui/Badge.astro';
import Button from '@web/components/ui/Button.astro';
import EmptyState from '@web/components/ui/EmptyState.astro';
import ConfirmModal from '@web/components/ui/ConfirmModal.astro';
import {
  organizations,
  spaces,
  spacePlatforms,
  platforms,
  subscriptions,
  subscriptionItems,
} from '../db/schema';
import { buildTracker, type SpaceRow, type TierRow } from '../lib/tracker';
import { truncationNote, type BadgeVariant } from '../lib/ui';

const { db } = Astro.locals;

// ?q= searches org name/slug (ilike — seq scan is fine at staff scale).
const q = Astro.url.searchParams.get('q')?.trim() ?? '';
const ORG_LIMIT = 100;

const orgFilter = q
  ? or(ilike(organizations.name, `%${q}%`), ilike(organizations.slug, `%${q}%`))
  : undefined;
const orgRows = await db
  .select({
    id: organizations.id,
    name: organizations.name,
    slug: organizations.slug,
    hasMigrated: organizations.hasMigrated,
  })
  .from(organizations)
  .where(orgFilter)
  .orderBy(desc(organizations.createdAt))
  .limit(ORG_LIMIT);

// Spaces + tiers only for the orgs on this page (was an unbounded full scan).
const orgIds = orgRows.map((o) => o.id);
const spaceRows: SpaceRow[] = orgIds.length === 0
  ? []
  : await db
      .select({
        id: spaces.id,
        organizationId: spaces.organizationId,
        name: spaces.name,
        status: spaces.status,
        platformName: platforms.name,
      })
      .from(spaces)
      .leftJoin(spacePlatforms, eq(spacePlatforms.spaceId, spaces.id))
      .leftJoin(platforms, eq(platforms.id, spacePlatforms.platformId))
      .where(inArray(spaces.organizationId, orgIds));

const tierRows: TierRow[] = orgIds.length === 0
  ? []
  : await db
      .select({
        organizationId: subscriptions.organizationId,
        tier: subscriptionItems.tier,
      })
      .from(subscriptionItems)
      .innerJoin(subscriptions, eq(subscriptions.id, subscriptionItems.subscriptionId))
      .where(inArray(subscriptions.organizationId, orgIds));

const tracker = buildTracker(orgRows, spaceRows, tierRows);

const statusVariant: Record<string, BadgeVariant> = {
  active: 'success',
  paused: 'warning',
  error: 'error',
  setup_incomplete: 'default',
};
---

<SidebarLayout title="Admin — Organizations">
  <div class="mx-auto max-w-[1200px] space-y-6">
    <PageHeader
      title="Organizations & Spaces"
      description={`Every Organization and its provisioned Spaces (PRD §5.4). ${tracker.length} organizations.${truncationNote(orgRows.length, ORG_LIMIT)}`}
    >
      <form slot="actions" method="get" action="/" class="join">
        <input
          type="search"
          name="q"
          value={q}
          placeholder="Search name or slug"
          class="input input-sm join-item w-52"
          aria-label="Search organizations"
        />
        <button type="submit" class="btn btn-sm join-item" aria-label="Search">
          <i class="iconify lucide--search size-4"></i>
        </button>
      </form>
    </PageHeader>

    {tracker.length === 0 ? (
      <EmptyState
        icon="lucide--building-2"
        title={q ? 'No matches' : 'No organizations yet'}
        description={q ? `No organizations match “${q}”.` : 'No organizations in the master DB yet.'}
        actionHref={q ? '/' : undefined}
        actionLabel={q ? 'Clear search' : undefined}
      />
    ) : (
      <div class="space-y-4">
        {tracker.map((org) => (
          <Card variant="outlined">
            <div class="flex flex-col gap-3">
              <div class="flex items-center justify-between flex-wrap gap-2">
                <div class="flex items-center gap-2">
                  <h2 class="text-lg font-semibold">
                    <a href={`/organizations/${org.id}`} class="link link-hover">{org.name}</a>
                  </h2>
                  <span class="font-mono text-xs text-base-content/50">{org.slug}</span>
                  {!org.hasMigrated && (
                    <Badge variant="warning" size="sm">migration pending</Badge>
                  )}
                </div>
                <div class="flex gap-1">
                  {org.tiers.length === 0 ? (
                    <Badge variant="default" size="sm">no subscription</Badge>
                  ) : (
                    org.tiers.map((t) => <Badge variant="primary" size="sm">{t}</Badge>)
                  )}
                </div>
              </div>

              {org.spaces.length === 0 ? (
                <p class="text-sm text-base-content/50">No spaces.</p>
              ) : (
                <div class="overflow-x-auto rounded-box border border-base-300">
                  <table class="table table-zebra table-sm">
                    <thead>
                      <tr>
                        <th>Space</th>
                        <th>Status</th>
                        <th>Platform</th>
                        <th>Space ID</th>
                        <th></th>
                      </tr>
                    </thead>
                    <tbody>
                      {org.spaces.map((s) => (
                        <tr>
                          <td>{s.name}</td>
                          <td>
                            <Badge variant={statusVariant[s.status] ?? 'default'} size="sm">
                              {s.status}
                            </Badge>
                          </td>
                          <td>{s.platformName ?? '—'}</td>
                          <td class="font-mono text-xs">{s.id.slice(0, 8)}…</td>
                          <td class="text-right">
                            <Button
                              variant="outline"
                              size="sm"
                              data-action-path="/api/actions/force-backup"
                              data-action-payload={JSON.stringify({ spaceId: s.id })}
                              data-action-label={`Queue a backup run for "${s.name}" (${org.name}). Requires an active Airtable connection and at least one included base; the run appears on the Backups page as triggered-by admin.`}
                            >Force backup</Button>
                          </td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              )}
            </div>
          </Card>
        ))}
      </div>
    )}
  </div>

  <ConfirmModal id="action-confirm" title="Force backup" confirmLabel="Force backup" confirmClass="btn-error">
    <p class="text-sm" data-confirm-label></p>
    <p class="mt-2 text-sm text-error hidden" data-confirm-error></p>
    <p class="mt-2 text-xs text-base-content/50">
      This action is recorded in the admin audit log before it executes.
    </p>
    <button slot="confirm" type="button" class="btn btn-error" data-confirm-button>Confirm</button>
  </ConfirmModal>
</SidebarLayout>
