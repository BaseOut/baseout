---
// Subscriptions dashboard (PRD §16.1 — "Subscriptions view"). Read-only;
// gated to role='super' by src/middleware.ts.
//
// admin-crm-ux (Task 1.4): the org listing paginates in SQL with a derived
// status-rollup filter (EXISTS / NOT EXISTS predicates — design D3). The
// summary tiles + estimated MRR stay whole-truth via summarizeSubscriptionsGlobal
// over the (bounded) full subscription/item set + a global org count (design D4).
import { and, asc, desc, eq, exists, ilike, notExists, or, sql, count } from 'drizzle-orm';
import SidebarLayout from '../layouts/SidebarLayout.astro';
import PageHeader from '@web/components/ui/PageHeader.astro';
import Badge from '@web/components/ui/Badge.astro';
import EmptyState from '@web/components/ui/EmptyState.astro';
import SortHeader from '../components/table/SortHeader.astro';
import Pager from '../components/table/Pager.astro';
import FilterBar from '../components/table/FilterBar.astro';
import EntityLink from '../components/EntityLink.astro';
import {
  organizations,
  overageRecords,
  subscriptions,
  subscriptionItems,
  platforms,
} from '../db/schema';
import {
  buildSubscriptionsView,
  summarizeSubscriptionsGlobal,
  estimateMrr,
  formatCents,
  stripeCustomerUrl,
  stripeSubscriptionUrl,
  summarizeOverages,
  SUB_STATUS_BADGE,
  TRIAL_STATE_BADGE,
  type OverageRow,
  type SubItemRow,
  type SubRow,
} from '../lib/subscriptions';
import { parseTableQuery, pageInfo, type TableSpec } from '../lib/table-query';

const { db } = Astro.locals;

const STATUS_VALUES = ['trialing', 'active', 'past_due', 'cancelled', 'none'] as const;

const SPEC: TableSpec = {
  sortKeys: ['name', 'created'],
  defaultSort: 'created',
  defaultDir: 'desc',
  searchable: true,
  filters: [{ key: 'status', allowed: [...STATUS_VALUES] }],
};
const SORT_MAP = { name: organizations.name, created: organizations.createdAt } as const;

const query = parseTableQuery(Astro.url, SPEC);

// Derived subscription-status rollup as a correlated SQL predicate (design D3).
const conditions = [];
if (query.q) conditions.push(or(ilike(organizations.name, `%${query.q}%`), ilike(organizations.slug, `%${query.q}%`)));
if (query.filters.status) {
  const s = query.filters.status;
  conditions.push(
    s === 'none'
      ? notExists(db.select({ x: sql`1` }).from(subscriptions).where(eq(subscriptions.organizationId, organizations.id)))
      : exists(
          db
            .select({ x: sql`1` })
            .from(subscriptions)
            .where(and(eq(subscriptions.organizationId, organizations.id), eq(subscriptions.status, s))),
        ),
  );
}
const whereClause = conditions.length ? and(...conditions) : undefined;

const sortCol = SORT_MAP[query.sort as keyof typeof SORT_MAP];
const orderBy = query.dir === 'asc' ? asc(sortCol) : desc(sortCol);

// Whole-truth inputs (bounded — one subscription + a few items per paying org).
const [[{ n: orgTotalCount }], allSubs, allItems] = await Promise.all([
  db.select({ n: count() }).from(organizations),
  db.select({ organizationId: subscriptions.organizationId, stripeSubscriptionId: subscriptions.stripeSubscriptionId, status: subscriptions.status }).from(subscriptions) as Promise<SubRow[]>,
  db
    .select({
      organizationId: subscriptions.organizationId,
      platformName: platforms.name,
      tier: subscriptionItems.tier,
      billingPeriod: subscriptionItems.billingPeriod,
      trialEndsAt: subscriptionItems.trialEndsAt,
      trialBackupRunUsed: subscriptionItems.trialBackupRunUsed,
      trialEverUsed: subscriptionItems.trialEverUsed,
      currentPeriodEnd: subscriptionItems.currentPeriodEnd,
      cancelledAt: subscriptionItems.cancelledAt,
    })
    .from(subscriptionItems)
    .innerJoin(subscriptions, eq(subscriptions.id, subscriptionItems.subscriptionId))
    .leftJoin(platforms, eq(platforms.id, subscriptionItems.platformId)) as Promise<SubItemRow[]>,
]);

const now = new Date();
const summary = summarizeSubscriptionsGlobal(orgTotalCount, allSubs, allItems, now);
const statusByOrg = new Map(allSubs.map((s) => [s.organizationId, s.status]));
const mrr = estimateMrr(
  allItems.map((i) => ({
    tier: i.tier,
    billingPeriod: i.billingPeriod,
    subscriptionStatus: statusByOrg.get(i.organizationId) ?? null,
    cancelledAt: i.cancelledAt,
  })),
);

// Paginated org listing.
const [{ n: total }] = await db.select({ n: count() }).from(organizations).where(whereClause);
const info = pageInfo(total, query.page, query.per);
const orgRows = await db
  .select({ id: organizations.id, name: organizations.name, slug: organizations.slug, stripeCustomerId: organizations.stripeCustomerId })
  .from(organizations)
  .where(whereClause)
  .orderBy(orderBy)
  .limit(query.per)
  .offset(info.offset);

const pageOrgIds = new Set(orgRows.map((o) => o.id));
const pageSubs = allSubs.filter((s) => pageOrgIds.has(s.organizationId));
const pageItems = allItems.filter((i) => pageOrgIds.has(i.organizationId));
const { rows } = buildSubscriptionsView(orgRows, pageSubs, pageItems, now, { preserveOrder: true });

// Overage records — separate bounded section (unchanged).
const overageRows: OverageRow[] = await db
  .select({
    orgName: organizations.name,
    metric: overageRecords.metric,
    periodStart: overageRecords.periodStart,
    periodEnd: overageRecords.periodEnd,
    includedQuota: overageRecords.includedQuota,
    usageAmount: overageRecords.usageAmount,
    overageAmount: overageRecords.overageAmount,
    totalCostCents: overageRecords.totalCostCents,
    stripeInvoiceItemId: overageRecords.stripeInvoiceItemId,
  })
  .from(overageRecords)
  .leftJoin(organizations, eq(organizations.id, overageRecords.organizationId))
  .orderBy(desc(overageRecords.periodStart))
  .limit(200);
const overages = summarizeOverages(overageRows);

const params = Astro.url.searchParams;
const filterHidden: Record<string, string> = { sort: query.sort, dir: query.dir, per: String(query.per) };
const statusOptions = [{ value: '', label: 'All statuses' }, ...STATUS_VALUES.map((s) => ({ value: s, label: s.replace('_', ' ') }))];

const fmtDate = (d: Date | null) => (d ? d.toISOString().slice(0, 10) : '—');
---

<SidebarLayout title="Admin — Subscriptions">
  <div class="mx-auto max-w-[1200px] space-y-6">
    <PageHeader title="Subscriptions" description="Stripe subscription + trial state per Organization (PRD §16.1)." />

    <div class="stats stats-horizontal bg-base-100 border border-base-300">
      <div class="stat py-3">
        <div class="stat-title">Organizations</div>
        <div class="stat-value text-2xl">{summary.organizations}</div>
      </div>
      <div class="stat py-3">
        <div class="stat-title">Active trials</div>
        <div class="stat-value text-2xl">{summary.activeTrials}</div>
      </div>
      <div class="stat py-3">
        <div class="stat-title">Past due</div>
        <div class={`stat-value text-2xl ${summary.pastDue > 0 ? 'text-error' : ''}`}>{summary.pastDue}</div>
      </div>
      <div class="stat py-3">
        <div class="stat-title">Estimated MRR</div>
        <div class="stat-value text-2xl">{formatCents(mrr.totalCents)}</div>
        <div class="stat-desc">
          list prices (Features §3) · {mrr.priced} active item{mrr.priced === 1 ? '' : 's'}
          {mrr.unpriceable > 0 && ` · excludes ${mrr.unpriceable} enterprise/custom`}
        </div>
      </div>
      <div class="stat py-3">
        <div class="stat-title">By status</div>
        <div class="stat-desc text-sm mt-1">
          {Object.entries(summary.byStatus).map(([status, c]) => (
            <span class="mr-2">{status}: <b>{c}</b></span>
          ))}
        </div>
      </div>
    </div>

    <FilterBar
      action="/subscriptions"
      searchable
      q={query.q}
      qPlaceholder="Search organization…"
      filters={[{ key: 'status', label: 'Status', options: statusOptions, current: query.filters.status ?? null }]}
      hidden={filterHidden}
    />

    {rows.length === 0 ? (
      <EmptyState
        icon="lucide--credit-card"
        title={query.filters.status || query.q ? 'No matches' : 'No subscriptions yet'}
        description={query.filters.status || query.q ? 'No organizations match this filter.' : 'No organizations in the master DB yet.'}
      />
    ) : (
      <div class="space-y-3">
        <div class="overflow-x-auto rounded-box border border-base-300 bg-base-100">
          <table class="table table-zebra table-sm">
            <thead>
              <tr>
                <SortHeader label="Organization" sortKey="name" current={params} spec={SPEC} />
                <SortHeader label="Status" current={params} spec={SPEC} />
                <SortHeader label="Platform / Tier" current={params} spec={SPEC} />
                <SortHeader label="Trial" current={params} spec={SPEC} />
                <SortHeader label="Period ends" current={params} spec={SPEC} />
                <SortHeader label="Cancelled" current={params} spec={SPEC} />
                <SortHeader label="Stripe" current={params} spec={SPEC} />
              </tr>
            </thead>
            <tbody>
              {rows.map((org) => (
                <tr>
                  <td>
                    <div class="font-medium"><EntityLink type="org" id={org.id} label={org.name} /></div>
                    <div class="font-mono text-xs text-base-content/50">{org.slug}</div>
                  </td>
                  <td>
                    {org.subscriptionStatus ? (
                      <Badge variant={SUB_STATUS_BADGE[org.subscriptionStatus] ?? 'default'} size="sm">{org.subscriptionStatus}</Badge>
                    ) : (
                      <Badge variant="default" size="sm">no subscription</Badge>
                    )}
                  </td>
                  <td>
                    {org.items.length === 0 ? '—' : org.items.map((i) => (
                      <div class="whitespace-nowrap flex items-center gap-1">
                        <span>{i.platformName ?? '?'} ·</span>
                        <Badge variant="primary" size="sm">{i.tier}</Badge>
                        <span class="text-xs text-base-content/50">{i.billingPeriod}</span>
                      </div>
                    ))}
                  </td>
                  <td>
                    {org.items.map((i) => (
                      <div class="whitespace-nowrap flex items-center gap-1">
                        <Badge variant={TRIAL_STATE_BADGE[i.trialState]} size="sm">{i.trialState.replace('_', ' ')}</Badge>
                        {i.trialDaysLeft !== null && <span class="text-xs text-base-content/60">{i.trialDaysLeft}d left</span>}
                        {i.trialBackupRunUsed && <Badge variant="default" size="sm" class="ml-1">run used</Badge>}
                      </div>
                    ))}
                  </td>
                  <td>{org.items.map((i) => <div>{fmtDate(i.currentPeriodEnd)}</div>)}</td>
                  <td>{org.items.map((i) => <div>{fmtDate(i.cancelledAt)}</div>)}</td>
                  <td class="font-mono text-xs">
                    <div title={org.stripeCustomerId ?? ''}>
                      {org.stripeCustomerId ? (
                        <a href={stripeCustomerUrl(org.stripeCustomerId)} target="_blank" rel="noopener noreferrer" class="link link-hover">{`${org.stripeCustomerId.slice(0, 14)}…`}</a>
                      ) : '—'}
                    </div>
                    <div title={org.stripeSubscriptionId ?? ''}>
                      {org.stripeSubscriptionId && (
                        <a href={stripeSubscriptionUrl(org.stripeSubscriptionId)} target="_blank" rel="noopener noreferrer" class="link link-hover">{`${org.stripeSubscriptionId.slice(0, 14)}…`}</a>
                      )}
                    </div>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <Pager info={info} current={params} per={query.per} noun="organization" />
      </div>
    )}

    <div>
      <h2 class="text-lg font-semibold">Overage records</h2>
      <p class="text-sm text-base-content/60 mt-1">
        Per-metric usage over quota, per billing period. Written by the quota
        monitor; “billed” once a Stripe invoice item exists.
        {overages.rows.length > 0 && ` Total ${formatCents(overages.totalCents)} · unbilled ${formatCents(overages.unbilledCents)}.`}
      </p>
      {overages.rows.length === 0 ? (
        <p class="text-sm text-base-content/50 mt-2">No overage records yet.</p>
      ) : (
        <div class="overflow-x-auto rounded-box border border-base-300 bg-base-100 mt-2">
          <table class="table table-zebra table-sm">
            <thead>
              <tr>
                <th>Organization</th>
                <th>Metric</th>
                <th>Period</th>
                <th class="text-right">Included</th>
                <th class="text-right">Usage</th>
                <th class="text-right">Overage</th>
                <th class="text-right">Cost</th>
                <th>Billing</th>
              </tr>
            </thead>
            <tbody>
              {overages.rows.map((o) => (
                <tr>
                  <td>{o.orgName ?? '—'}</td>
                  <td><Badge variant="default" size="sm">{o.metric.replace(/_/g, ' ')}</Badge></td>
                  <td class="font-mono text-xs whitespace-nowrap">{fmtDate(o.periodStart)} → {fmtDate(o.periodEnd)}</td>
                  <td class="text-right">{o.includedQuota}</td>
                  <td class="text-right">{o.usageAmount}</td>
                  <td class={`text-right ${o.overageAmount > 0 ? 'text-warning' : ''}`}>{o.overageAmount}</td>
                  <td class="text-right font-mono text-xs">{formatCents(o.totalCostCents)}</td>
                  <td>{o.stripeInvoiceItemId ? <Badge variant="success" size="sm">billed</Badge> : <Badge variant="warning" size="sm">unbilled</Badge>}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
    </div>
  </div>
</SidebarLayout>
