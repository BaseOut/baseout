---
// /users — global users directory (admin-entity-directories). Read-only sessions
// access; role='super' gated by middleware. Search + role filter + limit in SQL.
import { and, eq, ilike, inArray, max, or } from 'drizzle-orm';
import SidebarLayout from '../layouts/SidebarLayout.astro';
import PageHeader from '@web/components/ui/PageHeader.astro';
import Card from '@web/components/ui/Card.astro';
import Badge from '@web/components/ui/Badge.astro';
import EmptyState from '@web/components/ui/EmptyState.astro';
import { users, sessions } from '@baseout/db-schema';
import { organizations, organizationMembers } from '../db/schema';
import { buildUsersDirectory } from '../lib/users-directory';
import { entityHref, truncationNote } from '../lib/ui';

const LIMIT = 200;
const url = new URL(Astro.request.url);
const q = (url.searchParams.get('q') ?? '').trim();
const role = (url.searchParams.get('role') ?? '').trim() || null;
const { db } = Astro.locals;

const filters = [] as ReturnType<typeof eq>[];
if (q) filters.push(or(ilike(users.email, `%${q}%`), ilike(users.name, `%${q}%`))!);
if (role) filters.push(eq(users.role, role));
const userRows = await db
  .select({ id: users.id, name: users.name, email: users.email, role: users.role, emailVerified: users.emailVerified, createdAt: users.createdAt })
  .from(users)
  .where(filters.length ? and(...filters) : undefined)
  .orderBy(users.email)
  .limit(LIMIT);

const userIds = userRows.map((u) => u.id);
const [memberships, latestSessions] = userIds.length
  ? await Promise.all([
      db.select({ userId: organizationMembers.userId, organizationId: organizationMembers.organizationId, organizationName: organizations.name, role: organizationMembers.role })
        .from(organizationMembers).innerJoin(organizations, eq(organizationMembers.organizationId, organizations.id)).where(inArray(organizationMembers.userId, userIds)),
      db.select({ userId: sessions.userId, updatedAt: max(sessions.updatedAt) }).from(sessions).where(inArray(sessions.userId, userIds)).groupBy(sessions.userId),
    ])
  : [[], []];

const rows = buildUsersDirectory({
  users: userRows,
  memberships,
  latestSessions: latestSessions.filter((s): s is { userId: string; updatedAt: Date } => !!s.updatedAt),
});

const fmt = (d: Date | null) => (d ? new Date(d).toISOString().slice(0, 10) : 'never');
---

<SidebarLayout title="Admin — Users">
  <div class="mx-auto max-w-[1100px] space-y-6">
    <PageHeader title="Users" description={`Every user, their org memberships, and last sign-in.${truncationNote(userRows.length, LIMIT)}`} />

    <form method="get" class="flex flex-wrap items-center gap-2">
      <input type="search" name="q" value={q} placeholder="Search email or name…" class="input input-bordered input-sm w-64" />
      <select name="role" class="select select-bordered select-sm">
        <option value="" selected={!role}>All roles</option>
        {['customer', 'super'].map((r) => (<option value={r} selected={role === r}>{r}</option>))}
      </select>
      <button class="btn btn-sm btn-primary" type="submit">Apply</button>
    </form>

    <Card variant="outlined">
      {rows.length === 0 ? (
        <EmptyState title="No users match" description="Try a different search or role." />
      ) : (
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead>
              <tr class="border-b border-base-300 text-left text-xs uppercase text-base-content/60">
                <th class="py-2 pr-4 font-medium">User</th>
                <th class="py-2 pr-4 font-medium">Role</th>
                <th class="py-2 pr-4 font-medium">Organizations</th>
                <th class="py-2 pr-4 font-medium">Last seen</th>
              </tr>
            </thead>
            <tbody>
              {rows.map((r) => (
                <tr class="border-b border-base-200/60">
                  <td class="py-2 pr-4">
                    <div class="font-medium">{r.name ?? r.email}</div>
                    <div class="text-xs text-base-content/50">{r.email}{!r.emailVerified && ' · unverified'}</div>
                  </td>
                  <td class="py-2 pr-4">{r.role === 'super' ? <Badge variant="primary">super</Badge> : r.role}</td>
                  <td class="py-2 pr-4">
                    {r.memberships.length === 0 ? <span class="text-base-content/50">—</span> : (
                      <div class="flex flex-wrap gap-1">
                        {r.memberships.map((m) => (
                          <a href={entityHref('org', m.organizationId)} class="link link-hover text-xs">{m.organizationName} <span class="text-base-content/40">({m.role})</span></a>
                        ))}
                      </div>
                    )}
                  </td>
                  <td class="py-2 pr-4 text-base-content/70">{fmt(r.lastSeenAt)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
    </Card>
  </div>
</SidebarLayout>
