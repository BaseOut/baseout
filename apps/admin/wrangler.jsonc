// apps/admin — PROPOSED replacement for wrangler.jsonc.example (3 named envs).
//
//   Top level      = shared config only; always deploy with --env.
//   env.dev        = baseout-admin-dev     (staging account)
//   env.staging    = baseout-admin (pinned bare — Workers Builds name override; staging account, `staging` branch)
//   env.production = baseout-admin         (SEPARATE production account)
//
// `astro dev` runs SSR inside workerd, where a direct postgres-js TCP
// connection to a remote DB does NOT work — the master DB is reached through
// Hyperdrive exactly as apps/web does (middleware reads
// env.HYPERDRIVE.connectionString). {{DATABASE_URL}} is substituted by
// scripts/launch.mjs and matters only for env.dev.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "baseout-admin",
  // No `main` — the @astrojs/cloudflare adapter owns the worker entry.
  "compatibility_date": "2026-04-22",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_compat_populate_process_env"
  ],
  // Astro 6 unified entrypoint — a MODULE SPECIFIER, not a file path, so it
  // resolves in node_modules and exists before the build (@cloudflare/vite-plugin
  // validates `main` at the START of the build; a dist/ path fails there).
  // No `assets` / `no_bundle` / `rules`: the adapter emits those into
  // dist/server/wrangler.json and wrangler follows the .wrangler/deploy/config.json
  // redirect to it. Deploy flow: CLOUDFLARE_ENV=<env> astro build && wrangler deploy.
  "main": "@astrojs/cloudflare/entrypoints/server",
  "observability": {
    "enabled": false,
    "logs": {
      "enabled": false
    }
  },
  "dev": {
    "port": 4333
  },
  "env": {
    "dev": {
      "account_id": "33857e356899b7369fb01c18ace8d780",
      // Where the customer app (and its /login + /api/admin/handoff) lives;
      // the staff gate routes unauthenticated visitors there.
      "vars": {
        "WEB_APP_URL": "https://console.baseout.local",
        "BASEOUT_ENV": "dev"
      },
      // REUSES the shared dev Hyperdrive (baseout-dev-pg) that baseout-dev and
      // baseout-server-dev point at — Workers on the same config share one
      // 15-conn origin pool against dev PG's ~19 usable. Do NOT create a
      // second config for admin (2026-07-08 "backups spin forever" incident).
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          "id": "00000000000000000000000000000000"
        }
      ],
      // Admin doesn't use Astro sessions, but @astrojs/cloudflare injects a
      // SESSION binding unconditionally — without a pinned id, deploy tries to
      // interactively provision one. Dedicated namespace, NOT web's.
      // Adapter-injected binding, non-inheritable — declared per env now that
      // we deploy the source config rather than the adapter's output.
      "images": {
        "binding": "IMAGES"
      },
      "kv_namespaces": [
        {
          "binding": "SESSION"
        }
      ],
      // Staff actions (force backup, invalidate connection) call the engine's
      // SERVER_INTERNAL_TOKEN-gated routes. `remote: true` lets local `astro dev`
      // proxy to the deployed sibling.
      "services": [
        {
          "binding": "SERVER",
          "service": "baseout-server-dev",
          "remote": true
        }
      ]
    },
    "staging": {
      // Workers Builds deploys onto the Worker the build is connected to and
      // overrides any other name via WRANGLER_CI_OVERRIDE_NAME. The connected
      // Workers are unsuffixed, so this env must produce the bare name or the
      // deploy silently lands on a different Worker than the config describes.
      // Production lives in its own account, so the two cannot collide.
      "name": "baseout-admin",
      "routes": [
        {
          "pattern": "admin.baseout.dev",
          "custom_domain": true
        }
      ],
      // account_id intentionally omitted — Workers Builds runs inside the
      // owning account and supplies it. Pinning it here can only create a
      // mismatch, since production builds read this same file in a
      // different account. env.dev keeps its pin for local wrangler use.
      "vars": {
        "WEB_APP_URL": "https://console.baseout.dev",
        "BASEOUT_ENV": "staging"
      },
      // ⚠ ONE canonical list, byte-identical in env.staging and env.production.
      // `secrets` is NOT inherited from the top level (wrangler treats it like
      // `vars`), so it MUST be restated per env — a top-level-only block
      // validates nothing on a --env deploy and warns. `pnpm secrets:check`
      // asserts the two lists match; CI fails on drift.
      // env.dev deliberately has NO block: dev secrets come from .dev.vars
      // and are not deploy-gated.
      "secrets": {
        "required": [
          "ADMIN_HANDOFF_SECRET",
          "SERVER_INTERNAL_TOKEN"
        ]
      },
      // PROVISION: baseout-staging-pg (same config apps/web + apps/server
      // staging use — one pool, per the rule above).
      // PROVISION: `id` is omitted on purpose — wrangler HARD-ERRORS until it is
      // filled in. Do NOT use "id": "" — that silently DROPS the binding and
      // the Worker deploys with no database at all (verified on 4.112).
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          "id": "ec6bd3583c3441569eff3a4b0d11ef30"
        }
      ],
      // PROVISION: wrangler kv namespace create baseout-staging-admin-session
      // Adapter-injected binding, non-inheritable — declared per env now that
      // we deploy the source config rather than the adapter's output.
      "images": {
        "binding": "IMAGES"
      },
      "kv_namespaces": [
        {
          "binding": "SESSION"
        }
      ],
      "services": [
        {
          "binding": "SERVER",
          "service": "baseout-server"
        }
      ],
// Full observability for staging: every request logged AND traced, nothing
      // sampled away. `observability` is INHERITABLE, so this env block overrides
      // the top-level default and leaves dev/production on their own settings.
      // Fields verified against wrangler 4.124's config-schema.json, which sets
      // additionalProperties:false — `redact_query_string` is NOT valid and is
      // silently dropped with a warning. `destinations` is omitted: no Logpush
      // destination exists yet (systems-overview §13).
      "observability": {
        "enabled": true,
        "head_sampling_rate": 1,
        "logs": {
          "enabled": true,
          "head_sampling_rate": 1,
          "invocation_logs": true,
          "persist": true
        },
        "traces": {
          "enabled": true,
          "head_sampling_rate": 1,
          "persist": true
        }
      }
    },
    "production": {
      // Workers Builds deploys onto the Worker the build is connected to and
      // overrides any other name via WRANGLER_CI_OVERRIDE_NAME. The connected
      // Workers are unsuffixed, so this env must produce the bare name or the
      // deploy silently lands on a different Worker than the config describes.
      // Production lives in its own account, so the two cannot collide.
      "name": "baseout-admin",
      // Full observability for production: every request logged AND traced.
      // `observability` is INHERITABLE, so this block overrides the top level —
      // which matters for web/admin, whose top-level `enabled: false` would
      // otherwise leave production logging NOTHING.
      //
      // head_sampling_rate is the cost/volume lever. 1 = keep everything, which is
      // the right posture at launch (low traffic, maximum diagnosability) and the
      // first thing to dial back if ingest volume becomes a bill. Lower it here
      // only — staging should stay at 1.
      //
      // Fields validated against wrangler 4.124's config-schema.json
      // (additionalProperties:false). `destinations` omitted: no Logpush
      // destination exists yet (systems-overview §13).
      "observability": {
        "enabled": true,
        "head_sampling_rate": 1,
        "logs": {
          "enabled": true,
          "head_sampling_rate": 1,
          "invocation_logs": true,
          "persist": true
        },
        "traces": {
          "enabled": true,
          "head_sampling_rate": 1,
          "persist": true
        }
      },
      "routes": [
        {
          "pattern": "admin.baseout.com",
          "custom_domain": true
        }
      ],
      // PROVISION: production account id.
      // account_id intentionally omitted — supplied by Workers Builds in the
      // production account. Never pin it: this file is read by both accounts.
      "vars": {
        "WEB_APP_URL": "https://console.baseout.com",
        "BASEOUT_ENV": "production"
      },
      // ⚠ ONE canonical list, byte-identical in env.staging and env.production.
      // `secrets` is NOT inherited from the top level (wrangler treats it like
      // `vars`), so it MUST be restated per env — a top-level-only block
      // validates nothing on a --env deploy and warns. `pnpm secrets:check`
      // asserts the two lists match; CI fails on drift.
      // env.dev deliberately has NO block: dev secrets come from .dev.vars
      // and are not deploy-gated.
      "secrets": {
        "required": [
          "ADMIN_HANDOFF_SECRET",
          "SERVER_INTERNAL_TOKEN"
        ]
      },
      // PROVISION in the production account: baseout-live-pg.
      // PROVISION: `id` is omitted on purpose — wrangler HARD-ERRORS until it is
      // filled in. Do NOT use "id": "" — that silently DROPS the binding and
      // the Worker deploys with no database at all (verified on 4.112).
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE"
        }
      ],
      // PROVISION in the production account: baseout-live-admin-session.
      // Adapter-injected binding, non-inheritable — declared per env now that
      // we deploy the source config rather than the adapter's output.
      "images": {
        "binding": "IMAGES"
      },
      "kv_namespaces": [
        {
          "binding": "SESSION",
          "id": ""
        }
      ],
      "services": [
        {
          "binding": "SERVER",
          "service": "baseout-server"
        }
      ]
    }
  }
  // Routes: none declared. admin.baseout.com is a dashboard Custom Domain on
  // the production script; admin.baseout.dev is the staging custom domain.
  // Attach domains in the dashboard, or move them here as
  // "routes": [{ "pattern": "admin.baseout.com", "custom_domain": true }]
  // — but then wrangler owns them and a deploy restates them.
}