{
  "name": "@baseout/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Public read-only REST API at api.baseout.com. See openspec/changes/api-rest-read/proposal.md.",
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts",
    "build:deps": "pnpm --filter \"@baseout/api^...\" run build",
    "build:dev": "pnpm run build:deps",
    "build:production": "pnpm run build:deps",
    "build:staging": "pnpm run build:deps",
    "check:dev": "wrangler deploy --env dev --dry-run",
    "check:production": "wrangler deploy --env production --dry-run",
    "check:staging": "wrangler deploy --env staging --dry-run",
    "deploy:dev": "wrangler deploy --env dev && pnpm run secrets:sync:dev",
    "deploy:production": "wrangler deploy --env production",
    "deploy:staging": "node ../../db/scripts/deploy-bootstrap.mjs --worker baseout-api -- deploy --env staging",
    "dev": "node scripts/dev.mjs",
    "lint": "eslint .",
    "openapi:generate": "tsx scripts/generate-openapi.ts",
    "secrets:sync:dev": "node scripts/sync-secrets.mjs --env dev",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@baseout/db-schema": "workspace:*",
    "@baseout/shared": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.9",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240924.0",
    "tsup": "^8.3.0",
    "tsx": "^4.21.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.5",
    "wrangler": "^4.124.0"
  }
}
