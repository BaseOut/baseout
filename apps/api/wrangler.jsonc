{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "baseout-api",
  "main": "./src/index.ts",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],

  // Outgoing service binding to the backup engine (per-Space schema reads;
  // design D3). Local `wrangler dev` binds to a locally-running baseout-server.
  "services": [{ "binding": "SERVER", "service": "baseout-server" }],

  // Per-request usage metering (api-usage-tracking). Queryable via the AE SQL API.
  "analytics_engine_datasets": [{ "binding": "API_USAGE", "dataset": "baseout_api_requests" }],

  // Shadow rate limiting keyed by token id (beta binding). `simple` is the
  // provisional 100 req / 60s placeholder — subject to product-owner confirmation
  // (open question). Enforcement is gated by the RATE_LIMIT_ENFORCE var, not this.
  "unsafe": {
    "bindings": [
      {
        "name": "RATE_LIMITER",
        "type": "ratelimit",
        "namespace_id": "1001",
        "simple": { "limit": 100, "period": 60 }
      }
    ]
  },

  "vars": {
    // Launch state: shadow-only. Flip to "true" to enforce (429) — config, not code.
    "RATE_LIMIT_ENFORCE": "false",
    // Monthly-quota 429s (api-productionization 4.2) — needs AE_* creds + Dan's go.
    "QUOTA_ENFORCE": "false",
    // MCP appUrl deep links (api-search-tools D4) — local dev console.
    "PUBLIC_APP_URL": "https://baseout.local:4331"
  },

  // Master-DB access. Direct postgres-js TLS from workerd hangs (~3 min, then
  // fails) under `wrangler dev` — the same trap apps/server documents — so local
  // dev MUST go through wrangler's local Hyperdrive simulator: `pnpm dev` runs
  // scripts/dev.mjs, which feeds .dev.vars DATABASE_URL to the binding via
  // WRANGLER_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE. The id below is a
  // local-dev placeholder: deployed envs (production/staging) declare their own
  // provisioned binding in their env blocks (task 5.3) — bindings are
  // non-inheritable, so this top-level entry never reaches a deploy.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "00000000000000000000000000000000",
      "localConnectionString": "postgres://run-via-scripts-dev-mjs.invalid:5432/unset"
    }
  ],

  // DEPLOY-BLOCKED (production only — dev deploys today via `pnpm deploy:dev`,
  // see env.dev below). Remaining gap = Dan's env-lane completion for apps/api
  // (api-write-foundation task 5.3):
  //  - Public route on the domain:
  //      "routes": [{ "pattern": "api.baseout.com/*", "zone_name": "baseout.com" }]
  //  - Production Hyperdrive binding in env.production
  //      ("baseout live" Hyperdrive is Dan-owned; id goes here when assigned)
  //  - Logpush + 4xx/5xx alerting.

  "env": {
    // Dev lane (api-write-foundation task 5.1): workers.dev, shared dev
    // Hyperdrive (NEVER a new config — the dev PG cluster is conn-starved),
    // SERVER bound to the production engine script (`baseout-server-dev` was
    // removed in the Aug-19 env-model shift; same posture as apps/web dev).
    // Deploy: `pnpm --filter @baseout/api deploy:dev` (deploy + .dev.vars
    // secret sync — never `wrangler secret put` by hand, CLAUDE.md §3.3).
    // Bindings are non-inheritable, so everything is restated here.
    "dev": {
      "name": "baseout-api-dev",
      "workers_dev": true,
      "services": [{ "binding": "SERVER", "service": "baseout-server" }],
      "analytics_engine_datasets": [{ "binding": "API_USAGE", "dataset": "baseout_api_requests" }],
      "unsafe": {
        "bindings": [
          {
            "name": "RATE_LIMITER",
            "type": "ratelimit",
            "namespace_id": "1001",
            "simple": { "limit": 100, "period": 60 }
          }
        ]
      },
      "vars": {
        "RATE_LIMIT_ENFORCE": "false",
        "QUOTA_ENFORCE": "false",
        "PUBLIC_APP_URL": "https://baseout-dev.openside.workers.dev"
      },
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          "id": "ba2652f40f864918a2da0849f24d12a2"
        }
      ]
    },
    // Production scaffold (api-productionization 4.4): everything restated and
    // ready except Dan's two values + one decision — fill <PROD_HYPERDRIVE_ID>
    // ("baseout live"), uncomment the route, confirm PUBLIC_APP_URL. Secrets
    // (DATABASE_URL fallback unused with Hyperdrive; INTERNAL_TOKEN) are
    // production-managed — NOT synced from any .dev.vars. Per-tier rate
    // limiters (RATE_LIMITER_LITE/_CORE/_PLUS/_MAX/_ENTERPRISE, same
    // `ratelimit` type) slot in beside RATE_LIMITER when Dan's numbers land —
    // the code already selects by plan slug (lib/ratelimit.ts limiterForPlan).
    "production": {
      "name": "baseout-api",
      "services": [{ "binding": "SERVER", "service": "baseout-server" }],
      "analytics_engine_datasets": [{ "binding": "API_USAGE", "dataset": "baseout_api_requests" }],
      "unsafe": {
        "bindings": [
          {
            "name": "RATE_LIMITER",
            "type": "ratelimit",
            "namespace_id": "1001",
            "simple": { "limit": 100, "period": 60 }
          }
        ]
      },
      "vars": {
        "RATE_LIMIT_ENFORCE": "false",
        "QUOTA_ENFORCE": "false"
        // "PUBLIC_APP_URL": "<PROD_CONSOLE_ORIGIN>"  // confirm with Dan (console.baseout.dev?)
      }
      // "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "<PROD_HYPERDRIVE_ID>" }],
      // "routes": [{ "pattern": "api.baseout.com/*", "zone_name": "baseout.com" }]
    },
    "staging": { "name": "baseout-api-staging" }
  }
}
