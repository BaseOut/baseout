{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "baseout-api",
  "main": "./src/index.ts",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],

  // Outgoing service binding to the backup engine (per-Space schema reads;
  // design D3). Local `wrangler dev` binds to a locally-running baseout-server.
  "services": [{ "binding": "SERVER", "service": "baseout-server" }],

  // Per-request usage metering (api-usage-tracking). Queryable via the AE SQL API.
  "analytics_engine_datasets": [{ "binding": "API_USAGE", "dataset": "baseout_api_requests" }],

  // Shadow rate limiting keyed by token id (beta binding). `simple` is the
  // provisional 100 req / 60s placeholder — subject to product-owner confirmation
  // (open question). Enforcement is gated by the RATE_LIMIT_ENFORCE var, not this.
  "unsafe": {
    "bindings": [
      {
        "name": "RATE_LIMITER",
        "type": "ratelimit",
        "namespace_id": "1001",
        "simple": { "limit": 100, "period": 60 }
      }
    ]
  },

  "vars": {
    // Launch state: shadow-only. Flip to "true" to enforce (429) — config, not code.
    "RATE_LIMIT_ENFORCE": "false"
  },

  // DEPLOY-BLOCKED — provisioned in the ops follow-up (task 5.3):
  //  - Hyperdrive binding for the master DB (deployed envs read HYPERDRIVE;
  //    local dev reads DATABASE_URL from .dev.vars):
  //      "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "<PROVISION>" }]
  //  - Public route on the domain:
  //      "routes": [{ "pattern": "api.baseout.com/*", "zone_name": "baseout.com" }]
  //  - Logpush + 4xx/5xx alerting.
  // Secrets (via `wrangler secret bulk .dev.vars` on deploy, per the web/server
  // pipeline): DATABASE_URL, INTERNAL_TOKEN (shared with baseout-server).

  "env": {
    "production": { "name": "baseout-api" },
    "staging": { "name": "baseout-api-staging" }
  }
}
