---
/**
 * BackupScheduleScope — "What gets backed up" (depth) + the depth-driven schedule
 * (openspec backup-schedule-and-scope). Reused in the setup wizard and the
 * Space's backup settings.
 *
 * Model (Dan's 2026-07-01 restructure, research-backed — see
 * research-backup-schedule-scope): Schema is always on; Record Data + Attachments
 * are independent toggles that drive the schedule. Data + attachments always share
 * ONE schedule. Schema is tied to that schedule by default ("Same schedule as the
 * {data & attachments|data|attachments} backup" — a small toggle, ON) or splits to
 * its own cadence.
 *
 * Layout = horizontal (Dan picked this over the integrated variant, 2026-07-01): two
 * columns (What | Schedule); each backup group is one row with the choice(s) LEFT and
 * its schedule RIGHT. The data+attachments row is first so schema's "same as data"
 * references a schedule already shown above. A tie toggle + the dynamic
 * {data & attachments|data|attachments} noun drive the schema box.
 */
import type { Frequency } from '../../lib/capabilities/tier-capabilities';
import CadencePicker from './CadencePicker.astro';

interface Props {
  recordData?: boolean;
  attachments?: boolean;
  schemaTied?: boolean;
  schemaFrequency?: Frequency;
  dataFrequency?: Frequency;
  availableFrequencies: readonly Frequency[];
  nextSchemaAt?: string | null;
  nextDataAt?: string | null;
}
const {
  recordData = true,
  attachments = false,
  schemaTied = true,
  schemaFrequency = 'daily',
  dataFrequency = 'monthly',
  availableFrequencies,
  nextDataAt = null,
} = Astro.props as Props;

const RANK: Record<Frequency, number> = { monthly: 1, weekly: 2, daily: 3, instant: 4 };
const cap = (s: string) => (s ? s.charAt(0).toUpperCase() + s.slice(1) : s);
const fmtNext = (iso: string | null) => {
  if (!iso) return 'Not scheduled yet';
  const d = new Date(iso);
  if (Number.isNaN(d.getTime())) return 'Not scheduled yet';
  const diff = d.getTime() - Date.now();
  if (diff <= 0) return 'Due now';
  const h = Math.round(diff / 3_600_000);
  return h < 24 ? `Next run in ${h}h` : `Next run in ${Math.round(h / 24)}d`;
};

const hasDataBox = recordData || attachments;
const dataTitle = recordData && attachments ? 'Data & attachments backup' : attachments ? 'Attachments backup' : 'Data backup';
// Lowercase inline noun for the tie label + preview ("Same schedule as the {noun} backup").
const dataNoun = recordData && attachments ? 'data & attachments' : attachments ? 'attachments' : 'data';
const tied = hasDataBox && schemaTied;
const schemaLessThanData = RANK[schemaFrequency] < RANK[dataFrequency];
const effectiveCadence: Frequency = hasDataBox ? dataFrequency : schemaFrequency;
---

<section class="bss" data-backup-scope data-rank={JSON.stringify(RANK)}>
    {/* Horizontal layout — left = the layer choice, right = its schedule. The data+attachments
       row is first so schema's "same as data" references a schedule already shown above. */}
    <div class="bss-c">
      <div class="bss-c-heads">
        <span class="bss-legend">What gets backed up</span>
        <span class="bss-legend">Schedule</span>
      </div>

      {/* Data + attachments — FIRST so schema's "same as data" references a schedule already shown above */}
      <div class="bss-c-row">
        <div class="bss-c-what">
          <div class="bss-c-item">
            <label class="bss-dcheck">
              <input type="checkbox" class="checkbox checkbox-sm" checked={recordData} data-depth="recordData" />
              <span class="min-w-0"><span class="bss-drow-name">Record data</span><span class="bss-drow-sub">Every row and field value.</span></span>
            </label>
          </div>
          <div class="bss-c-item">
            <label class="bss-dcheck">
              <input type="checkbox" class="checkbox checkbox-sm" checked={attachments} data-depth="attachments" />
              <span class="min-w-0"><span class="bss-drow-name">Attachments</span><span class="bss-drow-sub">Files attached to records, stored as binaries.</span></span>
            </label>
            <span class="badge badge-soft badge-warning badge-sm shrink-0">Billed on storage</span>
          </div>
        </div>
        <div class="bss-c-when">
          <div data-databox hidden={!hasDataBox}>
            <div class="bss-a-cadhead"><span class="bss-a-cadlabel" data-databox-title>{dataTitle}</span><span class="bss-next" data-next-data>{fmtNext(nextDataAt)}</span></div>
            <CadencePicker name="bss-data-cad" selected={dataFrequency} availableFrequencies={availableFrequencies} />
          </div>
          <p class="bss-c-empty" data-databox-empty hidden={hasDataBox}>Turn on Record data or Attachments to set a schedule.</p>
        </div>
      </div>

      {/* Schema — its choice left, its schedule right */}
      <div class="bss-c-row">
        <div class="bss-c-what">
          <div class="bss-c-item">
            <label class="bss-dcheck cursor-not-allowed">
              <input type="checkbox" class="checkbox checkbox-sm" checked disabled />
              <span class="min-w-0"><span class="bss-drow-name">Schema</span><span class="bss-drow-sub">Tables, fields, views and relationships. Always captured.</span></span>
            </label>
            <span class="badge badge-soft badge-primary badge-sm shrink-0">Always on</span>
          </div>
        </div>
        <div class="bss-c-when">
          <label class="bss-tie bss-tie-toggle" data-tie-wrap hidden={!hasDataBox}>
            <span class="bss-tie-label">Same schedule as the <span data-tie-noun>{dataNoun}</span> backup</span>
            <input type="checkbox" class="toggle toggle-sm toggle-primary" checked={schemaTied} data-schema-tie />
          </label>
          <p class="bss-tie-preview" data-tie-preview hidden={!tied}>
            <span class="iconify lucide--link-2 size-3.5" aria-hidden="true"></span>
            Runs with the <span data-tie-noun>{dataNoun}</span> backup · <span data-tie-preview-cad>{cap(dataFrequency)}</span>
          </p>
          <div class="bss-schema-own" data-schema-own hidden={tied}>
            <CadencePicker name="bss-schema-cad" selected={schemaFrequency} availableFrequencies={availableFrequencies} />
            <p class="bss-hint" data-schema-hint hidden={!hasDataBox}>
              <span class="iconify lucide--info size-3.5" aria-hidden="true"></span>
              Schema can run more often than data. Every data backup also captures schema, so a more frequent schema schedule keeps the Schema page fresh between full backups.
            </p>
            <p class="bss-warn" data-warn hidden={!(hasDataBox && schemaLessThanData)}>
              <span class="iconify lucide--triangle-alert size-3.5" aria-hidden="true"></span>
              Schema is set less frequently than data. Data backups already capture schema, so this schedule is redundant.
            </p>
          </div>
        </div>
      </div>

      <p class="bss-depth-note">Airtable's API can't export automations, interfaces, forms or views — those aren't backed up.</p>
    </div>

  {/* Hidden mirror of the effective primary cadence → the host's cleanup/review reads this. */}
  <input type="radio" name="bss-cleanup-src" value={effectiveCadence} checked data-frequency class="sr-only" tabindex="-1" aria-hidden="true" />
</section>

<style>
  .bss { display: flex; flex-direction: column; }
  .bss-legend { display: block; font-size: .82rem; font-weight: 600; color: oklch(from var(--color-base-content) l c h / .7); margin-bottom: .55rem; }

  /* shared row/checkbox bits */
  .bss-dcheck { display: flex; align-items: flex-start; gap: .65rem; flex: 1; min-width: 0; cursor: pointer; }
  .bss-drow-name { display: block; font-size: .9rem; font-weight: 550; }
  .bss-drow-sub { display: block; font-size: .78rem; line-height: 1.4; color: oklch(from var(--color-base-content) l c h / .55); margin-top: .1rem; }
  .bss-depth-note { font-size: .76rem; line-height: 1.45; color: oklch(from var(--color-base-content) l c h / .6); margin-top: .55rem; }
  .bss-next { font-size: .76rem; color: oklch(from var(--color-base-content) l c h / .55); white-space: nowrap; }

  /* shared tie (toggle) + preview + own-cadence + hint/warn */
  .bss-tie { display: flex; align-items: center; gap: .55rem; cursor: pointer; }
  .bss-tie[hidden] { display: none; }
  .bss-tie-label { font-size: .85rem; font-weight: 500; }
  .bss-tie-toggle { justify-content: space-between; gap: 1rem; }
  .bss-tie-preview { display: flex; align-items: center; gap: .4rem; margin-top: .5rem; font-size: .78rem; color: oklch(from var(--color-base-content) l c h / .55); }
  .bss-tie-preview[hidden] { display: none; }
  .bss-tie-preview .iconify { color: oklch(from var(--color-base-content) l c h / .45); }
  .bss-tie-preview [data-tie-preview-cad] { font-weight: 600; color: oklch(from var(--color-base-content) l c h / .72); }
  .bss-schema-own[hidden] { display: none; }
  .bss-schema-own { margin-top: .6rem; }
  .bss-hint, .bss-warn { display: flex; gap: .4rem; margin-top: .6rem; font-size: .76rem; line-height: 1.45; }
  .bss-hint[hidden], .bss-warn[hidden] { display: none; }
  .bss-hint { color: oklch(from var(--color-base-content) l c h / .58); }
  .bss-hint .iconify { color: oklch(from var(--color-base-content) l c h / .45); flex: none; margin-top: 1px; }
  .bss-warn { padding: .5rem .65rem; border-radius: 8px; border: 1px solid color-mix(in oklch, var(--color-warning) 36%, var(--color-base-300)); background: color-mix(in oklch, var(--color-warning) 8%, var(--color-base-100)); color: oklch(from var(--color-base-content) l c h / .85); }
  .bss-warn .iconify { color: var(--color-warning); flex: none; margin-top: 1px; }

  /* schedule cadence header (shared by the data box) */
  .bss-a-cadhead { display: flex; align-items: baseline; justify-content: space-between; gap: .6rem; margin-bottom: .5rem; }
  .bss-a-cadlabel { font-size: .82rem; font-weight: 600; }

  /* ── A — horizontal (left = choice, right = schedule) ── */
  .bss-c { display: flex; flex-direction: column; gap: .7rem; }
  .bss-c-heads { display: none; }
  .bss-c-row { border: 1px solid var(--color-base-300); border-radius: .8rem; background: var(--color-base-100); overflow: hidden; }
  .bss-c-what { padding: .8rem .95rem; display: flex; flex-direction: column; gap: .75rem; }
  .bss-c-item { display: flex; align-items: flex-start; justify-content: space-between; gap: .5rem; }
  .bss-c-when { padding: .85rem .95rem; background: oklch(from var(--color-base-200) l c h / .3); border-top: 1px solid var(--color-base-300); }
  .bss-c-empty { font-size: .78rem; color: oklch(from var(--color-base-content) l c h / .48); }
  .bss-c-empty[hidden] { display: none; }
  @media (min-width: 640px) {
    .bss-c-heads { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr); gap: 1rem; padding: 0 .25rem; }
    .bss-c-heads .bss-legend { margin-bottom: 0; }
    .bss-c-row { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr); align-items: stretch; }
    .bss-c-what { border-right: 1px solid var(--color-base-300); }
    .bss-c-when { border-top: 0; }
  }

  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }
</style>

<script>
  function wireBackupScope() {
    document.querySelectorAll<HTMLElement>('[data-backup-scope]').forEach(wireOne);
  }
  function wireOne(root: HTMLElement) {
    if (root.dataset.bssWired) return;
    root.dataset.bssWired = '1';
    let RANK: Record<string, number> = { monthly: 1, weekly: 2, daily: 3, instant: 4 };
    try { RANK = JSON.parse(root.dataset.rank || '{}'); } catch { /* default */ }
    const cap = (s: string) => (s ? s.charAt(0).toUpperCase() + s.slice(1) : s);

    const $ = <T extends HTMLElement>(sel: string) => root.querySelector<T>(sel);
    const recordDataCb = $<HTMLInputElement>('[data-depth="recordData"]');
    const attachmentsCb = $<HTMLInputElement>('[data-depth="attachments"]');
    const tieWrap = $('[data-tie-wrap]');
    const tieCb = $<HTMLInputElement>('[data-schema-tie]');
    const dataBox = $('[data-databox]');
    const dataEmpty = $('[data-databox-empty]');
    const dataTitle = $('[data-databox-title]');
    const tiePreview = $('[data-tie-preview]');
    const tiePreviewCad = $('[data-tie-preview-cad]');
    const schemaOwn = $('[data-schema-own]');
    const schemaHint = $('[data-schema-hint]');
    const warn = $('[data-warn]');
    const cleanupMirror = $<HTMLInputElement>('[data-frequency]');

    const sel = (name: string) => root.querySelector<HTMLInputElement>(`input[name="${name}"]:checked`)?.value || '';

    function apply() {
      const recordData = !!recordDataCb?.checked;
      const attachments = !!attachmentsCb?.checked;
      const hasDataBox = recordData || attachments;
      const tied = hasDataBox && !!tieCb?.checked;

      if (dataBox) dataBox.hidden = !hasDataBox;
      if (dataEmpty) dataEmpty.hidden = hasDataBox;
      if (dataTitle) dataTitle.textContent = recordData && attachments ? 'Data & attachments backup' : attachments ? 'Attachments backup' : 'Data backup';
      // keep the tie label + preview noun in sync with what's checked
      const noun = recordData && attachments ? 'data & attachments' : attachments ? 'attachments' : 'data';
      root.querySelectorAll<HTMLElement>('[data-tie-noun]').forEach((el) => (el.textContent = noun));

      if (tieWrap) tieWrap.hidden = !hasDataBox;
      if (tiePreview) tiePreview.hidden = !tied;
      if (schemaOwn) schemaOwn.hidden = tied;
      if (schemaHint) schemaHint.hidden = !hasDataBox;

      const dataF = sel('bss-data-cad');
      const schemaF = sel('bss-schema-cad');
      if (tiePreviewCad) tiePreviewCad.textContent = cap(dataF);
      const effective = hasDataBox ? dataF : schemaF;
      if (cleanupMirror && effective && cleanupMirror.value !== effective) {
        cleanupMirror.value = effective;
        cleanupMirror.dispatchEvent(new Event('change', { bubbles: true }));
      }
      syncWarn();
    }

    function syncWarn() {
      if (!warn) return;
      const hasDataBox = !!(recordDataCb?.checked || attachmentsCb?.checked);
      const tied = hasDataBox && !!tieCb?.checked;
      const dataF = sel('bss-data-cad');
      const schemaF = sel('bss-schema-cad');
      warn.hidden = !(hasDataBox && !tied && dataF && schemaF && RANK[schemaF] < RANK[dataF]);
    }

    recordDataCb?.addEventListener('change', apply);
    attachmentsCb?.addEventListener('change', apply);
    tieCb?.addEventListener('change', apply);
    root.querySelector('[name="bss-data-cad"]')?.closest('.cad')?.addEventListener('change', apply);
    root.querySelector('[name="bss-schema-cad"]')?.closest('.cad')?.addEventListener('change', apply);

    apply();
  }
  wireBackupScope();
  document.addEventListener('astro:after-swap', wireBackupScope);
</script>
