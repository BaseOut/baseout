  .dcp-copyid { display: inline-grid; place-items: center; width: 20px; height: 20px; flex: none; border: 0; background: none; border-radius: 5px; cursor: pointer; color: oklch(from var(--color-base-content) l c h / .5); transition: color .4s ease, background-color .4s ease; }
  .dcp-copyid:hover { background: oklch(from var(--color-base-content) l c h / .1); color: var(--color-base-content); }
