  .dcp-copied .iconify { animation: dcp-copypop .32s cubic-bezier(.34,1.56,.64,1); }
  @keyframes dcp-copypop { 0% { transform: scale(.3); opacity: 0; } 60% { transform: scale(1.3); } 100% { transform: scale(1); opacity: 1; } }
  /* TRUE TABS — the drawer's pill-chip idiom (mirrors .rp-secnav-chip) + a count. */
  /* Change-type SEGMENTED CONTROL — a full-width, filled track with 3 equal segments below the header. */
  .dcp-segband { padding: 12px 16px 0; }
  .dcp-searchband { padding: 12px 16px 0; }
  .dcp-search { width: 100%; }
  .dcp-tabs { display: flex; gap: 4px; padding: 4px; background: var(--color-base-200); border-radius: 10px; }
  .dcp-tab { flex: 1; display: inline-flex; align-items: center; justify-content: center; gap: 6px; padding: 8px 12px; font-size: 13px; font-weight: 550; border: 0; background: none; border-radius: 8px; cursor: pointer; color: oklch(from var(--color-base-content) l c h / .6); white-space: nowrap; } /* ds-ok: 6px optical dot↔label gap */
  .dcp-tab:hover:not(.is-active) { color: var(--color-base-content); }
  .dcp-tab.is-active { background: var(--color-base-100); color: var(--color-primary); font-weight: 600; box-shadow: 0 1px 2px oklch(0 0 0 / .08); }
  .dcp-tab-zero { opacity: .45; }
