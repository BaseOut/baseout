---
/**
 * LockedTab — an in-place locked capability state (pattern-locked-tab). Used on the Data page
 * for the dynamic-only tabs (Changelog / record History / Chat) in a static-only Space: the
 * feature is shown where it would live, explaining what it does and why it needs a dynamic
 * backup, with the standard enable affordance. A data-capability constraint, not a price tier.
 */
interface Props {
  title: string;
  what: string;
  cta?: string;
}
const { title, what, cta = 'Enable dynamic backups' } = Astro.props;
---

<div class="lt">
  <span class="lt-ic"><span class="iconify lucide--lock size-5" aria-hidden="true"></span></span>
  <p class="lt-title">{title}</p>
  <p class="lt-what">{what}</p>
  <button type="button" class="btn btn-primary btn-sm lt-cta">{cta}</button>
</div>

<style>
  .lt { display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; gap: 8px; min-height: 320px; padding: 48px 24px; border: 1px dashed var(--color-base-300); border-radius: 14px; background: oklch(from var(--color-base-200) l c h / .3); }
  .lt-ic { display: grid; place-items: center; width: 3rem; height: 3rem; border-radius: .8rem; background: var(--color-base-200); }
  .lt-ic .iconify { opacity: .6; }
  .lt-title { font-size: 16px; font-weight: 650; }
  .lt-what { font-size: 14px; color: oklch(from var(--color-base-content) l c h / .6); max-width: 52ch; }
  .lt-cta { margin-top: 4px; }
</style>
