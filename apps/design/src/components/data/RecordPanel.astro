---
/**
 * RecordPanel — the record detail drawer for the Data page. Same component FAMILY as the
 * Schema EntityPanel (the canonical detail-panel anatomy: right-anchored drawer + scrim,
 * concept-icon tile + name in the header, crumbs sub-row, scroll-owning body, ESC / outside
 * click closes) but self-contained for records rather than schema entities.
 *
 * Two sections (segmented): **Fields** — every backed-up value, type-aware, with cell
 * provenance on computed/relational fields (pattern-cell-provenance); and **History** — the
 * record's cross-backup diff timeline (pattern-record-history) with "view as of this backup".
 * Linked / source rows PUSH that record onto a nav stack; Back pops. Presentational: opened by
 * `data:openRecord { id }` (dispatched by the Browse grid + Everywhere rows).
 */
import { AIRTABLE_FIELD_ICONS, airtableIconKey } from '../schema/airtableFieldIcons';
import type { DataBase, DataTable, DataRecord, DataComment } from './dataTypes';
import { authorLabel, authorInitials, resolveMentions, commentStatus } from './commentText';

interface Props {
  bases: DataBase[];
  tables: DataTable[];
  records: DataRecord[];
  /** In a static-only Space, per-record History is a locked (dynamic-only) capability. */
  mode?: 'dynamic' | 'static' | 'both';
  /** Docs that can tag records (B5 reverse links) — drives the "Referenced in" section.
   *  `kind` is built now so chats can join the same list later without a reshape. */
  docs?: { id: string; title: string; recordIds?: string[] }[];
  /** Captured record comments — drives the in-panel Comments section (comments-explorer). */
  comments?: DataComment[];
  /** The Space's latest capture — what a comment's `lastSeenAt` is measured against. */
  lastSyncedAt?: string;
}
const { bases, tables, records, mode = 'dynamic', docs = [], comments = [], lastSyncedAt } = Astro.props;

// recordId → the docs that tag it (B5 "Referenced in"). Docs are the only source today;
// chat threads will push { kind: 'chat' } refs into the same map when they gain record tags.
const docRefs: Record<string, { id: string; title: string; kind: 'doc' }[]> = {};
for (const d of docs) for (const rid of d.recordIds || []) (docRefs[rid] ||= []).push({ id: d.id, title: d.title, kind: 'doc' });

// recordId → its comments, oldest first (a conversation reads down, unlike the stream, which is a
// feed and reads newest-first). Everything the panel shows is resolved HERE — the mention-resolved
// text, the author label, the three-state status — so the panel body cannot drift from the feed by
// re-deriving the same rules a second time. `recordCaptured` is true by construction: a record with
// a panel is a record we hold, which is exactly what makes "Deleted" sayable here.
const recordIds = new Set(records.map((r) => r.id));
const panelComments: Record<string, unknown[]> = {};
for (const c of [...comments].sort((a, b) => a.createdAt.localeCompare(b.createdAt))) {
  if (!recordIds.has(c.recordId)) continue;
  (panelComments[c.recordId] ||= []).push({
    id: c.id,
    author: authorLabel(c.author),
    initials: authorInitials(c.author),
    // FULL text here, not the feed's one-line snippet: the panel is where someone came to read it.
    text: resolveMentions(c.text, c.mentioned),
    at: c.createdAt,
    edited: !!c.lastUpdatedAt,
    status: commentStatus(c, { recordCaptured: true, latestSyncAt: lastSyncedAt }),
    lastSeenAt: c.lastSeenAt,
    parentId: c.parentCommentId,
    attachmentCount: c.attachments?.length ?? 0,
  });
}

const snapshot = {
  baseName: Object.fromEntries(bases.map((b) => [b.id, b.name])),
  tables: tables.map((t) => ({ id: t.id, baseId: t.baseId, name: t.name, fields: t.fields })),
  records: records.map((r) => ({ id: r.id, tableId: r.tableId, primary: r.primary, cells: r.cells, linked: r.linked, history: r.history })),
  docRefs,
  comments: panelComments,
};
const iconsByType = Object.fromEntries(
  tables.flatMap((t) => t.fields).map((f) => {
    const k = airtableIconKey(f.type);
    return [f.type, k ? `<svg viewBox="0 0 16 16" width="13" height="13" aria-hidden="true">${AIRTABLE_FIELD_ICONS[k]}</svg>` : ''];
  }),
);
---

<div class="rp-wrap" data-recordpanel hidden>
  {/* NON-MODAL (mirrors Schema's EntityPanel): no scrim, the grid stays clickable behind the drawer.
      Coplanar multi-panel stack (up to MAXPANELS) with an ANCHOR at slot 0, auto-accordion to strips,
      detach/reorder, and a ＋ rail — reproducing the Schema EntityPanel controller. */}
  <div class="rp-panels" data-rp-panels>
    {/* Zero-width rail as the FIRST flex child; because the group is justify-content:flex-end, the rail's
        right edge sits at the leftmost panel's left edge and its controls hang LEFT into negative space. */}
    <div class="rp-rail" data-rp-rail hidden>
      <button type="button" class="rp-shutter tooltip tooltip-right" data-rp-shutter aria-label="Drag to resize all panels" data-tip="Drag to resize all panels equally"><span class="rp-shutter-pill" aria-hidden="true"></span></button>
      <button type="button" class="btn btn-sm btn-primary btn-circle rp-rail-add tooltip tooltip-left" data-rp-addbtn aria-label="Open a record beside" data-tip="Open a record beside"><span class="iconify lucide--plus size-4" aria-hidden="true"></span></button>
      <span class="rp-rail-count" data-rp-count hidden></span>
    </div>
  </div>
  {/* base→table→record search picker (Data typeahead over the records). */}
  <div class="rp-addpop" data-rp-addpop hidden>
    <div class="rp-addpop-head"><span>Open a record beside</span><button type="button" class="rp-addscope" data-rp-addscope></button></div>
    <label class="input input-sm rp-addsearch"><span class="iconify lucide--search size-3.5 opacity-50" aria-hidden="true"></span><input type="search" data-rp-addsearch placeholder="Search records…" aria-label="Search records" autocomplete="off" /></label>
    <div class="rp-addlist" data-rp-addlist></div>
  </div>
  {/* Undo / info toast (outside the panels so it survives the last panel closing). */}
  <div class="rp-undo" data-rp-undo hidden role="status">
    <span class="iconify rp-undo-ic size-4" data-rp-undo-ic aria-hidden="true"></span>
    <span class="rp-undo-label" data-rp-undo-label></span>
    <button type="button" class="rp-undo-act" data-rp-undo-act hidden></button>
    <span class="rp-undo-bar" data-rp-undo-bar></span>
  </div>
</div>

{/* A single panel, cloned per open panel. */}
<template data-rp-tpl>
  <aside class="rp-sheet" data-rp-panel role="dialog" aria-modal="false" aria-label="Record details">
    {/* Resize handle — variable width, drawer canon (mirrors the Schema EntityPanel .ep-grip). */}
    <div class="rp-grip" data-rp-grip aria-hidden="true"><span class="rp-grip-line"></span></div>
    {/* Anchor lock scrim — shown on the anchor during a reorder drag ("docked, can't be reordered"). */}
    <div class="rp-lock" aria-hidden="true"><span class="iconify lucide--lock size-5"></span><span>Docked to the table</span></div>
    <header class="rp-head">
      <div class="rp-head-row">
        <button type="button" class="rp-reorder tooltip tooltip-right" data-rp-reorder aria-label="Drag to reorder" data-tip="Drag to reorder"><span class="iconify lucide--grip-vertical size-4" aria-hidden="true"></span></button>
        <button type="button" class="btn btn-sm btn-ghost btn-square rp-detach tooltip tooltip-right" data-rp-detach aria-label="Detach panel" data-tip="Detach"><span class="iconify lucide--pin-off size-3.5" aria-hidden="true"></span></button>
        <button type="button" class="btn btn-sm btn-ghost btn-square rp-back tooltip tooltip-bottom" data-rp-back aria-label="Back" data-tip="Back" hidden>
          <span class="iconify lucide--arrow-left size-4" aria-hidden="true"></span>
        </button>
        {/* A record's own glyph (Oleh, 2026-07-30). This was `lucide--table-2` — the TABLE's glyph
            standing in for a record, so a panel titled with a record name wore the icon of a
            different concept. */}
        <span class="rp-head-ic" data-rp-head-ic aria-hidden="true"><span class="iconify lucide--circle-dot concept-ic-record size-4"></span></span>
        <div class="rp-head-title" data-rp-title></div>
        {/* "View … in Airtable" as a corner icon (label in the tooltip) — declutters the header; set per view. */}
        <a class="btn btn-sm btn-ghost btn-square rp-viewat tooltip tooltip-left" data-rp-viewat href="https://airtable.com" target="_blank" rel="noopener" aria-label="View record in Airtable" data-tip="View record in Airtable"><span class="iconify lucide--external-link size-4" aria-hidden="true"></span></a>
        <button type="button" class="btn btn-sm btn-ghost btn-square rp-park tooltip tooltip-bottom" data-rp-park aria-label="Collapse to strip" data-tip="Collapse"><span class="iconify lucide--chevrons-left size-4" aria-hidden="true"></span></button>
        <button type="button" class="btn btn-sm btn-ghost btn-square rp-x tooltip tooltip-left" data-rp-closepanel aria-label="Close" data-tip="Close">
          <span class="iconify lucide--x size-4" aria-hidden="true"></span>
        </button>
      </div>
      {/* Ancestors on the left, record id pulled to the right corner of the same row (Oleh 2026-07-21). */}
      <div class="rp-crumbrow" data-rp-crumbrow hidden>
        <nav class="rp-crumbs sb-crumb-row" data-rp-crumbs aria-label="Breadcrumb"></nav>
        <div class="rp-idchip" data-rp-idchip hidden></div>
      </div>
      {/* In-panel section jump-nav (3rd header row), shown only when the body scrolls — Schema parity. */}
      <nav class="rp-secnav" data-rp-secnav aria-label="Sections" hidden></nav>
      {/* "View record in Airtable" now lives at the TOP of the body (Schema-parity). */}
    </header>
    <div class="rp-body" data-rp-body></div>
  </aside>
</template>

<script type="application/json" data-rp-snapshot set:html={JSON.stringify(snapshot)} />
<script type="application/json" data-rp-icons set:html={JSON.stringify(iconsByType)} />
<script type="application/json" data-rp-mode set:html={JSON.stringify(mode)} />

<script>
  import { createPanelStack } from '../ui/panelStack';
  import { entityIconClass, entityIconMarkup } from '../schema/entityIcon';
  import {
    esc, family, ic, cellValue, provFormula, provLookup, linkedList,
    secHead, ancestorCrumbs, renderRecordBody, paintLinked, crumb, sep, PAGE,
    type Field, type Table, type Rec, type DocRef, type RecordBodyCtx, type PanelComment,
  } from './recordReadBody';
  type Snap = { baseName: Record<string, string>; tables: Table[]; records: Rec[]; docRefs?: Record<string, DocRef[]>; comments?: Record<string, PanelComment[]> };

  const RP_MINW = 360;
  const isMobile = () => window.matchMedia('(max-width: 1023.98px)').matches;
  // A live panel = one .rp-sheet with its OWN drill stack + view state. Up to two coplanar panels.
  type Panel = {
    el: HTMLElement; body: HTMLElement; titleEl: HTMLElement; crumbsEl: HTMLElement;
    backBtn: HTMLElement; headIc: HTMLElement; grip: HTMLElement; idChip: HTMLElement; secnav: HTMLElement;
    viewat: HTMLAnchorElement; crumbRow: HTMLElement;
    stack: string[]; asOf: string | null; fieldQuery: string; linkTab: string;
    fieldView: { fieldId: string; recId: string } | null; fieldTableCols: string[]; vtQuery: string;
    pendingFocus: string | null; pendingComment: string | null; render: () => void;
    // Multi-panel controller state (mirrors Schema's P record).
    uid: number; anchor: boolean; w: number; seq: number; collapsed: boolean;
  };

  function wireRecordPanel() {
    const root = document.querySelector<HTMLElement>('[data-recordpanel]');
    if (!root || root.dataset.rpWired) return;
    root.dataset.rpWired = '1';
    const snap: Snap = JSON.parse(document.querySelector('[data-rp-snapshot]')?.textContent || '{}');
    const icons: Record<string, string> = JSON.parse(document.querySelector('[data-rp-icons]')?.textContent || '{}');
    const mode: string = JSON.parse(document.querySelector('[data-rp-mode]')?.textContent || '"dynamic"');
    const staticMode = mode === 'static';
    const recById = new Map((snap.records || []).map((r) => [r.id, r]));
    const tableById = new Map((snap.tables || []).map((t) => [t.id, t]));
    // Shared-body context (recordReadBody.ts) — RP is the full-affordance host: field rows open
    // field-config, and "Referenced in" renders (both dropped for a DCP drill-hosted body).
    const bodyCtx: RecordBodyCtx = { baseName: snap.baseName, tableById, recById, icons, staticMode, docRefs: snap.docRefs || {}, fieldClickable: true, showRefs: true, comments: snap.comments || {} };

    const panelsEl = root.querySelector<HTMLElement>('[data-rp-panels]')!;
    const tpl = document.querySelector<HTMLTemplateElement>('[data-rp-tpl]')!;
    const elToPanel = new WeakMap<HTMLElement, Panel>();
    // ＋ add-record picker refs (Schema .ep-rail parity).
    const railEl = root.querySelector<HTMLElement>('[data-rp-rail]')!;
    const addPop = root.querySelector<HTMLElement>('[data-rp-addpop]')!;
    const addScopeBtn = root.querySelector<HTMLButtonElement>('[data-rp-addscope]')!;
    const addSearch = root.querySelector<HTMLInputElement>('[data-rp-addsearch]')!;
    const addList = root.querySelector<HTMLElement>('[data-rp-addlist]')!;
    let addScope = ''; // '' = All bases · a base id = This base
    const topId = (p: Panel) => p.stack[p.stack.length - 1];

    // Human label per Airtable field type (fallback = de-camelCased) — for the field-config view.
    const TYPE_LABEL: Record<string, string> = {
      singleLineText: 'Single line text', multilineText: 'Long text', email: 'Email', url: 'URL', phoneNumber: 'Phone',
      number: 'Number', currency: 'Currency', percent: 'Percent', rating: 'Rating', duration: 'Duration', autoNumber: 'Auto number',
      date: 'Date', dateTime: 'Date & time', createdTime: 'Created time', lastModifiedTime: 'Last modified',
      singleSelect: 'Single select', multipleSelects: 'Multiple select', checkbox: 'Checkbox',
      multipleRecordLinks: 'Link to record', multipleLookupValues: 'Lookup', rollup: 'Rollup', count: 'Count', formula: 'Formula',
    };
    const typeLabel = (t: string) => TYPE_LABEL[t] || t.replace(/([A-Z])/g, ' $1').replace(/^./, (c) => c.toUpperCase());

    // Fields/Linked/History/Referenced-in + their local helpers (esc/fmtDate/family/ic/cellValue/
    // valuesAsOf/provFormula/linkedList/provLookup/secHead) now live in recordReadBody.ts (shared
    // with the DCP drill host) — imported above.

    // ── Field-config view (pushed into a panel's own stack; Back returns to the record) ──────────
    // Two STACKED sections (not tabs): the field details, then a "Values" table of this field across
    // records with its own search + an ＋ Add-column picker (the D3 client ask, Data-only).
    // The table + footer (re-rendered alone on search, so the search input keeps focus).
    const vtBody = (t: Table, f: Field, p: Panel): string => {
      const primary = t.fields[0];
      const extra = p.fieldTableCols.map((id) => t.fields.find((x) => x.id === id)).filter((x): x is Field => !!x);
      const cols = [primary, ...(f.id === primary.id ? [] : [f]), ...extra];
      const q = p.vtQuery.trim().toLowerCase();
      const recs = snap.records.filter((r) => r.tableId === t.id && (!q || cols.some((c) => (r.cells[c.id]?.raw || '').toLowerCase().includes(q))));
      const win = recs.slice(0, 50);
      const head = cols.map((c) => `<th>${ic(bodyCtx, c.type)}${esc(c.name)}</th>`).join('');
      const rows = win.map((r) => `<tr data-rp-open="${r.id}">${cols.map((c, i) => `<td class="${i === 0 ? 'rp-vt-primary' : ''}">${cellValue(r, c)}</td>`).join('')}</tr>`).join('') || `<tr><td colspan="${cols.length}" class="rp-vt-empty">No records match.</td></tr>`;
      const shown = new Set(cols.map((c) => c.id));
      const avail = t.fields.filter((x) => !shown.has(x.id));
      const picker = avail.length ? `<select class="select select-sm rp-vt-add" data-rp-vt-add aria-label="Add a column"><option value="">＋ Add column…</option>${avail.map((x) => `<option value="${x.id}">${esc(x.name)}</option>`).join('')}</select>` : '';
      return `<div class="rp-vt-wrap"><table class="rp-vt"><thead><tr>${head}</tr></thead><tbody>${rows}</tbody></table></div>
        <div class="rp-vt-foot">${picker}<span class="rp-vt-note">${win.length.toLocaleString()} of ${recs.length.toLocaleString()} records</span></div>`;
    };
    const renderValueTable = (t: Table, f: Field, p: Panel): string => {
      const search = `<label class="input input-sm rp-vt-search"><span class="iconify lucide--search size-3.5 opacity-50" aria-hidden="true"></span><input type="search" data-rp-vtsearch value="${esc(p.vtQuery)}" placeholder="Search records" aria-label="Search records" /></label>`;
      return `<div class="rp-sec" data-rp-vtsec>${secHead('lucide--table-2', 'Values')}${search}<div data-rp-vtbody>${vtBody(t, f, p)}</div></div>`;
    };
    const renderFieldConfig = (rec: Rec, f: Field, p: Panel): string => {
      const t = tableById.get(rec.tableId)!;
      const row = (k: string, v: string) => `<div class="rp-fc-row"><span class="rp-fc-key">${esc(k)}</span><span class="rp-fc-val">${v}</span></div>`;
      let out = row('Type', `${ic(bodyCtx, f.type)}<span>${esc(typeLabel(f.type))}</span>`);
      out += row('Value on this record', cellValue(rec, f));
      if (f.linkedTableId) { const lt = tableById.get(f.linkedTableId); out += row('Links to', `${ic(bodyCtx, 'multipleRecordLinks')}<span>${esc(lt?.name || '—')}</span>`); }
      if (f.expression) out += row('Formula', `<code class="rp-fc-mono">${esc(f.expression)}</code>`);
      if (f.aggregation) out += row('Rollup', esc(f.aggregation));
      // Section 1: field details. Section 2: the values table (stacked, not a tab).
      return `<div class="rp-sec">${secHead('lucide--info', 'Field')}<div class="rp-fc">${out}</div>
        <div class="rp-fc-note">Full field settings — description, sync — live in <a class="rp-fc-link" href="/schema">Schema</a>.</div></div>${renderValueTable(t, f, p)}`;
    };

    // ── Per-panel render ─────────────────────────────────────────────────────────
    // In-panel section jump-nav (Schema `.ep-secnav` parity): a chip per body section, shown only when
    // the body actually scrolls; scroll-spy marks the active chip; a chip click scrolls to that section.
    const spyByPanel = new WeakMap<Panel, EventListener>();
    function wireSecNav(p: Panel) {
      const old = spyByPanel.get(p); if (old) p.body.removeEventListener('scroll', old);
      const secs = [...p.body.querySelectorAll<HTMLElement>('.rp-sec[id]')];
      const scrolls = p.body.scrollHeight > p.body.clientHeight + 4;
      if (!scrolls || secs.length < 2) { p.secnav.hidden = true; p.secnav.innerHTML = ''; return; }
      p.secnav.hidden = false;
      p.secnav.innerHTML = secs.map((s) => {
        const label = s.querySelector('.rp-seclabel span:not(.rp-sec-ic):not(.rp-sec-count)')?.textContent || s.id;
        return `<button type="button" class="rp-secnav-chip" data-rp-secnav-to="${s.id}">${esc(label)}</button>`;
      }).join('');
      const spy = () => {
        const top = p.body.scrollTop; let active = secs[0];
        for (const s of secs) { if (s.offsetTop - 12 <= top) active = s; }
        if (top + p.body.clientHeight >= p.body.scrollHeight - 4) active = secs[secs.length - 1]; // bottom → last
        p.secnav.querySelectorAll<HTMLElement>('.rp-secnav-chip').forEach((c) => c.classList.toggle('is-active', c.dataset.rpSecnavTo === active.id));
      };
      spyByPanel.set(p, spy); p.body.addEventListener('scroll', spy, { passive: true }); spy();
    }

    function makeRender(p: Panel) {
      return () => {
        const rec = recById.get(topId(p));
        if (!rec) return;
        const t = tableById.get(rec.tableId)!;
        const fv = p.fieldView && p.fieldView.recId === rec.id ? t.fields.find((x) => x.id === p.fieldView!.fieldId) : null;
        if (p.fieldView && !fv) p.fieldView = null;
        // "View … in Airtable" is a header corner icon (label in the tooltip); set per view. TODO(engine):
        // real Airtable ids for a working URL (placeholder host today, as before).
        const setViewat = (label: string) => { p.viewat.dataset.tip = label; p.viewat.setAttribute('aria-label', label); p.viewat.hidden = false; };
        // Back button: within-panel drill (a pushed stack, or a field view) reads "Back"; hidden once
        // the panel's own drill stack is exhausted (Browse/Docs only ever open a fresh panel — no
        // outside-origin exit anymore, see the removed `origin` mechanism).
        const setBack = (within: boolean) => {
          p.backBtn.hidden = !within;
          if (within) { p.backBtn.dataset.tip = 'Back'; p.backBtn.setAttribute('aria-label', 'Back'); }
        };
        if (fv) {
          p.titleEl.textContent = fv.name;
          p.headIc.innerHTML = ic(bodyCtx, fv.type);
          p.idChip.hidden = true;
          p.crumbRow.hidden = false;
          setViewat('View field in Airtable');
          // Ancestors only (base ▸ table ▸ record); the field name lives in the title, not a tail crumb.
          // The record segment used to pass an EMPTY icon, which still emitted the 14px crumb slot
          // — so this trail read 🗄 Base ▸ ▤ Table ▸ ⬚ Record, holding a blank box open where a
          // glyph belonged. It has one now.
          p.crumbsEl.innerHTML = crumb(entityIconClass('base'), snap.baseName[t.baseId]) + sep + crumb(entityIconClass('table'), t.name) + sep + crumb(entityIconClass('record'), rec.primary);
          setBack(true);
          p.secnav.hidden = true;
          p.body.innerHTML = renderFieldConfig(rec, fv, p);
          p.body.scrollTop = 0;
          return;
        }
        p.titleEl.textContent = rec.primary;
        p.headIc.innerHTML = entityIconMarkup('record', { size: 'size-4' });
        p.idChip.hidden = false;
        p.crumbRow.hidden = false;
        setViewat('View record in Airtable');
        // Right corner of the crumb row + one-click copy (tooltip-LEFT so it grows inward from the edge).
        p.idChip.innerHTML = `<span class="rp-idlabel">ID</span><code class="rp-idval">${esc(rec.id)}</code><button type="button" class="rp-copyid tooltip tooltip-left" data-rp-copyid="${esc(rec.id)}" aria-label="Copy record ID" data-tip="Copy ID"><span class="iconify lucide--copy size-3.5" aria-hidden="true"></span></button>`;
        // Ancestors only (base ▸ table); the record name lives in the title, not a tail crumb (Schema parity).
        p.crumbsEl.innerHTML = ancestorCrumbs(bodyCtx, rec);
        setBack(p.stack.length > 1);
        p.body.innerHTML = renderRecordBody(bodyCtx, p, rec);
        const lc = p.body.querySelector<HTMLElement>('[data-rp-linked]'); if (lc) paintLinked(bodyCtx, lc);
        p.body.scrollTop = 0;
        wireSecNav(p);
        if (p.pendingFocus === 'history') { document.getElementById('rp-sec-history')?.scrollIntoView({ block: 'start' }); }
        // Deep link from the Comments feed: land on the section, and on the exact comment when the
        // feed named one. The highlight is a transient CUE, not a selection — it fades on its own,
        // because nothing here is selectable and a permanent mark would look like state.
        if (p.pendingFocus === 'comments') {
          const target = p.pendingComment ? p.body.querySelector<HTMLElement>(`[data-rp-comment="${p.pendingComment}"]`) : null;
          const sec = p.body.querySelector<HTMLElement>('#rp-sec-comments');
          (target || sec)?.scrollIntoView({ block: target ? 'center' : 'start' });
          if (target) {
            target.classList.add('rp-cm-hit');
            setTimeout(() => target.classList.remove('rp-cm-hit'), 2400);
          }
        }
        p.pendingFocus = null;
        p.pendingComment = null;
      };
    }

    // ── Panel factory ────────────────────────────────────────────────────────────
    // ── Multi-panel controller (ports Schema EntityPanel's wireEntityPanel 1:1) ──────
    // MINEXP === MINW so three record panels fit a 1440px laptop expanded side by side.
    // MAXPANELS caps how many panels EXIST; opening past what fits parks the new one to a 46px strip
    // (auto-accordion) rather than destroying an existing panel. Only the hard ceiling evicts (undoable).
    // Stack geometry — consumed by the shared createPanelStack controller (built lower). railAdd/countEl/
    // undoTimer stay host-side (the ＋ picker, the rail count, and the toast DOM).
    const DEFW = 480, MINW = RP_MINW, TABLEGAP = 64, MAXPANELS = 10, MINEXP = 360, COLLAPSE_AT = 300;
    const railAdd = railEl.querySelector<HTMLElement>('[data-rp-addbtn]')!;
    const countEl = root.querySelector<HTMLElement>('[data-rp-count]')!;
    let undoTimer = 0;


    // ── Panel factory (template clone + per-panel resize grip; NOT yet in the array) ─
    const resetView = (p: Panel) => { p.asOf = null; p.fieldQuery = ''; p.linkTab = ''; };
    const loadInto = (p: Panel, id: string) => { p.stack = [id]; resetView(p); p.fieldView = null; p.fieldTableCols = []; p.vtQuery = ""; };
    function buildPanel(): Panel {
      const el = tpl.content.firstElementChild!.cloneNode(true) as HTMLElement;
      const p: Panel = {
        el,
        body: el.querySelector<HTMLElement>('[data-rp-body]')!,
        titleEl: el.querySelector<HTMLElement>('[data-rp-title]')!,
        crumbsEl: el.querySelector<HTMLElement>('[data-rp-crumbs]')!,
        backBtn: el.querySelector<HTMLElement>('[data-rp-back]')!,
        headIc: el.querySelector<HTMLElement>('[data-rp-head-ic]')!,
        grip: el.querySelector<HTMLElement>('[data-rp-grip]')!,
        idChip: el.querySelector<HTMLElement>('[data-rp-idchip]')!,
        viewat: el.querySelector<HTMLAnchorElement>('[data-rp-viewat]')!,
        crumbRow: el.querySelector<HTMLElement>('[data-rp-crumbrow]')!,
        secnav: el.querySelector<HTMLElement>('[data-rp-secnav]')!,
        stack: [], asOf: null, fieldQuery: '', linkTab: '', fieldView: null, fieldTableCols: [], vtQuery: '', pendingFocus: null, pendingComment: null, render: () => {},
        uid: 0, anchor: false, w: 0, seq: 0, collapsed: false,
      };
      p.render = makeRender(p);
      elToPanel.set(el, p);
      // uid / width / seq + the per-panel resize grip are assigned & wired by createPanelStack.
      return p;
    }

    // createPanel / open / openBeside / close+undo / evict / detach / park / reorder + shutter + resize-grip
    // are all owned by createPanelStack (built below). The host keeps its content render + openFieldBeside.
    // Open a FIELD's config in a 2nd panel (⌘/Ctrl-click a field) — mirrors Schema's open-beside.
    function openFieldBeside(source: Panel, fieldId: string, recId: string) {
      if (isMobile()) { source.fieldView = { fieldId, recId }; source.fieldTableCols = []; source.vtQuery = ""; source.render(); return; }
      const spawn = (p: Panel) => { p.fieldView = { fieldId, recId }; p.fieldTableCols = []; p.vtQuery = ""; };
      if (stack.atCap()) {
        showToast(`Can't add another panel — maximum of ${MAXPANELS} reached.`,
          { label: 'Close oldest', icon: 'lucide--layers', run: () => { stack.evictLRU(false); stack.createPanel(recId, false, spawn); stack.layout(); } }, 6000);
        return;
      }
      stack.createPanel(recId, false, spawn); stack.layout();
    }

    // ── Undo / info toast (pattern-undo-toast) ──────────────────────────────────────
    const UNDO_MS = 4000;
    function restartCountdown(el: HTMLElement, ms: number) { el.style.setProperty('--rp-undo-ms', ms + 'ms'); el.classList.remove('rp-undo-run'); void el.offsetWidth; el.classList.add('rp-undo-run'); }
    function showToast(label: string, action: { label: string; run: () => void; icon?: string } | null, ms = UNDO_MS) {
      const el = root.querySelector<HTMLElement>('[data-rp-undo]'); if (!el) return;
      const lbl = el.querySelector<HTMLElement>('[data-rp-undo-label]'); if (lbl) lbl.textContent = label;
      const btn = el.querySelector<HTMLButtonElement>('[data-rp-undo-act]');
      if (btn) { btn.hidden = !action; if (action) { btn.textContent = action.label; btn.onclick = () => { action.run(); hideUndo(); }; } else btn.onclick = null; }
      el.classList.toggle('rp-undo-actionable', !!action);
      const ic = el.querySelector<HTMLElement>('[data-rp-undo-ic]');
      if (ic) ic.className = `iconify rp-undo-ic ${action ? (action.icon || 'lucide--rotate-ccw') : 'lucide--info'} size-4`;
      el.hidden = false; restartCountdown(el, ms);
      window.clearTimeout(undoTimer); undoTimer = window.setTimeout(hideUndo, ms);
    }
    function hideUndo() { const el = root.querySelector<HTMLElement>('[data-rp-undo]'); if (!el) return; window.clearTimeout(undoTimer); el.classList.remove('rp-undo-run'); el.hidden = true; }

    // ── The ONE shared stacking controller (catalog pattern-multi-panel-drawer) ─────
    const stack = createPanelStack<Panel>({
      root, panelsEl, railEl, countEl, shutterEl: root.querySelector<HTMLElement>('[data-rp-shutter]'),
      DEFW, MINW, TABLEGAP, MAXPANELS, MINEXP, COLLAPSE_AT, STRIP: 46,
      storageKey: 'rp-w', widthVar: '--rp-w',
      cls: { collapsed: 'rp-collapsed', focus: 'rp-focus', anchor: 'rp-anchor', flash: 'rp-flash', gripOn: 'rp-grip-on', dragging: 'rp-dragging', reordering: 'rp-reordering' },
      reorderSel: '[data-rp-reorder]', panelSel: '[data-rp-panel]', gripSel: '[data-rp-grip]',
      isMobile,
      buildPanel, loadInto,
      render: (p) => p.render(),
      panelKey: (p) => p.fieldView ? '' : topId(p),
      canOpen: (id) => recById.has(id),
      onMissing: () => { root.hidden = false; showToast("This record isn't in this backup.", null); },
      mobileOpen: (p, id) => { if (p) { p.stack.push(id); resetView(p); p.fieldView = null; p.render(); } else stack.open(id); },
      toast: showToast, hideToast: hideUndo,
      text: {
        closed: 'Panel closed',
        capReached: (m) => `Can't add another panel — maximum of ${m} reached.`,
        evicted: (m) => `Closed oldest panel — ${m} max`,
        noRoom: 'No room to expand — opened as a strip. Click it to open.',
        detached: 'Detached — this panel is yours now. The next record you open starts a fresh anchor beside the grid.',
      },
      flash: (el) => { el.classList.remove('rp-flash'); void el.offsetWidth; el.classList.add('rp-flash'); },
      onEmpty: () => closeAddPop(),
    });
    // Name-preserving wrappers so the existing event handlers below stay untouched.
    const openBeside = (source: Panel | null, id: string) => stack.openBeside(source, id);
    const closePanel = (p: Panel) => stack.closePanel(p);
    const detachPanel = (p: Panel) => stack.detachPanel(p);
    const parkPanel = (uid: number) => stack.parkPanel(uid);
    const expandPanel = (uid: number) => stack.expandPanel(uid);
    const setFocus = (p: Panel | null) => stack.setFocus(p);
    const layout = () => stack.layout();
    // Switching Data tabs abandons this record's context → close the whole stack (see DataView tab wiring).
    document.addEventListener('app:tabchange', () => stack.closeAll());

    function doBack(p: Panel) {
      if (p.fieldView) { p.fieldView = null; p.render(); return; }
      if (p.stack.length > 1) { p.stack.pop(); resetView(p); p.render(); return; }
    }

    // ── Events (container-delegated; resolve the owning panel from the target) ─────
    // Presentational: Browse/Docs/Chat only ever send `{ id }` / `{ id, focus }` — a plain open into
    // the anchor (reused if already showing that record). No second "opened from elsewhere" mechanism
    // (the Changelog drill now opens records in its OWN dcp- stack, see DataChangelog.astro).
    document.addEventListener('data:openRecord', (ev) => {
      const d = (ev as CustomEvent).detail;
      stack.open(d.id, (p) => { p.pendingFocus = d.focus ?? null; p.pendingComment = d.commentId ?? null; });
    });
    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape' || root.hidden) return;
      const p = stack.focused() || stack.panels()[stack.panels().length - 1];
      if (!p) return;
      if (p.fieldView) { p.fieldView = null; p.render(); return; }
      closePanel(p);
    });

    panelsEl.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      const panelEl = target.closest<HTMLElement>('[data-rp-panel]');
      const p = panelEl ? elToPanel.get(panelEl) : null;
      if (!p) return;
      // A parked strip: click anywhere but its ✕ expands it back (auto-accordion / collapse-rail).
      if (p.collapsed && !target.closest('[data-rp-closepanel]')) { expandPanel(p.uid); return; }
      if (stack.focused() !== p) setFocus(p);
      const copyId = target.closest<HTMLElement>('[data-rp-copyid]');
      if (copyId) {
        navigator.clipboard?.writeText(copyId.dataset.rpCopyid!);
        const ci = copyId.querySelector<HTMLElement>('.iconify');
        if (ci) { copyId.classList.add('rp-copied'); ci.className = 'iconify lucide--check size-3.5'; setTimeout(() => { copyId.classList.remove('rp-copied'); ci.className = 'iconify lucide--copy size-3.5'; }, 1100); }
        return;
      }
      const secTo = target.closest<HTMLElement>('[data-rp-secnav-to]');
      if (secTo) { p.body.querySelector<HTMLElement>('#' + secTo.dataset.rpSecnavTo)?.scrollIntoView({ block: 'start', behavior: 'smooth' }); return; }
      if (target.closest('[data-rp-closepanel]')) { closePanel(p); return; }
      if (target.closest('[data-rp-detach]')) { detachPanel(p); return; }
      if (target.closest('[data-rp-park]')) { parkPanel(p.uid); return; }
      if (target.closest('[data-rp-reorder]')) { return; } // handled by the pointerdown drag
      if (target.closest('[data-rp-back]')) { doBack(p); return; }
      // A field NAME opens its config INSIDE this panel (pushed onto its stack) — intercept so the
      // shared Schema EntityPanel's document handler does NOT open a second drawer behind us.
      const feOpen = target.closest<HTMLElement>('[data-entity-open]');
      if (feOpen) {
        e.preventDefault(); e.stopPropagation();
        const fieldId = feOpen.dataset.entityOpen!; const recId = topId(p);
        const me = e as MouseEvent;
        if (me.metaKey || me.ctrlKey) openFieldBeside(p, fieldId, recId); // ⌘/Ctrl-click → 2nd panel
        else { p.fieldView = { fieldId, recId }; p.fieldTableCols = []; p.vtQuery = ""; p.render(); } // plain click → in place
        return;
      }
      const ltab = target.closest<HTMLElement>('[data-rp-linktab]');
      if (ltab) { p.linkTab = ltab.dataset.rpLinktab!; p.render(); return; }
      // Open beside (explicit ⧉ button) → load the linked record into a 2nd panel.
      const ob = target.closest<HTMLElement>('[data-rp-openbeside]');
      if (ob) { e.stopPropagation(); openBeside(p, ob.dataset.rpOpenbeside!); return; }
      // Same ⧉, on a FIELD row: opens that field's config beside — the same branch ⌘/Ctrl-clicking
      // the field name already takes (see the feOpen handler above), just without needing the modifier.
      const fob = target.closest<HTMLElement>('[data-rp-fieldbeside]');
      if (fob) { e.stopPropagation(); openFieldBeside(p, fob.dataset.rpFieldbeside!, topId(p)); return; }
      // Expand provenance (scoped to this panel's field element).
      const exp = target.closest<HTMLElement>('[data-rp-expand]');
      if (exp) {
        const fieldEl = exp.closest<HTMLElement>('[data-rp-field]')!;
        const wrap = fieldEl.querySelector<HTMLElement>('[data-rp-provwrap]')!;
        const opening = wrap.hidden;
        exp.classList.toggle('rp-expand-on', opening);
        if (opening && !wrap.dataset.built) {
          const rec = recById.get(topId(p))!;
          const f = tableById.get(rec.tableId)!.fields.find((x) => x.id === fieldEl.dataset.rpField)!;
          const fam = family(f.type);
          wrap.innerHTML = fam === 'formula' ? provFormula(bodyCtx, rec, f) : fam === 'link' ? linkedList(rec, f, rec.cells[f.id]?.linkedCount || 0) : provLookup(bodyCtx, rec, f);
          wrap.dataset.built = '1';
          const lc = wrap.querySelector<HTMLElement>('[data-rp-linked]'); if (lc) paintLinked(bodyCtx, lc);
        }
        wrap.hidden = !opening;
        return;
      }
      // A "Referenced in" row (B5) → the Docs tab with that document open (SchemaDocs listens).
      const refDoc = target.closest<HTMLElement>('[data-rp-refdoc]');
      if (refDoc) { document.dispatchEvent(new CustomEvent('schema:openDoc', { detail: { id: refDoc.dataset.rpRefdoc } })); return; }
      // A linked / source record: plain click = drill IN-PLACE; ⌘/Ctrl-click = open BESIDE.
      const openRow = target.closest<HTMLElement>('[data-rp-open]');
      if (openRow && openRow.dataset.rpOpen) {
        if (e.metaKey || e.ctrlKey) { openBeside(p, openRow.dataset.rpOpen); }
        else { p.stack.push(openRow.dataset.rpOpen); resetView(p); p.render(); }
        return;
      }
      const more = target.closest<HTMLElement>('[data-rp-linkmore]');
      if (more) { const c = more.closest<HTMLElement>('[data-rp-linked]')!; c.dataset.loaded = String(Number(c.dataset.loaded) + PAGE); paintLinked(bodyCtx, c); return; }
      const viewas = target.closest<HTMLElement>('[data-rp-viewas]');
      if (viewas) { p.asOf = viewas.dataset.rpViewas!; p.render(); return; }
      const clear = target.closest<HTMLElement>('[data-rp-asof-clear]');
      if (clear) { p.asOf = null; p.render(); return; }
    });

    panelsEl.addEventListener('input', (e) => {
      const target = e.target as HTMLElement;
      const panelEl = target.closest<HTMLElement>('[data-rp-panel]');
      const p = panelEl ? elToPanel.get(panelEl) : null;
      if (!p) return;
      const fs = target.closest<HTMLInputElement>('[data-rp-fieldsearch]');
      if (fs) {
        p.fieldQuery = fs.value.trim().toLowerCase();
        p.body.querySelectorAll<HTMLElement>('[data-rp-fieldlist] .rp-field').forEach((row) => {
          row.style.display = !p.fieldQuery || (row.dataset.fname || '').includes(p.fieldQuery) ? '' : 'none';
        });
        return;
      }
      const s = target.closest<HTMLElement>('[data-rp-linksearch]');
      if (s) { const c = s.closest<HTMLElement>('[data-rp-linked]')!; paintLinked(bodyCtx, c); return; }
      // Value-table search — re-render only the table body so the input keeps focus.
      const vts = target.closest<HTMLInputElement>('[data-rp-vtsearch]');
      if (vts && p.fieldView) {
        p.vtQuery = vts.value;
        const rec = recById.get(p.fieldView.recId); const t = rec ? tableById.get(rec.tableId) : null;
        const f = t?.fields.find((x) => x.id === p.fieldView!.fieldId);
        const bodyEl = vts.closest('[data-rp-vtsec]')?.querySelector<HTMLElement>('[data-rp-vtbody]');
        if (t && f && bodyEl) bodyEl.innerHTML = vtBody(t, f, p);
      }
    });
    // Value-table "＋ Add column" picker (a <select> → change).
    panelsEl.addEventListener('change', (e) => {
      const sel = (e.target as HTMLElement).closest<HTMLSelectElement>('[data-rp-vt-add]');
      if (!sel || !sel.value) return;
      const panelEl = sel.closest<HTMLElement>('[data-rp-panel]');
      const p = panelEl ? elToPanel.get(panelEl) : null;
      if (!p) return;
      if (!p.fieldTableCols.includes(sel.value)) p.fieldTableCols.push(sel.value);
      p.render();
    });

    // ── ＋ add-record picker — search records (base→table→record) → open the pick BESIDE ──────────
    const scopeBaseId = () => { const f = stack.focused(); return f ? tableById.get(recById.get(topId(f))?.tableId || '')?.baseId : undefined; };
    function updateScopeBtn() { const b = scopeBaseId(); addScopeBtn.hidden = !b; addScopeBtn.textContent = addScope ? 'This base' : 'All bases'; }
    function renderAddList() {
      const q = addSearch.value.trim().toLowerCase();
      const openIds = new Set(stack.panels().map((p) => topId(p)));
      const matches = snap.records.filter((r) => {
        const t = tableById.get(r.tableId);
        if (addScope && t?.baseId !== addScope) return false;
        return !q || r.primary.toLowerCase().includes(q) || r.id.toLowerCase().includes(q);
      }).slice(0, 60);
      const byTable = new Map<string, Rec[]>();
      matches.forEach((r) => { const a = byTable.get(r.tableId) || []; a.push(r); byTable.set(r.tableId, a); });
      let html = '';
      byTable.forEach((recs, tid) => {
        const t = tableById.get(tid)!;
        html += `<div class="rp-addgroup">${esc(snap.baseName[t.baseId])} · ${esc(t.name)}</div>` +
          recs.map((r) => `<button type="button" class="rp-addrow${openIds.has(r.id) ? ' rp-addrow-open' : ''}" data-rp-addpick="${r.id}"><span class="rp-addname">${esc(r.primary)}</span><code class="rp-addid">${esc(r.id)}</code></button>`).join('');
      });
      addList.innerHTML = html || '<div class="rp-addempty">No records match.</div>';
    }
    function openAddPop() {
      // The ＋ button hangs on the leftmost panel's left edge; open the popover into the visible grid to
      // its LEFT (falling back to the right if there is no room). Fixed positioning off the button rect.
      addScope = scopeBaseId() || ''; updateScopeBtn();
      const r = railAdd.getBoundingClientRect();
      const W = 300;
      const left = r.left - W - 8 >= 12 ? r.left - W - 8 : Math.min(r.right + 8, window.innerWidth - W - 12);
      addPop.style.left = Math.max(12, left) + 'px';
      addPop.style.top = Math.max(12, Math.min(r.top, window.innerHeight - 420)) + 'px';
      addPop.hidden = false; addSearch.value = ''; renderAddList();
      setTimeout(() => addSearch.focus(), 0);
    }
    function closeAddPop() { addPop.hidden = true; }
    railEl.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('[data-rp-addbtn]')) { e.stopPropagation(); addPop.hidden ? openAddPop() : closeAddPop(); } });
    addScopeBtn.addEventListener('click', () => { addScope = addScope ? '' : (scopeBaseId() || ''); updateScopeBtn(); renderAddList(); });
    addSearch.addEventListener('input', renderAddList);
    addList.addEventListener('click', (e) => { const b = (e.target as HTMLElement).closest<HTMLElement>('[data-rp-addpick]'); if (!b) return; openBeside(stack.focused(), b.dataset.rpAddpick!); closeAddPop(); });
    document.addEventListener('click', (e) => { if (!addPop.hidden && !addPop.contains(e.target as Node) && !railEl.contains(e.target as Node)) closeAddPop(); });
    window.addEventListener('resize', () => { if (!root.hidden) layout(); });
  }
  wireRecordPanel();
  document.addEventListener('astro:after-swap', wireRecordPanel);
</script>

<style is:global>
  /* Global (.rp- prefix): the body is rendered via innerHTML, which scoped styles never reach. */
  .rp-wrap { position: fixed; inset: 0; z-index: 62; pointer-events: none; } /* non-modal: clicks pass to the grid */
  .rp-wrap[hidden] { display: none; }
  /* ＋ add-record rail: a ZERO-WIDTH first flex child of .rp-panels. Because the group is right-anchored,
     the rail's edge sits at the leftmost panel's left edge and its ＋ hangs LEFT into the gutter (this is
     the fix for the previously-invisible rail; mirrors Schema .ep-rail RAILW=0). */
  .rp-rail { position: relative; flex: none; align-self: stretch; width: 0; pointer-events: none; }
  .rp-rail > * { pointer-events: auto; }
  .rp-rail[hidden] { display: none; }
  /* Shutter: a pill on the stack's outer edge. Dragging it resizes ALL expanded panels together and
     parks/unparks them one at a time (ports Schema .ep-shutter 1:1). */
  .rp-shutter { position: absolute; left: -13px; top: 50%; transform: translateY(-50%); width: 16px; height: 56px; display: grid; place-items: center; padding: 0; border: 0; background: none; cursor: ew-resize; z-index: 3; touch-action: none; }
  .rp-shutter-pill { width: 4px; height: 40px; border-radius: 999px; background: oklch(from var(--color-base-content) l c h / .28); transition: background-color .12s ease, height .12s ease; }
  .rp-shutter:hover .rp-shutter-pill,
  .rp-shutter:focus-visible .rp-shutter-pill,
  .rp-shutter.rp-shutter-on .rp-shutter-pill { background: oklch(from var(--color-primary) l c h / .8); height: 56px; }
  .rp-rail-add { position: absolute; top: 12px; left: -16px; z-index: 4; box-shadow: 0 4px 12px oklch(0 0 0 / .28); }
  .rp-rail-count { position: absolute; top: 52px; left: -16px; width: 32px; text-align: center; font-size: 11px; font-weight: 600; color: oklch(from var(--color-base-content) l c h / .5); font-variant-numeric: tabular-nums; } /* ds-ok: panel-count micro-label */
  .rp-rail-count[hidden] { display: none; }
  .rp-addpop { position: fixed; z-index: 63; width: 300px; max-width: 88vw; max-height: 70vh; display: flex; flex-direction: column; gap: 8px; padding: 12px; background: var(--color-base-100); border: 1px solid var(--color-base-300); border-radius: 12px; box-shadow: 0 12px 40px oklch(0 0 0 / .22); pointer-events: auto; }
  .rp-addpop[hidden] { display: none; }
  .rp-addpop-head { display: flex; align-items: center; justify-content: space-between; gap: 8px; font-size: 12px; color: oklch(from var(--color-base-content) l c h / .55); }
  .rp-addscope { font-size: 11px; font-weight: 600; padding: 2px 8px; border: 1px solid var(--color-base-300); border-radius: 999px; background: var(--color-base-200); cursor: pointer; color: var(--color-base-content); } /* ds-ok: 11px/2px scope pill micro-control */
  .rp-addsearch { width: 100%; }
  .rp-addlist { overflow-y: auto; display: flex; flex-direction: column; min-height: 0; }
  .rp-addgroup { font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: .05em; color: oklch(from var(--color-base-content) l c h / .45); padding: 8px 4px 4px; } /* ds-ok: menu-title scale */
  .rp-addrow { display: flex; align-items: center; justify-content: space-between; gap: 8px; padding: 4px 8px; border: 0; background: none; border-radius: 6px; cursor: pointer; text-align: left; font: inherit; color: var(--color-base-content); }
  .rp-addrow:hover { background: oklch(from var(--color-base-content) l c h / .07); }
  .rp-addrow-open { opacity: .5; }
  .rp-addname { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 13px; }
  .rp-addid { font-family: var(--font-mono, ui-monospace, monospace); font-size: 11px; color: oklch(from var(--color-base-content) l c h / .45); flex: none; } /* ds-ok: id micro-label */
  .rp-addempty { font-size: 12px; color: oklch(from var(--color-base-content) l c h / .5); padding: 8px; }
  /* Coplanar multi-panel stack, right-anchored (array[0] = anchor = leftmost). New ordinary panels append
     to the right; the whole group grows leftward as it fills (mirrors Schema .ep-cols). */
  .rp-panels { position: absolute; top: 0; right: 0; bottom: 0; display: flex; flex-direction: row; justify-content: flex-end; max-width: 100vw; pointer-events: auto; }
  .rp-sheet { position: relative; flex: none; height: 100dvh; width: var(--rp-w, var(--drawer-w)); background: var(--color-base-100); border-left: 1px solid var(--color-base-300); box-shadow: -12px 0 40px oklch(0 0 0 / .18); display: flex; flex-direction: column; }
  .rp-sheet.rp-focus .rp-head { border-bottom-color: oklch(from var(--color-primary) l c h / .4); }
  .rp-flash { animation: rp-flash .6s ease; }
  @keyframes rp-flash { 0% { box-shadow: -12px 0 40px oklch(0 0 0 / .18), inset 3px 0 0 0 var(--color-primary); } 100% { box-shadow: -12px 0 40px oklch(0 0 0 / .18), inset 0 0 0 0 transparent; } }
  /* Resize handle (macOS-style edge line) — drag to resize the drawer; same idiom as .ep-grip. */
  .rp-grip { position: absolute; left: -4px; top: 0; bottom: 0; width: 8px; cursor: col-resize; z-index: 3; touch-action: none; }
  .rp-grip-line { position: absolute; left: 3px; top: 0; bottom: 0; width: 2px; background: transparent; transition: background-color .12s ease; pointer-events: none; }
  .rp-grip:hover .rp-grip-line, .rp-grip.rp-grip-on .rp-grip-line { background: oklch(from var(--color-primary) l c h / .7); }
  .rp-head { border-bottom: 1px solid var(--color-base-300); padding: 12px 16px; display: flex; flex-direction: column; gap: 8px; }
  .rp-head-row { display: flex; align-items: center; gap: 8px; min-height: 32px; }
  .rp-head-ic { display: grid; place-items: center; width: 2rem; height: 2rem; border-radius: .55rem; background: var(--color-base-200); color: oklch(from var(--color-base-content) l c h / .75); flex: none; }
  .rp-head-ic .iconify { font-size: 1rem; opacity: .8; }
  .rp-head-title { font-size: 15px; font-weight: 650; letter-spacing: -0.15px; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; flex: 1; }
  .rp-crumbrow { display: flex; align-items: center; gap: 12px; }
  .rp-crumbrow[hidden] { display: none; }
  .rp-viewat[hidden] { display: none; }
  .rp-crumbs { min-width: 0; overflow: hidden; flex: 0 1 auto; }
  .rp-crumbs .sb-crumb-cur { color: var(--color-base-content); font-weight: 550; }
  /* In-panel section jump-nav (mirror Schema .ep-secnav). */
  .rp-secnav { display: flex; align-items: center; gap: 4px; overflow-x: auto; }
  .rp-secnav[hidden] { display: none; }
  .rp-secnav-chip { flex: none; padding: 2px 8px; font-size: 12px; font-weight: 550; border: 0; background: none; border-radius: 6px; cursor: pointer; color: oklch(from var(--color-base-content) l c h / .55); white-space: nowrap; }
  .rp-secnav-chip:hover { background: var(--color-base-200); color: var(--color-base-content); }
  .rp-secnav-chip.is-active { background: color-mix(in oklch, var(--color-primary) 16%, transparent); color: var(--color-primary); font-weight: 650; }
  /* Record id + copy chip in the header. */
  .rp-idchip { display: inline-flex; align-items: center; gap: 8px; flex: none; margin-left: auto; }
  .rp-idchip[hidden] { display: none; }
  .rp-idlabel { font-size: 10px; font-weight: 700; letter-spacing: .05em; text-transform: uppercase; color: oklch(from var(--color-base-content) l c h / .45); } /* ds-ok: id label, menu-title scale */
  .rp-idval { font-family: var(--font-mono, ui-monospace, monospace); font-size: 12px; color: oklch(from var(--color-base-content) l c h / .7); overflow: hidden; text-overflow: ellipsis; }
  .rp-copyid { display: inline-grid; place-items: center; width: 20px; height: 20px; flex: none; border: 0; background: none; border-radius: 5px; cursor: pointer; color: oklch(from var(--color-base-content) l c h / .5); transition: color .4s ease, background-color .4s ease; }
  .rp-copyid:hover { background: oklch(from var(--color-base-content) l c h / .1); color: var(--color-base-content); }
  .rp-copied { color: var(--color-success); background: oklch(from var(--color-success) l c h / .16); transition: none; }
  .rp-copied .iconify { animation: rp-copypop .32s cubic-bezier(.34,1.56,.64,1); }
  @keyframes rp-copypop { 0% { transform: scale(.3); opacity: 0; } 60% { transform: scale(1.3); } 100% { transform: scale(1); opacity: 1; } }
  @media (max-width: 1023.98px) { .rp-sheet { --rp-w: 94vw; } .rp-grip, .rp-reorder, .rp-shutter { display: none; } }

  /* ── Multi-panel chrome (ports Schema EntityPanel panel-state styles) ─────────────────────────── */
  /* Reorder handle (pattern-panel-reorder): a ⠿ grip, quiet until header-hover; drag live-swaps order. */

  /* ── The "hold" slot — how this panel is held (pattern-multi-panel-drawer) ─────────────────
     One leading slot, one control: a movable panel shows its drag grip, the anchored one shows
     Detach, and they are already mutually exclusive (see the anchor rules above). Putting them in
     the SAME place means the answer to "can I move this?" is always found in the same spot, and it
     frees the slot Detach used to occupy among the unrelated right-hand actions (Oleh 2026-07-24).
     Hidden until the header is hovered or holds focus: a grip and a pin do not need to be lit at
     all times. See the collapse recipe below. */
  .rp-reorder,
  .rp-detach {
    /* At rest the slot takes NO width — the title and its icon start at the edge of the header
       (Oleh 2026-07-24). Squeezed to zero rather than `display: none`, so the control stays in the
       DOM and stays focusable; hiding it outright is how a hover-only affordance silently becomes
       keyboard-unreachable. On hover it opens and nudges the title right, which is the movement
       that says "this belongs to the panel, not to the content". */
    width: 0;
    min-width: 0;
    padding-inline: 0;
    border-width: 0;
    opacity: 0;
    overflow: hidden;
    pointer-events: none;
    transition: width .14s ease, opacity .12s ease;
  }
  /* Trigger is the WHOLE header, not just its top row (Oleh 2026-07-28) — opening this slot
     widens it and pushes Back sideways, out from under the cursor reaching for it. Arming on the
     header lets that shift happen while the pointer is still travelling. Same fix in EntityPanel. */
  .rp-head:hover .rp-reorder,
  .rp-head:hover .rp-detach,
  .rp-head:focus-within .rp-reorder,
  .rp-head:focus-within .rp-detach {
    width: 24px;
    min-width: 24px;
    opacity: 1;
    pointer-events: auto;
  }
  /* Visibility is owned by the hold-slot rule above; this only carries shape + the grab affordance. */
  /* No `width` here on purpose: the hold-slot rule above owns it (0 at rest, 24px on hover). A
     width in THIS rule sits later in the file at equal specificity and silently won, so the
     collapse was a no-op on this surface while EntityPanel — whose shape rule carries no
     width — worked. */
  .rp-reorder { display: inline-grid; place-items: center; height: 32px; flex: none; border: 0; background: none; border-radius: 6px; cursor: grab; color: var(--color-base-content); }
  .rp-reorder:hover { background: oklch(from var(--color-base-content) l c h / .08); }
  .rp-reorder.rp-grip-on { cursor: grabbing; }
  .rp-detach { flex: none; }
  /* The dragged sheet stays OPAQUE (the drawer is non-modal over the grid): dashed accent + shadow. */
  .rp-sheet.rp-dragging { outline: 2px dashed var(--color-primary); outline-offset: -2px; z-index: 5; box-shadow: -12px 0 40px oklch(0 0 0 / .35); }
  /* The ANCHOR slot — docked to the grid; every plain open lands in THIS panel. Encoded by POSITION, not
     a badge: the header is HATCHED ("this bar does not move") with an accent line along the top. Detach
     frees the slot. A non-anchor panel shows its drag grip; the anchor hides it and shows Detach. */
  .rp-sheet:not(.rp-anchor) .rp-detach,
  .rp-sheet.rp-anchor .rp-reorder,
  .rp-sheet.rp-collapsed .rp-detach,
  .rp-sheet.rp-collapsed .rp-park,
  .rp-sheet.rp-collapsed .rp-lock { display: none !important; }
  .rp-sheet.rp-anchor .rp-head {
    background-color: oklch(from var(--color-base-200) l c h / .5);
    background-image: repeating-linear-gradient(-45deg, transparent 0 5px, oklch(from var(--color-base-content) l c h / .045) 5px 6px);
    box-shadow: inset 0 2px 0 var(--color-primary);
  }
  /* Anchor lock scrim — the anchor withdraws during a reorder drag (not a drop target, never moves). An
     OPAQUE inner scrim, never `opacity` on the sheet (which would let the grid bleed through). */
  .rp-lock { display: none; }
  .rp-panels.rp-reordering .rp-sheet.rp-anchor .rp-lock {
    display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8px;
    position: absolute; inset: 0; z-index: 6; cursor: not-allowed; text-align: center; padding: 16px;
    font-size: 13px; background: oklch(from var(--color-base-100) l c h / .88); color: oklch(from var(--color-base-content) l c h / .6);
    animation: rp-scrim-in .12s ease;
  }
  @keyframes rp-scrim-in { from { opacity: 0; } to { opacity: 1; } }
  /* Collapse-to-rail (pattern-panel-collapse-rail): a parked panel is a ~46px vertical strip — ✕ (top) ·
     icon tile · rotated name. Click the strip to expand; the ✕ closes. Also the auto-accordion overflow. */
  .rp-sheet.rp-collapsed { width: 46px !important; min-width: 46px; cursor: pointer; }
  .rp-sheet.rp-collapsed .rp-body,
  .rp-sheet.rp-collapsed .rp-crumbrow,
  .rp-sheet.rp-collapsed .rp-viewat,
  .rp-sheet.rp-collapsed .rp-secnav,
  .rp-sheet.rp-collapsed .rp-grip,
  .rp-sheet.rp-collapsed .rp-reorder,
  .rp-sheet.rp-collapsed .rp-back { display: none !important; }
  .rp-sheet.rp-collapsed .rp-head { padding: 8px 0; height: 100%; border-bottom: 0; }
  .rp-sheet.rp-collapsed .rp-head-row { flex-direction: column; align-items: center; gap: 12px; height: 100%; min-height: 0; }
  .rp-sheet.rp-collapsed .rp-x { order: -1; }
  .rp-sheet.rp-collapsed .rp-head-title { display: block; flex: 0 1 auto; writing-mode: vertical-rl; transform: rotate(180deg); overflow: hidden; max-height: 100%; text-overflow: ellipsis; white-space: nowrap; }

  /* Undo / info toast (pattern-undo-toast): one surface — an Undo offer (draining bar) or a bare fact. */
  .rp-undo { position: absolute; left: 50%; bottom: 24px; transform: translateX(-50%); z-index: 70; pointer-events: auto; display: flex; align-items: center; gap: 8px; max-width: min(92vw, 30rem); padding: 10px 14px; overflow: hidden; background: var(--color-neutral); color: var(--color-neutral-content); border-radius: 10px; box-shadow: 0 8px 24px oklch(0 0 0 / .28); font-size: 13px; } /* ds-ok: translateX(-50%) centering, not spacing */
  .rp-undo[hidden] { display: none; }
  .rp-undo-label { min-width: 0; overflow: hidden; text-overflow: ellipsis; }
  .rp-undo-act { flex: none; margin-left: 4px; font-weight: 600; color: var(--color-primary); background: none; border: 0; cursor: pointer; padding: 2px 8px; border-radius: 6px; }
  .rp-undo-act[hidden] { display: none; }
  .rp-undo-act:hover { background: oklch(from var(--color-primary) l c h / .18); }
  .rp-undo-bar { position: absolute; left: 0; right: 0; bottom: 0; height: 2px; background: var(--color-primary); transform-origin: left center; transform: scaleX(0); }
  .rp-undo:not(.rp-undo-actionable) .rp-undo-bar { display: none; }
  .rp-undo.rp-undo-run.rp-undo-actionable .rp-undo-bar { animation: rp-undo-count var(--rp-undo-ms, 4000ms) linear forwards; }
  @keyframes rp-undo-count { from { transform: scaleX(1); } to { transform: scaleX(0); } }
  @media (prefers-reduced-motion: reduce) { .rp-undo.rp-undo-run .rp-undo-bar { animation: none; transform: scaleX(1); } }

  /* Field-config sub-view (pushed into the drawer's own stack). */
  .rp-fc { display: flex; flex-direction: column; border: 1px solid var(--color-base-300); border-radius: 10px; overflow: hidden; }
  .rp-fc-row { display: flex; align-items: flex-start; gap: 12px; padding: 8px 12px; border-bottom: 1px solid var(--color-base-200); }
  .rp-fc-row:last-child { border-bottom: 0; }
  .rp-fc-key { flex: none; width: 140px; font-size: 12px; color: oklch(from var(--color-base-content) l c h / .55); padding-top: 2px; }
  .rp-fc-val { flex: 1; min-width: 0; font-size: 13px; display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
  .rp-fc-val .rp-fic { display: inline-flex; opacity: .8; }
  .rp-fc-mono { font-family: var(--font-mono, ui-monospace, monospace); font-size: 12px; background: var(--color-base-200); padding: 2px 8px; border-radius: 6px; }
  .rp-fc-note { font-size: 12px; color: oklch(from var(--color-base-content) l c h / .55); margin-top: 8px; }
  /* Field "Show as table" segment + value-table. */
  .rp-fc-seg { display: inline-flex; gap: 2px; padding: 2px; background: var(--color-base-200); border-radius: 8px; align-self: flex-start; }
  .rp-fc-segbtn { padding: 4px 12px; font-size: 12px; font-weight: 550; border: 0; background: none; border-radius: 6px; cursor: pointer; color: oklch(from var(--color-base-content) l c h / .6); }
  .rp-fc-segon { background: var(--color-base-100); color: var(--color-base-content); box-shadow: 0 1px 2px oklch(0 0 0 / .08); }
  .rp-vt-wrap { border: 1px solid var(--color-base-300); border-radius: 10px; overflow: auto; max-height: 52vh; }
  .rp-vt { width: 100%; border-collapse: collapse; font-size: 13px; }
  .rp-vt thead th { position: sticky; top: 0; z-index: 1; background: var(--color-base-200); text-align: left; padding: 4px 12px; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: .04em; color: oklch(from var(--color-base-content) l c h / .6); white-space: nowrap; } /* ds-ok: data-table header micro-label, 11px like the Browse grid */
  .rp-vt thead th .rp-fic { margin-right: 4px; opacity: .7; }
  .rp-vt td { padding: 4px 12px; border-top: 1px solid var(--color-base-200); white-space: nowrap; }
  .rp-vt tbody tr { cursor: pointer; }
  .rp-vt tbody tr:hover { background: oklch(from var(--color-base-200) l c h / .5); }
  .rp-vt-primary { font-weight: 600; }
  .rp-vt-foot { display: flex; align-items: center; gap: 8px; margin-top: 8px; }
  .rp-vt-note { font-size: 12px; color: oklch(from var(--color-base-content) l c h / .5); }
  .rp-fc-link { color: var(--color-primary); }

  /* Stacked sections (Fields → Linked records → History) that scroll as one. */
  .rp-body { flex: 1; overflow-y: auto; min-height: 0; padding: 16px; display: flex; flex-direction: column; gap: 20px; }
  .rp-sec { display: flex; flex-direction: column; gap: 8px; }
  .rp-seclabel { display: flex; align-items: center; gap: 6px; font-size: 11px; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; color: oklch(from var(--color-base-content) l c h / .5); } /* ds-ok: 6px optical icon↔label gap */
  .rp-sec-ic { opacity: .7; }
  .rp-sec-count { font-size: 11px; font-weight: 600; color: oklch(from var(--color-base-content) l c h / .4); font-variant-numeric: tabular-nums; }

  /* Comments (comments-explorer). A conversation, not a feed: oldest first, full text, replies
     indented under their parent. The stream on the Data tab stays one dense line per comment and
     links in here — the two are deliberately different shapes for the same data. */
  .rp-cmlist { display: flex; flex-direction: column; gap: 12px; }
  .rp-cm { display: flex; gap: 8px; padding: 4px 0; border-radius: 6px; }
  /* A reply is indented by exactly the chip + gap, so its text lines up under the parent's text. */
  .rp-cm-reply { margin-left: 32px; }
  .rp-cm-ini {
    flex: none; display: inline-flex; align-items: center; justify-content: center;
    width: 24px; height: 24px; border-radius: 9999px; margin-top: 1px;
    background: oklch(from var(--color-base-content) l c h / .1);
    color: oklch(from var(--color-base-content) l c h / .7);
    font-size: 12px; font-weight: 650;
  }
  /* No name, no chip — but the SLOT stays, because in a threaded conversation the text of every
     comment lines up on one left edge and a reply is indented by exactly the chip's width. Losing
     the box would ragged the whole thread rather than just that one comment. */
  .rp-cm-noini { flex: none; width: 24px; height: 24px; }
  .rp-cm-main { min-width: 0; display: flex; flex-direction: column; gap: 4px; }
  .rp-cm-head { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
  .rp-cm-author { font-size: 13px; font-weight: 650; color: var(--color-base-content); }
  .rp-cm-at { font-size: 12px; color: oklch(from var(--color-base-content) l c h / .45); }
  .rp-cm-edited { font-size: 12px; font-style: italic; color: oklch(from var(--color-base-content) l c h / .45); }
  .rp-cm-text { font-size: 13px; line-height: 1.5; color: oklch(from var(--color-base-content) l c h / .85); white-space: pre-wrap; overflow-wrap: anywhere; }
  .rp-cm-att { display: flex; align-items: center; gap: 4px; font-size: 12px; color: oklch(from var(--color-base-content) l c h / .5); }
  /* Deep-link cue. Transient on purpose: nothing in this list is selectable, so a mark that stayed
     would read as state the user has to dismiss. */
  .rp-cm-hit { background: color-mix(in oklch, var(--color-primary) 14%, transparent); box-shadow: 0 0 0 4px color-mix(in oklch, var(--color-primary) 14%, transparent); transition: background .4s ease, box-shadow .4s ease; }
  @media (prefers-reduced-motion: reduce) { .rp-cm-hit { transition: none; } }
  .rp-fieldsearch { width: 100%; }
  .rp-list { border: 1px solid var(--color-base-300); border-radius: 11px; overflow: hidden; background: oklch(from var(--color-base-200) l c h / .45); }
  /* Clickable field name → its config; reads as a quiet link, not a button. */
  .rp-fname-btn { border: 0; background: none; cursor: pointer; text-align: left; padding: 0; font: inherit; }
  .rp-fname-btn:hover { color: var(--color-primary); text-decoration: underline; }

  /* Linked records — tabs (one per link field) + the active list. */
  .rp-linktabs { display: flex; align-items: stretch; gap: 2px; border-bottom: 1px solid var(--color-base-300); overflow-x: auto; }
  .rp-linktab { display: inline-flex; align-items: center; gap: 8px; padding: 8px 12px; font-size: 12px; font-weight: 550; border: 0; border-bottom: 2px solid transparent; background: none; cursor: pointer; color: oklch(from var(--color-base-content) l c h / .6); white-space: nowrap; }
  .rp-linktab:hover { color: var(--color-base-content); }
  .rp-linktab-on { color: var(--color-primary); border-bottom-color: var(--color-primary); }
  .rp-linktab-n { font-size: 11px; font-variant-numeric: tabular-nums; opacity: .7; }

  .rp-field { border-top: 1px solid var(--color-base-200); }
  .rp-field:first-child { border-top: 0; }
  .rp-fieldrow { display: flex; align-items: center; gap: 8px; padding: 12px; }
  .rp-fic { display: inline-grid; place-items: center; width: 16px; flex: none; opacity: .65; }
  .rp-fic svg { width: 13px; height: 13px; }
  .rp-fname { font-size: 12px; color: oklch(from var(--color-base-content) l c h / .6); width: 40%; flex: none; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .rp-fval { flex: 1; font-size: 13px; min-width: 0; overflow: hidden; text-overflow: ellipsis; }
  .rp-num { font-family: var(--font-mono, ui-monospace); font-variant-numeric: tabular-nums; }
  /* Single-select value chip — readable full-contrast text on a subtle tint (matches the grid). */
  .rp-selval { display: inline-flex; align-items: center; padding: 2px 8px; border-radius: 6px; font-size: 12px; background: color-mix(in oklch, var(--color-base-content) 10%, transparent); color: var(--color-base-content); }
  .rp-empty { color: oklch(from var(--color-base-content) l c h / .35); }
  .rp-expand { display: grid; place-items: center; width: 24px; height: 24px; border: 0; background: none; border-radius: 6px; cursor: pointer; color: oklch(from var(--color-base-content) l c h / .5); flex: none; }
  .rp-expand:hover { background: oklch(from var(--color-base-content) l c h / .08); }
  .rp-expand .iconify { transition: transform .15s ease; }
  .rp-expand-on .iconify { transform: rotate(90deg); }
  /* ⧉ field-row open-beside (canon control, same treatment as .rp-openbeside / .ep-beside /
     .dcp-openbeside). Unlike EntityPanel's row it does NOT need absolute positioning + a swap with
     inert meta: `.rp-fval` already truncates and yields its own width, so this is a plain flex
     sibling placed before the (optional) provenance-expand chevron — both stay reachable on hover,
     the row height never changes, and opacity/pointer-events (never display:none) keep it in the
     tab order for keyboard reach. */
  .rp-fieldbeside { opacity: 0; pointer-events: none; transition: opacity .1s; flex: none; }
  .rp-fieldrow:hover .rp-fieldbeside, .rp-fieldbeside:focus-visible { opacity: 1; pointer-events: auto; }
  .rp-fieldbeside:hover { color: var(--color-primary); background: var(--color-base-200); }

  /* Provenance panels — one visual family (label header + row list). */
  .rp-provwrap { padding: 0 12px 12px 36px; }
  .rp-prov { border: 1px solid var(--color-base-300); border-radius: 10px; overflow: hidden; background: var(--color-base-100); }
  .rp-provhead { display: flex; align-items: center; gap: 8px; padding: 8px 12px; border-bottom: 1px solid var(--color-base-200); font-size: 12px; background: oklch(from var(--color-base-200) l c h / .4); }
  .rp-provexpr { font-family: var(--font-mono, ui-monospace); font-size: 12px; }
  .rp-provname { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .rp-provcount, .rp-provval { font-size: 12px; color: oklch(from var(--color-base-content) l c h / .65); font-family: var(--font-mono, ui-monospace); }
  .rp-provvia { color: oklch(from var(--color-base-content) l c h / .6); display: flex; flex-wrap: wrap; gap: 8px; }
  .rp-provagg { margin-left: auto; font-size: 11px; }
  .rp-provrow { display: flex; align-items: center; gap: 8px; padding: 8px 12px; border-top: 1px solid var(--color-base-200); font-size: 13px; }
  .rp-provrow:first-child { border-top: 0; }
  /* "Referenced in" rows (B5) — provrow language + a doc icon and a quiet kind tag. */
  .rp-ref-ic { opacity: .6; flex: none; }
  .rp-refkind { flex: none; font-size: 12px; font-weight: 600; letter-spacing: .03em; text-transform: uppercase; color: oklch(from var(--color-base-content) l c h / .45); }
  .rp-provlink { cursor: pointer; }
  .rp-provlink:hover { background: var(--color-base-200); }
  .rp-provrow .rp-provname { flex: 1; }
  /* Open-beside ⧉ — hover-revealed on a linked row; opens that record in a 2nd panel. */
  /* ⧉ open-beside — the canon treatment (matches .ep-beside / .dcp-openbeside): daisyUI btn sizing,
     revealed on row hover AND on keyboard focus. Reveal via OPACITY, not display: `display: none`
     removed the button from the tab order entirely, so it was unreachable by keyboard, and the row
     reflowed on hover. pointer-events is off at rest so the invisible button can never swallow a
     click meant for the row itself (the row is what drills in place). */
  .rp-openbeside { opacity: 0; pointer-events: none; transition: opacity .1s; flex: none; }
