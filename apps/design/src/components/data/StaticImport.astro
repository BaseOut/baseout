---
/**
 * StaticImport — the Browse experience for a STATIC-only Space (client 2026-07-15: keep it
 * simple for v1). No queryable store exists, so browsing means importing one table's CSV into
 * a temporary review copy: pick a Base + Table → Import → a loading state → a single read-only
 * table view of what was imported, under a persistent "temporary copy" banner. The imported
 * data is a temporary cache only, not stored long-term. Rows still open the record panel
 * (Fields + formula-input provenance work — the schema is in the static backup).
 */
import { AIRTABLE_FIELD_ICONS, airtableIconKey } from '../schema/airtableFieldIcons';
import type { DataBase, DataTable, DataRecord } from './dataTypes';

interface Props {
  bases: DataBase[];
  tables: DataTable[];
  records: DataRecord[];
}
const { bases, tables, records } = Astro.props;
const snapshot = {
  baseName: Object.fromEntries(bases.map((b) => [b.id, b.name])),
  tables: tables.map((t) => ({ id: t.id, baseId: t.baseId, name: t.name, fields: t.fields })),
  records: records.map((r) => ({ id: r.id, tableId: r.tableId, primary: r.primary, cells: r.cells })),
};
const icons = Object.fromEntries(
  tables.flatMap((t) => t.fields).map((f) => {
    const k = airtableIconKey(f.type);
    return [f.type, k ? `<svg viewBox="0 0 16 16" width="13" height="13" aria-hidden="true">${AIRTABLE_FIELD_ICONS[k]}</svg>` : ''];
  }),
);
---

<section class="si" data-staticimport>
  {/* Step 1 — the import picker (explainer + Base ▸ Table ▸ Import). */}
  <div class="si-pick" data-si-pick>
    <span class="si-pick-ic"><span class="iconify lucide--file-down size-5" aria-hidden="true"></span></span>
    <p class="si-pick-title">Your backups are files, not a database</p>
    <p class="si-pick-sub">To browse a static backup here, pick a base and table and import it into a temporary review copy. The imported data is held only for this session — it is not stored long-term.</p>
    <div class="si-pick-row">
      <label class="si-pick-lbl">Base
        <select class="select select-sm" data-si-base>
          {bases.map((b) => <option value={b.id}>{b.name}</option>)}
        </select>
      </label>
      <label class="si-pick-lbl">Table
        <select class="select select-sm" data-si-table></select>
      </label>
      <button type="button" class="btn btn-primary btn-sm" data-si-import>
        <span class="iconify lucide--download size-4" aria-hidden="true"></span>Import
      </button>
    </div>
  </div>

  {/* Step 2 — loading. */}
  <div class="si-loading" data-si-loading hidden>
    <span class="loading loading-spinner loading-md" aria-hidden="true"></span>
    <p data-si-loading-label>Importing…</p>
  </div>

  {/* Step 3 — the single read-only imported table. */}
  <div class="si-result" data-si-result hidden>
    <div class="si-banner" role="status">
      <span class="iconify lucide--clock size-4" aria-hidden="true"></span>
      <span data-si-banner-text>Viewing an imported review copy — temporary, not stored.</span>
      <button type="button" class="btn btn-sm btn-ghost si-reimport" data-si-reimport>
        <span class="iconify lucide--rotate-ccw size-3.5" aria-hidden="true"></span>Import a different table
      </button>
    </div>
    <div class="si-head"><span class="si-count" data-si-count></span></div>
    <div class="si-wrap">
      <table class="table table-sm text-sm si-table">
        <thead data-si-thead></thead>
        <tbody data-si-tbody></tbody>
      </table>
    </div>
  </div>
</section>

<script type="application/json" data-si-snapshot set:html={JSON.stringify(snapshot)} />
<script type="application/json" data-si-icons set:html={JSON.stringify(icons)} />

<script>
  type Cell = { raw: string; linkedCount?: number; empty?: boolean };
  type Field = { id: string; name: string; type: string };
  type Table = { id: string; baseId: string; name: string; fields: Field[] };
  type Rec = { id: string; tableId: string; primary: string; cells: Record<string, Cell> };
  type Snap = { baseName: Record<string, string>; tables: Table[]; records: Rec[] };

  const family = (t: string) => {
    if (['number', 'currency', 'percent', 'rating', 'duration', 'rollup', 'count'].includes(t)) return 'number';
    if (t === 'multipleRecordLinks' || t === 'multipleLookupValues') return 'link';
    if (t === 'singleSelect' || t === 'multipleSelects') return 'select';
    return 'text';
  };
  const esc = (s: string) => (s || '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]!));

  function wireStaticImport() {
    const root = document.querySelector<HTMLElement>('[data-staticimport]');
    if (!root || root.dataset.siWired) return;
    root.dataset.siWired = '1';
    const snap: Snap = JSON.parse(document.querySelector('[data-si-snapshot]')?.textContent || '{}');
    const icons: Record<string, string> = JSON.parse(document.querySelector('[data-si-icons]')?.textContent || '{}');
    if (!snap.tables?.length) return;
    const tableById = new Map(snap.tables.map((t) => [t.id, t]));

    const pick = root.querySelector<HTMLElement>('[data-si-pick]')!;
    const loading = root.querySelector<HTMLElement>('[data-si-loading]')!;
    const result = root.querySelector<HTMLElement>('[data-si-result]')!;
    const baseSel = root.querySelector<HTMLSelectElement>('[data-si-base]')!;
    const tableSel = root.querySelector<HTMLSelectElement>('[data-si-table]')!;

    const fillTables = () => {
      const bid = baseSel.value;
      tableSel.innerHTML = snap.tables.filter((t) => t.baseId === bid).map((t) => `<option value="${t.id}">${esc(t.name)}</option>`).join('');
    };
    baseSel.addEventListener('change', fillTables);
    fillTables();

    const renderTable = (tid: string) => {
      const t = tableById.get(tid)!;
      const recs = snap.records.filter((r) => r.tableId === tid);
      const thead = root.querySelector<HTMLElement>('[data-si-thead]')!;
      const tbody = root.querySelector<HTMLElement>('[data-si-tbody]')!;
      thead.innerHTML = `<tr>${t.fields.map((f) => `<th>${icons[f.type] ? `<span class="si-th-ic">${icons[f.type]}</span>` : ''}${esc(f.name)}</th>`).join('')}</tr>`;
      tbody.innerHTML = recs.map((r) => `<tr data-dg-open="${r.id}">${t.fields.map((f, i) => {
        const c = r.cells[f.id]; const raw = c?.raw ?? ''; const fam = family(f.type);
        let inner = esc(raw);
        if (!raw || c?.empty) inner = '<span class="si-empty">—</span>';
        else if (fam === 'link') inner = `<span class="si-linkpill"><span class="iconify lucide--link size-3" aria-hidden="true"></span>${esc(raw)}</span>`;
        else if (fam === 'number') inner = `<span class="si-num">${esc(raw)}</span>`;
        else if (fam === 'select') inner = `<span class="si-selval">${esc(raw)}</span>`;
        return `<td class="${i === 0 ? 'si-primary' : ''}">${inner}</td>`;
      }).join('')}</tr>`).join('');
      root.querySelector<HTMLElement>('[data-si-count]')!.textContent = `${recs.length.toLocaleString()} records imported`;
      root.querySelector<HTMLElement>('[data-si-banner-text]')!.textContent = `Viewing an imported review copy of ${snap.baseName[t.baseId]} · ${t.name} — temporary, not stored.`;
    };

    root.querySelector<HTMLElement>('[data-si-import]')!.addEventListener('click', () => {
      const tid = tableSel.value; const t = tableById.get(tid); if (!t) return;
      pick.hidden = true; result.hidden = true; loading.hidden = false;
      root.querySelector<HTMLElement>('[data-si-loading-label]')!.textContent = `Importing ${t.name}…`;
      // Fake ingest latency, then reveal the single-table view.
      setTimeout(() => { loading.hidden = true; renderTable(tid); result.hidden = false; }, 800);
    });
    root.querySelector<HTMLElement>('[data-si-reimport]')!.addEventListener('click', () => {
      result.hidden = true; pick.hidden = false;
    });
    // Row → record panel (Fields + provenance; History is locked in static mode).
    root.querySelector<HTMLElement>('[data-si-tbody]')!.addEventListener('click', (e) => {
      const tr = (e.target as HTMLElement).closest<HTMLElement>('[data-dg-open]');
      if (tr) document.dispatchEvent(new CustomEvent('data:openRecord', { detail: { id: tr.dataset.dgOpen } }));
    });
  }
  wireStaticImport();
  document.addEventListener('astro:after-swap', wireStaticImport);
</script>

<style is:global>
  /* Rows are injected via innerHTML → global (.si- prefix) so styles reach them. */
  .si-pick, .si-loading { display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; gap: 8px; min-height: 340px; padding: 48px 24px; border: 1px dashed var(--color-base-300); border-radius: 14px; background: oklch(from var(--color-base-200) l c h / .3); }
  .si-pick-ic { display: grid; place-items: center; width: 3rem; height: 3rem; border-radius: .8rem; background: var(--color-base-200); }
  .si-pick-ic .iconify { opacity: .6; }
  .si-pick-title { font-size: 16px; font-weight: 650; }
  .si-pick-sub { font-size: 14px; color: oklch(from var(--color-base-content) l c h / .6); max-width: 56ch; }
  .si-pick-row { display: flex; align-items: flex-end; gap: 12px; flex-wrap: wrap; justify-content: center; margin-top: 8px; }
  .si-pick-lbl { display: flex; flex-direction: column; gap: 4px; font-size: 12px; color: oklch(from var(--color-base-content) l c h / .6); text-align: left; }
  .si-loading { color: oklch(from var(--color-base-content) l c h / .6); font-size: 14px; }

  .si-banner { display: flex; align-items: center; gap: 8px; padding: 8px 12px; margin-bottom: 12px; border-radius: 8px; font-size: 13px; background: color-mix(in oklch, var(--color-warning) 12%, transparent); color: oklch(from var(--color-base-content) l c h / .82); }
  .si-banner .si-reimport { margin-left: auto; }
  .si-head { margin-bottom: 8px; }
  .si-count { font-size: 13px; font-family: var(--font-mono, ui-monospace); color: oklch(from var(--color-base-content) l c h / .6); }
  .si-wrap { border: 1px solid var(--color-base-300); border-radius: 11px; overflow: auto; background: var(--color-base-100); max-height: clamp(420px, calc(100dvh - 360px), 860px); }
  .si-table { margin: 0; }
  .si-table thead th { position: sticky; top: 0; z-index: 2; background: var(--color-base-200); font-size: 11px; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; color: oklch(from var(--color-base-content) l c h / .6); white-space: nowrap; }
  .si-th-ic { display: inline-grid; place-items: center; width: 14px; vertical-align: -2px; margin-right: 4px; opacity: .7; }
  .si-th-ic svg { width: 13px; height: 13px; }
  .si-table tbody tr { cursor: pointer; }
  .si-table tbody tr:hover { background: var(--color-base-200); }
  .si-table tbody td { white-space: nowrap; max-width: 320px; overflow: hidden; text-overflow: ellipsis; }
  .si-primary { font-weight: 600; }
  .si-num { font-family: var(--font-mono, ui-monospace); font-variant-numeric: tabular-nums; }
  .si-selval { display: inline-flex; align-items: center; padding: 2px 8px; border-radius: 6px; font-size: 12px; background: color-mix(in oklch, var(--color-base-content) 10%, transparent); color: var(--color-base-content); }
  .si-linkpill { display: inline-flex; align-items: center; gap: 4px; font-size: 12px; padding: 1px 8px; border-radius: 999px; border: 1px solid var(--color-base-300); background: oklch(from var(--color-primary) l c h / .07); color: oklch(from var(--color-base-content) l c h / .8); }
  .si-empty { color: oklch(from var(--color-base-content) l c h / .35); }
</style>
