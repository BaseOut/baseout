      } else {
        const bases = pIndex
          .filter((x) => x.kind === 'base' && !open.has(x.id))
          .sort((a, b) => Number(b.name === base?.name) - Number(a.name === base?.name))
          .map((x) => row(x, 'whole base', 'lucide--database'));
        if (bases.length) groups.push({ label: 'Bases', items: bases });
      }
