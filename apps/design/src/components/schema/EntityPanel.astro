    document.addEventListener('auxclick', (ev) => {
      const me = ev as MouseEvent; if (me.button !== 1) return;
      const o = (ev.target as HTMLElement).closest('[data-entity-open]');
      if (o) { ev.preventDefault(); openBeside(o.getAttribute('data-entity-open')!); }
