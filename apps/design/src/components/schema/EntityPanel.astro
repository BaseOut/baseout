    addScopeBtn.addEventListener('click', () => { setScope(addScope ? '' : (pickerCtx().base?.name || '')); const f = addField(); if (f) f.focus(); });
    addSugg.addEventListener('click', (ev) => { const b = (ev.target as HTMLElement).closest<HTMLElement>('[data-ep-sugg-id]'); if (b) { openBeside(b.dataset.epSuggId!); closeAddPop(); } });
    // Enter on an empty search opens the Suggested default (current table · all fields).
    addSearch.addEventListener('keydown', (ev) => { const f = addField(); if ((ev as KeyboardEvent).key === 'Enter' && f && !f.value.trim()) { const d = addSugg.querySelector<HTMLElement>('[data-ep-sugg-default]'); if (d) { ev.preventDefault(); openBeside(d.dataset.epSuggId!); closeAddPop(); } } });
    document.addEventListener('schema:pickAdd', (ev) => { const id = (ev as CustomEvent).detail?.id; if (id) { openBeside(id); closeAddPop(); } });
    document.addEventListener('click', (ev) => { if (!addPop.hidden && !addPop.contains(ev.target as Node) && !(ev.target as HTMLElement).closest('[data-ep-add]')) closeAddPop(); });
    document.addEventListener('keydown', (ev) => { if ((ev as KeyboardEvent).key === 'Escape' && !addPop.hidden) closeAddPop(); });

  }
  wireEntityPanel();
  document.addEventListener('astro:after-swap', wireEntityPanel);
</script>
