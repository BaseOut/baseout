      addSugg.innerHTML = groups
        .map((g) => `<div class="ep-sugg-lbl">${escv(g.label)}</div>` + g.items
          .map((it) => `<button type="button" class="ep-sugg-row" data-ep-sugg-id="${it.e.id}"${n++ === 0 ? ' data-ep-sugg-default' : ''}><span class="iconify ${it.ic} size-4" aria-hidden="true"></span><span>${escv(it.e.name)}</span><span class="ep-sugg-meta">${it.meta}</span></button>`)
          .join(''))
        .join('');
    }
    function setScope(base: string) {
      addScope = base; addSearch.dataset.esScopeBase = base;
      addScopeLbl.textContent = base || 'All bases';
      const f = addField(); if (f) f.placeholder = base ? `Search ${base}…` : 'Search all bases…';
      // The typeahead filters by dataset at query time, so a live result list has to be re-queried —
      // without this the scope pill looks inert (it was).
