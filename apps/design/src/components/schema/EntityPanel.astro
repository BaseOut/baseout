    window.addEventListener('resize', () => { if (!wrap.hidden) stack.layout(); });

    // ── "Compare with…" picker (rail ＋): scoped EntitySearch + Suggested defaults ──────────────────
    const pIndex: SchemaEntity[] = (() => { const el = document.querySelector('[data-ep-index]'); return el ? JSON.parse(el.textContent || '[]') : []; })();
    const pById = new Map(pIndex.map((e) => [e.id, e]));
    const escv = (s: string) => (s || '').replace(/[&<>]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' }[c]!));
