---
/**
 * EntitySearch — the shared entity typeahead. A daisyUI search input + a dropdown
 * of matches grouped by kind (Bases / Tables / Fields), each row = type icon +
 * name + parent path + health dot. Keyboard: ↑/↓ move, Enter jumps, Esc clears.
 *
 * Reused three ways: Browse global search / jump-to (here), the Docs "add tag"
 * control, and (future) the Visualize add-entity picker. It emits two events so a
 * host list can react: `schema:searchInput` ({ name, query }) on every keystroke
 * for filter-in-place, and the pick event (default `schema:openEntity`, { id }).
 */
import type { SchemaEntity } from './schemaEntities';

interface Props {
  index: SchemaEntity[];
  name?: string;
  placeholder?: string;
  /** Event dispatched on pick. Browse → opens the panel; Docs → inserts a tag. */
  pickEvent?: string;
  /** Narrow the input (toolbar vs full width). */
  size?: 'sm' | 'md';
}
const { index, name = 'schema', placeholder = 'Search bases, tables, fields…', pickEvent = 'schema:openEntity', size = 'sm' } = Astro.props;
const lite = index.map((e) => ({ id: e.id, kind: e.kind, name: e.name, baseName: e.baseName, tableName: e.tableName, fieldType: e.fieldType, health: e.health, isPrimary: e.isPrimary }));
---

<div class="es" data-entity-search data-es-name={name} data-es-pick={pickEvent}>
  <label class={`input ${size === 'sm' ? 'input-sm' : ''} es-input`}>
    <span class="iconify lucide--search size-4 opacity-55" aria-hidden="true"></span>
    <input type="search" placeholder={placeholder} data-es-field data-sch-search aria-label={placeholder} autocomplete="off" spellcheck="false" />
    <kbd class="kbd kbd-sm es-kbd">/</kbd>
  </label>
  <div class="es-pop" data-es-pop hidden>
    <div class="es-list" data-es-listbox role="listbox"></div>
    <div class="es-foot">
      <span><kbd class="kbd kbd-xs">↑</kbd><kbd class="kbd kbd-xs">↓</kbd> navigate</span>
      <span><kbd class="kbd kbd-xs">↵</kbd> open</span>
      <span><kbd class="kbd kbd-xs">esc</kbd> clear</span>
    </div>
  </div>
</div>

<script type="application/json" data-es-index={name} set:html={JSON.stringify(lite)} />

<style is:global>
  /* Global: the result list is rendered at runtime via innerHTML. Classes are .es- prefixed. */
  .es { position: relative; }
  .es-input { width: 100%; background: var(--color-base-100); }
  .es-kbd { opacity: .5; }
  .es-input:focus-within .es-kbd { display: none; }

  .es-pop {
    position: absolute; z-index: 40; top: calc(100% + 4px); left: 0; right: 0;
    background: var(--color-base-100); border: 1px solid var(--color-base-300);
    border-radius: var(--radius-box, .9rem); box-shadow: 0 10px 30px oklch(0 0 0 / .16);
    overflow: hidden;
  }
  .es-list { max-height: min(52vh, 380px); overflow-y: auto; padding: 4px; }
  .es-group { padding: 8px 8px 4px; font-size: 10.5px; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; opacity: .45; }
  .es-opt { display: flex; align-items: center; gap: 8px; padding: 8px 8px; border-radius: 7px; cursor: pointer; }
  .es-opt[aria-selected="true"], .es-opt:hover { background: var(--color-base-200); }
  .es-opt-ic { width: 18px; flex: none; display: grid; place-items: center; }
  .es-opt-ic svg { width: 15px; height: 15px; opacity: .8; }
  .es-opt-ic .iconify { font-size: .9rem; opacity: .75; }
  .es-opt-main { min-width: 0; flex: 1; }
  .es-opt-name { font-size: 13px; font-weight: 500; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .es-opt-path { font-size: 11px; color: oklch(from var(--color-base-content) l c h / .5); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .es-opt-dot { width: 7px; height: 7px; border-radius: 999px; flex: none; }
  .es-dot-green { background: var(--color-success); } .es-dot-amber { background: var(--color-warning); } .es-dot-red { background: var(--color-error); }
  .es-empty { padding: 16px; text-align: center; font-size: 12.5px; color: oklch(from var(--color-base-content) l c h / .5); }
  .es-foot { display: flex; gap: 16px; padding: 8px 12px; border-top: 1px solid var(--color-base-300); font-size: 11px; color: oklch(from var(--color-base-content) l c h / .5); }
  .es-foot span { display: inline-flex; align-items: center; gap: 4px; }
</style>

<script>
  import { AIRTABLE_FIELD_ICONS, airtableIconKey } from './airtableFieldIcons';

  type Lite = { id: string; kind: 'base' | 'table' | 'field'; name: string; baseName: string; tableName?: string; fieldType?: string; health: string; isPrimary?: boolean };

  function wireEntitySearch() {
    document.querySelectorAll<HTMLElement>('[data-entity-search]').forEach((root) => {
      if (root.dataset.esWired) return;
      root.dataset.esWired = '1';
      const name = root.dataset.esName!;
      const pickEvent = root.dataset.esPick || 'schema:openEntity';
      const dataEl = document.querySelector(`[data-es-index="${name}"]`);
      const index: Lite[] = dataEl ? JSON.parse(dataEl.textContent || '[]') : [];
      const field = root.querySelector<HTMLInputElement>('[data-es-field]')!;
      const pop = root.querySelector<HTMLElement>('[data-es-pop]')!;
      const listbox = root.querySelector<HTMLElement>('[data-es-listbox]')!;

      const esc = (s: string) => (s || '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]!));
      const dot = (h: string) => `<span class="es-opt-dot es-dot-${h === 'green' ? 'green' : h === 'red' ? 'red' : 'amber'}"></span>`;
      const fieldIcon = (type?: string) => { const k = type ? airtableIconKey(type) : null; return k ? `<svg viewBox="0 0 16 16">${AIRTABLE_FIELD_ICONS[k]}</svg>` : '<span class="iconify lucide--circle size-3.5"></span>'; };
      const icon = (e: Lite) => e.kind === 'base' ? '<span class="iconify lucide--database concept-ic-base"></span>' : e.kind === 'table' ? '<span class="iconify lucide--table-2"></span>' : fieldIcon(e.fieldType);
      const path = (e: Lite) => e.kind === 'field' ? `${e.baseName} ▸ ${e.tableName}` : e.kind === 'table' ? e.baseName : 'Base';

      // Substring OR initials match (DataGrip-style abbreviation).
      function matches(e: Lite, q: string): boolean {
        const hay = `${e.name} ${e.tableName || ''} ${e.baseName}`.toLowerCase();
        if (hay.includes(q)) return true;
        const initials = e.name.split(/[\s_]+/).map((w) => w[0]).join('').toLowerCase();
        return initials.includes(q);
      }

      let results: Lite[] = [];
      let active = -1;

      function close() { pop.hidden = true; active = -1; }
      function render(q: string) {
        if (!q) { close(); return; }
        results = index.filter((e) => matches(e, q)).slice(0, 40);
        if (!results.length) { pop.hidden = false; listbox.innerHTML = '<div class="es-empty">No matching entities</div>'; return; }
        const groups: Array<[string, string]> = [['base', 'Bases'], ['table', 'Tables'], ['field', 'Fields']];
        let html = '';
        let flat = 0;
        for (const [kind, label] of groups) {
          const items = results.filter((e) => e.kind === kind);
          if (!items.length) continue;
          html += `<div class="es-group">${label}</div>`;
          for (const e of items) {
            html += `<div class="es-opt" role="option" data-es-i="${flat}" data-es-id="${e.id}">
              <span class="es-opt-ic">${icon(e)}</span>
              <span class="es-opt-main"><div class="es-opt-name">${esc(e.name)}</div><div class="es-opt-path">${esc(path(e))}</div></span>
              ${dot(e.health)}
            </div>`;
            flat++;
          }
        }
        // Re-order results to match the grouped DOM order for keyboard nav.
        results = groups.flatMap(([kind]) => index.filter((e) => matches(e, q)).slice(0, 40).filter((e) => e.kind === kind));
        listbox.innerHTML = html;
        pop.hidden = false;
        active = -1;
      }
      function setActive(i: number) {
        const opts = Array.from(listbox.querySelectorAll<HTMLElement>('.es-opt'));
        if (!opts.length) return;
        active = (i + opts.length) % opts.length;
        opts.forEach((o, k) => o.setAttribute('aria-selected', String(k === active)));
        opts[active]?.scrollIntoView({ block: 'nearest' });
      }
      function pick(id: string) {
        field.value = ''; close();
        document.dispatchEvent(new CustomEvent('schema:searchInput', { detail: { name, query: '' } }));
        document.dispatchEvent(new CustomEvent(pickEvent, { detail: { id } }));
      }

      field.addEventListener('input', () => {
        const q = field.value.trim().toLowerCase();
        document.dispatchEvent(new CustomEvent('schema:searchInput', { detail: { name, query: field.value.trim() } }));
        render(q);
      });
      field.addEventListener('keydown', (ev) => {
        if (pop.hidden) { if (ev.key === 'Escape' && field.value) { field.value = ''; field.dispatchEvent(new Event('input')); } return; }
        if (ev.key === 'ArrowDown') { ev.preventDefault(); setActive(active + 1); }
        else if (ev.key === 'ArrowUp') { ev.preventDefault(); setActive(active - 1); }
        else if (ev.key === 'Enter') { ev.preventDefault(); if (active >= 0 && results[active]) pick(results[active].id); }
        else if (ev.key === 'Escape') { ev.preventDefault(); close(); field.value = ''; field.dispatchEvent(new Event('input')); }
      });
      listbox.addEventListener('mousedown', (ev) => { const o = (ev.target as HTMLElement).closest<HTMLElement>('.es-opt'); if (o) { ev.preventDefault(); pick(o.dataset.esId!); } });
      document.addEventListener('click', (ev) => { if (!root.contains(ev.target as Node)) close(); });
      // "/" focuses THIS search — but only while its panel is actually visible (tab-aware, so it
      // never steals focus to a hidden tab's search).
      document.addEventListener('keydown', (ev) => {
        if (ev.key === '/' && document.activeElement?.tagName !== 'INPUT' && document.activeElement?.tagName !== 'TEXTAREA' && !(document.activeElement as HTMLElement)?.isContentEditable) {
          if (field.offsetParent !== null) { ev.preventDefault(); field.focus(); }
        }
      });
    });
  }
  wireEntitySearch();
  document.addEventListener('astro:after-swap', wireEntitySearch);
</script>
