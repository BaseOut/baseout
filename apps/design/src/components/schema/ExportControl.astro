---
/**
 * ExportControl — the one export affordance for every Schema tab (`pattern-export-control`).
 *
 * The format is FIXED per tab (client's answer), so the trigger NAMES it: "Export CSV" / "Export image"
 * / "Export PDF". A bare "Export" is only honest when the user still has a format to pick.
 *
 * Built from the app's one filter language (ff-trigger / ff-panel / ff-group / ff-opt, global in
 * styles/components/facet-filter.css) — an export is a quiet toolbar control, not the page's primary
 * action. It replaces three divergent, hand-rolled, dead `btn-neutral` dropdowns.
 *
 * Scope shows BOTH counts so "keeps your filters" is verifiable, not promised. Zero matches disables the
 * control with a reason rather than producing a header-only file. The filename encodes the scope.
 *
 * There is no backend in this mirror: nothing is downloaded. Every confirm announces that it is faked
 * (the honest-signal pattern used across this repo).
 */
export type ExportFormat = 'csv' | 'image' | 'pdf';

interface Props {
  /** Tab slug — goes into the filename and the aria label. */
  tab: string;
  format: ExportFormat;
  /** What the counts are counting: "fields", "changes", "relationships"… */
  noun: string;
  /** M — everything, server-known. */
  total: number;
  /** Selector for the rows that make up "current view". Counted live; omit when the tab has no rows. */
  rowSelector?: string;
  /** The Space name, for the filename. */
  space?: string;
  /** Above this many items the export degrades to an async request (ProBackup's pattern). */
  heavyAbove?: number;
}

const { tab, format, noun, total, rowSelector = '', space = 'Space', heavyAbove = 500 } = Astro.props;

const LABEL: Record<ExportFormat, string> = {
  csv: 'Export CSV',
  image: 'Export image',
  pdf: 'Export PDF',
};
---

<div
  class="dropdown dropdown-end ff xp"
  data-export
  data-export-tab={tab}
  data-export-format={format}
  data-export-noun={noun}
  data-export-total={String(total)}
  data-export-rows={rowSelector}
  data-export-space={space}
  data-export-heavy={String(heavyAbove)}
>
  <button type="button" class="btn btn-sm gap-1.5 ff-trigger xp-trigger" data-export-trigger aria-haspopup="true" aria-expanded="false">
    <span class="iconify lucide--download size-4 opacity-70" aria-hidden="true"></span>
    <span data-export-label>{LABEL[format]}</span>
    <span class="iconify lucide--chevron-down size-3 opacity-55" aria-hidden="true"></span>
  </button>

  <div tabindex="0" class="dropdown-content ff-panel xp-panel" data-export-panel>
    <div class="ff-group">Scope</div>

    <label class="ff-opt">
      <span class="ff-label">Current view</span>
      <span class="xp-count" data-export-current>0</span>
      <input type="radio" class="radio radio-sm radio-primary" name={`xp-${tab}`} data-export-scope="filtered" checked />
    </label>
    <label class="ff-opt">
      <span class="ff-label">Everything</span>
      <span class="xp-count">{total} {noun}</span>
      <input type="radio" class="radio radio-sm radio-primary" name={`xp-${tab}`} data-export-scope="all" />
    </label>

    {format === 'csv' && (
      <>
        <div class="ff-sep"></div>
        {/* Name the OUTCOME, not the byte. "UTF-8 byte-order mark" is jargon; "opens correctly in Excel"
            is the decision the user is actually making. The default is off: the marker fixes Excel on
            Windows but corrupts the first column header for many other importers. */}
        <label class="ff-opt">
          <span class="ff-label">Opening in Excel</span>
          <input type="checkbox" class="toggle toggle-sm toggle-primary" data-export-bom />
        </label>
        <p class="xp-note">Keeps accents, dashes and emoji readable in Excel on Windows.</p>
      </>
    )}

    {format === 'image' && (
      <>
        <div class="ff-sep"></div>
        {/* ASSUMPTION (Dan has not answered): the whole graph, fitted with padding — never the viewport,
            which silently drops the off-screen nodes the user wanted. See research/schema-export/. */}
        <div class="ff-group">Background</div>
        <label class="ff-opt"><span class="ff-label">Match theme</span><input type="radio" class="radio radio-sm radio-primary" name={`xp-bg-${tab}`} data-export-bg="theme" checked /></label>
        <label class="ff-opt"><span class="ff-label">Light</span><input type="radio" class="radio radio-sm radio-primary" name={`xp-bg-${tab}`} data-export-bg="light" /></label>
        <label class="ff-opt"><span class="ff-label">Transparent</span><input type="radio" class="radio radio-sm radio-primary" name={`xp-bg-${tab}`} data-export-bg="transparent" /></label>
        <div class="ff-group">Scale</div>
        {/* ASSUMPTION: 2x by default — raster blurs when a schema diagram is zoomed. */}
        <label class="ff-opt"><span class="ff-label">1×</span><input type="radio" class="radio radio-sm radio-primary" name={`xp-sc-${tab}`} data-export-scale="1" /></label>
        <label class="ff-opt"><span class="ff-label">2×</span><input type="radio" class="radio radio-sm radio-primary" name={`xp-sc-${tab}`} data-export-scale="2" checked /></label>
        <label class="ff-opt"><span class="ff-label">3×</span><input type="radio" class="radio radio-sm radio-primary" name={`xp-sc-${tab}`} data-export-scale="3" /></label>
        <p class="xp-note">The whole graph, fitted with padding — not just what is on screen.</p>
      </>
    )}

    <div class="ff-sep"></div>
    {/* What you are about to get: its name, and — for CSV — the one thing about its contents a user
        could be surprised by. Grouped, because both describe the FILE, not the options above it. */}
    <p class="xp-file"><span class="iconify lucide--file-down size-3.5 opacity-60 mt-0.5 shrink-0" aria-hidden="true"></span><code data-export-filename></code></p>
    {format === 'csv' && <p class="xp-note xp-file-note">Formulas export as text, never evaluated.</p>}

    {/* Disabled with a reason beats a header-only file, which reads as a bug — and a bug in an export is
        indistinguishable from data loss. */}
    <p class="xp-empty" data-export-empty hidden>No {noun} match the current filter.</p>

    <button type="button" class="btn btn-sm btn-primary xp-go" data-export-go>
      <span data-export-go-label>Export</span>
    </button>
  </div>

  <span class="sr-only" role="status" aria-live="polite" data-export-live></span>
</div>

<style>
  /* The shared .ff-panel caps at min(58vh, 420px) — right for a long facet list, too short for a
     panel whose content is fixed and short. Scrolling a 6-row form is worse than making it fit. */
  .xp-panel { width: 264px; max-height: min(88vh, 620px); }
  .xp-count { flex: none; font-size: 12px; color: oklch(from var(--color-base-content) l c h / .55); font-variant-numeric: tabular-nums; }
  .xp-note { margin: 4px 8px 0; font-size: 12px; line-height: 1.4; color: oklch(from var(--color-base-content) l c h / .5); }
  /* Sits with the filename — both describe the file, not the options. No rule: it is not a section. */
  /* Indented to the filename's text column, not the icon's (pad 8 + icon 14 + gap 4 = 26; 24 is the
     nearest grid step and the 2px is optical). */
  .xp-file-note { margin: -4px 8px 8px 24px; }
  .xp-file { display: flex; align-items: flex-start; gap: 4px; margin: 0 8px 8px; font-size: 12px; color: oklch(from var(--color-base-content) l c h / .55); }
  /* WRAPS, never ellipsises. The scope suffix (`_filtered` / `_all`) is the last thing in the name and
     the whole reason the preview exists — truncating hides exactly the word it is here to show. */
  .xp-file code { min-width: 0; font-size: 12px; line-height: 1.35; overflow-wrap: anywhere; }
  .xp-empty { margin: 0 8px 8px; font-size: 12px; color: var(--color-error); }
  .xp-empty[hidden] { display: none; }
  .xp-go { width: 100%; }
</style>

<script>
  import { exportFilename } from '../../lib/csv';

  /** Every wired control's sync(), so a filter change anywhere can refresh the counts. */
  const syncs: Array<() => void> = [];

  function wireExports() {
    document.querySelectorAll<HTMLElement>('[data-export]').forEach((root) => {
      if (root.dataset.exportWired) return;
      root.dataset.exportWired = '1';

      const trigger = root.querySelector<HTMLButtonElement>('[data-export-trigger]')!;
      const go = root.querySelector<HTMLButtonElement>('[data-export-go]')!;
      const goLabel = root.querySelector<HTMLElement>('[data-export-go-label]')!;
      const currentEl = root.querySelector<HTMLElement>('[data-export-current]')!;
      const fileEl = root.querySelector<HTMLElement>('[data-export-filename]')!;
      const emptyEl = root.querySelector<HTMLElement>('[data-export-empty]')!;
      const live = root.querySelector<HTMLElement>('[data-export-live]')!;

      const tab = root.dataset.exportTab!;
      const noun = root.dataset.exportNoun!;
      const total = Number(root.dataset.exportTotal || 0);
      const rowSel = root.dataset.exportRows || '';
      const space = root.dataset.exportSpace || 'Space';
      const format = root.dataset.exportFormat as 'csv' | 'image' | 'pdf';
      const ext = format === 'csv' ? 'csv' : format === 'image' ? 'png' : 'pdf';

      const scopeOf = () =>
        (root.querySelector<HTMLInputElement>('[data-export-scope]:checked')?.dataset.exportScope || 'filtered') as
          | 'filtered'
          | 'all';

      /** "Current view" = the rows the tab is actually showing. No rowSelector ⇒ the tab has no rows. */
      const currentCount = () => {
        if (!rowSel) return total;
        return Array.from(document.querySelectorAll<HTMLElement>(rowSel)).filter((r) => r.offsetParent !== null).length;
      };

      function sync() {
        // A hidden tab reports zero visible rows, which would disable a control the user cannot even see
        // — and would then be wrong the moment they switch to it. Only recount what is on screen.
        if (root.offsetParent === null) return;
        // Read live: the threshold is a tab-owned knob, not a value frozen at wire time.
        const heavy = Number(root.dataset.exportHeavy || 500);
        const scope = scopeOf();
        const n = currentCount();
        currentEl.textContent = `${n} ${noun}`;
        const count = scope === 'all' ? total : n;

        // Zero matches: refuse, and say why. Only the filtered scope can be empty.
        const empty = count === 0;
        emptyEl.hidden = !empty;
        go.disabled = empty;

        // ProBackup's degrade-on-size: the label change IS the warning and the wait-communication.
        const isHeavy = !empty && count > heavy;
        goLabel.textContent = empty
          ? 'Nothing to export'
          : isHeavy
            ? 'Request full export'
            : `Export ${count} ${noun}`;
        go.setAttribute(
          'aria-label',
          `${goLabel.textContent} — ${scope === 'all' ? 'everything' : 'current view'}, as ${ext.toUpperCase()}`,
        );
        fileEl.textContent = exportFilename({ space, tab, scope, ext, date: new Date() });
      }

      root.querySelectorAll<HTMLInputElement>('[data-export-scope]').forEach((r) => r.addEventListener('change', sync));
      trigger.addEventListener('click', () => {
        trigger.setAttribute('aria-expanded', String(trigger.getAttribute('aria-expanded') !== 'true'));
        sync();
      });

      go.addEventListener('click', () => {
        const heavy = Number(root.dataset.exportHeavy || 500);
        const scope = scopeOf();
        const count = scope === 'all' ? total : currentCount();
        const name = fileEl.textContent;
        const heavyNow = count > heavy;

        // No backend here. Say so, rather than implying a file exists. (honest-signal pattern)
        live.textContent = heavyNow
          ? `Export requested. It will arrive in your Inbox. Nothing was downloaded — this preview has no backend.`
          : `Exported ${count} ${noun} as ${name}. Nothing was downloaded — this preview has no backend.`;

        if (heavyNow) document.dispatchEvent(new CustomEvent('schema:exportQueued', { detail: { tab, name, count } }));

        // Focus belongs back on the trigger once the panel closes; never on an async result.
        (document.activeElement as HTMLElement | null)?.blur();
        trigger.setAttribute('aria-expanded', 'false');
        trigger.focus();
      });

      syncs.push(sync);
      sync();
    });
  }

  const syncAll = () => syncs.forEach((fn) => fn());

  wireExports();
  document.addEventListener('astro:after-swap', () => { syncs.length = 0; wireExports(); });
  // The counts are only honest if they follow the tab. Facets emit `facetchange`; search boxes and the
  // derived checkboxes just fire input/change. Listen to all three and recount from the DOM.
  document.addEventListener('facetchange', syncAll);
  document.addEventListener('input', syncAll);
  document.addEventListener('change', syncAll);
</script>
