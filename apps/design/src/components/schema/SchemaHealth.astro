  @media (max-width: 640px) { .hl-comp { grid-template-columns: 1fr; gap: .8rem; } }
</style>

<script>
  function wireHealth() {
    // Scope to the Health root specifically — Browse rows also carry `data-health`, so a bare
    // [data-health] selector would grab a Browse row (it renders first) and break all wiring.
    const root = document.querySelector<HTMLElement>('.hl[data-health]');
    if (!root || root.dataset.hlWired) return;
    root.dataset.hlWired = '1';
    const cards = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-hl-card]'));
    const details = Array.from(root.querySelectorAll<HTMLElement>('[data-detail]'));
    const selectBase = (id: string | undefined) => {
      cards.forEach((c) => {
        const on = c.dataset.hlCard === id;
        c.classList.toggle('is-active', on);
        if (c.getAttribute('role') === 'tab') c.setAttribute('aria-selected', String(on));
      });
      details.forEach((d) => (d.hidden = d.dataset.detail !== id));
    };
    cards.forEach((c) => c.addEventListener('click', () => selectBase(c.dataset.hlCard)));

    // Expand/collapse a metric row (JS-driven; we avoid native <details> so the enable toggle
    // behaves like a normal checkbox). A click on the toggle does NOT expand the row.
    const toggleRow = (row: HTMLElement) => {
      const open = row.closest('.hl-metric')?.classList.toggle('is-open');
      row.setAttribute('aria-expanded', String(!!open));
    };
    root.addEventListener('click', (ev) => {
      const t = ev.target as HTMLElement;
      if (t.closest('[data-hl-metric-en]')) return; // the toggle owns its own clicks
      const row = t.closest<HTMLElement>('[data-hl-metric-row]');
      if (row) toggleRow(row);
    });
    root.addEventListener('keydown', (ev) => {
      if (ev.key !== 'Enter' && ev.key !== ' ') return;
      const row = (ev.target as HTMLElement).closest<HTMLElement>('[data-hl-metric-row]');
      if (row) { ev.preventDefault(); toggleRow(row); }
    });
    // Enable/disable: the toggle is a plain checkbox now — reflect its state into the muted class.
    // (Faked: the grade recomputes on the next score; we just mute + mark "not counted".)
    root.addEventListener('change', (ev) => {
      const cb = (ev.target as HTMLElement).closest<HTMLInputElement>('[data-hl-metric-en] input');
      if (cb) cb.closest('.hl-metric')?.classList.toggle('hl-metric-off', !cb.checked);
    });

    // H3 — prompt-editor drawer: open per metric, populate the resolution + textarea, fake edits.
    const peToggle = document.getElementById('hl-prompt') as HTMLInputElement | null;
    const peMetric = root.querySelector<HTMLElement>('[data-pe-metric]');
    const peTa = root.querySelector<HTMLTextAreaElement>('[data-pe-ta]');
    const peReset = root.querySelector<HTMLElement>('[data-pe-reset]');
    const peStale = root.querySelector<HTMLElement>('[data-pe-stale]');
    const peScopeCur = root.querySelector<HTMLElement>('[data-pe-scope-cur]');
    const peScopeSearch = root.querySelector<HTMLInputElement>('[data-pe-scope-search]');
    const peScopeEmpty = root.querySelector<HTMLElement>('[data-pe-scope-empty]');
    const peSaveLabel = root.querySelector<HTMLElement>('[data-pe-save-label]');
    const peResetLabel = root.querySelector<HTMLElement>('[data-pe-reset-label]');
    const peChip = (src: string) => root.querySelectorAll<HTMLElement>('[data-pe-chip]').forEach((c) => c.classList.toggle('is-active', c.dataset.peChip === src));
    const SPACE_LABEL = 'Whole Space — applies to all bases';
    let peSystem = '';
    let peSpace = '';
    let peScopeVal = 'space';
    const setScope = (val: string, label: string) => { peScopeVal = val; if (peScopeCur) peScopeCur.textContent = label; };
    // Reflect the chosen scope (whole Space vs a per-entity override) into the editor.
    const applyScope = () => {
      const ov = peScopeVal.startsWith('ent:');
      if (peSaveLabel) peSaveLabel.textContent = ov ? 'Save override' : 'Save prompt';
      if (peResetLabel) peResetLabel.textContent = ov ? 'Remove override' : 'Reset to default';
      if (peTa) peTa.value = peSpace || peSystem;
      if (ov) { peChip('override'); if (peReset) peReset.hidden = false; }
      else { peChip(peSpace ? 'space' : 'default'); if (peReset) peReset.hidden = !peSpace; }
    };
    // Scope picker — searchable list of entities the override can target.
    peScopeSearch?.addEventListener('input', () => {
      const q = peScopeSearch.value.trim().toLowerCase();
      let shown = 0;
      root.querySelectorAll<HTMLElement>('[data-pe-scope-opt]').forEach((o) => {
        const ok = !q || (o.dataset.search || '').includes(q);
        o.hidden = !ok; if (ok) shown++;
      });
      if (peScopeEmpty) peScopeEmpty.hidden = shown > 0;
    });
    root.querySelectorAll<HTMLElement>('[data-pe-scope-opt]').forEach((o) => {
      o.addEventListener('click', () => {
        setScope(o.dataset.value || 'space', o.dataset.label || SPACE_LABEL);
        applyScope();
        (document.activeElement as HTMLElement | null)?.blur(); // close the dropdown
      });
    });
    root.addEventListener('click', (ev) => {
      const t = (ev.target as HTMLElement).closest<HTMLElement>('[data-hl-prompt-open]');
      if (!t) return;
      peSystem = t.dataset.system || '';
      peSpace = t.dataset.space || '';
      if (peMetric) peMetric.textContent = `${t.dataset.metric} · ${t.dataset.tiers}`;
      setScope('space', SPACE_LABEL);
      if (peScopeSearch) peScopeSearch.value = '';
      root.querySelectorAll<HTMLElement>('[data-pe-scope-opt]').forEach((o) => (o.hidden = false));
      if (peScopeEmpty) peScopeEmpty.hidden = true;
      if (peStale) peStale.hidden = t.dataset.stale !== '1';
      applyScope();
      if (peToggle) peToggle.checked = true;
    });
    peReset?.addEventListener('click', () => {
      if (peScopeVal.startsWith('ent:')) { setScope('space', SPACE_LABEL); applyScope(); }   // remove override → back to Space
      else { if (peTa) peTa.value = peSystem; peChip('default'); peReset.hidden = true; }      // reset to default
    });
    root.querySelector<HTMLElement>('[data-pe-save]')?.addEventListener('click', () => {
      if (peScopeVal.startsWith('ent:')) { peChip('override'); }
      else { peSpace = peTa?.value || peSpace; peChip('space'); if (peReset) peReset.hidden = false; }
      if (peToggle) peToggle.checked = false;
    });
    root.querySelector<HTMLElement>('[data-pe-rerun]')?.addEventListener('click', () => { if (peStale) peStale.hidden = true; });

    // console search (many-bases mode): filter the master list by base name
    const search = root.querySelector<HTMLInputElement>('[data-hl-search]');
    const mrows = Array.from(root.querySelectorAll<HTMLElement>('.hl-mrow'));
    const emptyMsg = root.querySelector<HTMLElement>('[data-hl-search-empty]');
    search?.addEventListener('input', () => {
      const q = search.value.trim().toLowerCase();
      let shown = 0;
      mrows.forEach((r) => {
        const ok = !q || (r.dataset.name ?? '').includes(q);
        r.hidden = !ok;
        if (ok) shown++;
      });
      if (emptyMsg) emptyMsg.hidden = shown !== 0;
    });

    // console sort (many-bases mode): a small dropdown of sort options reorders the master list
    const master = root.querySelector<HTMLElement>('.hl-master');
    const sortOpts = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-hl-sort]'));
    sortOpts.forEach((opt) =>
      opt.addEventListener('click', () => {
        const mode = opt.dataset.hlSort;
        mrows
          .slice()
          .sort((a, b) => {
            if (mode === 'name') return (a.dataset.name ?? '').localeCompare(b.dataset.name ?? '');
            const sa = Number(a.dataset.score ?? 0);
            const sb = Number(b.dataset.score ?? 0);
            return mode === 'best' ? sb - sa : sa - sb;
          })
          .forEach((r) => master?.appendChild(r));
        if (emptyMsg) master?.appendChild(emptyMsg); // keep the no-match line last
        sortOpts.forEach((o) => o.classList.toggle('is-active', o === opt));
        (document.activeElement as HTMLElement | null)?.blur(); // close the dropdown
      }),
    );

    // Issues / Insights sub-switcher — per base detail, toggle the two panels.
    root.querySelectorAll<HTMLElement>('.hl-detail').forEach((detail) => {
      const subtabs = Array.from(detail.querySelectorAll<HTMLButtonElement>('[data-subtab]'));
      const subpanels = Array.from(detail.querySelectorAll<HTMLElement>('[data-subpanel]'));
      if (subtabs.length === 0) return;
      const sevsum = detail.querySelector<HTMLElement>('[data-sevsum]');
      subtabs.forEach((tb) =>
        tb.addEventListener('click', () => {
          subtabs.forEach((x) => { const on = x === tb; x.classList.toggle('is-active', on); x.setAttribute('aria-selected', String(on)); });
          subpanels.forEach((p) => (p.hidden = p.dataset.subpanel !== tb.dataset.subtab));
          if (sevsum) sevsum.hidden = tb.dataset.subtab !== 'issues'; // legend is issue-only
        }),
      );
    });

    // ===================== Insights =====================
    const INS_SHOWN = 6; // keep in sync with INSIGHTS_SHOWN in the frontmatter
    const setCardArchived = (card: HTMLElement, isArc: boolean) => {
      const foot = card.querySelector('.hl-ins-foot');
      if (foot) foot.innerHTML = isArc
        ? '<button type="button" class="btn btn-sm btn-ghost gap-1 hl-ins-act" data-ins-restore><span class="iconify lucide--rotate-ccw size-3.5" aria-hidden="true"></span>Restore</button>'
        : '<button type="button" class="btn btn-sm btn-ghost gap-1 hl-ins-act" data-ins-archive><span class="iconify lucide--archive size-3.5" aria-hidden="true"></span>Archive</button>';
      const top = card.querySelector('.hl-ins-top');
      let tag = card.querySelector('.hl-arctag');
      if (isArc && !tag && top) {
        tag = document.createElement('span');
        tag.className = 'badge badge-sm badge-ghost hl-arctag';
        tag.textContent = 'Archived';
        top.insertBefore(tag, top.querySelector('.hl-ins-date'));
      }
      if (!isArc && tag) tag.remove();
    };
    root.querySelectorAll<HTMLElement>('[data-insights]').forEach((sec) => {
      const showArc = sec.querySelector<HTMLInputElement>('[data-ins-show-archived]');
      const moreBtn = sec.querySelector<HTMLElement>('[data-ins-more]');
      // The active count lives on the Insights sub-tab (outside this section), so look it up via the base detail.
      const countEl = sec.closest('.hl-detail')?.querySelector<HTMLElement>('[data-ins-count]');
      const arcNEl = sec.querySelector<HTMLElement>('.hl-ins-arc-n');
      const arcToggleWrap = sec.querySelector<HTMLElement>('.hl-ins-arctoggle');
      const moreN = moreBtn?.querySelector<HTMLElement>('[data-ins-more-n]');
      let expanded = false;
      const apply = () => {
        const cards = Array.from(sec.querySelectorAll<HTMLElement>('[data-insight]'));
        const actives = cards.filter((c) => c.dataset.archived !== '1');
        const archived = cards.filter((c) => c.dataset.archived === '1');
        const showArchived = !!showArc?.checked;
        actives.forEach((c, i) => (c.hidden = !expanded && i >= INS_SHOWN));
        archived.forEach((c) => (c.hidden = !showArchived));
        if (countEl) countEl.textContent = String(actives.length);
        if (arcNEl) arcNEl.textContent = String(archived.length);
        if (arcToggleWrap) arcToggleWrap.hidden = archived.length === 0;
        if (moreBtn) moreBtn.hidden = expanded || actives.length <= INS_SHOWN;
        if (moreN) moreN.textContent = String(Math.max(0, actives.length - INS_SHOWN));
      };
      showArc?.addEventListener('change', apply);
      moreBtn?.addEventListener('click', () => { expanded = true; apply(); });
      sec.addEventListener('click', (ev) => {
        const t = ev.target as HTMLElement;
        const card = t.closest<HTMLElement>('[data-insight]');
        if (!card) return;
        if (t.closest('[data-ins-archive]')) { card.dataset.archived = '1'; card.classList.add('hl-ins-arc'); setCardArchived(card, true); apply(); }
        else if (t.closest('[data-ins-restore]')) { card.dataset.archived = '0'; card.classList.remove('hl-ins-arc'); setCardArchived(card, false); apply(); }
      });
      apply();
    });

    // Section-header Re-run: clear this base's stale banner + hide the button (faked regen).
    root.querySelectorAll<HTMLElement>('[data-ins-rerun-base]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const sec = btn.closest<HTMLElement>('[data-insights]');
        const stale = sec?.querySelector<HTMLElement>('[data-ins-stale]');
        if (stale) stale.hidden = true;
        btn.hidden = true;
      });
    });

    // Insight prompt editor drawer — Space vs per-base override (resolution: default ▸ space ▸ override).
    const ipeToggle = document.getElementById('hl-insight-prompt') as HTMLInputElement | null;
    const ipeBase = root.querySelector<HTMLElement>('[data-ipe-base]');
    const ipeTa = root.querySelector<HTMLTextAreaElement>('[data-ipe-ta]');
    const ipeReset = root.querySelector<HTMLElement>('[data-ipe-reset]');
    const ipeStale = root.querySelector<HTMLElement>('[data-ipe-stale]');
    const ipeHint = root.querySelector<HTMLElement>('[data-ipe-hint]');
    const ipeSaveLabel = root.querySelector<HTMLElement>('[data-ipe-save-label]');
    const ipeResetLabel = root.querySelector<HTMLElement>('[data-ipe-reset-label]');
    const ipeChip = (src: string) => root.querySelectorAll<HTMLElement>('[data-ipe-chip]').forEach((c) => c.classList.toggle('is-active', c.dataset.ipeChip === src));
    let ipeSystem = '', ipeSpace = '', ipeBaseP = '', ipeScope = 'space';
    const ipeApply = () => {
      const ov = ipeScope === 'base';
      if (ipeSaveLabel) ipeSaveLabel.textContent = ov ? 'Save override' : 'Save prompt';
      if (ipeResetLabel) ipeResetLabel.textContent = ov ? 'Remove override' : 'Reset to default';
      if (ipeHint) ipeHint.textContent = ov ? 'Overrides the Space prompt for this base only.' : 'Applies to insight generation across every base in this Space.';
      if (ipeTa) ipeTa.value = ov ? (ipeBaseP || ipeSpace || ipeSystem) : (ipeSpace || ipeSystem);
      if (ov) { ipeChip('override'); if (ipeReset) ipeReset.hidden = !ipeBaseP; }
      else { ipeChip(ipeSpace ? 'space' : 'default'); if (ipeReset) ipeReset.hidden = !ipeSpace; }
      root.querySelectorAll<HTMLElement>('[data-ipe-scope]').forEach((s) => s.classList.toggle('is-active', s.dataset.ipeScope === ipeScope));
    };
    root.querySelectorAll<HTMLElement>('[data-ipe-scope]').forEach((s) => s.addEventListener('click', () => { ipeScope = s.dataset.ipeScope || 'space'; ipeApply(); }));
    root.addEventListener('click', (ev) => {
      const t = (ev.target as HTMLElement).closest<HTMLElement>('[data-ins-prompt-open]');
      if (!t) return;
      ipeSystem = t.dataset.system || '';
      ipeSpace = t.dataset.space || '';
      ipeBaseP = t.dataset.baseprompt || '';
      // Open on the effective source: a per-base override wins, else Space.
      ipeScope = ipeBaseP ? 'base' : 'space';
      if (ipeBase) ipeBase.textContent = t.dataset.baseName || 'Base';
      root.querySelectorAll<HTMLElement>('[data-ipe-scope-base]').forEach((e) => (e.textContent = t.dataset.baseName || 'This base'));
      if (ipeStale) ipeStale.hidden = t.dataset.stale !== '1';
      ipeApply();
      if (ipeToggle) ipeToggle.checked = true;
    });
    ipeReset?.addEventListener('click', () => {
      if (ipeScope === 'base') { ipeBaseP = ''; ipeScope = 'space'; ipeApply(); }   // remove override → Space
      else { ipeSpace = ''; if (ipeTa) ipeTa.value = ipeSystem; ipeChip('default'); ipeReset.hidden = true; } // reset to default
    });
    root.querySelector<HTMLElement>('[data-ipe-save]')?.addEventListener('click', () => {
      if (ipeScope === 'base') { ipeBaseP = ipeTa?.value || ipeBaseP; ipeChip('override'); if (ipeReset) ipeReset.hidden = false; }
      else { ipeSpace = ipeTa?.value || ipeSpace; ipeChip('space'); if (ipeReset) ipeReset.hidden = false; }
      if (ipeToggle) ipeToggle.checked = false;
    });
    root.querySelector<HTMLElement>('[data-ipe-rerun]')?.addEventListener('click', () => { if (ipeStale) ipeStale.hidden = true; });
  }
  wireHealth();
  document.addEventListener('astro:after-swap', wireHealth);
</script>
