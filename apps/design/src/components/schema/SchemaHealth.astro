  .hl-ins-act:focus-visible { opacity: 1; }

  .hl-ins-arc { opacity: .62; }
  .hl-ins-arc:hover { opacity: .85; }

  .hl-ins-more { display: inline-flex; align-items: center; gap: .35rem; margin-top: .7rem; padding: .35rem .2rem; font-size: .8rem; font-weight: 550; color: var(--color-primary); background: none; border: 0; cursor: pointer; }
  .hl-ins-more[hidden] { display: none; }
