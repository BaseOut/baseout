  .hl-ins-top { display: flex; align-items: center; gap: .5rem; margin-bottom: .4rem; }
  .hl-ins-cat { display: inline-flex; align-items: center; gap: .35rem; font-size: .72rem; font-weight: 600; letter-spacing: .01em; color: oklch(from var(--color-base-content) l c h / .72); }
  .hl-ins-cat .iconify { color: oklch(from var(--color-base-content) l c h / .5); }
  .hl-arctag { flex: none; }
  .hl-ins-date { margin-left: auto; font-size: .72rem; color: oklch(from var(--color-base-content) l c h / .45); white-space: nowrap; }

  .hl-ins-text { font-size: .88rem; line-height: 1.5; color: oklch(from var(--color-base-content) l c h / .9); }
  .hl-ins-ev { margin-top: .3rem; font-size: .78rem; line-height: 1.45; color: oklch(from var(--color-base-content) l c h / .55); }

  .hl-ins-tags { display: flex; flex-wrap: wrap; gap: .35rem; margin-top: .6rem; }

  .hl-ins-foot { display: flex; justify-content: flex-end; margin-top: .5rem; }
