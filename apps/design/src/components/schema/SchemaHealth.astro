  /* insight prompt scope — 2-option segmented control (Space vs this base) */
  .pe-segmented { display: inline-flex; padding: 4px; gap: 4px; background: var(--color-base-200); border: 1px solid var(--color-base-300); border-radius: 9px; }
  .pe-seg { display: inline-flex; align-items: center; gap: .35rem; padding: .3rem .65rem; border: 0; border-radius: 6px; background: none; cursor: pointer; font: inherit; font-size: .8rem; font-weight: 500; color: oklch(from var(--color-base-content) l c h / .65); }
  .pe-seg .iconify { opacity: .7; }
