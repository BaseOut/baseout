  .hl-ins-gen { display: inline-flex; align-items: center; gap: .3rem; font-size: .73rem; color: oklch(from var(--color-base-content) l c h / .5); }
  .hl-ins-gen .iconify { opacity: .7; }
  .hl-ins-actions { margin-left: auto; display: inline-flex; align-items: center; gap: .35rem; flex-wrap: wrap; }
  .hl-ins-arctoggle { display: inline-flex; align-items: center; gap: .4rem; font-size: .78rem; color: oklch(from var(--color-base-content) l c h / .7); cursor: pointer; padding-left: .3rem; }
  .hl-ins-arctoggle[hidden] { display: none; }
