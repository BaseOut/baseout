  .rl-dpair { display: flex; align-items: center; gap: .5rem; flex-wrap: wrap; border: 1px solid var(--color-base-300); border-radius: 11px; background: color-mix(in oklch, var(--color-base-200) 45%, transparent); padding: 12px; }
  .rl-darrow { color: oklch(from var(--color-base-content) l c h / .45); }
  .rl-dmeta { font-size: .82rem; line-height: 1.5; color: oklch(from var(--color-base-content) l c h / .72); }
  /* Provenance = catalog Alert (alert alert-soft alert-info); only compact size here. */
  .rl-dprov { font-size: .8rem; line-height: 1.45; }
  /* Linked fields (formula/rollup) — the referenced fields as click-through chips, inside the
     shared row-list container (pattern-detail-panel) so a lone chip doesn't float. */
  .rl-dfields { display: flex; align-items: center; gap: .5rem; flex-wrap: wrap; border: 1px solid var(--color-base-300); border-radius: 11px; background: color-mix(in oklch, var(--color-base-200) 45%, transparent); overflow: hidden; padding: 12px; }
  /* Changelog — the relationship's added/removed history. Now the shared row-list container (one
     clearly-visible box, hairline-split rows) instead of faint per-row fills that were too subtle. */
  .rl-dlog { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; border: 1px solid var(--color-base-300); border-radius: 11px; background: color-mix(in oklch, var(--color-base-200) 45%, transparent); overflow: hidden; }
  .rl-dlog-item { display: flex; align-items: center; gap: .5rem; font-size: .8rem; padding: 8px 12px; }
  .rl-dlog-item + .rl-dlog-item { border-top: 1px solid var(--color-base-200); }
  .rl-dlog-ic { flex: none; }
  .rl-dlog-added .rl-dlog-ic { color: var(--color-success); }
  .rl-dlog-removed .rl-dlog-ic { color: var(--color-error); }
  .rl-dlog-txt { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .rl-dlog-when { margin-left: auto; font-size: .72rem; color: oklch(from var(--color-base-content) l c h / .5); white-space: nowrap; flex: none; }
  /* Invalid = catalog Alert (alert alert-soft alert-warning); only compact size here. */
  .rl-dinvalid { font-size: .8rem; }
  /* Inference card — one bordered catalog Alert (alert-soft alert-info) grouping the header,
