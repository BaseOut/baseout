  .rl-detail-ic .iconify, .rl-detail-ic svg { opacity: .8; }
  .rl-detail-type { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 15px; font-weight: 650; letter-spacing: -0.15px; line-height: 1.2; }
  /* Crumb-segment styling comes from the shared .sb-crumb* (styles/global.css); this keeps the row
     from overflowing the header, matching .ep-crumbs. */
  .rl-detail-crumbs { min-width: 0; overflow: hidden; }
  .rl-detail-crumbs[hidden] { display: none; }
  /* Identity meta line — FIRST body element (canonical), styled like EntityPanel .ep-body-meta:
     status dot+label · readable cardinality. */
  .rl-dbody-meta { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; font-size: 12px; color: oklch(from var(--color-base-content) l c h / .65); }
  .rl-meta-sep { opacity: .4; }
  /* Validity as a coloured dot + label (Browse-panel identity), not plain text. */
  .rl-dstatus { display: inline-flex; align-items: center; gap: 4px; font-weight: 550; color: oklch(from var(--color-base-content) l c h / .85); }
  .rl-dot { width: 8px; height: 8px; border-radius: 999px; flex: none; }
  .rl-dot-green { background: var(--color-success); }
  .rl-dot-red { background: var(--color-error); }
  .rl-dot-primary { background: var(--color-primary); }
  .rl-detail-body { padding: 1rem; overflow-y: auto; display: flex; flex-direction: column; gap: 1rem; }

  /* detail body bits (rendered via JS innerHTML → keep selectors global-safe) */
  .rl-dsect-label { display: flex; align-items: center; gap: 8px; font-size: 11px; text-transform: uppercase; letter-spacing: .05em; color: oklch(from var(--color-base-content) l c h / .5); font-weight: 700; margin-bottom: 8px; }
  .rl-dsect-ic { flex: none; opacity: .85; }
  /* Count badge (catalog badge-sm badge-neutral) — pressed right after the section name; the flex
     gap keeps it 8px off the label. Suppressed under 2 by the builder, so a lone "1" never shows. */
  .rl-dsect-count { flex: none; }
  /* Canonical panel-anatomy (c): adjacent body sections separated by whitespace, NOT a divider —
     a small top margin on the 4px grid on top of the body's flex gap (skip the first section). */
  .rl-detail-body > div:not(:first-child):has(> .rl-dsect-label) { margin-top: 8px; }
  /* Connects — the A→B pair inside the shared row-list container (same recipe as .rl-dfields)
