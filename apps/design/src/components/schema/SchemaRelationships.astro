  .rl-dinf { display: block; }
  .rl-dinf-inner { display: flex; flex-direction: column; gap: 8px; min-width: 0; }
  .rl-dinf-head { display: flex; align-items: center; gap: 8px; font-size: .8rem; font-weight: 650; }
