  /* count sits inline right after the name (Browse "8 tables · 47 fields" style), not floating at the edge */
  .rl-base-meta { font-size: .8rem; color: oklch(from var(--color-base-content) l c h / .5); }

  .rl-typegroup { border-top: 1px solid var(--color-base-200); }
