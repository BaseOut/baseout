    // ⌘I / Ctrl+I toggles the assistant; Esc closes
    document.addEventListener('keydown', (e) => {
      if ((e.metaKey || e.ctrlKey) && (e.key === 'i' || e.key === 'I')) { e.preventDefault(); root.dataset.mode === 'closed' ? openChat() : setMode('closed'); }
      if (e.key === 'Escape' && root.dataset.mode !== 'closed') setMode('closed');
    });

    // variant switcher
    // the active tab (→ panel) of a given variant's currently-visible bar
    const activeOf = (v: string) =>
      v === 'a'
        ? root.querySelector<HTMLElement>('.pn-bar-a .pn-tab.is-on')
        : root.querySelector<HTMLElement>('.pn-bar-b .pn-subrow:not([hidden]) .pn-subtab.is-on');

    root.querySelectorAll<HTMLElement>('[data-set-variant]').forEach((btn) =>
      btn.addEventListener('click', () => {
        const v = btn.dataset.setVariant!;
        root.dataset.variant = v;
        if (root.dataset.mode !== 'closed') openChat(); // keep chat open, swap surface
        showPanel(activeOf(v)?.dataset.panel); // sync the body to that variant's active tab
        root.querySelectorAll('[data-set-variant]').forEach((x) => x.classList.toggle('is-on', x === btn));
      }),
    );

    // tab active state (Bar A + Bar B sub-tabs) → swaps the static screen
    const wireTabs = (scope: Element) => {
      const tabs = Array.from(scope.querySelectorAll<HTMLElement>('[data-tab]'));
      tabs.forEach((t) =>
        t.addEventListener('click', () => {
          tabs.forEach((x) => x.classList.toggle('is-on', x === t));
          showPanel(t.dataset.panel);
        }),
      );
    };
    wireTabs(root.querySelector('.pn-bar-a')!);

    // Bar B clusters swap the sub-row, then show that cluster's active sub-tab panel
    root.querySelectorAll<HTMLElement>('[data-cluster]').forEach((c) =>
      c.addEventListener('click', () => {
        root.querySelectorAll('[data-cluster]').forEach((x) => x.classList.toggle('is-on', x === c));
        const key = c.dataset.cluster;
        root.querySelectorAll<HTMLElement>('.pn-subrow').forEach((r) => (r.hidden = r.dataset.sub !== key));
        showPanel(root.querySelector<HTMLElement>(`.pn-subrow[data-sub="${key}"] .pn-subtab.is-on`)?.dataset.panel);
      }),
    );
    root.querySelectorAll<HTMLElement>('.pn-subrow').forEach((r) => wireTabs(r));
  }
  wirePrototype();
  document.addEventListener('astro:after-swap', wirePrototype);
</script>
