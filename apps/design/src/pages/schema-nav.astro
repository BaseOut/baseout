---
/**
 * /schema-nav — THROWAWAY navigation prototype (harness-only, apps/design).
 *
 * Lets the client click two candidate reworks of the 9-tab Schema bar over a
 * shared placeholder body, WITHOUT touching the real SchemaView. The two
 * variants differ ONLY in the bar treatment (decided with Oleh 2026-07-02):
 *
 *   Variant A — Grouped bar (dividers + cluster labels)
 *   Variant B — Two-level bar (clusters → sub-tabs)
 *
 * Both share the SAME chat surface: a modal side-drawer over a dimmed body that
 * can "Expand" to the full 3-column chat page (the inset-panel concept was
 * dropped — Oleh 2026-07-02). Chat is pulled OUT of the tab row in both
 * (9 → 8 tabs) and launched from a persistent "Ask about your schema" button.
 * Everything here is presentational — scoped `.pn-` classes, no real SchemaChat
 * wiring. See research/schema-navigation/index.html for the rationale.
 */
import SidebarLayout from '../layouts/SidebarLayout.astro';

const breadcrumbs = [{ label: 'Schema' }, { label: 'Navigation prototype' }];
// ?v=a | b picks the initial variant (the floating switcher flips it client-side too).
const v = Astro.url.searchParams.get('v') === 'b' ? 'b' : 'a';

// A short faked conversation, reused across the inset panel, the drawer, and the
// full view so all three read as the same assistant. Presentational only.
const CONVO_HTML = `
  <div class="pn-msg-user">Which tables in Sales CRM have undocumented fields?</div>
  <div class="pn-msg-ai">
    <span class="pn-mark"><span class="iconify lucide--sparkles size-3.5"></span></span>Three tables in Sales CRM have fields with no description: <b>Deals</b> (4 fields), <b>Contacts</b> (2), and <b>Activities</b> (1). The most linked of these is <b>Deals.Stage</b>, referenced by two rollups.
    <div class="pn-refs"><span class="pn-refs-label">References</span>
      <span class="pn-refchip"><span class="iconify lucide--table-2 size-3.5"></span>Deals</span>
      <span class="pn-refchip"><span class="iconify lucide--table-2 size-3.5"></span>Contacts</span>
      <span class="pn-refchip"><span class="iconify lucide--table-2 size-3.5"></span>Activities</span>
    </div>
  </div>
  <div class="pn-msg-user">Draft a description for Deals.Stage.</div>
  <div class="pn-msg-ai">
    <span class="pn-mark"><span class="iconify lucide--sparkles size-3.5"></span></span>Suggested: “The current position of a deal in the sales pipeline (e.g. Lead, Qualified, Won). Drives the Weighted Value rollup and the Pipeline interface grouping.” Want me to save this as a doc?
  </div>`;

// ── Light, non-functional-but-faithful tab bodies ───────────────────────────
// Each tab renders a real-looking toolbar (the FILTER placement is the point of
// this prototype) + a compact table. Static HTML, no wiring. Shared by A and B.
const ic = (n: string) => `<span class="iconify lucide--${n}"></span>`;
const search = (ph: string) => `<span class="pn-search">${ic('search')}<span class="pn-search-ph">${ph}</span></span>`;
const chip = (l: string, on = false) => `<span class="pn-fchip${on ? ' is-on' : ''}">${l}<span class="pn-caret">▾</span></span>`;
const qchip = (l: string, on = false) => `<span class="pn-qchip${on ? ' is-on' : ''}">${l}</span>`;
const seg = (opts: string[], on: string) => `<span class="pn-seg">${opts.map((o) => `<span class="pn-seg-opt${o === on ? ' is-on' : ''}">${o}</span>`).join('')}</span>`;
const tgl = (l: string, on = false) => `<span class="pn-tgl${on ? ' is-on' : ''}"><span class="pn-tgl-box"></span>${l}</span>`;
const btnP = (l: string, icon = 'plus') => `<span class="pn-btnp">${ic(icon)}${l}</span>`;
const cnt = (t: string) => `<span class="pn-count">${t}</span>`;
const badge = (l: string, k: string) => `<span class="pn-badge pn-badge-${k}">${l}</span>`;
const sp = '<span class="pn-tb-sp"></span>';
const nm = (icon: string, name: string, i = 0, cls = '') => `<span class="pn-nm" style="--i:${i}rem"><span class="iconify lucide--${icon} ${cls}"></span>${name}</span>`;
const tbl = (head: string[], rows: string[][]) =>
  `<table class="pn-tbl"><thead><tr>${head.map((h) => `<th>${h}</th>`).join('')}</tr></thead><tbody>${rows.map((r) => `<tr>${r.map((c) => `<td>${c}</td>`).join('')}</tr>`).join('')}</tbody></table>`;
const mini = (l: string, k = '') => `<span class="pn-mini pn-mini-${k}">${l}</span>`;

const PANEL: Record<string, string> = {
  browse:
    `<div class="pn-tb">${search('Search bases, tables, fields…')}${chip('Base')}${chip('Table')}${chip('Field type')}${sp}${seg(['Tree', 'Flat'], 'Tree')}${tgl('Include deleted')}${cnt('24 of 180')}</div>` +
    `<div class="pn-body">${tbl(['Name', 'Type', 'Description'], [
      [nm('database', 'Sales CRM', 0, 'concept-ic-base'), '<span class="pn-mut">Base</span>', 'CRM master base'],
      [nm('table-2', 'Deals', 1), '<span class="pn-mut">Table · 12 fields</span>', 'Open and closed deals'],
      [nm('tag', 'Stage', 2), '<span class="pn-mut">Single select</span>', 'Pipeline position'],
      [nm('tag', 'Amount', 2), '<span class="pn-mut">Currency</span>', 'Deal value'],
      [nm('tag', 'Weighted Value', 2), '<span class="pn-mut">Formula</span>', 'Amount × Probability'],
      [nm('table-2', 'Contacts', 1), '<span class="pn-mut">Table · 8 fields</span>', 'People and companies'],
      [nm('tag', 'Email', 2), '<span class="pn-mut">Email</span>', '<span class="pn-mut">— no description</span>'],
    ])}</div>`,

  visualize:
    `<div class="pn-tb">${chip('Fields: 24 of 180')}${chip('Bases')}${qchip('Hide unlinked')}${sp}<span class="pn-zoom">−&nbsp;&nbsp;100%&nbsp;&nbsp;+</span>${qchip('Fit')}</div>` +
    `<div class="pn-body pn-er-wrap"><div class="pn-er">` +
      `<div class="pn-node"><div class="pn-node-h">${ic('table-2')}Deals</div><div class="pn-node-f"><span>Stage</span><span class="pn-mut">select</span></div><div class="pn-node-f"><span>Amount</span><span class="pn-mut">currency</span></div><div class="pn-node-f pn-node-fk"><span>Contact</span><span class="pn-mut">link →</span></div></div>` +
      `<span class="pn-edge">→</span>` +
      `<div class="pn-node"><div class="pn-node-h">${ic('table-2')}Contacts</div><div class="pn-node-f"><span>Name</span><span class="pn-mut">text</span></div><div class="pn-node-f"><span>Email</span><span class="pn-mut">email</span></div><div class="pn-node-f pn-node-fk"><span>Company</span><span class="pn-mut">link →</span></div></div>` +
      `<span class="pn-edge">→</span>` +
      `<div class="pn-node"><div class="pn-node-h">${ic('table-2')}Companies</div><div class="pn-node-f"><span>Name</span><span class="pn-mut">text</span></div><div class="pn-node-f"><span>Tier</span><span class="pn-mut">select</span></div></div>` +
    `</div><p class="pn-er-note">ER diagram — pan / zoom canvas (static preview)</p></div>`,

  relationships:
    `<div class="pn-tb">${chip('All bases ▸ All tables')}${chip('Type')}${qchip('Linked', true)}${qchip('Rollup')}${qchip('Lookup')}${sp}${tgl('Include removed')}${seg(['Tree', 'Flat'], 'Flat')}${cnt('31')}</div>` +
    `<div class="pn-body">${tbl(['From', 'Type', 'To', 'Via field', ''], [
      [nm('table-2', 'Deals'), badge('Linked', 'info'), 'Contacts', '<span class="pn-mut">Primary contact</span>', ''],
      [nm('table-2', 'Deals'), badge('Rollup', 'info'), 'Contacts', '<span class="pn-mut">Contact count</span>', ''],
      [nm('table-2', 'Invoices'), badge('Lookup', 'info'), 'Deals', '<span class="pn-mut">Amount</span>', ''],
      [nm('table-2', 'Deals'), badge('Synced', 'off') + ' ' + badge('Inferred', 'warn'), 'Projects', '<span class="pn-mut">—</span>', mini('Confirm', 'ok') + mini('Dismiss', 'x')],
    ])}</div>`,

  automations:
    `<div class="pn-tb">${chip('Base')}${search('Search automations…')}${tgl('Include removed')}${sp}${btnP('New automation')}</div>` +
    `<div class="pn-body"><div class="pn-grouphdr">${nm('database', 'Sales CRM', 0, 'concept-ic-base')} <span class="pn-mut">· 3</span></div>${tbl(['Name', 'Status', 'Trigger', 'Tagged'], [
      ['Notify deal owner', badge('Active', 'ok'), '<span class="pn-mut">Record enters “Won”</span>', '2 tagged'],
      ['Weekly pipeline digest', badge('Inactive', 'off'), '<span class="pn-mut">Every Monday 9:00</span>', '1 tagged'],
      ['Sync to Slack', badge('Active', 'ok'), '<span class="pn-mut">Record updated</span>', '3 tagged'],
    ])}</div>`,

  interfaces:
    `<div class="pn-tb">${chip('Base')}${search('Search interfaces…')}${sp}${btnP('New interface')}</div>` +
    `<div class="pn-body">${tbl(['Name', 'Type', 'Status'], [
      [nm('database', 'Sales CRM', 0, 'concept-ic-base'), '<span class="pn-mut">Base</span>', ''],
      [nm('layout-panel-left', 'Pipeline', 1, 'concept-ic-interface'), '<span class="pn-mut">Interface · 2 pages</span>', badge('Published', 'ok')],
      [nm('file-text', 'Overview', 2, 'concept-ic-page'), '<span class="pn-mut">Page</span>', ''],
      [nm('file-text', 'Deal detail', 2, 'concept-ic-page'), '<span class="pn-mut">Page</span>', ''],
      [nm('layout-panel-left', 'Team hub', 1, 'concept-ic-interface'), '<span class="pn-mut">Interface · 1 page</span>', badge('Not published', 'off')],
    ])}</div>`,

  changelog:
    `<div class="pn-tb">${chip('Base')}${chip('Table')}${chip('Change type')}${sp}${chip('Last 30 days')}</div>` +
    `<div class="pn-body pn-feed">` +
      `<div class="pn-feed-day">Jul 2</div>` +
      `<div class="pn-feed-row"><span class="pn-feed-ic pn-fi-add">+</span><span>Field added · <b>Deals.Forecast</b></span></div>` +
      `<div class="pn-feed-row"><span class="pn-feed-ic pn-fi-ren">✎</span><span>Field renamed · <b>Amount → Deal Amount</b></span>${badge('Data change', 'warn')}</div>` +
      `<div class="pn-feed-row"><span class="pn-feed-ic pn-fi-rem">−</span><span>Table removed · <b>Archive</b></span>${badge('Data change', 'warn')}</div>` +
      `<div class="pn-feed-day">Jul 1</div>` +
      `<div class="pn-feed-row"><span class="pn-feed-ic pn-fi-cfg">⚙</span><span>Automation turned off · <b>Weekly pipeline digest</b></span></div>` +
    `</div>`,

  health:
    `<div class="pn-tb">${seg(['Sales CRM', 'Marketing', 'Operations'], 'Sales CRM')}${sp}${chip('Category')}</div>` +
    `<div class="pn-body pn-health">` +
      `<div class="pn-score"><span class="pn-score-n">78</span><span class="pn-score-d">/ 100</span><span class="pn-badge pn-badge-warn">Fair</span></div>` +
      `<div class="pn-cats">` +
        `<div class="pn-cat"><div class="pn-cat-t"><span>Descriptions</span><span class="pn-mut">62%</span></div><div class="pn-hbar"><span class="pn-hbar-fill" style="width:62%"></span></div></div>` +
        `<div class="pn-cat"><div class="pn-cat-t"><span>Structure</span><span class="pn-mut">90%</span></div><div class="pn-hbar"><span class="pn-hbar-fill pn-hbar-ok" style="width:90%"></span></div></div>` +
        `<div class="pn-cat"><div class="pn-cat-t"><span>Naming</span><span class="pn-mut">71%</span></div><div class="pn-hbar"><span class="pn-hbar-fill" style="width:71%"></span></div></div>` +
        `<div class="pn-issues"><div class="pn-feed-row"><span class="pn-feed-ic pn-fi-warn">!</span><span>18 fields missing descriptions</span></div><div class="pn-feed-row"><span class="pn-feed-ic pn-fi-warn">!</span><span>3 tables with no primary link</span></div></div>` +
      `</div>` +
    `</div>`,

  docs:
    `<div class="pn-tb">${search('Search docs…')}${chip('Tag')}${sp}${btnP('New doc')}</div>` +
    `<div class="pn-body">${tbl(['Title', 'Tags', 'Updated'], [
      [nm('file-text', 'Data model overview'), badge('Sales CRM', 'info') + ' ' + badge('Deals', 'info'), '<span class="pn-mut">Jul 1</span>'],
      [nm('file-text', 'Onboarding schema'), badge('Contacts', 'info'), '<span class="pn-mut">Jun 20</span>'],
      [nm('file-text', 'Formula reference'), badge('Weighted Value', 'info'), '<span class="pn-mut">Jun 12</span>'],
    ])}</div>`,
};
---

<SidebarLayout pageTitle="Schema navigation prototype" breadcrumbs={breadcrumbs}>
  <div class="pn" data-variant={v} data-mode="closed">
    {/* ── section header: freshness + persistent chat launcher ── */}
    <div class="pn-head">
      <div class="pn-head-l">
        <h1 class="pn-title">Schema</h1>
        <span class="pn-stamp"><span class="iconify lucide--history size-3.5"></span>Schema as of Jul 2 · Read-only</span>
      </div>
      <button type="button" class="pn-launcher" data-pn-open>
        <span class="iconify lucide--sparkles size-4"></span>Ask about your schema
        <kbd class="pn-kbd">⌘I</kbd>
      </button>
    </div>

    {/* ═══════════ BAR A — grouped: cluster label ABOVE each group's tabs ═══════════ */}
    <div class="pn-bar pn-bar-a" role="tablist" aria-label="Schema sections (grouped)">
      <div class="pn-group">
        <span class="pn-glabel">Explore</span>
        <div class="pn-gtabs">
          <button type="button" class="pn-tab is-on" data-tab data-panel="browse"><span class="iconify lucide--list-tree size-4"></span>Browse</button>
          <button type="button" class="pn-tab" data-tab data-panel="visualize"><span class="iconify lucide--workflow size-4"></span>Visualize</button>
          <button type="button" class="pn-tab" data-tab data-panel="relationships"><span class="iconify lucide--waypoints size-4"></span>Relationships</button>
        </div>
      </div>
      <span class="pn-div"></span>
      <div class="pn-group">
        <span class="pn-glabel">App layer</span>
        <div class="pn-gtabs">
          <button type="button" class="pn-tab" data-tab data-panel="automations"><span class="iconify lucide--zap size-4"></span>Automations</button>
          <button type="button" class="pn-tab" data-tab data-panel="interfaces"><span class="iconify lucide--layout-panel-left size-4"></span>Interfaces</button>
        </div>
      </div>
      <span class="pn-div"></span>
      <div class="pn-group">
        <span class="pn-glabel">Monitor</span>
        <div class="pn-gtabs">
          <button type="button" class="pn-tab" data-tab data-panel="changelog"><span class="iconify lucide--history size-4"></span>Changelog</button>
          <button type="button" class="pn-tab" data-tab data-panel="health"><span class="iconify lucide--heart-pulse size-4"></span>Health</button>
        </div>
      </div>
      <span class="pn-div"></span>
      <div class="pn-group">
        <span class="pn-glabel">Knowledge</span>
        <div class="pn-gtabs">
          <button type="button" class="pn-tab" data-tab data-panel="docs"><span class="iconify lucide--book-text size-4"></span>Docs</button>
        </div>
      </div>
    </div>

    {/* ═══════════ BAR B — two-level: clusters → sub-tabs ═══════════ */}
    <div class="pn-bar-b">
      <div class="pn-clusters" role="tablist" aria-label="Schema clusters">
        <button type="button" class="pn-cluster is-on" data-cluster="explore"><span class="iconify lucide--list-tree size-4"></span>Explore</button>
        <button type="button" class="pn-cluster" data-cluster="app"><span class="iconify lucide--zap size-4"></span>App layer</button>
        <button type="button" class="pn-cluster" data-cluster="monitor"><span class="iconify lucide--heart-pulse size-4"></span>Monitor</button>
        <button type="button" class="pn-cluster" data-cluster="knowledge"><span class="iconify lucide--book-text size-4"></span>Knowledge</button>
      </div>
      <div class="pn-subrow" data-sub="explore">
        <button type="button" class="pn-subtab is-on" data-tab data-panel="browse">Browse</button>
        <button type="button" class="pn-subtab" data-tab data-panel="visualize">Visualize</button>
        <button type="button" class="pn-subtab" data-tab data-panel="relationships">Relationships</button>
      </div>
      <div class="pn-subrow" data-sub="app" hidden>
        <button type="button" class="pn-subtab is-on" data-tab data-panel="automations">Automations</button>
        <button type="button" class="pn-subtab" data-tab data-panel="interfaces">Interfaces</button>
      </div>
      <div class="pn-subrow" data-sub="monitor" hidden>
        <button type="button" class="pn-subtab is-on" data-tab data-panel="changelog">Changelog</button>
        <button type="button" class="pn-subtab" data-tab data-panel="health">Health</button>
      </div>
      <div class="pn-subrow" data-sub="knowledge" hidden>
        <button type="button" class="pn-subtab is-on" data-tab data-panel="docs">Docs</button>
      </div>
    </div>

    {/* ── work area: one light, static screen per tab (filter placement is the point) ── */}
    <div class="pn-work">
      <main class="pn-main">
        {Object.entries(PANEL).map(([key, html]) => (
          <section class="pn-panel" data-panel={key} hidden={key !== 'browse'} set:html={html} />
        ))}
      </main>
    </div>

    {/* ── Chat: modal side-drawer (both variants); Expand → full page ── */}
    <div class="pn-scrim" data-pn-close></div>
    <aside class="pn-drawer" aria-label="Schema assistant">
      <div class="pn-cpanel">
        <div class="pn-cpanel-top">
          <span class="pn-cpanel-title"><span class="iconify lucide--sparkles size-4"></span>Schema assistant</span>
          <div class="pn-cpanel-acts">
            <button type="button" class="pn-icobtn" data-pn-expand aria-label="Expand to full page" title="Expand"><span class="iconify lucide--arrow-up-right size-4"></span></button>
            <button type="button" class="pn-icobtn" data-pn-close aria-label="Close"><span class="iconify lucide--x size-4"></span></button>
          </div>
        </div>
        <div class="pn-cpanel-scope"><span class="pn-scopechip"><span class="iconify lucide--database size-3.5"></span>Whole Space</span></div>
        <div class="pn-convo" set:html={CONVO_HTML}></div>
        <div class="pn-composer">
          <div class="pn-composer-box">
            <div class="pn-input-fake">Ask about your schema…</div>
            <div class="pn-composer-bar">
              <span class="pn-addctx"><span class="iconify lucide--plus size-3.5"></span>Add context</span>
              <span class="pn-credits"><span class="iconify lucide--zap size-3.5"></span>~2 credits</span>
              <span class="pn-send"><span class="iconify lucide--arrow-up size-4"></span></span>
            </div>
          </div>
        </div>
      </div>
    </aside>

    {/* ── Full page (shared Expand target): the rich 3-column chat ── */}
    <div class="pn-full" aria-label="Schema assistant — full view">
      <div class="pn-full-rail">
        <div class="pn-full-newbtn"><span class="iconify lucide--plus size-4"></span>New chat</div>
        <div class="pn-trow is-on"><span class="iconify lucide--message-square size-3.5"></span>Undocumented fields in Sales CRM<span class="pn-trow-when">Jul 2</span></div>
        <div class="pn-trow"><span class="iconify lucide--message-square size-3.5"></span>What links to Companies?<span class="pn-trow-when">Jul 1</span></div>
        <div class="pn-trow"><span class="iconify lucide--message-square size-3.5"></span>Formula fields overview<span class="pn-trow-when">Jun 28</span></div>
      </div>
      <div class="pn-full-main">
        <div class="pn-full-top">
          <span class="pn-full-thread">Undocumented fields in Sales CRM</span>
          <div class="pn-cpanel-acts">
            <span class="pn-convert"><span class="iconify lucide--file-text size-3.5"></span>Convert to doc</span>
            <button type="button" class="pn-icobtn" data-pn-collapse aria-label="Collapse to panel" title="Collapse"><span class="iconify lucide--x size-4"></span></button>
          </div>
        </div>
        <div class="pn-convo pn-convo-wide" set:html={CONVO_HTML}></div>
        <div class="pn-composer pn-composer-wide">
          <div class="pn-composer-box">
            <div class="pn-input-fake">Ask about your schema…</div>
            <div class="pn-composer-bar">
              <span class="pn-addctx"><span class="iconify lucide--plus size-3.5"></span>Add context</span>
              <span class="pn-credits"><span class="iconify lucide--zap size-3.5"></span>~2 credits / message</span>
              <span class="pn-send"><span class="iconify lucide--arrow-up size-4"></span></span>
            </div>
          </div>
        </div>
      </div>
      <div class="pn-full-ctx">
        <div class="pn-full-ctx-h">Context</div>
        <span class="pn-scopechip"><span class="iconify lucide--database size-3.5"></span>Sales CRM</span>
        <span class="pn-scopechip"><span class="iconify lucide--table-2 size-3.5"></span>Deals</span>
      </div>
    </div>

    {/* ── floating variant switcher (scenario-switcher pattern) ── */}
    <div class="pn-switch" role="radiogroup" aria-label="Prototype variant">
      <span class="pn-switch-label">Nav variant</span>
      <button type="button" class="pn-switch-btn is-on" data-set-variant="a">
        <span class="pn-switch-key">A</span>
        <span class="pn-switch-meta"><b>Grouped bar</b><i>dividers + labels</i></span>
      </button>
      <button type="button" class="pn-switch-btn" data-set-variant="b">
        <span class="pn-switch-key">B</span>
        <span class="pn-switch-meta"><b>Two-level</b><i>clusters → sub-tabs</i></span>
      </button>
    </div>
  </div>
</SidebarLayout>

<style is:global>
  /* scoped-ish: everything under .pn, `.pn-`-prefixed. is:global so set:html'd
     conversation markup is styled too. Throwaway prototype CSS. */
  .pn { position: relative; display: flex; flex-direction: column; min-height: calc(100dvh - 130px); }

  .pn-head { display: flex; align-items: center; gap: 1rem; margin-bottom: .9rem; flex: none; }
  .pn-head-l { display: flex; align-items: baseline; gap: .7rem; min-width: 0; }
  .pn-title { font-size: 1.4rem; font-weight: 650; letter-spacing: -.01em; }
  .pn-stamp { display: inline-flex; align-items: center; gap: .35rem; font-size: .78rem; color: oklch(from var(--color-base-content) l c h / .5); }
  .pn-stamp .iconify { opacity: .7; }
  .pn-launcher { margin-left: auto; display: inline-flex; align-items: center; gap: .45rem; font-size: .85rem; font-weight: 550; padding: .42rem .7rem .42rem .6rem; border-radius: 999px; border: 1px solid color-mix(in oklch, var(--color-primary) 40%, var(--color-base-300)); color: var(--color-primary); background: color-mix(in oklch, var(--color-primary) 7%, var(--color-base-100)); cursor: pointer; }
  .pn-launcher:hover { background: color-mix(in oklch, var(--color-primary) 13%, var(--color-base-100)); }
  .pn-kbd { font-size: .66rem; font-family: ui-monospace, monospace; border: 1px solid color-mix(in oklch, var(--color-primary) 35%, var(--color-base-300)); border-radius: 5px; padding: 0 .3rem; opacity: .8; }

  /* ── Bar A: grouped — cluster label sits ABOVE each group's tab row ── */
  .pn-bar { display: flex; align-items: stretch; gap: .1rem; flex-wrap: wrap; border-bottom: 1px solid var(--color-base-300); flex: none; }
  .pn-group { display: flex; flex-direction: column; }
