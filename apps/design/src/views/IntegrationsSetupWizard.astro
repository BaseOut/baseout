  .switch-confirm-title { font-size: .85rem; font-weight: 650; }
  .switch-confirm-sub { font-size: .76rem; color: oklch(from var(--color-base-content) l c h / .65); margin-top: .1rem; }
  .switch-confirm-actions { display: flex; gap: .5rem; flex: none; align-self: center; }
  .bases-reset-note { display: flex; align-items: center; gap: .5rem; margin-bottom: .75rem; padding: .5rem .75rem; font-size: .78rem; border-radius: .5rem; color: oklch(from var(--color-base-content) l c h / .8); background: oklch(from var(--color-primary) l c h / .08); border: 1px solid oklch(from var(--color-primary) l c h / .22); }
  .bases-reset-note[hidden] { display: none; }
  .bases-reset-note .iconify { font-size: .95rem; flex: none; color: var(--color-primary); }

