  /* Radio option rows (source + destination pickers) */
  .opt-options { display: grid; gap: .5rem; }
  .opt-opt { display: flex; align-items: center; gap: .75rem; padding: .5rem .75rem; border: 1px solid var(--color-base-300); border-radius: .55rem; cursor: pointer; transition: border-color .12s ease, background .12s ease; }
  .opt-opt:hover { background: oklch(from var(--color-base-200) l c h / .5); }
