  .opt-row-sub { display: block; font-size: 0.75rem; color: oklch(from var(--color-base-content) l c h / .66); margin-top: .05rem; }

  /* Cleanup schedule — the retention ladder for the selected frequency */
  .cleanup { border: 1px solid var(--color-base-300); border-radius: .7rem; background: var(--color-base-100); padding: .75rem 1rem 1rem; }
  .cleanup-lead { font-size: .82rem; color: oklch(from var(--color-base-content) l c h / .7); }
  .cleanup-ladder { display: flex; flex-direction: column; gap: .25rem; margin-top: .5rem; }
  .cleanup-tier { display: flex; align-items: center; gap: .5rem; font-size: .85rem; font-weight: 500; }
  .cleanup-tier-n { width: 1.5rem; height: 1.5rem; border-radius: 999px; display: grid; place-items: center; flex: none; font-size: .72rem; font-weight: 700; background: oklch(from var(--color-primary) l c h / .14); color: var(--color-primary); }
  .cleanup-cutoff { display: flex; align-items: center; gap: .5rem; flex-wrap: wrap; margin-top: .75rem; padding-top: .75rem; border-top: 1px solid oklch(from var(--color-base-300) l c h / .6); }
  .cleanup-cutoff-k { font-size: .82rem; color: oklch(from var(--color-base-content) l c h / .7); }

  /* Review step */
  .review-pipe { display: flex; align-items: stretch; gap: .25rem; }
