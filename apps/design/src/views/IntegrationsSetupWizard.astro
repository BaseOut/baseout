  .add-field { display: flex; flex-direction: column; gap: .25rem; }
  .add-label { font-size: .8125rem; font-weight: 600; }
  .add-hint { font-size: 0.75rem; color: oklch(from var(--color-base-content) l c h / .66); }
  .add-hint code { font-size: 0.75rem; padding: .05rem .25rem; border-radius: 4px; background: oklch(from var(--color-base-content) l c h / .07); }
  /* "Required" / "Recommended" / "Managed" + the managed note are catalog badges / alerts now. */
  .method-tabs { display: flex; gap: .25rem; padding: .25rem; border-radius: .6rem; background: oklch(from var(--color-base-200) l c h / .7); margin-top: .5rem; }
  .method-tab { flex: 1; cursor: pointer; }
  .method-tab > span { display: block; padding: .5rem .75rem; border-radius: .45rem; text-align: center; font-size: .8125rem; font-weight: 600; color: oklch(from var(--color-base-content) l c h / .6); transition: background .15s ease, color .15s ease; }
  .method-tab:has(input:checked) > span { background: var(--color-base-100); color: var(--color-base-content); box-shadow: 0 1px 2px oklch(from var(--color-base-content) l c h / .08); }
  .connect:has(input[value="oauth"]:checked) [data-src-method="pat"] { display: none; }
  .connect:has(input[value="pat"]:checked) [data-src-method="oauth"] { display: none; }

  .dtype-grid { display: grid; grid-template-columns: 1fr 1fr; gap: .5rem; }
  .dtype { display: flex; align-items: center; gap: .5rem; padding: .5rem .75rem; border: 1px solid var(--color-base-300); border-radius: .6rem; background: var(--color-base-100); cursor: pointer; text-align: left; transition: border-color .12s ease, background .12s ease; }
  .dtype:hover { border-color: oklch(from var(--color-primary) l c h / .5); background: oklch(from var(--color-primary) l c h / .04); }
  .dtype-ic { width: 2rem; height: 2rem; border-radius: .5rem; display: grid; place-items: center; background: oklch(from var(--color-base-200) l c h / .8); flex: none; }
  .dtype-ic .iconify { font-size: 1rem; color: oklch(from var(--color-base-content) l c h / .7); }
  .dtype-ic-db { background: oklch(from var(--color-primary) l c h / .1); }
  .dtype-ic-db .iconify { color: var(--color-primary); }
  .dtype-name { display: flex; align-items: center; gap: .25rem; font-size: .82rem; font-weight: 600; }
  .dtype-note { display: block; font-size: 0.75rem; color: oklch(from var(--color-base-content) l c h / .66); }

  /* Inline reconnect (broken row → reconnect in place) is a catalog btn-sm btn-warning;
     the reconnect drawer's broken-object card is a catalog alert. */

  /* Source-change → base-reset heads-up */
  .switch-confirm { display: flex; align-items: flex-start; gap: .75rem; margin-top: .75rem; padding: .75rem; border: 1px solid oklch(from var(--color-warning) l c h / .35); border-radius: .6rem; background: oklch(from var(--color-warning) l c h / .08); }
  .switch-confirm[hidden] { display: none; }
  .switch-confirm-ic { width: 2rem; height: 2rem; border-radius: .45rem; display: grid; place-items: center; background: oklch(from var(--color-warning) l c h / .15); flex: none; }
