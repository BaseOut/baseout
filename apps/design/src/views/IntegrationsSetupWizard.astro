---
/**
 * IntegrationsSetupWizard — the per-Space backup setup, as a left-to-right
 * stepper that fits the account-level model (Sources / Destinations are reusable
 * account objects; this Space references them).
 *
 * Steps: Source → Bases → Destination → Options (depth + schedule) → Review.
 *
 * Empty-first: when the account has no Sources / Destinations yet, the Source and
 * Destination steps open on a "connect your first…" card whose button opens a
 * right-hand DRAWER to create one inline — the wizard never unmounts, and the new
 * object is auto-selected on success (prototype simulates the create client-side).
 *
 * Decisions baked in (founder + our edge analysis): one Source per Space; changing
 * the Source resets the base selection; reconnect happens in-context; no draft of
 * an abandoned wizard. Destination = 1 file (required) + 1 optional database.
 */
import BaseSelectionTable from '../components/integrations/BaseSelectionTable.astro';
import BackupScheduleScope from '../components/backups/BackupScheduleScope.astro';
import Drawer from '../components/ui/Drawer.astro';
import type { IntegrationsState } from '../stores/connections';
import type { SourceSummary } from '../stores/sources';
import type { DestinationSummary } from '../stores/destinations';

interface Props {
  state: IntegrationsState;
  sources?: SourceSummary[];
  destinations?: DestinationSummary[];
  /** 'setup' = first-run gated stepper; 'edit' = free tabs + Save (reached via Configure). */
  mode?: 'setup' | 'edit';
}
const { state, sources = [], destinations = [], mode = 'setup' } = Astro.props;
const isEdit = mode === 'edit';

const spaceName = Astro.locals.account?.space?.id ? (Astro.locals.account?.space?.name ?? 'this Space') : 'this Space';
const spaceId = Astro.locals.account?.space?.id ?? '';
const cap = state.tierBasesPerSpace;
const bases = state.bases;

const fileDestinations = destinations.filter((d) => d.kind === 'file');
const dbDestinations = destinations.filter((d) => d.kind === 'database');
const noSources = sources.length === 0;
const noFileDest = fileDestinations.length === 0;

// Catalog soft badge for the option's connection status. `opt-chip` stays as a
// stable JS hook class; the badge-* classes carry the visual + the broken-state
// signal the wiring below reads (.opt-chip.badge-warning).
const statusChip = (s: string) =>
  s === 'connected'
    ? { cls: 'badge badge-soft badge-success', label: 'Connected' }
    : { cls: 'badge badge-soft badge-warning', label: s === 'needs_connection' ? 'Needs connection' : 'Lost access' };
// Action verb for the inline reconnect button on a non-connected row.
const reconnectLabel = (s: string) => (s === 'needs_connection' ? 'Connect' : 'Reconnect');

// Real service logos for known destination providers (the rest fall back to a Lucide
// icon — we don't fabricate a logo for our own R2 or for databases we have no mark for).
const destLogo: Record<string, string> = {
  google_drive: '/brands/google-drive.svg',
  dropbox: '/brands/dropbox.svg',
  s3: '/brands/aws.svg',
};

// `icon` is only read by the edit-mode tab bar (the Schema tab recipe = leading Lucide
// glyph + label). Every name below appears here as STATIC markup, so Tailwind's scanner
// emits the mask — do not move any of them into an innerHTML string.
const ALL_STEPS = [
  { key: 'source', label: 'Source', icon: 'lucide--plug' },
  { key: 'bases', label: 'Bases', icon: 'lucide--table-2' },
  { key: 'dest', label: 'Destination', icon: 'lucide--hard-drive' },
  { key: 'options', label: 'Options', icon: 'lucide--sliders-horizontal' },
  { key: 'review', label: 'Review', icon: 'lucide--clipboard-check' },
];
// Edit mode has no Review/Run step — you jump between tabs and Save.
const STEPS = isEdit ? ALL_STEPS.filter((s) => s.key !== 'review') : ALL_STEPS;

const FREQS = [
  { value: 'monthly', label: 'Monthly', helper: 'One scheduled backup per month' },
  { value: 'weekly', label: 'Weekly', helper: 'One scheduled backup per week' },
  { value: 'daily', label: 'Daily', helper: 'One scheduled backup per day' },
  { value: 'instant', label: 'Instant', helper: 'Webhook-driven — captures changes as they happen' },
];

// Cleanup schedule = tiered rolling retention, keyed to the backup frequency (On2Air
// model). Older versions are progressively thinned (daily→weekly→monthly) so storage
// stays bounded; whatever is older than the max-retention cutoff is removed.
const CLEANUP_TIERS: Record<string, string[]> = {
  monthly: ['Monthly versions kept'],
  weekly: ['3 months of weekly backups', 'then monthly'],
  daily: ['30 days of daily backups', 'then 2 months of weekly', 'then monthly'],
  instant: ['3 days of continuous backups', 'then 27 days of daily', 'then 2 months of weekly', 'then monthly'],
};
const freqLabel = (v: string) => FREQS.find((f) => f.value === v)?.label ?? 'Monthly';
const initialFreq = state.policy.frequency;
const initialTiers = CLEANUP_TIERS[initialFreq] ?? CLEANUP_TIERS.monthly;
---

<div class="mx-auto max-w-5xl space-y-6" data-wizard data-mode={mode}>
  {/* Header */}
  <div>
    <a href="/" class="back-link"><span class="iconify lucide--arrow-left"></span> Home</a>
    <h1 class="text-title mt-3">{isEdit ? "Edit this Space's backup" : "Set up this Space's backup"}</h1>
    <p class="text-sm text-base-content/60 mt-1">{isEdit ? 'Change the source, bases, destination or schedule — jump between tabs in any order' : 'Pick a source, the bases to protect, and where they go'} — for <span class="font-medium text-base-content/80">{spaceName}</span>.</p>
  </div>

  <div class="tabs-shell" data-tabs>
    {/* Nav bar: free tabs (edit) or a gated stepper (setup) + the primary action */}
    <div class="bar">
      {isEdit ? (
        <div class="sch-tabbar flex-1" role="tablist" aria-label="Backup settings sections">
          <div class="sch-gtabs tabs tabs-border">
            {STEPS.map((s, i) => (
              <button type="button" class={`tab${i === 0 ? ' tab-active' : ''}`} role="tab" aria-selected={i === 0 ? 'true' : 'false'} data-tab={s.key}>
                <span class={`iconify ${s.icon} size-4`} aria-hidden="true"></span>{s.label}
              </button>
            ))}
          </div>
        </div>
      ) : (
        <ol class="stepper" data-stepper>
          {STEPS.map((s, i) => (
            <li class="step" data-step-nav={s.key} data-index={i}>
              <span class="step-dot"><span class="step-num">{i + 1}</span><span class="iconify lucide--check step-check"></span></span>
              <span class="step-label">{s.label}</span>
            </li>
          ))}
        </ol>
      )}
      <div class="bar-actions">
        {isEdit ? (
          <>
            <a href="/" class="btn btn-sm btn-ghost">Cancel</a>
            <button type="button" class="btn btn-sm btn-primary" data-save-edit><span class="iconify lucide--check size-4" aria-hidden="true"></span>Save changes</button>
          </>
        ) : (
          <>
            <button type="button" class="btn btn-sm btn-ghost" data-step-back hidden><span class="iconify lucide--arrow-left size-4"></span> Back</button>
            <button type="button" class="btn btn-sm btn-primary" data-step-next>Next</button>
          </>
        )}
      </div>
    </div>

    <div class="tab-body">
      <div class="step-hint alert alert-soft alert-warning" data-step-hint hidden role="status">
        <span class="iconify lucide--circle-alert size-4 shrink-0" aria-hidden="true"></span>
        <span class="flex-1" data-step-hint-text></span>
      </div>

      {/* STEP 1 — SOURCE */}
      <section class={`tab-panel panel-source${noSources ? ' is-empty' : ''}`} data-step="source" data-picker="source">
        <div class="panel-head"><h2>Where does this Space back up from?</h2><p>Pick or connect one Airtable source to continue — a Space backs up from exactly one. Connect once on your account, reuse across Spaces.</p></div>

        <div class="picker-empty" data-picker-empty>
          <span class="picker-empty-ic"><img src="/airtable.svg" alt="" width="26" height="26" /></span>
          <div class="min-w-0">
            <p class="picker-empty-title">No Airtable source yet</p>
            <p class="picker-empty-sub">Baseout reads your bases read-only. Connect an account to continue.</p>
          </div>
          <button type="button" class="btn btn-sm btn-primary shrink-0 ml-auto" data-open-drawer="source"><span class="iconify lucide--plug size-4" aria-hidden="true"></span>Connect Airtable</button>
        </div>

        <fieldset class="opt-options" data-picker-list>
          <legend class="sr-only">Source</legend>
          {sources.map((s, i) => {
            const chip = statusChip(s.status);
            return (
              <label class="opt-opt">
                <input type="radio" name="wz-source" value={s.id} checked={i === 0} class="radio radio-sm radio-primary" data-source-radio />
                <span class="opt-ic"><img src="/airtable.svg" alt="" width="18" height="18" /></span>
                <span class="min-w-0 flex-1">
                  <span class="opt-name">{s.name}</span>
                  <span class="opt-sub">{s.account} · {s.basesAvailable} bases</span>
                </span>
                <span class={`opt-chip ${chip.cls}`}><span class="size-1.5 rounded-full bg-current"></span>{chip.label}</span>
                {s.status !== 'connected' && (
                  <button type="button" class="btn btn-sm btn-warning" data-reconnect="source" data-reconnect-auth={s.auth === 'pat' ? 'secret' : 'oauth'} data-reconnect-secret-label="Personal access token"><span class="iconify lucide--rotate-cw size-4"></span>{reconnectLabel(s.status)}</button>
                )}
              </label>
            );
          })}
        </fieldset>
        <button type="button" class="btn btn-sm btn-ghost text-primary self-start mt-1" data-open-drawer="source" data-picker-add><span class="iconify lucide--plus size-4" aria-hidden="true"></span>Add another source</button>

        {/* Heads-up before a source switch clears the base selection (bases belong to a source) */}
        <div class="switch-confirm" data-switch-confirm hidden>
          <span class="switch-confirm-ic"><span class="iconify lucide--info"></span></span>
          <div class="min-w-0 flex-1">
            <p class="switch-confirm-title">Switch to <span data-switch-name>—</span>?</p>
            <p class="switch-confirm-sub">Bases belong to a source. Your <span data-switch-count>0</span> selected base<span data-switch-plural></span> will be cleared so you don't back up the wrong ones.</p>
          </div>
          <div class="switch-confirm-actions">
            <button type="button" class="btn btn-ghost btn-sm" data-switch-cancel>Keep current</button>
            <button type="button" class="btn btn-warning btn-sm" data-switch-go>Switch &amp; clear</button>
          </div>
        </div>
      </section>

      {/* STEP 2 — BASES */}
      <section class="tab-panel panel-bases" data-step="bases">
        <div class="panel-head"><h2>Which bases to back up</h2><p>Pick the bases this Space protects — at least one to continue. Search, sort, or select all up to your plan limit.</p></div>
        <p class="bases-reset-note" data-bases-reset-note hidden><span class="iconify lucide--info"></span> Base selection cleared — these are the bases for <span class="font-medium" data-bases-reset-name>—</span>. Pick the ones to back up.</p>
        {bases.length > 0 ? (
          <BaseSelectionTable
            bases={bases}
            cap={cap}
            spaceId={spaceId}
            embedded={true}
            enrolledWorkspaces={state.enrolledWorkspaces}
            autoEnrollNewWorkspaces={state.autoEnrollNewWorkspaces}
            wsResolve={state.wsResolve}
            wsResolvedCount={state.wsResolvedCount}
            wsTotalCount={state.wsTotalCount}
            groupByWorkspace={state.groupByWorkspace}
            workspaceAliases={state.workspaceAliases}
          />
        ) : (
          <p class="text-sm text-base-content/60">The selected source didn't reveal any bases. <button type="button" class="link link-hover font-medium" data-open-drawer="source">Pick another source</button>.</p>
        )}
      </section>

      {/* STEP 3 — DESTINATION */}
      <section class={`tab-panel panel-dest${noFileDest ? ' is-empty' : ''}`} data-step="dest" data-picker="dest">
        <div class="panel-head"><h2>Where do backups go?</h2><p>A file store is required; a database is an optional extra you can add now or later.</p></div>

        <div class="picker-empty" data-picker-empty>
          <span class="picker-empty-ic"><span class="iconify lucide--square-arrow-right-enter"></span></span>
          <div class="min-w-0">
            <p class="picker-empty-title">No destination yet</p>
            <p class="picker-empty-sub">Pick storage you control — Google Drive, S3, Dropbox, or managed Baseout R2.</p>
          </div>
          <button type="button" class="btn btn-sm btn-primary shrink-0 ml-auto" data-open-drawer="dest"><span class="iconify lucide--plug size-4" aria-hidden="true"></span>Add a destination</button>
        </div>

        <div class="dest-groups" data-picker-list>
          <div class="dest-group">
            <div class="dest-group-head"><span class="dest-group-title">File storage</span><span class="badge badge-soft badge-error badge-sm">Required</span></div>
            <fieldset class="opt-options" data-dest-file>
              <legend class="sr-only">File destination</legend>
              {fileDestinations.map((d, i) => {
                const chip = statusChip(d.status);
                return (
                  <label class="opt-opt">
                    <input type="radio" name="wz-dest-file" value={d.id} checked={i === 0} class="radio radio-sm radio-primary" data-dest-file-radio />
                    <span class="opt-ic">{destLogo[d.provider] ? <img src={destLogo[d.provider]} alt="" width="18" height="18" /> : <span class="iconify lucide--hard-drive"></span>}</span>
                    <span class="min-w-0 flex-1">
                      <span class="opt-name">{d.name}</span>
                      <span class="opt-sub">{d.providerLabel} · {d.detail}</span>
                    </span>
                    <span class={`opt-chip ${chip.cls}`}><span class="size-1.5 rounded-full bg-current"></span>{chip.label}</span>
                    {d.status !== 'connected' && (
                      <button type="button" class="btn btn-sm btn-warning" data-reconnect="dest" data-reconnect-auth="oauth"><span class="iconify lucide--rotate-cw size-4"></span>{reconnectLabel(d.status)}</button>
                    )}
                  </label>
                );
              })}
            </fieldset>
          </div>

          <div class="dest-group">
            <div class="dest-group-head"><span class="dest-group-title">Database</span><span class="badge badge-soft badge-primary badge-sm">Recommended</span></div>
            <p class="dest-blurb">Query your backup with SQL and power live dashboards. Optional — your file backup runs without it.</p>
            <fieldset class="opt-options" data-dest-db>
              <legend class="sr-only">Database destination</legend>
              {dbDestinations.map((d) => {
                const chip = statusChip(d.status);
                return (
                  <label class="opt-opt">
                    <input type="radio" name="wz-dest-db" value={d.id} class="radio radio-sm radio-primary" data-dest-db-radio />
                    <span class="opt-ic opt-ic-db"><span class="iconify lucide--database"></span></span>
                    <span class="min-w-0 flex-1">
                      <span class="opt-name">{d.name}</span>
                      <span class="opt-sub">{d.providerLabel} · {d.detail}</span>
                    </span>
                    <span class={`opt-chip ${chip.cls}`}><span class="size-1.5 rounded-full bg-current"></span>{chip.label}</span>
                    {d.status !== 'connected' && (
                      <button type="button" class="btn btn-sm btn-warning" data-reconnect="dest" data-reconnect-auth="secret" data-reconnect-secret-label="Connection string"><span class="iconify lucide--rotate-cw size-4"></span>{reconnectLabel(d.status)}</button>
                    )}
                  </label>
                );
              })}
              <label class="opt-opt opt-skip">
                <input type="radio" name="wz-dest-db" value="" checked class="radio radio-sm radio-primary" data-dest-db-radio />
                <span class="min-w-0 flex-1"><span class="opt-name">Skip for now</span><span class="opt-sub">Add a database later from Destinations.</span></span>
              </label>
            </fieldset>
          </div>

          <button type="button" class="btn btn-sm btn-ghost text-primary self-start mt-1" data-open-drawer="dest"><span class="iconify lucide--plus size-4" aria-hidden="true"></span>Add a custom destination</button>
        </div>
        <p class="dest-folder-note" data-dest-folder>Each backup writes to <span class="font-medium">/Baseout/{spaceName}</span> in the destination you pick.</p>
      </section>

      {/* STEP 4 — OPTIONS (depth + schedule) */}
      <section class="tab-panel panel-options" data-step="options">
        <div class="panel-head"><h2>What gets backed up, and how often</h2><p>Choose the depth of each backup and the schedule.</p></div>

        <BackupScheduleScope
          recordData={state.policy.recordData ?? (state.policy.scope !== 'schema-only')}
          attachments={state.policy.attachments ?? false}
          schemaTied={state.policy.schemaTied ?? true}
          dataFrequency={state.policy.dataFrequency ?? state.policy.frequency}
          schemaFrequency={state.policy.schemaFrequency ?? 'daily'}
          availableFrequencies={state.availableFrequencies}
          nextDataAt={state.policy.nextDataAt ?? state.policy.nextScheduledAt}
          nextSchemaAt={state.policy.nextSchemaAt ?? null}
        />

        {/* Cleanup schedule — tiered retention keyed to the frequency above. */}
        <h3 class="opt-subhead mt-5">Cleanup schedule</h3>
        <div role="alert" class="alert alert-soft alert-info">
          <span class="iconify lucide--info size-4" aria-hidden="true"></span>
          <span>Older backup versions are thinned automatically so storage stays in check — recent backups are kept in full; as they age we keep them less often.</span>
        </div>
        <div class="cleanup mt-3" data-cleanup data-tiers={JSON.stringify(CLEANUP_TIERS)}>
          <p class="cleanup-lead">With <span class="font-semibold text-base-content" data-cleanup-freq>{freqLabel(initialFreq)}</span> backups we keep:</p>
          <ol class="cleanup-ladder" data-cleanup-ladder>
            {initialTiers.map((t, i) => (
              <li class="cleanup-tier"><span class="cleanup-tier-n">{i + 1}</span>{t}</li>
            ))}
          </ol>
          <label class="cleanup-cutoff">
            <span class="cleanup-cutoff-k">Then remove anything older than</span>
            <select class="select select-sm w-auto" data-cleanup-cutoff aria-label="Maximum retention">
              <option value="1">1 year</option>
              <option value="2">2 years</option>
              <option value="5" selected>5 years</option>
              <option value="0">never (keep forever)</option>
            </select>
          </label>
        </div>
      </section>

      {/* STEP 5 — REVIEW */}
      <section class="tab-panel panel-review" data-step="review">
        <div class="panel-head"><h2>Review and run</h2><p>This is what your Space will back up. We run the first backup right after.</p></div>
        <div class="review-pipe">
          <div class="review-node">
            <span class="review-node-k">Source</span>
            <span class="review-node-v"><img src="/airtable.svg" alt="" class="review-mark" /><span data-review-source>—</span></span>
          </div>
          <span class="review-link" aria-hidden="true"><span class="review-link-badge"><span class="iconify lucide--check"></span></span></span>
          <div class="review-node">
            <span class="review-node-k">Backs up</span>
            <span class="review-node-v"><span class="iconify lucide--table review-mark-ic"></span><span data-review-bases>—</span></span>
          </div>
          <span class="review-link" aria-hidden="true"><span class="review-link-badge"><span class="iconify lucide--check"></span></span></span>
          <div class="review-node">
            <span class="review-node-k">Destination</span>
            <span class="review-node-v"><span class="iconify lucide--hard-drive review-mark-ic"></span><span data-review-dest>—</span></span>
          </div>
        </div>
        <div class="review-meta">
          <div class="review-meta-item"><span class="review-meta-k">Schedule</span><span class="review-meta-v" data-review-schedule>—</span></div>
          <div class="review-meta-item"><span class="review-meta-k">Depth</span><span class="review-meta-v" data-review-depth>—</span></div>
          <div class="review-meta-item"><span class="review-meta-k">Folder</span><span class="review-meta-v">/Baseout/{spaceName}</span></div>
          <div class="review-meta-item"><span class="review-meta-k">Auto-add</span><span class="review-meta-v" data-review-autoadd>—</span></div>
        </div>
      </section>
    </div>
  </div>

  <p class="text-xs hidden mt-2 text-right" data-save-status role="status" aria-live="polite"></p>

  {/* ───────── DRAWERS (inline create) ───────── */}

  {/* Source drawer */}
  <Drawer id="wz-drawer-source" title="Add an Airtable source" subtitle="Connect once, reuse across Spaces. Read-only access.">
    <label class="add-field">
      <span class="add-label">Name</span>
      <input type="text" data-src-name placeholder="e.g. Ops Airtable" class="input input-sm input-bordered w-full" />
      <span class="add-hint">A label to tell this connection apart from other Airtable accounts.</span>
    </label>
    <div class="connect" data-src-connect>
      <span class="add-label">Connection method</span>
      <div role="tablist" class="method-tabs">
        <label class="method-tab"><input type="radio" name="wz-src-method" value="oauth" class="sr-only" checked /><span>OAuth</span></label>
        <label class="method-tab"><input type="radio" name="wz-src-method" value="pat" class="sr-only" /><span>Personal access token</span></label>
      </div>
      <div data-src-method="oauth" class="mt-4">
        <p class="add-hint">You approve read-only access on Airtable in a popup, then return here — the wizard stays open.</p>
      </div>
      <div data-src-method="pat" class="mt-4">
        <label class="block"><span class="add-label">Personal access token</span>
          <input type="password" data-src-token placeholder="pat••••••••••••••" autocomplete="off" class="input input-sm input-bordered w-full font-mono text-sm mt-2" /></label>
        <p class="add-hint mt-2">A read-only token with <code>data.records:read</code> and <code>schema.bases:read</code> scopes.</p>
      </div>
    </div>
    <Fragment slot="footer">
      <label for="wz-drawer-source" class="btn btn-sm btn-ghost">Cancel</label>
      <button type="button" class="btn btn-sm btn-primary" data-src-create><span class="iconify lucide--plug size-4" aria-hidden="true"></span>Test &amp; create</button>
    </Fragment>
  </Drawer>

  {/* Destination drawer (pick type → configure). Title/sub are updated by JS via
      the panel's .sb-drawer-title / .sb-drawer-sub once a type is picked. */}
  <Drawer id="wz-drawer-dest" title="Add a destination" subtitle="Pick where backups go. Reusable across Spaces.">
    {/* type picker */}
    <div data-dest-pick>
      <p class="add-label mb-2">File storage <span class="badge badge-soft badge-error badge-sm">Required</span></p>
      <div class="dtype-grid">
        <button type="button" class="dtype" data-dtype="r2" data-kind="file" data-label="Baseout R2" data-managed="1"><span class="dtype-ic"><span class="iconify lucide--box"></span></span><span class="min-w-0"><span class="dtype-name">Baseout R2 <span class="badge badge-soft badge-success badge-sm">Managed</span></span><span class="dtype-note">Zero setup</span></span></button>
        <button type="button" class="dtype" data-dtype="google_drive" data-kind="file" data-label="Google Drive"><span class="dtype-ic"><img src="/brands/google-drive.svg" alt="" width="18" height="18" /></span><span class="min-w-0"><span class="dtype-name">Google Drive</span><span class="dtype-note">Your own Drive</span></span></button>
        <button type="button" class="dtype" data-dtype="dropbox" data-kind="file" data-label="Dropbox"><span class="dtype-ic"><img src="/brands/dropbox.svg" alt="" width="18" height="18" /></span><span class="min-w-0"><span class="dtype-name">Dropbox</span><span class="dtype-note">Your own Dropbox</span></span></button>
        <button type="button" class="dtype" data-dtype="s3" data-kind="file" data-label="Amazon S3"><span class="dtype-ic"><img src="/brands/aws.svg" alt="" width="18" height="18" /></span><span class="min-w-0"><span class="dtype-name">Amazon S3</span><span class="dtype-note">Your own bucket</span></span></button>
      </div>
      <p class="add-label mb-2 mt-4">Database <span class="badge badge-soft badge-primary badge-sm">Recommended</span></p>
      <div class="dtype-grid">
        <button type="button" class="dtype" data-dtype="postgres" data-kind="database" data-label="Postgres"><span class="dtype-ic dtype-ic-db"><span class="iconify lucide--database"></span></span><span class="min-w-0"><span class="dtype-name">Postgres</span><span class="dtype-note">Self-hosted or cloud</span></span></button>
        <button type="button" class="dtype" data-dtype="neon" data-kind="database" data-label="Neon"><span class="dtype-ic dtype-ic-db"><span class="iconify lucide--database"></span></span><span class="min-w-0"><span class="dtype-name">Neon</span><span class="dtype-note">Serverless Postgres</span></span></button>
      </div>
    </div>
    {/* configure (after type pick) */}
    <div data-dest-config hidden>
      <button type="button" class="back-link mb-3" data-dest-back><span class="iconify lucide--arrow-left"></span> Pick a different type</button>
      <label class="add-field">
        <span class="add-label">Name</span>
        <input type="text" data-dest-name placeholder="Backup storage" class="input input-sm input-bordered w-full" />
      </label>
      <div data-dest-field-folder class="add-field mt-3">
        <span class="add-label">Folder</span>
        <input type="text" data-dest-folder-input placeholder="/Baseout" class="input input-sm input-bordered w-full font-mono text-sm" />
        <span class="add-hint">You authorize the account in a popup after saving. Each Space writes to its own subfolder.</span>
      </div>
      <div data-dest-field-conn class="add-field mt-3" hidden>
        <span class="add-label">Connection string</span>
        <input type="password" data-dest-conn-input placeholder="postgres://user:••••@host:5432/db" autocomplete="off" class="input input-sm input-bordered w-full font-mono text-sm" />
        <span class="add-hint">Stored encrypted. Baseout writes one schema per Space.</span>
      </div>
      <div role="alert" data-dest-field-managed class="alert alert-soft alert-success mt-3" hidden><span class="iconify lucide--shield-check size-4" aria-hidden="true"></span><span>Managed by Baseout — no account to connect or folder to choose.</span></div>
    </div>
    <Fragment slot="footer">
      <label for="wz-drawer-dest" class="btn btn-sm btn-ghost">Cancel</label>
      <button type="button" class="btn btn-sm btn-primary" data-dest-create hidden><span class="iconify lucide--check size-4" aria-hidden="true"></span>Save destination</button>
    </Fragment>
  </Drawer>

  {/* Reconnect drawer — re-authorize a broken object in place (no kick-out).
      Title updated by JS via the panel's .sb-drawer-title. */}
  <Drawer id="wz-drawer-reconnect" title="Reconnect" subtitle="Reauthorize to resume backups — your selection and settings are kept.">
    <div role="alert" class="alert alert-soft alert-warning">
      <span class="iconify lucide--triangle-alert size-4" aria-hidden="true"></span>
      <div class="min-w-0"><p class="font-semibold" data-reconnect-name>—</p><p class="text-sm text-base-content/70">Lost access · backups paused</p></div>
    </div>
    <div data-reconnect-oauth class="mt-4">
      <p class="add-hint">You reauthorize read-only access in a popup, then return here — the wizard stays open.</p>
    </div>
    <label data-reconnect-secret-field class="add-field mt-4" hidden>
      <span class="add-label" data-reconnect-secret-label>Personal access token</span>
      <input type="password" data-reconnect-secret placeholder="••••••••••••••" autocomplete="off" class="input input-sm input-bordered w-full font-mono text-sm" />
      <span class="add-hint">Stored encrypted. Re-enter to restore access.</span>
    </label>
    <Fragment slot="footer">
      <label for="wz-drawer-reconnect" class="btn btn-sm btn-ghost">Cancel</label>
      <button type="button" class="btn btn-sm btn-primary" data-reconnect-confirm><span class="iconify lucide--rotate-cw size-4" aria-hidden="true"></span> Reconnect</button>
    </Fragment>
  </Drawer>

  {/* Toast — daisyUI toast pinned to the top-right; JS injects a success alert. */}
  <div class="toast toast-top toast-end wz-toast" data-toast hidden></div>
</div>

<style>
  .back-link { display: inline-flex; align-items: center; gap: .25rem; font-size: .8125rem; font-weight: 500; color: oklch(from var(--color-base-content) l c h / .6); text-decoration: none; background: none; border: none; cursor: pointer; padding: 0; }
  .back-link:hover { color: var(--color-base-content); }
  .back-link .iconify { font-size: .95rem; }

  .tabs-shell { border: 1px solid var(--color-base-300); border-radius: .7rem; background: var(--color-base-100); overflow: hidden; }
  .bar { display: flex; align-items: center; gap: 1rem; flex-wrap: wrap; padding: .5rem .75rem .5rem 1rem; border-bottom: 1px solid var(--color-base-300); background: oklch(from var(--color-base-200) l c h / .45); }
  .bar-actions { margin-left: auto; display: flex; align-items: center; gap: .5rem; flex: none; }
