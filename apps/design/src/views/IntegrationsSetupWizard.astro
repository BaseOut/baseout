  /* connector: a green "linked & healthy" line + check badge, matching the Home pipeline */
  .review-link { align-self: center; position: relative; width: 1.75rem; height: 2px; border-radius: 2px; background: oklch(from var(--color-success) l c h / .5); flex: none; display: grid; place-items: center; }
  .review-link-badge { position: relative; z-index: 1; width: 1.1rem; height: 1.1rem; border-radius: 999px; display: grid; place-items: center; background: var(--color-success); color: var(--color-success-content); box-shadow: 0 0 0 3px var(--color-base-100); }
  .review-link-badge .iconify { font-size: .72rem; }
  .review-meta { display: flex; gap: 2.25rem; flex-wrap: wrap; margin-top: 1rem; padding: .75rem 1rem; border: 1px solid var(--color-base-300); border-radius: .65rem; background: oklch(from var(--color-base-200) l c h / .35); }
  .review-meta-item { display: flex; flex-direction: column; gap: .25rem; }
  .review-meta-k { font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: .05em; color: oklch(from var(--color-base-content) l c h / .66); }
  .review-meta-v { font-size: .85rem; font-weight: 600; }

  /* Drawer chrome now lives in the catalog Drawer component (components/ui/Drawer.astro).
