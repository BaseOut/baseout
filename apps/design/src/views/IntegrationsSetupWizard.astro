  .step:not(:last-child)::after { content: ''; width: clamp(.5rem, 3.5vw, 2.5rem); height: 2px; background: var(--color-base-300); margin: 0 .5rem; }
  .step.is-done:not(:last-child)::after { background: oklch(from var(--color-primary) l c h / .5); }
  .step-dot { position: relative; display: inline-flex; align-items: center; justify-content: center; width: 1.5rem; height: 1.5rem; border-radius: 999px; flex: none; font-size: .75rem; font-weight: 700; border: 1.5px solid var(--color-base-300); color: oklch(from var(--color-base-content) l c h / .66); background: var(--color-base-100); }
  .step-check { display: none; font-size: .9rem; }
  .step.is-current .step-dot { border-color: var(--color-primary); color: var(--color-primary); }
  .step.is-done .step-dot { background: var(--color-primary); border-color: var(--color-primary); color: var(--color-primary-content); }
