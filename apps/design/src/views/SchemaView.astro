---
/**
 * SchemaView — the Schema page (/schema). Space-scoped, read-only.
 *
 * The 8 tabs are grouped into 4 clusters (approved /schema-nav Variant A): Explore
 * (Browse · Visualize · Relationships) · App layer (Automations · Interfaces) ·
 * Monitor (Changelog · Health) · Knowledge (Docs · Chat History). Each cluster has a
 * quiet label ABOVE its tabs. Chat is OUT of the tab row — reached from the persistent
 * "Ask about your schema" launcher (header, top-right) and Knowledge ▸ Chat History,
 * both of which open the Chat panel. Browse is the landing tab.
 *
 * The Visualize canvas is a React Flow island (the one place React lives) — see
 * components/schema/SchemaCanvas.tsx. Tab switching toggles the full-width `.sch-panel`s
 * by `data-tab`/`data-panel`; everything else is Astro/daisyUI.
 */
import SchemaCanvas, { type SchemaTable } from '../components/schema/SchemaCanvas';
import SchemaHealth, { type BaseHealth } from '../components/schema/SchemaHealth.astro';
import SchemaChangelog, { type ChangelogEntry } from '../components/schema/SchemaChangelog.astro';
import SchemaRelationships, { type SchemaRelationship } from '../components/schema/SchemaRelationships.astro';
import SchemaAutomations, { type SchemaAutomation } from '../components/schema/SchemaAutomations.astro';
import SchemaInterfaces, { type SchemaInterface } from '../components/schema/SchemaInterfaces.astro';
import SchemaBrowse from '../components/schema/SchemaBrowse.astro';
import SchemaChat, { type ChatThread } from '../components/schema/SchemaChat.astro';
import SchemaDocs from '../components/schema/SchemaDocs.astro';
import EntityPanel from '../components/schema/EntityPanel.astro';
import RelationshipPanel from '../components/schema/RelationshipPanel.astro';
import { buildEntityIndex, type SchemaDoc } from '../components/schema/schemaEntities';
import { AIRTABLE_FIELD_ICONS, airtableIconKey } from '../components/schema/airtableFieldIcons';

interface Props {
  bases: { id: string; name: string }[];
  tables: SchemaTable[];
  health?: BaseHealth[];
  changelog?: ChangelogEntry[];
  relationships?: SchemaRelationship[];
  automations?: SchemaAutomation[];
  interfaces?: SchemaInterface[];
  chatThreads?: ChatThread[];
  docs?: SchemaDoc[];
  hasRecordCounts?: boolean;
  /** When the schema was last captured (a backup run). Stamped on Browse. */
  lastBackupAt?: string;
  /** AI Generate-description capability for the Visualize side panel (ready / locked / no-credits). */
  aiState?: 'ready' | 'locked' | 'no-credits';
}
const { bases, tables, health = [], changelog = [], relationships = [], automations = [], interfaces = [], chatThreads = [], docs = [], lastBackupAt, aiState = 'ready' } = Astro.props;
const index = buildEntityIndex(bases, tables, docs);
// Browse keeps the full index (so "Include deleted" can reveal removed entities); the live
// diagram + doc mini-diagrams show only active tables (deleted ones are history, not current).
const liveTables = tables.filter((t) => !t.removed);
// Entities a Health scoring-prompt override can target (the searchable "Edit at" picker).
const overrideTargets = index
  .filter((e) => !e.removed)
  .map((e) => ({
    id: e.id,
    kind: e.kind,
    label: e.kind === 'field' ? `${e.baseName} ▸ ${e.tableName} ▸ ${e.name} (field)` : e.kind === 'table' ? `${e.baseName} ▸ ${e.name} (table)` : `${e.name} (base)`,
  }));
const hasSchema = tables.length > 0;

// Freshness stamp — the whole section reflects one captured backup, so it lives at the
// title level (once), not inside any one tab's toolbar.
const fmtStamp = (iso: string) => {
  const d = new Date(iso);
  return Number.isNaN(d.getTime())
    ? iso
    : d.toLocaleString('en-US', { month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' });
};

// Health lookups for the facet status dots — the same per-entity health Browse renders, so
// the Base/Table filters in Changelog and Visualize read consistently with the canvas.
// (Keyed by name for Changelog's name-based entries; by id for the Visualize island.)
const baseHealthByName: Record<string, 'green' | 'amber' | 'red'> = {};
const baseHealthById: Record<string, 'green' | 'amber' | 'red'> = {};
const tableHealthByKey: Record<string, 'green' | 'amber' | 'red'> = {};
// Name → entity-id maps so Changelog's location breadcrumb can open the shared EntityPanel
// (changelog entries reference base/table by name; field-level entries carry their own id).
const baseIdByName: Record<string, string> = {};
const tableIdByKey: Record<string, string> = {};
for (const e of index) {
  if (e.kind === 'base') { baseHealthByName[e.name] = e.health; baseHealthById[e.id] = e.health; baseIdByName[e.name] = e.id; }
  else if (e.kind === 'table') { tableHealthByKey[`${e.baseName}::${e.name}`] = e.health; tableIdByKey[`${e.baseName}::${e.name}`] = e.id; }
}

// Quick-ask drawer thread switcher — the compact drawer showed one hardcoded conversation with
// no way to switch. It now lists the same NON-ARCHIVED threads the full Chat tab rail uses
// (from the shared chatThreads fixture) and swaps the shown exchange on select (presentational —
// first user question + first assistant answer per thread; the full Chat tab owns real history).
const scdThreads = chatThreads
  .filter((t) => !t.archived)
  .map((t) => ({ id: t.id, title: t.title, messages: t.messages }));
const scdCurrent = scdThreads[0];
// Quiet reference-chip icon for the quick-ask drawer (kept simple; the full Chat tab has the rich set).
const scdRefIcon = (r: { kind: string; entityKind?: string }) =>
  r.kind === 'doc' ? 'lucide--file-text' : r.entityKind === 'base' ? 'lucide--database' : r.entityKind === 'field' ? 'lucide--hash' : 'lucide--table-2';

// Quick-ask "Add context" picker — the same browsable + searchable list the full Chat composer
// uses (SchemaChat), scoped to the slim drawer. Bases/Tables/Fields from the entity index + Docs.
const scdFieldIcon = (type?: string) => {
  const k = type ? airtableIconKey(type) : null;
  return k ? `<svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true">${AIRTABLE_FIELD_ICONS[k]}</svg>` : '';
};
const scdCtxIcon = (e: (typeof index)[number]) =>
  e.kind === 'field' ? scdFieldIcon(e.fieldType) || '<span class="iconify lucide--tag"></span>'
  : e.kind === 'table' ? '<span class="iconify lucide--table-2"></span>'
  : '<span class="iconify lucide--database"></span>';
const scdCtxSearch = (e: (typeof index)[number]) => [e.name, e.tableName, e.baseName].filter(Boolean).join(' ').toLowerCase();
const scdCtxGroups = [
  { label: 'Bases', items: index.filter((e) => e.kind === 'base' && !e.removed) },
  { label: 'Tables', items: index.filter((e) => e.kind === 'table' && !e.removed) },
  { label: 'Fields', items: index.filter((e) => e.kind === 'field' && !e.removed) },
];
---

<div class="sch" data-schema data-chat="closed">
  {/* Page header — title + the section-wide freshness stamp (applies to every tab, so it
      lives here once, right-aligned, not inside any single tab's toolbar). */}
  <header class="sch-head">
    <div class="min-w-0">
      <h1 class="text-title">Schema</h1>
      <p class="text-sm text-base-content/60 mt-1">Your Airtable structure, visualized — tables, fields, and how they link. Read-only.</p>
    </div>
    <div class="sch-head-r">
      {lastBackupAt && (
        <p class="sch-stamp tooltip tooltip-left" data-tip="Schema is captured at backup time and may drift from Airtable until the next run.">
          <span class="iconify lucide--history size-3.5" aria-hidden="true"></span>
          Schema as of {fmtStamp(lastBackupAt)}
        </p>
      )}
      {/* Persistent chat launcher — reachable from any tab in the section (opens the Chat panel,
          i.e. Knowledge ▸ Chat History). Ported from the approved /schema-nav Variant A prototype. */}
      {hasSchema && (
        <button type="button" class="btn btn-ghost text-primary gap-1.5" data-sch-ask>
          <span class="iconify lucide--sparkles size-4" aria-hidden="true"></span>Ask about your schema
        </button>
      )}
    </div>
  </header>

  {/* Tab bar (approved /schema-nav Variant A): the 8 tabs are grouped into 4 clusters, each with a
      quiet label ABOVE its tabs. Chat is pulled OUT of the row — reached via the "Ask about your
      schema" launcher (above) + the "Chat History" item under Knowledge, which both open the Chat
      panel (data-tab="chat"). Icons match each section's empty state. */}
  <div class="sch-tabbar" role="tablist" aria-label="Schema sections">
    <div class="sch-group">
      <span class="sch-glabel">Explore</span>
      <div class="sch-gtabs tabs tabs-border">
        <button type="button" class="tab tab-active" role="tab" data-tab="browse"><span class="iconify lucide--list-tree size-4" aria-hidden="true"></span>Browse</button>
        <button type="button" class="tab" role="tab" data-tab="visualize"><span class="iconify lucide--workflow size-4" aria-hidden="true"></span>Visualize</button>
        <button type="button" class="tab" role="tab" data-tab="relationships"><span class="iconify lucide--waypoints size-4" aria-hidden="true"></span>Relationships</button>
      </div>
    </div>
    <span class="sch-tabdiv" aria-hidden="true"></span>
    <div class="sch-group">
      <span class="sch-glabel">App layer</span>
      <div class="sch-gtabs tabs tabs-border">
        <button type="button" class="tab" role="tab" data-tab="automations"><span class="iconify lucide--zap size-4" aria-hidden="true"></span>Automations</button>
        <button type="button" class="tab" role="tab" data-tab="interfaces"><span class="iconify lucide--layout-panel-left size-4" aria-hidden="true"></span>Interfaces</button>
      </div>
    </div>
    <span class="sch-tabdiv" aria-hidden="true"></span>
    <div class="sch-group">
      <span class="sch-glabel">Monitor</span>
      <div class="sch-gtabs tabs tabs-border">
        <button type="button" class="tab" role="tab" data-tab="changelog"><span class="iconify lucide--history size-4" aria-hidden="true"></span>Changelog</button>
        <button type="button" class="tab" role="tab" data-tab="health"><span class="iconify lucide--heart-pulse size-4" aria-hidden="true"></span>Health</button>
      </div>
    </div>
    <span class="sch-tabdiv" aria-hidden="true"></span>
    <div class="sch-group">
      <span class="sch-glabel">Knowledge</span>
      <div class="sch-gtabs tabs tabs-border">
        <button type="button" class="tab" role="tab" data-tab="docs"><span class="iconify lucide--book-text size-4" aria-hidden="true"></span>Docs</button>
        <button type="button" class="tab" role="tab" data-tab="chat"><span class="iconify lucide--messages-square size-4" aria-hidden="true"></span>Chat</button>
      </div>
    </div>
  </div>

  {/* Panels — full width */}
  <div class="sch-panel" data-panel="browse">
    {hasSchema ? (
      <SchemaBrowse index={index} bases={bases} docs={docs} chatThreads={chatThreads} />
    ) : (
      <div class="sch-empty">
        <span class="sch-empty-ic"><span class="iconify lucide--list-tree"></span></span>
        <p class="sch-empty-title">Schema appears after your first backup</p>
        <p class="sch-empty-sub">Once a backup completes, every base, table, and field shows up here to browse and inspect.</p>
      </div>
    )}
  </div>

  <div class="sch-panel" data-panel="visualize" hidden>
    <div class="sch-canvas">
      {hasSchema ? (
        <SchemaCanvas client:only="react" tables={liveTables} bases={bases} baseHealth={baseHealthById} docs={docs} genState={aiState} relationships={relationships} automations={automations} interfaces={interfaces} />
      ) : (
        <div class="sch-empty">
          <span class="sch-empty-ic"><span class="iconify lucide--workflow"></span></span>
          <p class="sch-empty-title">Schema appears after your first backup</p>
          <p class="sch-empty-sub">Once a backup completes, your tables and their relationships are drawn here.</p>
        </div>
      )}
    </div>
  </div>

  <div class="sch-panel" data-panel="relationships" hidden>
    {hasSchema ? (
      <SchemaRelationships relationships={relationships} bases={bases} />
    ) : (
      <div class="sch-empty">
        <span class="sch-empty-ic"><span class="iconify lucide--waypoints"></span></span>
        <p class="sch-empty-title">Schema appears after your first backup</p>
        <p class="sch-empty-sub">Once a backup completes, linked records, formulas, rollups, lookups, and synced views show up here.</p>
      </div>
    )}
  </div>

  <div class="sch-panel" data-panel="automations" hidden>
    {hasSchema ? (
      <SchemaAutomations automations={automations} bases={bases} index={index} changelog={changelog} aiState={aiState} />
    ) : (
      <div class="sch-empty">
        <span class="sch-empty-ic"><span class="iconify lucide--zap"></span></span>
        <p class="sch-empty-title">Schema appears after your first backup</p>
        <p class="sch-empty-sub">Register automations to track them alongside your backed-up tables and fields.</p>
      </div>
    )}
  </div>

  <div class="sch-panel" data-panel="interfaces" hidden>
    {hasSchema ? (
      <SchemaInterfaces interfaces={interfaces} bases={bases} index={index} changelog={changelog} aiState={aiState} />
    ) : (
      <div class="sch-empty">
        <span class="sch-empty-ic"><span class="iconify lucide--layout-panel-left"></span></span>
        <p class="sch-empty-title">Schema appears after your first backup</p>
        <p class="sch-empty-sub">Register interfaces and their pages to track them alongside your backed-up tables and fields.</p>
      </div>
    )}
  </div>

  <div class="sch-panel" data-panel="changelog" hidden>
    <SchemaChangelog entries={changelog} baseHealth={baseHealthByName} tableHealth={tableHealthByKey} baseId={baseIdByName} tableId={tableIdByKey} />
  </div>

  <div class="sch-panel" data-panel="health" hidden>
    {health.length > 0 ? (
      <SchemaHealth health={health} aiState={aiState} overrideTargets={overrideTargets} />
    ) : (
      <div class="sch-soon">
        <span class="iconify lucide--heart-pulse size-5 opacity-60" aria-hidden="true"></span>
        <p>Health appears after your first backup completes — a per-base 0–100 grade (Green / Yellow / Red) with the issues behind it.</p>
      </div>
    )}
  </div>

  <div class="sch-panel" data-panel="docs" hidden>
    {hasSchema ? (
      <SchemaDocs docs={docs} index={index} bases={bases} tables={liveTables} />
    ) : (
      <div class="sch-soon">
        <span class="iconify lucide--book-text size-5 opacity-60" aria-hidden="true"></span>
        <p>Docs let you write up how the schema works, tagging real bases, tables, and fields. They appear once there's a schema to document.</p>
      </div>
    )}
  </div>

  <div class="sch-panel" data-panel="chat" hidden>
    {hasSchema ? (
      <SchemaChat threads={chatThreads} index={index} docs={docs.map((d) => ({ id: d.id, title: d.title }))} aiState={aiState} />
    ) : (
      <div class="sch-soon">
        <span class="iconify lucide--messages-square size-5 opacity-60" aria-hidden="true"></span>
        <p>Chat with AI about your schema once there's a backup to talk about — scope the context to a base or table and turn answers into docs.</p>
      </div>
    )}
  </div>

  {/* Quick-ask chat DOCK (approved /schema-nav prototype): the "Ask about your schema" launcher
      opens this slim right drawer for a quick question from any tab; its Expand ⤢ jumps to the
      full Chat tab (Knowledge ▸ Chat History). Presentational, like the rest of the faked chat. */}
  {hasSchema && (
    <div class="scd" data-scd>
      <div class="scd-scrim" data-scd-close aria-hidden="true"></div>
      <aside class="scd-drawer" aria-label="Schema assistant">
        <div class="scd-grip" data-scd-grip aria-hidden="true"></div>
        <div class="scd-top">
          {scdThreads.length > 0 ? (
            <div class="dropdown scd-threadmenu">
              <div tabindex="0" role="button" class="scd-threadbtn tooltip tooltip-bottom" data-tip="Switch chat" aria-label="Switch chat">
                <span class="iconify lucide--sparkles size-4 scd-threadmark" aria-hidden="true"></span>
                <span class="scd-threadttl" data-scd-current>{scdCurrent.title}</span>
                <span class="iconify lucide--chevron-down size-3.5 scd-threadchev" aria-hidden="true"></span>
              </div>
              <ul tabindex="0" class="dropdown-content scd-threadlist">
                {scdThreads.map((t) => (
                  <li>
                    <button type="button" class="scd-threaditem" data-scd-pick={t.id} data-scd-title={t.title}>
                      <span class="iconify lucide--message-square size-3.5" aria-hidden="true"></span>
                      <span class="scd-threaditem-ttl">{t.title}</span>
                    </button>
                  </li>
                ))}
              </ul>
            </div>
          ) : (
            <span class="scd-ttl"><span class="iconify lucide--sparkles size-4" aria-hidden="true"></span>Schema assistant</span>
          )}
          <div class="scd-acts">
            <button type="button" class="scd-icobtn tooltip tooltip-bottom" data-scd-new data-tip="New chat" aria-label="New chat"><span class="iconify lucide--plus size-4" aria-hidden="true"></span></button>
            <button type="button" class="scd-icobtn tooltip tooltip-bottom" data-scd-expand data-tip="Open full chat" aria-label="Open full chat"><span class="iconify lucide--arrow-up-right size-4" aria-hidden="true"></span></button>
            <button type="button" class="scd-icobtn" data-scd-close aria-label="Close"><span class="iconify lucide--x size-4" aria-hidden="true"></span></button>
          </div>
        </div>
        <div class="scd-scope" data-scd-scope><span class="scd-chip scd-chip-whole" data-scd-whole><span class="iconify lucide--database size-3.5" aria-hidden="true"></span>Whole Space</span></div>
        <div class="scd-convo" data-scd-convo>
          {scdThreads.map((t) => (
            <div class="scd-thread" data-scd-thread={t.id} hidden={t.id !== scdCurrent.id}>
              {t.messages.map((m) => (
                m.role === 'user' ? (
                  <div class="scd-msg-user">{m.text}</div>
                ) : m.convertedDoc ? (
                  <div class="scd-msg-doc"><span class="iconify lucide--file-plus-2 size-3.5" aria-hidden="true"></span><span>Saved as a doc · <strong>{m.convertedDoc.title}</strong></span></div>
                ) : (
                  <div class="scd-msg-ai">
                    <span class="scd-mark"><span class="iconify lucide--sparkles size-3.5" aria-hidden="true"></span></span>
                    <div class="scd-msg-ai-body">
                      <div class="scd-msg-ai-text">{m.text}</div>
                      {m.refs && m.refs.length > 0 && (
                        <div class="scd-refs">
                          <span class="scd-refs-lbl">References</span>
                          {m.refs.map((r) => (
                            <span class="scd-refchip"><span class={`iconify ${scdRefIcon(r)} size-3.5`} aria-hidden="true"></span>{r.name}</span>
                          ))}
                        </div>
                      )}
                    </div>
                  </div>
                )
              ))}
            </div>
          ))}
          <div class="scd-newempty" data-scd-empty hidden>
            <span class="iconify lucide--sparkles size-5" aria-hidden="true"></span>
            <p class="scd-newempty-ttl">Ask anything about your schema</p>
            <p class="scd-newempty-sub">Start a new question below, or switch to an existing chat.</p>
          </div>
        </div>
        <div class="scd-composer">
          <div class="scd-box">
            <div class="scd-input">Ask about your schema…</div>
            <div class="scd-bar">
              <div class="dropdown dropdown-top scd-addctxwrap">
                <div tabindex="0" role="button" class="scd-addctx" data-scd-addctx><span class="iconify lucide--plus size-3.5" aria-hidden="true"></span>Add context</div>
                <div tabindex="0" class="dropdown-content scd-addctx-pop">
                  <label class="input input-sm scd-addctx-search">
                    <span class="iconify lucide--search size-3.5 opacity-50" aria-hidden="true"></span>
                    <input type="text" data-scd-ctx-search placeholder="Search bases, tables, fields, docs…" aria-label="Search context" autocomplete="off" />
                  </label>
                  <div class="scd-addctx-list">
                    {scdCtxGroups.map((g) => g.items.length > 0 && (
                      <>
                        <div class="scd-addctx-sec" data-scd-ctx-sec>{g.label}</div>
                        {g.items.map((e) => (
                          <button type="button" class="scd-addctx-item" data-scd-add-ent={e.id} data-ent-name={e.name} data-search={scdCtxSearch(e)}>
                            <span class="scd-addctx-ic" set:html={scdCtxIcon(e)}></span>
                            <span class="scd-addctx-item-name">{e.name}</span>
                            {(e.tableName ?? e.baseName) && <span class="scd-addctx-item-path">{e.tableName ?? e.baseName}</span>}
                          </button>
                        ))}
                      </>
                    ))}
                    {docs.length > 0 && <div class="scd-addctx-sec" data-scd-ctx-sec>Docs</div>}
                    {docs.map((d) => (
                      <button type="button" class="scd-addctx-item" data-scd-add-doc={d.id} data-doc-title={d.title} data-search={d.title.toLowerCase()}>
                        <span class="scd-addctx-ic"><span class="iconify lucide--file-text size-3.5" aria-hidden="true"></span></span>
                        <span class="scd-addctx-item-name">{d.title}</span>
                      </button>
                    ))}
                    <div class="scd-addctx-empty" data-scd-ctx-empty hidden>No match.</div>
                  </div>
                </div>
              </div>
              <span class="scd-credits"><span class="iconify lucide--zap size-3.5" aria-hidden="true"></span>~2 credits</span>
              <span class="scd-send"><span class="iconify lucide--arrow-up size-4" aria-hidden="true"></span></span>
            </div>
          </div>
          <p class="scd-disclaimer">AI can make mistakes. Verify important details against your schema.</p>
        </div>
      </aside>
    </div>
  )}
</div>

{/* Shared stacking entity detail panel — opened by Browse rows and Docs tag chips. */}
<EntityPanel index={index} docs={docs} changelog={changelog} automations={automations} interfaces={interfaces} chatThreads={chatThreads} aiState={aiState} />

{/* Shared relationship detail — opened by the Relationships table (row click) AND the
    Visualize "Relationships" graph (edge click), both via `schema:openRelationship`. */}
{hasSchema && <RelationshipPanel relationships={relationships} tables={liveTables} bases={bases} />}

<style>
  .sch { display: flex; flex-direction: column; gap: 1rem; }
  .sch-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem; flex-wrap: wrap; }
  /* Section-wide freshness stamp — quiet, right-aligned. */
  .sch-stamp { display: inline-flex; align-items: center; gap: 4px; font-size: 12px; white-space: nowrap; color: oklch(from var(--color-base-content) l c h / .55); }
  .sch-head-r { display: flex; align-items: center; gap: .75rem; flex-wrap: wrap; justify-content: flex-end; }
  /* the chat launcher (top-right) is now the catalog Ghost Button (btn btn-ghost) — no custom CSS */

  /* grouped tab bar (approved Variant A) — cluster label ABOVE each group's tabs, thin dividers */
  .sch-tabbar { display: flex; align-items: stretch; gap: .1rem; flex-wrap: wrap; border-bottom: 1px solid var(--color-base-300); }
  .sch-group { display: flex; flex-direction: column; }
  .sch-glabel { font-size: .6rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: oklch(from var(--color-base-content) l c h / .42); padding: 0 0 .1rem .6rem; }
  /* The tabs are the catalog daisyUI `tab` (inside `tabs tabs-border`); the pattern themes them to
     the quiet-inactive / primary-underline-active look. The 1px baseline is the .sch-tabbar border. */
  .sch-gtabs { display: flex; align-items: stretch; }
  .sch-gtabs.tabs { border: 0; }
  /* The active underline is daisyUI's own tab-active indicator (its ::before, already primary in
     this theme) — we DON'T add a second border-bottom (that caused a doubled/offset underline). */
  .sch-gtabs .tab { height: auto; padding: .5rem .6rem; font-size: .86rem; font-weight: 560; gap: .4rem; color: oklch(from var(--color-base-content) l c h / .68); background: transparent; white-space: nowrap; }
  .sch-gtabs .tab .iconify { opacity: .72; }
  .sch-gtabs .tab:hover { color: var(--color-base-content); background: transparent; }
  .sch-gtabs .tab.tab-active { color: var(--color-primary); }
  .sch-gtabs .tab.tab-active .iconify { opacity: 1; }
  .sch-tabdiv { width: 1px; background: var(--color-base-300); margin: 0 .6rem; align-self: flex-end; height: 1.9rem; }

  /* primitive mobile: let the grouped bar scroll sideways (a fuller mobile nav is a follow-up) */
  @media (max-width: 720px) {
    .sch-tabbar { flex-wrap: nowrap; overflow-x: auto; scrollbar-width: thin; }
    .sch-head-r { align-items: flex-start; }
  }

  /* quick-ask chat dock — a modal right drawer opened by the Ask launcher; Expand ⤢ → full Chat tab */
  .scd-scrim { position: fixed; inset: 0; background: oklch(0 0 0 / .32); opacity: 0; pointer-events: none; transition: opacity .18s ease; z-index: 60; }
  .scd-drawer { position: fixed; top: 0; right: 0; height: 100dvh; width: var(--scd-w, min(480px, 94vw)); background: var(--color-base-100); border-left: 1px solid var(--color-base-300); box-shadow: -12px 0 40px oklch(0 0 0 / .18); transform: translateX(100%); transition: transform .2s ease; z-index: 61; display: flex; flex-direction: column; }
  /* Left-edge resize (same rule as the detail panels): drag to widen, width persisted. */
  .scd-grip { position: absolute; left: -4px; top: 0; bottom: 0; width: 8px; cursor: col-resize; z-index: 2; }
  .scd-grip::after { content: ''; position: absolute; left: 3px; top: 0; bottom: 0; width: 2px; background: transparent; transition: background-color .12s ease; }
  .scd-grip:hover::after, .scd-grip.scd-grip-on::after { background: oklch(from var(--color-primary) l c h / .6); }
  .sch[data-chat="drawer"] .scd-scrim { opacity: 1; pointer-events: auto; }
  .sch[data-chat="drawer"] .scd-drawer { transform: translateX(0); }
  .scd-top { display: flex; align-items: center; gap: .5rem; padding: .6rem .5rem .6rem .85rem; border-bottom: 1px solid var(--color-base-300); }
  .scd-ttl { display: inline-flex; align-items: center; gap: .4rem; font-size: .85rem; font-weight: 640; }
  .scd-ttl .iconify { color: var(--color-primary); }
  /* thread switcher — a daisyUI dropdown whose trigger is the current chat title; menu lists the
     non-archived threads (mirrors the full Chat tab rail). Compact, quiet, on the 4px grid. */
  .scd-threadmenu { min-width: 0; }
  .scd-threadbtn { display: inline-flex; align-items: center; gap: .35rem; max-width: 15rem; padding: .25rem .4rem; border-radius: 8px; cursor: pointer; font-size: .85rem; font-weight: 640; color: var(--color-base-content); }
  .scd-threadbtn:hover { background: oklch(from var(--color-base-content) l c h / .07); }
  .scd-threadmark { color: var(--color-primary); flex: none; }
  .scd-threadttl { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .scd-threadchev { flex: none; opacity: .5; }
  .scd-threadlist { z-index: 62; margin-top: .35rem; width: 17rem; max-height: 60dvh; overflow-y: auto; padding: .3rem; border: 1px solid var(--color-base-300); border-radius: 12px; background: var(--color-base-100); box-shadow: 0 8px 28px oklch(0 0 0 / .16); }
  .scd-threaditem { display: flex; align-items: center; gap: .5rem; width: 100%; padding: .4rem .5rem; border: 0; background: none; border-radius: 8px; cursor: pointer; text-align: left; font-size: .84rem; color: var(--color-base-content); }
  .scd-threaditem:hover { background: oklch(from var(--color-base-content) l c h / .07); }
  .scd-threaditem .iconify { flex: none; opacity: .55; }
  .scd-threaditem-ttl { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .scd-newempty { margin: auto; display: flex; flex-direction: column; align-items: center; text-align: center; gap: .3rem; color: oklch(from var(--color-base-content) l c h / .6); }
  .scd-newempty .iconify { color: var(--color-primary); opacity: .8; }
  .scd-newempty-ttl { font-size: .95rem; font-weight: 640; color: var(--color-base-content); }
  .scd-newempty-sub { font-size: .8rem; max-width: 30ch; }
  .scd-acts { margin-left: auto; display: inline-flex; gap: .1rem; }
  .scd-icobtn { display: grid; place-items: center; width: 1.9rem; height: 1.9rem; border: 0; background: none; border-radius: 7px; cursor: pointer; color: oklch(from var(--color-base-content) l c h / .55); }
  .scd-icobtn:hover { background: oklch(from var(--color-base-content) l c h / .07); color: var(--color-base-content); }
  .scd-scope { padding: .55rem .85rem; border-bottom: 1px solid var(--color-base-200); }
  .scd-chip { display: inline-flex; align-items: center; gap: .3rem; font-size: .74rem; padding: .12rem .5rem; border-radius: 999px; border: 1px solid var(--color-base-300); background: oklch(from var(--color-base-200) l c h / .5); color: oklch(from var(--color-base-content) l c h / .7); }
  .scd-chip .iconify { opacity: .6; }
  .scd-convo { flex: 1; overflow-y: auto; min-height: 0; padding: 16px 16px 20px; }
  .scd-thread { display: flex; flex-direction: column; gap: 20px; }
  .scd-thread[hidden] { display: none; }
  .scd-msg-user { align-self: flex-end; max-width: 85%; padding: 8px 12px; border-radius: 14px 14px 4px 14px; background: var(--color-base-200); font-size: 13px; line-height: 1.55; }
  /* Assistant turn: a small sparkle avatar + the answer body, so a multi-turn thread reads as a real chat. */
  .scd-msg-ai { align-self: stretch; display: flex; gap: 8px; }
  .scd-mark { flex: none; display: grid; place-items: center; width: 24px; height: 24px; border-radius: 999px; background: color-mix(in oklch, var(--color-primary) 14%, transparent); color: var(--color-primary); }
  .scd-msg-ai-body { min-width: 0; flex: 1; }
  .scd-msg-ai-text { font-size: 13px; line-height: 1.6; color: var(--color-base-content); }
  /* "Saved as a doc" system line between turns. */
  .scd-msg-doc { align-self: center; display: inline-flex; align-items: center; gap: 8px; padding: 4px 12px; border-radius: 999px; border: 1px solid var(--color-base-300); background: oklch(from var(--color-base-200) l c h / .5); font-size: 12px; color: oklch(from var(--color-base-content) l c h / .75); }
  .scd-msg-doc .iconify { color: var(--color-primary); opacity: .85; }
  .scd-msg-doc strong { font-weight: 600; color: var(--color-base-content); }
  .scd-refs { display: flex; flex-wrap: wrap; gap: .35rem; margin-top: .6rem; align-items: center; }
  .scd-refs-lbl { font-size: .68rem; color: oklch(from var(--color-base-content) l c h / .42); }
  .scd-refchip { display: inline-flex; align-items: center; gap: .3rem; font-size: .72rem; padding: .1rem .45rem; border-radius: 999px; border: 1px solid var(--color-base-300); background: oklch(from var(--color-base-200) l c h / .5); color: oklch(from var(--color-base-content) l c h / .75); }
  .scd-refchip .iconify { opacity: .6; }
  .scd-composer { padding: .8rem; border-top: 1px solid var(--color-base-300); }
  .scd-box { border: 1px solid var(--color-base-300); border-radius: 1rem; background: var(--color-base-100); padding: .7rem .85rem .6rem; box-shadow: 0 1px 3px oklch(0 0 0 / .05); }
  .scd-input { font-size: .9rem; color: oklch(from var(--color-base-content) l c h / .4); padding: .2rem 0 .7rem; }
  .scd-bar { display: flex; align-items: center; gap: .5rem; }
  .scd-addctx { display: inline-flex; align-items: center; gap: .25rem; font-size: .76rem; color: oklch(from var(--color-base-content) l c h / .6); cursor: pointer; padding: .2rem .35rem; border-radius: 6px; }
  .scd-addctx:hover { background: oklch(from var(--color-base-content) l c h / .07); color: var(--color-base-content); }
  /* Add-context picker (opens upward from the composer). Mirrors the full Chat picker. */
  .scd-addctx-pop { width: 20rem; max-width: calc(100vw - 4rem); margin-bottom: 8px; padding: 8px; background: var(--color-base-100); border: 1px solid var(--color-base-300); border-radius: 12px; box-shadow: 0 8px 28px oklch(0 0 0 / .18); z-index: 62; }
  .scd-addctx-search { width: 100%; margin-bottom: 8px; }
  .scd-addctx-list { max-height: 16rem; overflow-y: auto; display: flex; flex-direction: column; gap: 1px; }
  .scd-addctx-sec { font-size: .62rem; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; opacity: .45; padding: 8px 4px 2px; }
  .scd-addctx-sec[hidden] { display: none; }
  .scd-addctx-item { display: flex; align-items: center; gap: .45rem; padding: .38rem .45rem; border: 0; background: none; border-radius: 6px; cursor: pointer; font: inherit; font-size: .82rem; text-align: left; color: var(--color-base-content); width: 100%; }
  .scd-addctx-item:hover { background: oklch(from var(--color-base-content) l c h / .06); }
  .scd-addctx-item[hidden] { display: none; }
  .scd-addctx-ic { display: inline-grid; place-items: center; width: 15px; flex: none; color: oklch(from var(--color-base-content) l c h / .55); }
  .scd-addctx-ic svg { width: 13px; height: 13px; }
  .scd-addctx-item-name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .scd-addctx-item-path { margin-left: auto; font-size: .72rem; opacity: .5; white-space: nowrap; flex: none; }
  .scd-addctx-empty { padding: .5rem .45rem; font-size: .8rem; opacity: .5; }
  /* scope row: injected context chips sit beside/replace "Whole Space" */
  .scd-scope { display: flex; align-items: center; flex-wrap: wrap; gap: .3rem; }
  .scd-scope[data-has-ctx] .scd-chip-whole { display: none; }
  .scd-credits { display: inline-flex; align-items: center; gap: .25rem; font-size: .72rem; color: oklch(from var(--color-base-content) l c h / .5); margin-left: auto; }
  .scd-send { display: grid; place-items: center; width: 1.9rem; height: 1.9rem; border-radius: 8px; background: var(--color-primary); color: var(--color-primary-content); flex: none; }
  .scd-disclaimer { text-align: center; font-size: .7rem; color: oklch(from var(--color-base-content) l c h / .4); margin-top: .5rem; }

  .sch-panel { width: 100%; }

  .sch-canvas {
    height: clamp(520px, calc(100dvh - 250px), 940px);
    border: 1px solid var(--color-base-300);
    border-radius: .85rem;
    overflow: hidden;
    background: var(--color-base-100);
  }
  .sch-canvas :global(.react-flow) { background: transparent; }

  /* Theme the React Flow chrome with our tokens (colorMode follows our data-theme,
     not the OS, so these keep the minimap / controls on-brand in both themes). */
  .sch-canvas :global(.react-flow__minimap) { background: var(--color-base-200); border: 1px solid var(--color-base-300); border-radius: 6px; }
  .sch-canvas :global(.react-flow__controls) { border-radius: 7px; overflow: hidden; box-shadow: 0 2px 10px oklch(0 0 0 / .14); border: 1px solid var(--color-base-300); }
  .sch-canvas :global(.react-flow__controls-button) { background: var(--color-base-100); border-bottom: 1px solid var(--color-base-300); }
  .sch-canvas :global(.react-flow__controls-button:hover) { background: var(--color-base-200); }
  .sch-canvas :global(.react-flow__controls-button svg) { fill: var(--color-base-content); }

  .sch-empty, .sch-soon { height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; gap: .5rem; padding: 2rem; }
  .sch-empty-ic { width: 3rem; height: 3rem; border-radius: .8rem; display: grid; place-items: center; background: var(--color-base-200); margin-bottom: .3rem; }
  .sch-empty-ic .iconify { font-size: 1.4rem; color: oklch(from var(--color-base-content) l c h / .55); }
  .sch-empty-title { font-size: 1rem; font-weight: 650; }
  .sch-empty-sub { font-size: .85rem; color: oklch(from var(--color-base-content) l c h / .6); max-width: 44ch; }

  .sch-soon { min-height: 300px; border: 1px dashed var(--color-base-300); border-radius: .85rem; background: oklch(from var(--color-base-200) l c h / .3); }
  .sch-soon p { font-size: .9rem; color: oklch(from var(--color-base-content) l c h / .66); max-width: 56ch; }
</style>

{/* Scoped styles don't reach the JS-injected context chips (innerHTML) — style them globally
    under a unique `.scd-`-prefix. Matches the "Whole Space" chip's pill look. */}
<style is:global>
  .scd-ctxchip { display: inline-flex; align-items: center; gap: .3rem; font-size: .74rem; padding: .12rem .2rem .12rem .5rem; border-radius: 999px; border: 1px solid var(--color-base-300); background: oklch(from var(--color-primary) l c h / .08); color: oklch(from var(--color-base-content) l c h / .82); }
  .scd-ctxchip .iconify, .scd-ctxchip svg { width: 12px; height: 12px; opacity: .7; flex: none; }
  .scd-ctxchip-name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 11rem; }
  .scd-ctxchip-x { display: inline-grid; place-items: center; width: 16px; height: 16px; border: 0; border-radius: 999px; background: none; cursor: pointer; color: oklch(from var(--color-base-content) l c h / .5); flex: none; }
  .scd-ctxchip-x:hover { background: oklch(from var(--color-base-content) l c h / .12); color: var(--color-base-content); }
  .scd-ctxchip-x .iconify { opacity: 1; }
</style>

<script>
  function wireSchemaTabs() {
    const root = document.querySelector<HTMLElement>('[data-schema]');
    if (!root) return;
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-tab]'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('[data-panel]'));
    tabs.forEach((t) =>
      t.addEventListener('click', () => {
        tabs.forEach((x) => x.classList.toggle('tab-active', x === t));
        panels.forEach((p) => (p.hidden = p.dataset.panel !== t.dataset.tab));
        // Nudge React Flow to re-fit when the canvas panel becomes visible again.
        if (t.dataset.tab === 'visualize') window.dispatchEvent(new Event('resize'));
      }),
    );
    // Chat DOCK: the Ask launcher opens the slim quick-ask drawer; its Expand ⤢ jumps to the full
    // Chat tab (Knowledge ▸ Chat History). Scrim / × / Esc close it.
    const chatTab = root.querySelector<HTMLButtonElement>('[data-tab="chat"]');
    const setChat = (m: string) => { root.dataset.chat = m; };
    root.querySelector<HTMLButtonElement>('[data-sch-ask]')?.addEventListener('click', () => setChat('drawer'));
    root.querySelectorAll<HTMLElement>('[data-scd-close]').forEach((b) => b.addEventListener('click', () => setChat('closed')));
    root.querySelector<HTMLButtonElement>('[data-scd-expand]')?.addEventListener('click', () => { setChat('closed'); chatTab?.click(); });
    // Quick-ask thread switcher: pick a thread → swap the shown title + exchange; New chat → blank
    // it (presentational — the full Chat tab owns real history). Blur closes the daisyUI dropdown.
    const scdCurEl = root.querySelector<HTMLElement>('[data-scd-current]');
    const scdEmpty = root.querySelector<HTMLElement>('[data-scd-empty]');
    const scdThreadsEls = Array.from(root.querySelectorAll<HTMLElement>('[data-scd-thread]'));
    // Show one thread's full conversation (or the empty state on New) — toggle, don't re-render.
    const showScdThread = (id: string | null) => {
      scdThreadsEls.forEach((el) => { el.hidden = el.dataset.scdThread !== id; });
      if (scdEmpty) scdEmpty.hidden = id !== null;
      const convo = root.querySelector<HTMLElement>('[data-scd-convo]'); if (convo) convo.scrollTop = 0;
    };
    root.querySelectorAll<HTMLButtonElement>('[data-scd-pick]').forEach((b) =>
      b.addEventListener('click', () => {
        if (scdCurEl) scdCurEl.textContent = b.dataset.scdTitle ?? '';
        showScdThread(b.dataset.scdPick ?? null);
        (document.activeElement as HTMLElement | null)?.blur();
      }),
    );
    root.querySelector<HTMLButtonElement>('[data-scd-new]')?.addEventListener('click', () => {
      if (scdCurEl) scdCurEl.textContent = 'New chat';
      showScdThread(null);
      (document.activeElement as HTMLElement | null)?.blur();
    });
    // Quick-ask "Add context": mirror the full Chat picker — pick an entity/doc → a removable scope
    // chip; picker search filters items + hides empty section headers. Presentational (no real send).
    const scdScope = root.querySelector<HTMLElement>('[data-scd-scope]');
    const scdCtx = new Map<string, { name: string; icon: string }>();
    const renderScdCtx = () => {
      scdScope?.querySelectorAll('[data-scd-ctxchip]').forEach((c) => c.remove());
      scdScope?.toggleAttribute('data-has-ctx', scdCtx.size > 0);
      scdCtx.forEach((v, key) => {
        const chip = document.createElement('span');
        chip.className = 'scd-ctxchip';
        chip.dataset.scdCtxchip = key;
        chip.innerHTML = `${v.icon}<span class="scd-ctxchip-name">${v.name}</span><button type="button" class="scd-ctxchip-x" data-scd-ctx-remove aria-label="Remove ${v.name}"><span class="iconify lucide--x size-3" aria-hidden="true"></span></button>`;
        scdScope?.appendChild(chip);
      });
    };
    root.addEventListener('click', (ev) => {
      const t = ev.target as HTMLElement;
      const item = t.closest<HTMLElement>('[data-scd-add-ent],[data-scd-add-doc]');
      if (item) {
        const isDoc = item.hasAttribute('data-scd-add-doc');
        const id = (isDoc ? item.dataset.scdAddDoc : item.dataset.scdAddEnt) || '';
        const key = (isDoc ? 'doc:' : 'ent:') + id;
        const name = (isDoc ? item.dataset.docTitle : item.dataset.entName) || id;
        const icon = item.querySelector<HTMLElement>('.scd-addctx-ic')?.innerHTML || '';
        if (!scdCtx.has(key)) scdCtx.set(key, { name, icon });
        renderScdCtx();
        (document.activeElement as HTMLElement | null)?.blur();
        return;
      }
      const rm = t.closest<HTMLElement>('[data-scd-ctx-remove]');
      if (rm) {
        const chip = rm.closest<HTMLElement>('[data-scd-ctxchip]');
        if (chip?.dataset.scdCtxchip) { scdCtx.delete(chip.dataset.scdCtxchip); renderScdCtx(); }
      }
    });
    const scdCtxSearchEl = root.querySelector<HTMLInputElement>('[data-scd-ctx-search]');
    const scdCtxEmptyEl = root.querySelector<HTMLElement>('[data-scd-ctx-empty]');
    scdCtxSearchEl?.addEventListener('input', () => {
      const q = scdCtxSearchEl.value.trim().toLowerCase();
      let shown = 0;
      root.querySelectorAll<HTMLElement>('.scd-addctx-item').forEach((it) => {
        const ok = !q || (it.dataset.search || '').includes(q);
        it.hidden = !ok;
        if (ok) shown++;
      });
      root.querySelectorAll<HTMLElement>('[data-scd-ctx-sec]').forEach((sec) => {
        let any = false;
        let n = sec.nextElementSibling as HTMLElement | null;
        while (n && !n.hasAttribute('data-scd-ctx-sec') && !n.hasAttribute('data-scd-ctx-empty')) {
          if (n.classList.contains('scd-addctx-item') && !n.hidden) { any = true; break; }
          n = n.nextElementSibling as HTMLElement | null;
        }
        sec.hidden = !any;
      });
      if (scdCtxEmptyEl) scdCtxEmptyEl.hidden = shown > 0;
    });
    // Left-edge resize of the drawer — same feel as the detail panels; width persisted.
    const scdDrawer = root.querySelector<HTMLElement>('.scd-drawer');
    const scdGrip = root.querySelector<HTMLElement>('[data-scd-grip]');
    const SCD_MIN = 340; const scdMax = () => Math.min(760, window.innerWidth - 80);
    try { const w = parseInt(localStorage.getItem('scd-w') || '', 10); if (Number.isFinite(w) && w >= SCD_MIN && scdDrawer) scdDrawer.style.setProperty('--scd-w', w + 'px'); } catch { /* ignore */ }
    if (scdGrip && scdDrawer) {
      scdGrip.addEventListener('pointerdown', (e) => {
        e.preventDefault(); scdGrip.classList.add('scd-grip-on');
        const sx = e.clientX; const sw = scdDrawer.getBoundingClientRect().width;
        const mv = (me: PointerEvent) => { const w = Math.max(SCD_MIN, Math.min(sw + (sx - me.clientX), scdMax())); scdDrawer.style.setProperty('--scd-w', w + 'px'); };
        const up = () => { scdGrip.classList.remove('scd-grip-on'); document.removeEventListener('pointermove', mv); document.removeEventListener('pointerup', up); try { localStorage.setItem('scd-w', String(Math.round(scdDrawer.getBoundingClientRect().width))); } catch { /* ignore */ } };
        document.addEventListener('pointermove', mv); document.addEventListener('pointerup', up);
      });
    }
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && root.dataset.chat === 'drawer') setChat('closed'); });
    // "/" focuses the search of the currently-visible tab — the shared shortcut for every list tab.
    document.addEventListener('keydown', (e) => {
      if (e.key !== '/') return;
      const ae = document.activeElement as HTMLElement | null;
      if (ae && (ae.tagName === 'INPUT' || ae.tagName === 'TEXTAREA' || ae.isContentEditable)) return;
      const panel = panels.find((p) => !p.hidden);
      const search = panel?.querySelector<HTMLInputElement>('[data-sch-search]');
      if (search) { e.preventDefault(); search.focus(); }
    });
  }
  wireSchemaTabs();
  document.addEventListener('astro:after-swap', wireSchemaTabs);
</script>
