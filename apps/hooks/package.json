{
  "name": "@baseout/hooks",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Public Airtable webhook receiver at webhooks.baseout.com. See openspec/changes/hooks/proposal.md.",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsup src/index.ts --format esm --dts",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@baseout/db-schema": "workspace:*",
    "@baseout/shared": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240924.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.5",
    "wrangler": "^4.124.0"
  }
}
