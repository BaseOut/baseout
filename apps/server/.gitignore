# It contains the local Postgres connection string (sourced from .dev.vars)
# which must never be committed. Per CLAUDE.md §3.3 + PRD §20.1.
# wrangler.jsonc is COMMITTED and authoritative (no template, no renderer).
# It holds no credential — localConnectionString is a dummy, overridden at dev
# time via CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE.

# Local-fs backup output (dev path; see trigger/tasks/_lib/local-fs-write.ts).
# Will be replaced by managed R2 once baseout-server-byos-destinations Phase 0
# lands per baseout-r2-stance.
.backups/
wrangler.local.jsonc
