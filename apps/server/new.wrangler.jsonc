// apps/server — PROPOSED replacement for wrangler.jsonc.example (3 named envs).
//
// ENV MODEL (2026-08-27 revision):
//   Top level      = shared, non-deployable config ONLY. `migrations` stays here
//                    (it is deploy-wide, not per-env). Always deploy with --env.
//   env.dev        = baseout-server-dev     (staging account)
//   env.staging    = baseout-server-staging (staging account, `staging` branch)
//   env.production = baseout-server         (SEPARATE production account)
//
// CHANGED vs the old file: top level used to BE production (name
// "baseout-server", live Hyperdrive id, live R2 bucket) while env.production
// was declared name-only. Because vars/hyperdrive/durable_objects/r2_buckets/
// send_email/ai are non-inheritable, `wrangler deploy --env production` would
// have stripped every binding off the live engine. Each env now restates all.
//
// {{DATABASE_URL}} is substituted by scripts/launch.mjs from .dev.vars and only
// matters for env.dev — deployed Workers connect via the Hyperdrive `id`.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "baseout-server",
  "main": "./src/index.ts",
  "compatibility_date": "2026-04-22",
  "compatibility_flags": ["nodejs_compat"],

  // Durable Objects — canonical names per CLAUDE.md §5.3. The migration tag is
  // deploy-wide and stays top-level; the BINDINGS are non-inheritable and are
  // restated in every env block below.
  // ⚠ Each Worker script owns its OWN DO namespaces: baseout-server-staging
  // gets fresh ConnectionDO/SpaceDO storage, and the production account's
  // namespaces start empty. DO SQLite state does NOT migrate across scripts
  // or accounts.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ConnectionDO", "SpaceDO"] }],

  "env": {
    // ───────────────────────────── DEV ─────────────────────────────
    "dev": {
      "account_id": "f094d60e8a0996752eb1efd971bda45a",
      "vars": {
        "BASEOUT_ENV": "dev",
        "EMAIL_FROM": "Baseout Reports <reports@mail.baseout.dev>",
        "PUBLIC_APP_URL": "https://baseout.local:4331",
        // Account that owns the per-Space D1 databases this Worker provisions.
        "CLOUDFLARE_ACCOUNT_ID": "f094d60e8a0996752eb1efd971bda45a",
        "DRIZZLE_SSL": "require",
        "TRIGGER_PROJECT_REF": "proj_lklmptmrmrkeaszrmhcs",
        // ConnectionDO lazy-refreshes an expired access token on /token.
        "AIRTABLE_ON_DEMAND_REFRESH_ENABLED": "1",
        // Refresh-model selector (shared-oauth-refresh-keepalive): shadow first.
        "AIRTABLE_KEEPALIVE_MODE": "shadow",
        // "1" forces legacy REST view capture for every connection and strips
        // the MCP path (server-mcp-views, 2026-07-27). Keep 0.
        "VIEW_CAPTURE_OVERRIDE": "0",
        "AI_DESCRIPTIONS_ENABLED": "true",
        "AI_DESCRIPTIONS_MODEL": "",
        "DB_ISOLATION_ENFORCEMENT": "0",
        "ENTITLEMENT_ENFORCEMENT": "0",
        "RETENTION_FROM_ENTITLEMENTS": "0"
      },
      // Cron strings must stay byte-identical to the dispatch map in
      // src/lib/cron/dispatch.ts — scheduled() routes by event.cron.
      // wrangler deploy SYNCS schedules: omitting these deletes them.
      "triggers": {
        "crons": [
          "*/15 * * * *", // OAuth token refresh sweep + run reconciliation
          "0 13 * * *",   // OAuth idle keep-alive (shared-oauth-refresh-keepalive)
          "0 * * * *"     // Airtable webhook renewal (server-cron-webhook-renewal)
        ]
      },
      // baseout-dev-pg — shared pool with baseout-dev + baseout-admin-dev.
      "hyperdrive": [
        { "binding": "HYPERDRIVE", "id": "ba2652f40f864918a2da0849f24d12a2", "localConnectionString": "{{DATABASE_URL}}" }
      ],
      // Platform-authenticated, no key. Local `wrangler dev` serves it through
      // a remote proxy — an expired `wrangler login` kills the dev server.
      "ai": { "binding": "AI" },
      // Native credential-less bucket binding (NOT S3 creds — r2-setup.md §2.4
      // is untouched). Read-only by discipline: the engine only .get()s.
      "r2_buckets": [{ "binding": "BACKUPS_R2", "bucket_name": "baseout-backups-dev" }],
      "send_email": [{ "name": "EMAIL" }],
      "durable_objects": {
        "bindings": [
          { "name": "CONNECTION_DO", "class_name": "ConnectionDO" },
          { "name": "SPACE_DO", "class_name": "SpaceDO" }
        ]
      }
    },

    // ─────────────────────────── STAGING ───────────────────────────
    "staging": {
      // account_id intentionally omitted — Workers Builds runs inside the
      // owning account and supplies it. Pinning it here can only create a
      // mismatch, since production builds read this same file in a
      // different account. env.dev keeps its pin for local wrangler use.
      "vars": {
        "BASEOUT_ENV": "staging",
        "EMAIL_FROM": "Baseout Reports <reports@mail.baseout.dev>",
        "PUBLIC_APP_URL": "https://staging.console.baseout.dev",
        "CLOUDFLARE_ACCOUNT_ID": "f094d60e8a0996752eb1efd971bda45a",
        "DRIZZLE_SSL": "require",
        "TRIGGER_PROJECT_REF": "proj_lklmptmrmrkeaszrmhcs",
        "AIRTABLE_ON_DEMAND_REFRESH_ENABLED": "1",
        "AIRTABLE_KEEPALIVE_MODE": "shadow",
        "VIEW_CAPTURE_OVERRIDE": "0",
        "AI_DESCRIPTIONS_ENABLED": "true",
        "AI_DESCRIPTIONS_MODEL": "",
        "DB_ISOLATION_ENFORCEMENT": "0",
        "ENTITLEMENT_ENFORCEMENT": "0",
        "RETENTION_FROM_ENTITLEMENTS": "0"
      },
      // ⚠ ONE canonical list, byte-identical in env.staging and env.production.
      // `secrets` is NOT inherited from the top level (wrangler treats it like
      // `vars`), so it MUST be restated per env — a top-level-only block
      // validates nothing on a --env deploy and warns. `pnpm secrets:check`
      // asserts the two lists match; CI fails on drift.
      // env.dev deliberately has NO block: dev secrets come from .dev.vars
      // and are not deploy-gated.
      "secrets": {
        "required": [
          "AIRTABLE_OAUTH_CLIENT_ID",
          "AIRTABLE_OAUTH_CLIENT_SECRET",
          "BASEOUT_ENCRYPTION_KEY",
          "BOX_OAUTH_CLIENT_ID",
          "BOX_OAUTH_CLIENT_SECRET",
          "CLOUDFLARE_D1_API_TOKEN",
          "DROPBOX_OAUTH_CLIENT_ID",
          "DROPBOX_OAUTH_CLIENT_SECRET",
          "GOOGLE_DRIVE_OAUTH_CLIENT_ID",
          "GOOGLE_DRIVE_OAUTH_CLIENT_SECRET",
          "INTERNAL_TOKEN",
          "MICROSOFT_OAUTH_CLIENT_ID",
          "TRIGGER_SECRET_KEY"
        ]
      },
      // Staging runs the real schedules against the staging DB. Comment these
      // out if you'd rather staging never fires background work.
      "triggers": {
        "crons": ["*/15 * * * *", "0 13 * * *", "0 * * * *"]
      },
      // PROVISION: baseout-staging-pg (Hyperdrive is never auto-created).
      // PROVISION: `id` is omitted on purpose — wrangler HARD-ERRORS until it is
      // filled in. Do NOT use "id": "" — that silently DROPS the binding and
      // the Worker deploys with no database at all (verified on 4.112).
      "hyperdrive": [{ "binding": "HYPERDRIVE" }],
      "ai": { "binding": "AI" },
      // PROVISION: wrangler r2 bucket create baseout-backups-staging
      "r2_buckets": [{ "binding": "BACKUPS_R2", "bucket_name": "baseout-backups-staging" }],
      "send_email": [{ "name": "EMAIL" }],
      "durable_objects": {
        "bindings": [
          { "name": "CONNECTION_DO", "class_name": "ConnectionDO" },
          { "name": "SPACE_DO", "class_name": "SpaceDO" }
        ]
      }
    },

    // ───────────────────────── PRODUCTION ──────────────────────────
    // Separate Cloudflare account. Re-provision everything there.
    "production": {
      // PROVISION: production account id.
      // account_id intentionally omitted — supplied by Workers Builds in the
      // production account. Never pin it: this file is read by both accounts.
      "vars": {
        "BASEOUT_ENV": "production",
        "EMAIL_FROM": "Baseout Reports <reports@mail.baseout.dev>",
        "PUBLIC_APP_URL": "https://console.baseout.com",
        // PROVISION: must be the PRODUCTION account id — this is the account
        // per-Space D1 databases get created in.
        "CLOUDFLARE_ACCOUNT_ID": "",
        "DRIZZLE_SSL": "require",
        "TRIGGER_PROJECT_REF": "proj_lklmptmrmrkeaszrmhcs",
        "AIRTABLE_ON_DEMAND_REFRESH_ENABLED": "1",
        "AIRTABLE_KEEPALIVE_MODE": "shadow",
        "VIEW_CAPTURE_OVERRIDE": "0",
        "AI_DESCRIPTIONS_ENABLED": "true",
        "AI_DESCRIPTIONS_MODEL": "",
        "DB_ISOLATION_ENFORCEMENT": "0",
        "ENTITLEMENT_ENFORCEMENT": "0",
        "RETENTION_FROM_ENTITLEMENTS": "0"
      },
      // ⚠ ONE canonical list, byte-identical in env.staging and env.production.
      // `secrets` is NOT inherited from the top level (wrangler treats it like
      // `vars`), so it MUST be restated per env — a top-level-only block
      // validates nothing on a --env deploy and warns. `pnpm secrets:check`
      // asserts the two lists match; CI fails on drift.
      // env.dev deliberately has NO block: dev secrets come from .dev.vars
      // and are not deploy-gated.
      "secrets": {
        "required": [
          "AIRTABLE_OAUTH_CLIENT_ID",
          "AIRTABLE_OAUTH_CLIENT_SECRET",
          "BASEOUT_ENCRYPTION_KEY",
          "BOX_OAUTH_CLIENT_ID",
          "BOX_OAUTH_CLIENT_SECRET",
          "CLOUDFLARE_D1_API_TOKEN",
          "DROPBOX_OAUTH_CLIENT_ID",
          "DROPBOX_OAUTH_CLIENT_SECRET",
          "GOOGLE_DRIVE_OAUTH_CLIENT_ID",
          "GOOGLE_DRIVE_OAUTH_CLIENT_SECRET",
          "INTERNAL_TOKEN",
          "MICROSOFT_OAUTH_CLIENT_ID",
          "TRIGGER_SECRET_KEY"
        ]
      },
      "triggers": {
        "crons": ["*/15 * * * *", "0 13 * * *", "0 * * * *"]
      },
      // PROVISION in the production account: baseout-live-pg.
      // PROVISION: `id` is omitted on purpose — wrangler HARD-ERRORS until it is
      // filled in. Do NOT use "id": "" — that silently DROPS the binding and
      // the Worker deploys with no database at all (verified on 4.112).
      "hyperdrive": [{ "binding": "HYPERDRIVE" }],
      "ai": { "binding": "AI" },
      // PROVISION in the production account: baseout-live.
      // ⚠ R2 objects do NOT migrate between accounts — existing backups in the
      // current account's baseout-live must be copied before cutover.
      "r2_buckets": [{ "binding": "BACKUPS_R2", "bucket_name": "baseout-live" }],
      "send_email": [{ "name": "EMAIL" }],
      "durable_objects": {
        "bindings": [
          { "name": "CONNECTION_DO", "class_name": "ConnectionDO" },
          { "name": "SPACE_DO", "class_name": "SpaceDO" }
        ]
      }
    }
  }
}
