{
  "name": "@baseout/support",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "description": "Baseout support portal — Starlight docs, support chat, tickets, public roadmap. Target: support.baseout.com.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev --port 4342",
    "build": "astro build",
    "preview": "astro preview --port 4342",
    "typecheck": "astro check",
    "emails": "mjml emails/*.mjml -o emails/ --config.allowIncludes true --config.keepComments false",
    "emails:check": "rm -rf .emails-check && mkdir -p .emails-check && mjml emails/*.mjml -o .emails-check/ --config.allowIncludes true --config.keepComments false && for f in emails/*.html; do diff \"$f\" \".emails-check/$(basename \"$f\")\" || exit 1; done && rm -rf .emails-check",
    "build:dev": "astro build",
    "check:dev": "wrangler deploy --env dev --dry-run",
    "deploy:dev": "wrangler deploy --env dev",
    "build:staging": "astro build",
    "check:staging": "wrangler deploy --env staging --dry-run",
    "deploy:staging": "wrangler deploy --env staging",
    "build:production": "astro build",
    "check:production": "wrangler deploy --env production --dry-run",
    "deploy:production": "wrangler deploy --env production"
  },
  "dependencies": {
    "@astrojs/markdoc": "1.0.6",
    "@astrojs/starlight": "^0.40.0",
    "@astrojs/starlight-markdoc": "0.6.0",
    "astro": "^6.1.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.8",
    "mjml": "^5.4.0",
    "typescript": "^5.9.3",
    "wrangler": "^4.124.0"
  }
}
