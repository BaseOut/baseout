---
/**
 * The page title, preceded by the one thing a reader of multi-platform documentation needs before
 * the first sentence: whether this page is about them.
 *
 * WHY A CHIP AND NOT A SENTENCE. It answers a yes/no question that is asked on every page, and a
 * sentence answering that on every page becomes furniture the eye stops seeing. The chip carries
 * the platform's own mark, so it is recognised before it is read.
 *
 * THE "ALL PLATFORMS" CHIP IS DELIBERATELY QUIET, and it appears only where a platform exists to
 * contrast with. 15 of our 38 pages have no platform at all, and stamping "All platforms" on a
 * billing page would be answering a question nobody asked there.
 *
 * THE HIDDEN-BY-FILTER NOTICE lives here rather than in the sidebar because this is where a reader
 * who followed an outside link arrives, having never seen the filter that is confusing them.
 */
import Default from '@astrojs/starlight/components/PageTitle.astro';
import PlatformMark from './PlatformMark.astro';
import { platform, type PlatformId } from '../lib/platforms';
import { manualForPath } from '../lib/api-docs';
import { entryDate, formatEntryDate } from '../lib/changelog';

const route = Astro.locals.starlightRoute;
const data = route.entry.data as {
  platform?: PlatformId;
  description?: string;
  template?: string;
  lastUpdated?: unknown;
};
const id = data.platform;
const p = id ? platform(id) : null;

/* THE DATE A CHANGELOG ENTRY IS ABOUT, ABOVE ITS TITLE.
 *
 * Dan, on video 2026-08-26, standing on an entry: "here I don't have context of when this got
 * deployed, which I think is important… either a label or part of the heading." He was right about
 * the fact as well as the need — this portal renders `lastUpdated` NOWHERE. Starlight's own
 * last-updated line is off (no `lastUpdated: true` in `astro.config.mjs`), so an entry carried a
 * date in its frontmatter, sorted the hub by it, and never showed it to the reader who had opened
 * the page.
 *
 * A KICKER, NOT A FOOTER LINE. Turning Starlight's `lastUpdated` option on would put the date under
 * the article, which answers the question after the reading rather than before it, and would put it
 * on all ninety documentation pages to fix three. Every changelog worth copying — Linear, Stripe,
 * GitHub — sets the date above the title, because on a dated record the date is half the heading.
 *
 * ONLY IN THE CHANGELOG, and asked through `manualForPath` rather than a path prefix, for the
 * reason `DocsSidebar.astro` gives at length: the registry is what three other files already agree
 * through. The hub is excluded by its own id — it is a list of dates, not one of them.
 *
 * THE WORD IS ABSENT ON PURPOSE. Oleh, 2026-08-26: the label is the date and nothing else.
 * `lib/changelog.ts` carries the argument — `lastUpdated` does not mean "deployed", and this repo
 * does not print a claim it cannot trace. */
const isChangelogEntry =
  manualForPath(Astro.url.pathname) === 'changelog' && route.id !== 'changelog/index';
const stamp = isChangelogEntry ? entryDate(data.lastUpdated) : undefined;

/* THE LEDE. Both GitHub and Stripe put exactly one summary sentence under the title of every page,
   larger than body and muted, and it is the cheapest structural thing either of them does: it tells
   a reader who arrived from search whether to keep reading before they commit to a paragraph.
   Starlight renders the title and nothing else, and `description` goes to a `<meta>` tag where no
   reader ever sees it. So all 49 pages already have a lede written; they simply were not showing
   it. Rendering it here costs one line per page and no content edits at all.
   The splash landing is excluded: its hero already carries a tagline, and a second one under it
   would be the same sentence twice. */
const lede = data.template === 'splash' ? null : data.description;
---

{stamp && <p class="pp-date">{formatEntryDate(stamp)}</p>}

{
  p && (
    <div class="pp" data-page-platform={p.id}>
      <span class="pp-chip">
        <PlatformMark id={p.id} size={13} />
        {p.name} only
      </span>
    </div>
  )
}

<Default><slot /></Default>

{/* THE SEARCH FILTER'S HALF OF THE PLATFORM STORY. Pagefind reads `data-pagefind-filter` out of
    the indexed body at build time, and this is the one component that renders on every docs page,
    so emitting it here is what makes it impossible to forget on a new page.

    A page with no platform is tagged `all` rather than left untagged: Pagefind excludes a document
    that carries no value for a filter you query, and a page about billing is TRUE of every
    platform, not of none. The modal queries the reader's platforms plus `all`, which is what makes
    narrowing to Notion hide Airtable's connecting page and keep "How backups work". */}
<span class="pp-index" data-pagefind-filter={`platform:${id ?? 'all'}`} aria-hidden="true"></span>

{lede && <p class="pp-lede">{lede}</p>}

{
  p && (
    <p class="pp-notice" data-platform-page-notice hidden>
      <span>
        This page is about {p.name}, which your filter is hiding. Nothing is missing from the
        documentation.
      </span>
      <button type="button" data-platform-page-show>
        Show {p.name}
      </button>
    </p>
  )
}

<style>
  .pp {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 8px;
  }

  /* Sized and weighted to be read before the title rather than after it, and coloured with the
     accent so it is the one thing above the heading that is not muted. `--bo-t-13` is the rung the
     portal's own metadata rows already use; nothing is minted for one line. */
  .pp-date {
    margin: 0 0 6px;
    font-size: var(--bo-t-13);
    font-weight: 700;
    line-height: 1.4;
    color: var(--bo-primary);
  }

  .pp-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 3px 10px;
    border-radius: 999px;
    background: var(--bo-soft-primary-bg);
    color: var(--bo-soft-primary-fg);
    font-size: var(--bo-t-12);
    font-weight: 600;
    line-height: 1.4;
  }


  /* One step above body and muted, so it reads as a summary of the page rather than its first
     paragraph. It sits inside the title block, above the rule Starlight draws under the header. */
  /* It carries a filter value and nothing else. Not `hidden`, because Pagefind's crawler is the
     only consumer and a zero-size inline box is cheaper than a display rule to argue about. */
  .pp-index {
    display: none;
  }

  .pp-lede {
    margin: 8px 0 0;
    max-width: 38rem;
    font-size: var(--bo-t-18);
    line-height: 1.5;
    color: var(--bo-muted);
    text-wrap: pretty;
  }

  .pp-notice {
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin: 16px 0 0;
    padding: 10px 14px;
    border-radius: var(--bo-r-8);
    background: var(--bo-soft-warning-bg);
    color: var(--bo-soft-warning-fg);
    font-size: var(--bo-t-13);
    line-height: 1.5;
  }

  .pp-notice[hidden] {
    display: none;
  }

  .pp-notice button {
    margin-left: auto;
    flex: none;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    font-size: var(--bo-t-13);
    font-weight: 700;
    text-decoration: underline;
    cursor: pointer;
    white-space: nowrap;
  }

  .pp-notice button:focus-visible {
    outline: 2px solid var(--bo-primary);
    outline-offset: 2px;
  }
</style>
