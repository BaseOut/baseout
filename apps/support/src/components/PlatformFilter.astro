---
/**
 * "Show docs for" — the platform control above the documentation tree.
 *
 * IT SUBTRACTS, IT NEVER SUBSTITUTES, and that distinction is the whole design. A platform DROPDOWN
 * scopes the site: pick ClickUp and the docs claim to be ClickUp's, which is false for the 15 of our
 * 38 pages that never name a platform at all. Clerk shipped that shape and their universal pages
 * started losing to platform-scoped ones in search (their ticket, DOCS-11910); Next.js has had the
 * same class of bug open for months, where switching the variant leaves you on a page that was never
 * written for it. None of the six connector catalogs we surveyed uses one.
 *
 * A multi-select that starts with everything ON has neither problem. The first visit shows the whole
 * documentation, so nothing is hidden from someone who has not chosen; narrowing removes noise and
 * never replaces a page with another platform's. `PlatformPicker` has exactly one behaviour now and
 * that is it — the roadmap's single-select `scope` mode was deleted on 2026-08-21 rather than kept
 * beside it.
 *
 * AND NOTHING TICKED IS NOTHING NARROWED, since the same pass. The control used to refuse to switch
 * the last platform off; it now lets a reader empty it, which shows the whole manual again — the
 * same view they started from, reached from the other end. `All` and `None` are in the list.
 *
 * THE CONTROL IS NOW SHARED, AND IT IS COLLAPSED HERE — as it is everywhere, since the inline chip
 * row was deleted. It was three chips wide here and wrapped to two lines from the day it shipped:
 * this sidebar is roughly 190px and one chip is a 13px mark, a 6px gap, a 12px name and 20px of
 * padding, so "Airtable" alone is 88px. Dan asked about it twice. This surface is the reason the
 * disclosure exists; it is now what every surface gets.
 *
 * WHY IT LIVES ABOVE THE TREE rather than above the content: it governs what EXISTS, and the
 * sidebar is where "what exists" is answered. Over the content it would compete with the page title
 * and have no authority over navigation.
 *
 * THE MAP IS BUILT HERE, NOT GUESSED IN THE BROWSER. Every page carrying a `platform` frontmatter
 * field is emitted as href → platform so the client can hide the right rows without parsing titles.
 * The site is static, so this is the only moment the two halves can meet.
 */
import { getCollection } from 'astro:content';
import { PLATFORMS, FILTER_KEY } from '../lib/platforms';
import PlatformPicker from './PlatformPicker.astro';

const docs = await getCollection('docs');
const pages: Record<string, string> = {};
for (const entry of docs) {
  const id = (entry as { data: { platform?: string } }).data.platform;
  if (id) pages[`/${entry.id}/`] = id;
}

/* The whole mark travels with the map so the client can draw one on each row it finds: viewBox,
   gradient defs and every path with its own fill. Sending the geometry rather than a class name
   means the sidebar's rows and the control above them come from one source; a second copy of these
   paths in a stylesheet would be a second thing to keep in step with `lib/platforms.ts`. */
const marks = Object.fromEntries(PLATFORMS.map((p) => [p.id, p.mark]));
---

<div class="pf" data-platform-filter data-storage-key={FILTER_KEY}>
  <span class="pf-h" id="pf-h">Show docs for</span>

  {/* ONE ROW, AND THE WAY BACK IS ON IT. An amber sentence used to sit under this control saying
      which platforms were hidden. It went on 2026-08-21, on Dan's argument: the only person who
      ever read it was the person who had just set the filter, the trigger already carries the marks
      of what is on, and it was spending three lines of a 300px rail to report a choice back to its
      own author. What it carried that nothing else does is the ONE-CLICK WAY BACK, so that is the
      part that stayed. The per-page notice in `DocsPageTitle.astro` is a different thing and is
      untouched: that one fires when a reader lands on a page their own filter hides, which is the
      case this argument does not cover, because nothing on screen explains it.

      THE RESET IS A GRID TRACK, NOT A FLEX ITEM PUSHED RIGHT, and that is load bearing. As a flex
      item the picker would shrink to the width of its own trigger, and the list it opens is
      positioned and width-capped against that box — so a trigger reading "Airtable" would drag the
      popover in to match. A `minmax(0, 1fr)` track holds the picker at the full column width
      whatever the trigger currently says.

      IT CANNOT MAKE THE ROW JUMP. Its height is the trigger's by construction: the same 12px at
      1.4, the same 4px of padding, and a 1px border that is transparent until hover rather than
      absent until hover. Measured at 26.8px against the trigger's 26.8px, so the tree below does
      not twitch each time the filter changes. */}
  <div class="pf-row">
    <PlatformPicker label="Show docs for" />
    <button
      type="button"
      class="pf-reset"
      data-platform-show-all
      aria-label="Show all platforms"
      hidden
    >
      Show all
    </button>
  </div>

  {/* `is:inline` says out loud what Astro would do anyway with an attribute present, and stops the
      compiler warning that this script will not be processed. It is data, not code. */}
  <script
    is:inline
    type="application/json"
    data-platform-map
    set:html={JSON.stringify({ pages, marks })}
  />
</div>

<script>
  import { mountPlatformFilter } from '../lib/platform-filter';
  mountPlatformFilter();
</script>

<style>
  .pf {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 0 0 16px;
    margin-bottom: 8px;
    border-bottom: 1px solid var(--bo-base-300);
  }

  /* Starlight's prose rhythm is a general-sibling rule that reaches inside any flex OR grid box,
     and every child after the first would take 16px of margin it was never given here. `:global(*)`
     on the child half because the picker is another component and carries no scope hash of ours;
     a bare `> *` would have ours appended and would ship as valid CSS matching nothing. */
  .pf > :global(*),
  .pf-row > :global(*) {
    margin-top: 0;
  }

  /* 11px is the floor, and it is spent here rather than on anything read in sequence: an uppercase
     tracked micro-label is a signpost, not prose. */
  .pf-h {
    font-size: var(--bo-t-11);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--bo-muted);
  }

  /* Two tracks: the picker takes what is left, the reset takes what it needs. `minmax(0, 1fr)`
     rather than `1fr` so the first track can go below its own min-content width instead of pushing
     the reset out of the rail. */
  .pf-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 8px;
  }

  /* TERTIARY, because it undoes rather than does. Ghost at rest with a border that is already
     there and merely transparent, so hover paints it instead of inserting it and the row keeps its
     height to the pixel. */
  .pf-reset {
    padding: 4px 8px;
    border: 1px solid transparent;
    border-radius: var(--bo-r-6);
    background: none;
    color: var(--bo-muted);
    font: inherit;
    font-size: var(--bo-t-12);
    font-weight: 600;
    line-height: 1.4;
    white-space: nowrap;
    cursor: pointer;
    transition:
      background-color 150ms ease-out,
      border-color 150ms ease-out,
      color 150ms ease-out;
  }

  .pf-reset:hover {
    border-color: var(--bo-base-300);
    background: var(--bo-base-200);
    color: var(--bo-base-content);
  }

  /* Restated rather than left to the UA sheet. A grid item is blockified, and any author `display`
     that ever lands on this button would outrank `[hidden]` and leave a reset on screen for a
     filter that is not narrowed. This portal has shipped that failure before. */
  .pf-reset[hidden] {
    display: none;
  }

  .pf-reset:focus-visible {
    outline: 2px solid var(--bo-primary);
    outline-offset: -1px;
  }

  @media (prefers-reduced-motion: reduce) {
    .pf-reset {
      transition-duration: 0s;
    }
  }
</style>
