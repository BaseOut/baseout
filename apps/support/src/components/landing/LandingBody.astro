  .vb-shot-light {
    display: block;
  }

  .vb-shot-dark {
    display: none;
  }

  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .vb-shot-light {
      display: none;
    }

    :root:not([data-theme='light']) .vb-shot-dark {
      display: block;
    }
  }

  :root[data-theme='dark'] .vb-shot-light {
    display: none;
  }

  :root[data-theme='dark'] .vb-shot-dark {
    display: block;
  }

  :root[data-theme='light'] .vb-shot-light {
    display: block;
  }

  :root[data-theme='light'] .vb-shot-dark {
    display: none;
  }

  /* ── The noun that changes ───────────────────────────────────────────────────────────
   * EVERY READING OF EVERY SENTENCE IS SERVER-RENDERED and one of them is shown. The alternative
   * was rewriting `textContent` from a script, and it loses twice: the neutral sentence would be
   * painted first and visibly swapped a moment later, and the swap would depend on a module that a
