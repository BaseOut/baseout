---
/**
 * The floating control that flips the landing between its two variants.
 *
 * TEMPORARY, AND BUILT TO BE DELETED: this file, `lib/shot-switch.ts`, the pre-paint script and the
 * `html[data-shots]` rules in `LandingBody.astro` and `PlatformStart.astro`, and the losing
 * variant's markup all go in one commit once the client picks. That was the deal the last preview
 * switch on this page made, and keeping it is what stops a review instrument becoming a feature
 * nobody remembers agreeing to.
 *
 * WHY IT FLOATS. In the flow it charges the page a row and a rule above the first thing anyone came
 * to read, which is exactly what the previous switch was told off for (Oleh, 2026-08-19). Fixed, it
 * costs the layout nothing and can be ignored.
 *
 * BOTTOM LEFT IS THE ONE FREE CORNER, and this was checked rather than assumed. Everything fixed on
 * this page was enumerated first: `ChatDock`'s drawer is `position: fixed` with
 * `inset-inline-end: 0` and `inset-block: var(--sl-nav-height) 0`, so it owns the ENTIRE right edge
 * from the header to the floor whenever the chat is open — a bottom-right control would be under it
 * exactly when someone is using the assistant. Starlight's `.right-sidebar` is fixed on the same
 * side. The Astro dev toolbar sits bottom centre. Nothing is fixed on the left. The chat launchers
 * are ordinary in-flow buttons in the hero and the search bar, so they are never covered by this.
 *
 * IT IS LAST IN THE DOCUMENT so it is last in the tab order: a demo toggle must not sit between the
 * reader and the page's real links. `data-pagefind-ignore` for the matching reason — the landing is
 * already out of the index, and this would not belong in it if it were not.
 *
 * ITS STYLES LIVE HERE WITH IT. An Astro scoped `<style>` does not reach a child component, so a
 * component that is extracted without its CSS renders unstyled while both gates stay green. That
 * has cost this codebase five separate rounds.
 */
import { SHOT_VARIANTS } from '../../lib/shot-switch';
---

<div
  class="sw not-content"
  role="group"
  aria-label="Screenshot treatment"
  data-shot-switch
  data-pagefind-ignore
>
  {
    SHOT_VARIANTS.map((v) => (
      <button type="button" class="sw-pick" data-shot-pick={v.key} aria-pressed="false">
        {v.label}
      </button>
    ))
  }
</div>

<script>
  import { mountShotSwitch } from '../../lib/shot-switch';
  mountShotSwitch();
</script>

<style>
  .sw {
    position: fixed;
    left: 16px;
    bottom: 16px;
    /* Above the chat drawer's 1000, so the control is still reachable while the drawer is open. It
       cannot overlap it — different edges — but a review instrument that a panel can bury is one
       that gets reported as broken. */
    z-index: 1001;
    display: flex;
    gap: 4px;
    padding: 4px;
    border: 1px solid var(--bo-base-300);
    border-radius: var(--bo-r-8);
    background: var(--bo-base-100);
    /* The one shadow on this page, and legal for the reason the drawer's is: the thing genuinely
       floats above the document rather than sitting in it. The COLOUR is a token mix, never a raw
       black — a literal 40% black is the heaviest paint on the page in light theme and can never
       follow a theme. */
    box-shadow: 0 12px 32px color-mix(in srgb, var(--bo-base-content) 24%, transparent);
  }

  /* Starlight's prose rhythm is a general-sibling rule and it reaches inside any nested flex box:
     the first child keeps `margin-top: 0` and every sibling after it takes 16px, which is what
     staggered the last switch's buttons 16px below each other inside their own row. `not-content`
     on the root exempts the subtree; this is the belt to that pair of braces. */
  .sw > * {
    margin-top: 0;
  }

  .sw-pick {
    height: 28px;
    padding: 0 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 0;
    border-radius: var(--bo-r-6);
    background: none;
    color: var(--bo-muted);
    font: inherit;
    font-size: var(--bo-t-12);
    font-weight: 600;
    line-height: 1;
    cursor: pointer;
    transition:
      color 150ms ease-out,
      background-color 150ms ease-out;
  }

  .sw-pick:hover {
    color: var(--bo-base-content);
    background: var(--bo-base-200);
  }

  /* THE SELECTED LOOK IS DRIVEN BY THE ATTRIBUTE, NOT BY `aria-pressed`, because the attribute is
     stamped by the pre-paint script and `aria-pressed` is not corrected until the module runs. Keyed
     to the state the browser already has, the control cannot show the wrong segment lit for a frame.
     `aria-pressed` is still maintained by the module: it is what a screen reader reads. */
  :root[data-shots='reactive'] .sw-pick[data-shot-pick='reactive'],
  :root[data-shots='filter'] .sw-pick[data-shot-pick='filter'] {
    color: var(--bo-soft-primary-fg);
    background: var(--bo-soft-primary-bg);
  }

  .sw-pick:focus-visible {
    outline: 2px solid var(--bo-primary);
    outline-offset: -1px;
  }
</style>
