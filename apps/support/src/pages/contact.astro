     and the submit button is not, and two solid buttons in one form is two first choices. */
  .sb-file-add {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 12px;
    border: 1px solid var(--bo-base-300);
    border-radius: var(--bo-r-6);
    background: var(--bo-base-100);
    color: var(--bo-muted-strong);
    font: inherit;
    font-size: var(--bo-t-13);
    font-weight: 500;
    cursor: pointer;
    transition: border-color 150ms ease-out, background-color 150ms ease-out;
