    place-items: center;
    flex: none;
    width: 20px;
    height: 20px;
    padding: 0;
    border: 0;
    border-radius: var(--bo-r-4);
    background: none;
    color: var(--bo-muted);
    cursor: pointer;
    transition: background-color 140ms ease, color 140ms ease;
