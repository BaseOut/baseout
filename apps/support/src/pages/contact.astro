  .sb-receipt-line { margin: 0; font-size: var(--bo-t-14); line-height: 1.5; }

  .sb-receipt-quiet { font-size: var(--bo-t-13); color: var(--bo-muted); }

  /* ── Suggested articles ────────────────────────────────────────────────────────────────────── */

  /* The same panel as the duplicate strip below, because it is the same offer in the other lane:
