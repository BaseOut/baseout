  /* REMOVE TRAVELS WITH ITS WORD, the same rule the dismiss control two panels up follows. */
  .sb-hand-x {
    display: flex;
    flex: none;
    align-items: center;
    gap: 4px;
    padding: 4px 8px;
    border: 0;
    border-radius: var(--bo-r-6);
    background: transparent;
    color: var(--bo-muted);
    font: inherit;
    font-size: var(--bo-t-12);
    cursor: pointer;
  }

  .sb-hand-x:hover { background: var(--bo-base-300); color: var(--sl-color-white); }

  .sb-hand-x:focus-visible {
    outline: 2px solid var(--bo-primary);
    outline-offset: 1px;
  }

