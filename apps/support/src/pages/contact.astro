  .sb-file-list :global(.sb-file-size) {
    flex: none;
    color: var(--bo-muted);
    font-variant-numeric: tabular-nums;
  }

  /* ── IT SAT 10px ABOVE THE ROW'S CENTRE, AND `align-items: center` WAS NOT THE PROBLEM ─────────
     Oleh, 2026-08-26: "кнопка Remove, вона не по центру". Measured with a file attached, at 900:

       .sb-file      y 1090.8  h 68.8   centre 1125.2   (align-items: center)
       .sb-file-name                    centre 1125.2   ✓
       .sb-file-size                    centre 1125.2   ✓
       .sb-file-drop y 1098.8  h 32.8   centre 1115.2   — 10px high

