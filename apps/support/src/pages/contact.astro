     would stamp the page hash onto the `*`. */
  .sb-arts-list :global(.sh-row) {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0;
    padding: 8px;
    border-radius: var(--bo-r-6);
    color: var(--sl-color-text-accent);
    font-size: var(--bo-t-14);
    text-decoration: none;
  }

  .sb-arts-list :global(.sh-row:hover) { background: var(--bo-base-300); text-decoration: underline; }

  .sb-arts-list :global(.sh-row:focus-visible) {
    outline: 2px solid var(--bo-primary);
    outline-offset: -1px;
  }

  .sb-arts-list :global(.sh-row-icon) { display: flex; flex: none; color: var(--bo-muted); }

  .sb-arts-list :global(.sh-row-body) { flex: 1; min-width: 0; }

