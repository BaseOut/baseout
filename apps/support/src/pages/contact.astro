     context for the people who never open it, and a block that arrived already unrolled would
     push the send button off the screen on the one door that most needs pressing. */
  .sb-hand-toggle {
    display: flex;
    flex: 1;
    align-items: center;
    gap: 6px;
    min-width: 0;
    padding: 0;
    border: 0;
    background: none;
    color: var(--bo-muted-strong);
    font: inherit;
    font-size: var(--bo-t-13);
    font-weight: 600;
    text-align: start;
    cursor: pointer;
  }

  .sb-hand-toggle:focus-visible {
    outline: 2px solid var(--bo-primary);
    outline-offset: 2px;
    border-radius: var(--bo-r-6);
  }

  .sb-hand-n {
    font-weight: 400;
    color: var(--bo-muted);
  }

  .sb-hand-chev {
    flex: none;
    color: var(--bo-muted);
