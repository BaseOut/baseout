  .sb-file-list :global(.sb-file) {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 8px 12px;
    font-size: var(--bo-t-13);
  }

  .sb-file-list :global(.sb-file + .sb-file) { border-top: 1px solid var(--bo-base-300); }

