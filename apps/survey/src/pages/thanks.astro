  .rep-end__copy[data-state='done'] > [data-label='idle'] {
    opacity: 0;
    visibility: hidden;
  }

  .rep-end__copy[data-state='done'] {
    color: var(--bo-success);
    border-color: var(--bo-success);
  }

  @media (max-width: 30rem) {
    .rep-end__act > .bo-btn {
      width: 100%;
    }
  }

  /* The opening states what the page is and then gets out of the way. `.rep-open__aside` sat here
     and carried the report-by-email line; it went with the line on 2026-08-31 rather than being
     left as a rule with nothing to style. */
  .rep-open { padding-top: var(--bo-space-5); }

  .rep-instrument {
    display: grid;
    align-content: start;
    gap: var(--bo-space-4);
