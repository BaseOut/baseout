     button leaves and stops at a width that still shows a hostname, which is the point at which the
     row wraps instead of continuing to squeeze. */
  .rep-end__url {
    flex: 1;
    min-width: 14rem;
    text-align: center;
    font-variant-numeric: tabular-nums;
    cursor: text;
  }

