{
  "name": "@baseout/web",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.dev.vars scripts/dev.mjs",
    "setup:certs": "mkdir -p .certs && mkcert -install && mkcert -cert-file .certs/baseout.local.pem -key-file .certs/baseout.local-key.pem baseout.local localhost 127.0.0.1",
    "setup:hosts": "grep -q baseout.local /etc/hosts || echo '127.0.0.1 baseout.local' | sudo tee -a /etc/hosts",
    "build": "pnpm run build:dev",
    "wrangler": "CLOUDFLARE_ENV=dev node --env-file-if-exists=.dev.vars scripts/launch.mjs build local && wrangler dev --remote --port 4331 --var PUBLIC_AUTH_BASE_URL:https://baseout.local:4331",
    "wrangler:baseout": "CLOUDFLARE_ENV=dev node --env-file-if-exists=.dev.vars scripts/launch.mjs build local && wrangler dev --remote --port 4331 --var PUBLIC_AUTH_BASE_URL:https://baseout.dev",
    "secrets:sync": "node scripts/sync-secrets.mjs --config dist/server/wrangler.json",
    "cf-typegen": "wrangler types --env dev",
    "pretypecheck": "test -f worker-configuration.d.ts || wrangler types --env dev",
    "astro": "astro",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build -o dist/storybook",
    "audit:components": "vitest run src/components/ui/stories-coverage.test.ts src/components/component-classification.test.ts && storybook build -o dist/storybook",
    "setup": "node scripts/setup.mjs --force",
    "setup:tokens": "node scripts/setup.mjs --tokens-only",
    "seed": "pnpm --filter @baseout/db run db:seed",
    "db:seed:entitlements": "pnpm --filter @baseout/db run db:seed:entitlements",
    "db:backfill:plan-id": "node --env-file=.dev.vars --import tsx/esm scripts/backfill-plan-id.ts",
    "setup:stripe:entitlements": "node --env-file=.dev.vars --import tsx/esm scripts/setup-stripe-entitlements.ts",
    "db:migrate": "pnpm --filter @baseout/db run db:migrate",
    "db:check": "pnpm --filter @baseout/db run db:check",
    "typecheck": "astro check",
    "lint": "eslint .",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:unit:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:harness": "vitest run --config vitest.harness.config.ts",
    "test:db:up": "docker compose -f docker-compose.test.yml up -d",
    "test:db:down": "docker compose -f docker-compose.test.yml down -v",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium",
    "build:dev": "CLOUDFLARE_ENV=dev node --env-file-if-exists=.dev.vars scripts/launch.mjs build",
    "build:staging": "CLOUDFLARE_ENV=staging node --env-file-if-exists=.dev.vars scripts/launch.mjs build",
    "build:production": "CLOUDFLARE_ENV=production node --env-file-if-exists=.dev.vars scripts/launch.mjs build",
    "deploy:dev": "wrangler deploy --env dev && pnpm run secrets:sync",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy:production": "wrangler deploy --env production",
    "dev:remote": "DEV_REMOTE=1 node --env-file-if-exists=.dev.vars scripts/dev.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^13.7.0",
    "@astrojs/react": "^5.0.7",
    "@baseout/db-schema": "workspace:*",
    "@baseout/embed-protocol": "workspace:*",
    "@baseout/shared": "workspace:*",
    "@dagrejs/dagre": "^3.0.0",
    "@opensided/theme": "file:./vendor/@opensided/theme",
    "@platejs/basic-nodes": "^53.0.0",
    "@tailwindcss/vite": "^4.2.2",
    "@xyflow/react": "^12.11.0",
    "apexcharts": "^5.3.4",
    "astro": "^6.4.8",
    "better-auth": "^1.6.13",
    "drizzle-orm": "^0.45.2",
    "nanostores": "^1.3.0",
    "platejs": "^53.2.1",
    "postgres": "^3.4.9",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^7.18.2",
    "stripe": "^22.0.2",
    "tailwindcss": "^4.2.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.8",
    "@cloudflare/vitest-pool-workers": "^0.14.9",
    "@cloudflare/workers-types": "^4.20250906.0",
    "@fortawesome/fontawesome-free": "^6.7.2",
    "@iconify-json/lucide": "^1.2.105",
    "@iconify/tailwind4": "^1.2.3",
    "@playwright/test": "^1.59.1",
    "@storybook/addon-themes": "10.4.3",
    "@storybook/html-vite": "10.4.3",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.5",
    "daisyui": "^5.5.19",
    "drizzle-kit": "^0.31.10",
    "embedded-postgres": "16.14.0-beta.17",
    "eslint": "^10.2.1",
    "eslint-plugin-astro": "^1.7.0",
    "happy-dom": "^20.9.0",
    "jsdom": "^29.1.1",
    "msw": "^2.13.4",
    "storybook": "10.4.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.1",
    "vite": "7.3.6",
    "vitest": "^4.1.5",
    "wrangler": "^4.124.0"
  },
  "overrides": {
    "vite": "~7.3.1"
  }
}
