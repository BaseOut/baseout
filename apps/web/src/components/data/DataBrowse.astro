      pager.reset(); renderGrid(); touch();
    });

    // ── Row open → record sidebar ───────────────────────────────────────────────
    root.addEventListener('click', (e) => {
      // Copy a record id (id column) — don't open the record; flash a check-mark.
      const copyBtn = (e.target as HTMLElement).closest<HTMLElement>('[data-dg-copyid]');
      if (copyBtn) {
        e.stopPropagation();
        navigator.clipboard?.writeText(copyBtn.dataset.dgCopyid!);
        flashCopied(copyBtn);
        return;
      }
      // A clicked linked-record name opens THAT record (drill), not the row's own record.
      // `beside` carries the modifier through to the host. Without it the event said only WHICH
      // record, so every open reused the anchor and ⌘-click silently replaced the panel you were
      // reading (founder, 2026-08-04). Changelog and Attachments already read the modifier at the
      // source; Browse was the one grid that did not.
      const beside = (ev: MouseEvent) => ev.metaKey || ev.ctrlKey;
      const chip = (e.target as HTMLElement).closest<HTMLElement>('[data-dg-openrec]');
      if (chip) { e.stopPropagation(); document.dispatchEvent(new CustomEvent('data:openRecord', { detail: { id: chip.dataset.dgOpenrec, beside: beside(e as MouseEvent) } })); return; }
      const tr = (e.target as HTMLElement).closest<HTMLElement>('[data-dg-open]');
      if (!tr) return;
      document.dispatchEvent(new CustomEvent('data:openRecord', { detail: { id: tr.dataset.dgOpen, tableId: active().tableId, beside: beside(e as MouseEvent) } }));
    });

    // Middle-click opens beside too — the same gesture Changelog and Attachments rows already
    // honour. Browse lacking it was a gap, not a decision.
    root.addEventListener('auxclick', (e) => {
      const me = e as MouseEvent;
      if (me.button !== 1) return;
      const tr = (me.target as HTMLElement).closest<HTMLElement>('[data-dg-open]');
      if (!tr) return;
      me.preventDefault();
      document.dispatchEvent(new CustomEvent('data:openRecord', { detail: { id: tr.dataset.dgOpen, tableId: active().tableId, beside: true } }));
    });

    // ── Table switching (facet pickers) ─────────────────────────────────────────
    const tableBase = new Map(snap.tables.map((t) => [t.id, t.baseId]));
    const baseFirstTable = new Map<string, string>();
    snap.tables.forEach((t) => { if (!baseFirstTable.has(t.baseId)) baseFirstTable.set(t.baseId, t.id); });
    const narrowTableFacet = (baseId: string) => {
      root.querySelectorAll<HTMLElement>('[data-facet="dbtable"] .ff-opt').forEach((row) => {
        const val = row.querySelector<HTMLInputElement>('[data-facet-opt]')?.value || '';
        row.style.display = tableBase.get(val) === baseId ? '' : 'none';
      });
      const baseName = snap.baseName[baseId];
      root.querySelectorAll<HTMLElement>('[data-facet="dbtable"] .ff-group').forEach((g) => {
        g.style.display = (g.textContent || '') === baseName ? '' : 'none';
      });
    };
    const setFacetLabel = (name: string, text: string) => {
      const lbl = root.querySelector<HTMLElement>(`[data-facet="${name}"] [data-facet-label]`);
      if (lbl) lbl.textContent = text;
    };
    const setFacetRadio = (name: string, val: string) => {
      root.querySelectorAll<HTMLInputElement>(`[data-facet="${name}"] [data-facet-opt]`).forEach((o) => (o.checked = o.value === val));
    };
    // In-place table switching is FORBIDDEN on a saved preset (Dan 2026-07-23) — the Base/Table
    // pickers render LOCKED the moment a preset is saved (setFacetLocked, below), so this handler
    // only ever runs against a Draft: it re-points THIS preset's base/table in place and resets the
    // table-bound config, since filters/sort/hidden-cols/colOrder cannot survive a table change.
    // (Switching table via a NEW tab — ＋ New blank preset / Duplicate current — is unaffected; those
    // just open a fresh Draft with its own scope, handled by newView().)
    function repointDraftTable(tid: string) {
      const v = active();
      if (v.saved || v.tableId === tid) return; // defensive: the picker is disabled once saved
      v.tableId = tid;
      v.filterTree = emptyGroup(); v.sortField = ''; v.sortDir = 1; v.hiddenCols = new Set(); v.colOrder = [];
      // `commentFilter` resets too. It is the one item here that could NOT dangle — all/with/without
      // is table-agnostic, unlike the field ids above — so this is about consistency rather than
      // safety: every other lens the toolbar carries starts fresh on a table change, and a filter
      // silently surviving into a different table is a state the user did not ask for.
      v.commentFilter = 'all';
      loadActiveView(); renderViews();
    }
    // Reflect a scope picker's lock state onto its trigger — a bubbling `facetlock` event that
    // FacetFilter itself owns the visual treatment for (disabled + lock glyph + tooltip reason).
    function setFacetLocked(name: string, locked: boolean) {
      root.querySelector(`[data-facet="${name}"]`)?.dispatchEvent(
        new CustomEvent('facetlock', { detail: { locked, reason: LOCK_REASON } }),
      );
    }
    // Comment-presence facet (comments-explorer) — unlike Base/Table this is a per-PRESET value that
    // is never locked (only scope locks on Save), so its trigger visual is synced directly here
    // rather than through setFacetRadio + a separate label call.
    function setCommentFacet(val: CommentFilter) {
      setFacetRadio('dgcomments', val);
      const ff = root.querySelector<HTMLElement>('[data-facet="dgcomments"]');
      if (!ff) return;
      const badge = ff.querySelector<HTMLElement>('[data-facet-selbadge]');
      if (badge) badge.hidden = val === 'all';
      ff.querySelector('[role="button"]')?.classList.toggle('ff-on', val !== 'all');
    }
    function syncFacetsToActive() {
      const t = activeTable(); const v = active();
      setFacetRadio('dbbase', t.baseId); setFacetLabel('dbbase', snap.baseName[t.baseId]); narrowTableFacet(t.baseId);
      setFacetRadio('dbtable', t.id); setFacetLabel('dbtable', t.name);
      setFacetLocked('dbbase', v.saved); setFacetLocked('dbtable', v.saved);
      setCommentFacet(v.commentFilter);
      renderFilter();
    }
    root.addEventListener('facetchange', (ev) => {
      const d = (ev as CustomEvent).detail;
      // Comment presence stays editable on a SAVED preset — only Base/Table lock on save.
      if (d.name === 'dgcomments') {
        active().commentFilter = d.value === 'with' || d.value === 'without' ? d.value : 'all';
        pager.reset(); renderBody(); touch();
        return;
      }
      if (active().saved) return; // locked scope — the trigger is disabled, this is a defensive no-op
      if (d.name === 'dbbase') {
        const baseId = d.value; narrowTableFacet(baseId);
        repointDraftTable(baseFirstTable.get(baseId)!);
      } else if (d.name === 'dbtable') {
        repointDraftTable(d.value);
      }
    });

    // ── Search (in-table only; cross-table master-search is a deferred later modal) ──────
    const searchInput = root.querySelector<HTMLInputElement>('[data-dg-search]')!;
    searchInput.addEventListener('input', () => {
      active().query = searchInput.value.trim().toLowerCase();
      pager.reset(); renderBody(); touch();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key !== '/') return;
      const ae = document.activeElement as HTMLElement | null;
      if (ae && (ae.tagName === 'INPUT' || ae.tagName === 'TEXTAREA' || ae.isContentEditable)) return;
      if (searchInput.offsetParent !== null) { e.preventDefault(); searchInput.focus(); }
    });

    // ── Clear ────────────────────────────────────────────────────────────────────
    root.querySelectorAll<HTMLElement>('[data-dg-clear]').forEach((b) => b.addEventListener('click', () => {
      const v = active();
      v.filterTree = emptyGroup(); v.hiddenCols = new Set(); v.query = ''; searchInput.value = ''; v.sortField = ''; v.commentFilter = 'all'; pager.reset();
      // facetreset (not a plain value set) so the radio + selbadge repaint through the component's
      // own logic, same as every other facet Clear resets.
      root.querySelector('[data-facet="dgcomments"]')?.dispatchEvent(new CustomEvent('facetreset'));
      renderFields(); renderFilter(); renderGrid(); touch();
    }));

    // ── Save / Discard — real toolbar markup (server-rendered, `hidden` by default); wired once,
    // toggled every render (see renderViews()). saveView/revertView are function declarations
    // (hoisted), so referencing them here ahead of their own definitions is safe.
    const saveBtn = q<HTMLButtonElement>('[data-dv-save]');
    const discardBtn = q<HTMLButtonElement>('[data-dv-discard]');
    saveBtn.addEventListener('click', () => saveView(active()));
    discardBtn.addEventListener('click', () => revertView(active()));

    // ── Views: load / switch / lifecycle ─────────────────────────────────────────
    // Load the active view's config into the toolbar + grid.
    async function loadActiveView() {
      const v = active();
      searchInput.value = v.query;
      pager.reset();
      syncFacetsToActive();
      renderFilter();
      // Table switch / preset open: fetch page-1 when this table has no/few SSR rows.
      const ok = await ensureCoverage(v.tableId, pager.pageSize);
      if (ok) renderGrid();
    }
    // Open a preset as a tab (or just re-activate it if already open) — a library-row click and a tab
    // click both route here. Opening pushes it onto the tab bar; the preset always lives in the library.
    function openPreset(id: string) {
      if (!views.some((v) => v.id === id)) return;
      if (!openIds.includes(id)) openIds.push(id);
      if (id === activeId) return;
      activeId = id; loadActiveView(); renderViews();
    }
    // Close a tab (✕) — the preset stays in the library. Activate a neighbour; if none remain open,
    // spin up a fresh blank preset so the grid always has an active config (never a blank grid).
    function closeTab(id: string) {
      const i = openIds.indexOf(id); if (i < 0) return;
      openIds.splice(i, 1);
      if (activeId !== id) { renderViews(); return; }
      const next = openIds[i] || openIds[i - 1];
      if (next) { activeId = next; loadActiveView(); renderViews(); return; }
      // Last tab closed → re-open a library preset so the grid stays alive (never blank, and no pile of
      // throwaway blanks). Only spin up a fresh one if the library is somehow empty.
      const fallback = views.find((v) => v.id !== id) || views[0];
      if (fallback) openPreset(fallback.id); else newView(false);
    }
    // ＋ New blank preset / Duplicate current — the ONLY ways to reach another table (Dan 2026-07-23).
    // Both arrive UNSAVED, with no baseline: a Draft, scope open, so base+table can be set right in
    // the (unlocked) toolbar pickers before the first Save.
    function newView(fromActive = false) {
      const src = fromActive ? active() : null;
      const id = `v-new-${idSeq++}`;
      // A new/duplicated preset is ungrouped by default; a duplicate keeps its source's group.
      const v: View = src ? {
        id, name: `${src.name} copy`, tableId: src.tableId, pinned: false, temporary: false, groupId: src.groupId,
        hiddenCols: new Set(src.hiddenCols), filterTree: cloneTree(src.filterTree),
        sortField: src.sortField, sortDir: src.sortDir, query: src.query, showRecId: src.showRecId, colOrder: src.colOrder.slice(),
        commentFilter: src.commentFilter, saved: false,
      } : {
        id, name: 'New preset', tableId: active().tableId, pinned: false, temporary: false, groupId: undefined,
        hiddenCols: new Set(), filterTree: emptyGroup(), sortField: '', sortDir: 1, query: '', showRecId: false, colOrder: [],
        commentFilter: 'all', saved: false,
      };
      views.push(v); openIds.push(id); activeId = id; loadActiveView(); renderViews();
    }
    // The first Save LOCKS the preset's base + table (see setFacetLocked/syncFacetsToActive) — after
    // this, only filters/fields/sort/search stay editable.
    function saveView(v: View) {
      v.baseline = snapConfig(v); v.saved = true;
      if (v.id === activeId) { setFacetLocked('dbbase', true); setFacetLocked('dbtable', true); }
      renderViews();
    }
    // Discard edits — restore the preset's config from its saved baseline and reload the grid. Not
    // offered on a never-saved Draft (no baseline to return to) — the kebab's Delete is the way out.
    function revertView(v: View) {
      if (!v.baseline) return;
      applyConfig(v, v.baseline);
      if (v.id === activeId) loadActiveView();
      renderViews();
    }
    function deleteView(id: string) {
      const oi = openIds.indexOf(id); if (oi >= 0) openIds.splice(oi, 1);
      const idx = views.findIndex((v) => v.id === id);
      if (idx < 0) return;
      views.splice(idx, 1);
      if (!views.length) { newView(); return; }
      if (activeId === id) {
        if (!openIds.length) openIds = [views[Math.max(0, idx - 1)].id];
        activeId = openIds[0]; loadActiveView();
      }
      renderViews();
    }
    function renameView(id: string, name: string) { const v = views.find((x) => x.id === id); if (v && name.trim()) { v.name = name.trim(); renderViews(); } }

    // ── Groups (folders) lifecycle ───────────────────────────────────────────────
    function newGroup(name = 'New group'): Group { const g = { id: `grp-new-${idSeq++}`, name, collapsed: false }; groups.push(g); return g; }
    function renameGroup(id: string, name: string) { const g = groups.find((x) => x.id === id); if (g && name.trim()) { g.name = name.trim(); renderViews(); } }
    // Deleting a group NEVER deletes its views — they fall back to Ungrouped.
    function deleteGroup(id: string) { views.forEach((v) => { if (v.groupId === id) v.groupId = undefined; }); const i = groups.findIndex((g) => g.id === id); if (i >= 0) groups.splice(i, 1); renderViews(); }
    function toggleCollapse(id: string) { const g = groups.find((x) => x.id === id); if (g) { g.collapsed = !g.collapsed; renderViews(); } }
    function moveViewToGroup(viewId: string, groupId: string | null) {
      const v = views.find((x) => x.id === viewId); if (!v) return;
      if (groupId === 'new') { const g = newGroup(); v.groupId = g.id; renderViews(); startRenameGroup(g.id); return; }
      v.groupId = groupId || undefined; renderViews();
    }

    // ── Views rendering (both layouts) ───────────────────────────────────────────
    const railEl = q('[data-dv-raillist]');
    const pinbarEl = q('[data-dv-pinbar]');
    // The row's width changes without the WINDOW changing — opening the preset library takes 240px,
    // and split view takes several hundred more. A resize listener would miss both, so observe the
    // element itself. `requestAnimationFrame` keeps the re-fit off the observer's own callback, which
    // is what ResizeObserver loops complain about.
    let fitQueued = 0;
    new ResizeObserver(() => {
      if (fitQueued) return;
      fitQueued = requestAnimationFrame(() => { fitQueued = 0; fitPinbar(); });
    }).observe(pinbarEl);

    // ── Library drag-and-drop — drag a preset row onto a group (or Ungrouped) to re-file it ─────────
    let dragViewId: string | null = null;
    railEl.addEventListener('dragstart', (e) => {
      const row = (e.target as HTMLElement).closest<HTMLElement>('[data-dv-viewrow]');
      if (!row) { e.preventDefault(); return; }
      dragViewId = row.dataset.dvViewrow!;
      e.dataTransfer!.effectAllowed = 'move';
      row.classList.add('dv-vrow-dragging');
      railEl.classList.add('dv-rail-dragging');
    });
    railEl.addEventListener('dragend', () => {
      dragViewId = null;
      railEl.classList.remove('dv-rail-dragging');
      railEl.querySelectorAll('.dv-vrow-dragging, .dv-dropactive').forEach((el) => el.classList.remove('dv-vrow-dragging', 'dv-dropactive'));
    });
    railEl.addEventListener('dragover', (e) => {
      if (dragViewId == null) return;
      const zone = (e.target as HTMLElement).closest<HTMLElement>('[data-dv-groupzone]');
      if (!zone) return;
      e.preventDefault();
      if (!zone.classList.contains('dv-dropactive')) { railEl.querySelectorAll('.dv-dropactive').forEach((el) => el.classList.remove('dv-dropactive')); zone.classList.add('dv-dropactive'); }
    });
    railEl.addEventListener('drop', (e) => {
      if (dragViewId == null) return;
      const zone = (e.target as HTMLElement).closest<HTMLElement>('[data-dv-groupzone]');
      if (!zone) return;
      e.preventDefault();
      const gid = zone.dataset.dvGroupzone!;
      const v = views.find((x) => x.id === dragViewId);
      dragViewId = null;
      if (v && (v.groupId || undefined) !== (gid === 'none' ? undefined : gid)) moveViewToGroup(v.id, gid === 'none' ? null : gid);
    });
    // The unsaved indicator shared by a library row and its tab: a Draft (never saved) gets the
    // ghost "Draft" badge; a SAVED preset with edits pending gets the quieter unsaved status dot.
    // The two never show together — a Draft's whole existence is "unsaved", the badge already says so.
    const unsavedMark = (v: View) =>
      !v.saved ? '<span class="badge badge-soft badge-warning badge-sm">Draft</span>' : isDirty(v) ? '<span class="status status-primary status-sm" aria-hidden="true"></span>' : '';
    // One row shape used by the library rail sections.
    const vrow = (v: View) => `
      <div class="dv-vrow ${v.id === activeId ? 'dv-active' : ''} ${openIds.includes(v.id) ? 'dv-open' : ''}" data-dv-tab="${v.id}" data-dv-viewrow="${v.id}" role="tab" draggable="true">
        <span class="dv-vrow-grip" aria-hidden="true"><span class="iconify lucide--grip-vertical size-3.5"></span></span>
        <span class="dv-vrow-ic"><span class="iconify ${v.saved ? 'lucide--bookmark' : 'lucide--file-pen-line'} size-3.5" aria-hidden="true"></span></span>
        <span class="dv-vrow-name">${esc(v.name)}</span>${unsavedMark(v)}
        <span class="dv-tab-kebab" data-dv-kebab="${v.id}" role="button" aria-label="Preset actions"><span class="iconify lucide--ellipsis size-4" aria-hidden="true"></span></span>
      </div>`;
    // The library list: each group (collapsible) · Ungrouped. Shows ALL presets (open or not); the tab
    // bar shows the open ones. `s` filters by name.
    function buildViewList(s: string): string {
      const query = s.trim().toLowerCase();
      const match = (v: View) => !query || v.name.toLowerCase().includes(query);
      let html = '';
      groups.forEach((g) => {
        const gv = views.filter((v) => v.groupId === g.id);
        const shown = gv.filter(match);
        if (query && !shown.length) return; // under an active search, hide groups with no matches
        // The whole group (head + body) is one drop zone — dropping a dragged view anywhere on it
        // files the view into this group.
        html += `<div class="dv-groupzone" data-dv-groupzone="${g.id}">
          <div class="dv-grouphead" data-dv-group="${g.id}">
            <button type="button" class="dv-groupcaret" data-dv-collapse="${g.id}" aria-label="Collapse group"><span class="iconify ${g.collapsed ? 'lucide--chevron-right' : 'lucide--chevron-down'} size-3.5" aria-hidden="true"></span></button>
            <span class="dv-groupname">${esc(g.name)}</span><span class="dv-groupcount">${gv.length}</span>
            <span class="dv-tab-kebab" data-dv-groupkebab="${g.id}" role="button" aria-label="Group actions"><span class="iconify lucide--ellipsis size-4" aria-hidden="true"></span></span>
          </div>
          <div class="dv-groupbody" ${g.collapsed ? 'hidden' : ''}>${shown.length ? shown.map(vrow).join('') : '<div class="dv-groupempty">Empty — drag a preset here or use its ⋯ menu.</div>'}</div>
        </div>`;
      });
      // Ungrouped = loose presets with no group. Always a drop zone so a preset can be dragged OUT of a
      // group (the hint is revealed while dragging if empty).
      const ungrouped = views.filter((v) => !v.groupId && match(v));
      html += `<div class="dv-groupzone dv-ungroupzone ${ungrouped.length ? '' : 'dv-ungroupzone-empty'}" data-dv-groupzone="none">
        <div class="dv-seclabel">Ungrouped</div>
        ${ungrouped.length ? ungrouped.map(vrow).join('') : '<div class="dv-groupempty dv-ungroup-hint">Drop here to remove from a group.</div>'}
      </div>`;
      return html || '<div class="dv-groupempty">No presets match.</div>';
    }
    // The preset toggle's two vocabularies: a column you hide/show, or a chooser you open.
    const PRESET_SHEET_LABELS = { hide: 'Hide presets', show: 'Show presets', choose: 'Choose a preset', close: 'Close the preset list' };

    function renderViews() {
      // Single writer: every state-changing action already re-renders, so persisting here covers all
      // of them (Save/Discard/Delete/new tab/close tab/rename/move-to-group/…) without a separate
      // call site to remember. Also runs on the very first render, migrating a legacy `dg-open-presets`
      // value into the v2 shape immediately.
      persistState();
      // Library rail — all presets by group + Ungrouped (open or not).
      railEl.innerHTML = buildViewList(viewSearch);
      // Tab bar — a "Presets" panel toggle ALWAYS leads the row (same position collapsed or expanded,
      // so nothing jumps), then the OPEN preset tabs (Chrome-style, ✕ to close) + a "+".
      const barViews = openIds.map((id) => views.find((v) => v.id === id)).filter(Boolean) as View[];
      // Icon only. The word "Presets" cost ~56px of a row whose whole problem is width, and the thing
      // it labelled is the panel BESIDE it — which, when open, says "Presets" in its own heading.
      // The toggle is ONE button with TWO jobs — hide/show a column when the section is wide, open a
      // chooser SHEET when it is not — so lib/listSheet.ts owns which words it carries. This console
      // re-renders its pin-bar, so it asks for the label instead of having attributes set on a node
      // that is about to be replaced.
      const tgl = listSheetToggleLabel(root, PRESET_SHEET_LABELS, root.dataset.collapsed === '1');
      const toggle = `<button type="button" class="dv-pinreopen tooltip tooltip-bottom" data-dv-panel-toggle aria-label="${esc(tgl.label)}" data-tip="${esc(tgl.label)}" aria-expanded="${tgl.showing}"><span class="iconify ${tgl.showing ? 'lucide--panel-left-close' : 'lucide--panel-left-open'} size-4" aria-hidden="true"></span></button>`;
      // The ＋ lives OUTSIDE the scroller: a scroll container clips its descendants' tooltips no matter
      // what z-index they carry (overflow-x:auto forces overflow-y to auto too — you cannot have one
      // axis scroll and the other visible), so a tooltip inside .dv-tabscroll can never escape it.
      // Keeping ＋ out both frees its tooltip and stops it scrolling away when tabs overflow.
      pinbarEl.innerHTML = `<div class="dv-tabscroll">` + toggle + barViews.map((v) => `
        <button type="button" class="dv-tab ${v.id === activeId ? 'dv-active' : ''}" data-dv-tab="${v.id}" role="tab">
          <span class="dv-tab-name">${esc(v.name)}</span>${unsavedMark(v)}
          <span class="dv-tab-close" data-dv-close="${v.id}" role="button" aria-label="Close tab"><span class="iconify lucide--x size-3.5" aria-hidden="true"></span></span>
        </button>`).join('') + `</div>
        <button type="button" class="dv-pinmore tooltip tooltip-bottom" data-dv-pinmore hidden aria-label="Show presets that do not fit" data-tip="Open presets that do not fit"><span class="iconify lucide--chevron-down size-3.5" aria-hidden="true"></span><span data-dv-pinmore-n>0</span></button>
        <button type="button" class="btn btn-sm btn-ghost btn-square text-primary dv-addbtn tooltip tooltip-bottom" data-dv-addbtn aria-label="Add preset" data-tip="New / duplicate preset"><span class="iconify lucide--plus size-4" aria-hidden="true"></span></button>`;
      fitPinbar();
      // Save / Discard — real toolbar buttons (server-rendered, `hidden` by default; see saveBtn/
      // discardBtn above), just toggled here. A never-saved Draft always offers Save (there is no
      // baseline yet to be "dirty" against); Discard needs a baseline to revert to, so it only shows
      // once the preset has been saved at least once AND has since diverged.
      const av = active();
      const avDirty = isDirty(av);
      saveBtn.hidden = av.saved && !avDirty;
      discardBtn.hidden = !av.baseline || !avDirty;
      // Point the toolbar kebab at whichever preset is active, so the delegated [data-dv-kebab] handler
      // opens the very same popMenu() the library row opens — one menu, one source of truth.
      const tbKebab = q<HTMLElement>('[data-dv-tbkebab]');
      if (tbKebab) tbKebab.dataset.dvKebab = av.id;
      // The export control's "All open tabs" scope depends on how many tabs are open — opening/closing
      // one fires no input/change, so tell it explicitly (EXPORT-1).
      document.dispatchEvent(new CustomEvent('data:tabschange', { detail: { count: openIds.length } }));
    }

    // A tiny action menu popped next to a kebab (view or group).
    let openMenu: HTMLElement | null = null;
    const closeMenu = () => { openMenu?.remove(); openMenu = null; };
    const placeMenu = (m: HTMLElement, anchor: HTMLElement) => {
      document.body.appendChild(m); const r = anchor.getBoundingClientRect();
      m.style.top = `${r.bottom + 4}px`; m.style.left = `${Math.min(r.left, window.innerWidth - 200)}px`; openMenu = m;
    };
    // ── Pin-bar overflow (replaces a horizontal scrollbar) ──────────────────────────────────────
    // A scrolled tab row hides its own overflow: nothing on screen says there are three more presets
    // to the right, and finding one means dragging a 4px scrollbar. Show what fits and collapse the
    // rest behind a counted chip whose menu carries FULL NAMES.
    //
    // Deliberately NOT Chrome's shrink-to-icon (Oleh proposed it, argued down 2026-08-05): Chrome can
    // do that because every tab has a favicon — a distinct mark per tab. Presets have no mark and are
    // all one kind of thing, so five shrunk tabs are five identical grey chips and "hover to see"
    // means five hovers to find one. The name IS the preset; it is the last thing to give up.
    //
    // The window is CONTIGUOUS and always contains the active preset. Reserving the active's width and
    // otherwise filling left-to-right was the first attempt and it read as broken — tabs 1,2,3 shown,
    // 4,5 gone, 6 shown, a hole in the middle of a row that is supposed to be an order.
    const PIN_GAP = 2;
    function fitPinbar() {
      const scroll = pinbarEl.querySelector<HTMLElement>('.dv-tabscroll');
      const more = pinbarEl.querySelector<HTMLElement>('[data-dv-pinmore]');
      if (!scroll || !more) return;
      const tabs = [...scroll.querySelectorAll<HTMLElement>('.dv-tab')];
      tabs.forEach((t) => { t.hidden = false; });
      more.hidden = true;
      if (!tabs.length) return;
      const toggleEl = scroll.querySelector<HTMLElement>('.dv-pinreopen');
      const addEl = pinbarEl.querySelector<HTMLElement>('[data-dv-addbtn]');
      /**
       * MARGINS COUNT. `offsetWidth` is the border box; a margin sits outside it and still takes
       * space on a flex line. The reopen toggle carries `margin-right: 4px`, so `offsetWidth +
       * PIN_GAP` reserved 35px for something that occupies 37.
       *
       * Two pixels here, and it is the same mistake that cost the SECTION tab bar eighteen — there
       * `.sch-tabdiv` was a 0-width hairline with `margin-inline: 9.6px` that the fit counted as
       * zero (see `lib/sectionNavFit.ts`). Both are one question asked too narrowly: "how wide is
       * this element" when the layout is answering "how much of the row does it consume". The tabs
       * themselves have no margins and their 2px gap is the real `gap`, so they were always right;
       * only the chrome around them was short.
       */
      const occupies = (el: HTMLElement | null) => {
        if (!el) return 0;
        const cs = getComputedStyle(el);
        return el.offsetWidth + (parseFloat(cs.marginLeft) || 0) + (parseFloat(cs.marginRight) || 0) + PIN_GAP;
      };
      const chrome = occupies(toggleEl) + occupies(addEl);
      const avail = pinbarEl.clientWidth - chrome;
      const w = tabs.map((t) => t.offsetWidth + PIN_GAP);
      if (w.reduce((a, b) => a + b, 0) <= avail) return;   // everything fits — no chip, no menu

      // Measure the chip while it is still laid out, so the reserve is the real thing and not a guess.
      more.hidden = false;
      const reserve = occupies(more);
      let budget = avail - reserve;
      const activeIdx = Math.max(0, tabs.findIndex((t) => t.classList.contains('dv-active')));

      // Grow outward from the active one: right first (later presets are the ones just opened), then
      // left. Whatever the window cannot hold goes to the chip.
      let lo = activeIdx, hi = activeIdx;
      budget -= w[activeIdx];
      for (;;) {
        const canR = hi + 1 < tabs.length && budget - w[hi + 1] >= 0;
        const canL = lo - 1 >= 0 && budget - w[lo - 1] >= 0;
        if (canR) { hi += 1; budget -= w[hi]; }
        else if (canL) { lo -= 1; budget -= w[lo]; }
        else break;
      }
      tabs.forEach((t, i) => { t.hidden = i < lo || i > hi; });
      const n = tabs.length - (hi - lo + 1);
      more.hidden = n <= 0;
      const nEl = more.querySelector<HTMLElement>('[data-dv-pinmore-n]');
      if (nEl) nEl.textContent = String(n);
    }

    /** The hidden tabs, by name, in their bar order. Reuses the library's own menu shell. */
    function popPinOverflow(anchorEl: HTMLElement) {
      closeMenu();
      const hidden = [...pinbarEl.querySelectorAll<HTMLElement>('.dv-tab')].filter((t) => t.hidden);
      if (!hidden.length) return;
      const m = document.createElement('div');
      m.className = 'dv-menu'; m.style.position = 'fixed';
      m.innerHTML = hidden.map((t) => {
        const id = t.dataset.dvTab!;
        const v = views.find((x) => x.id === id);
        return `<button type="button" data-m="${id}"><span class="iconify lucide--layout-list size-3.5" aria-hidden="true"></span>${esc(v ? v.name : id)}</button>`;
      }).join('');
      placeMenu(m, anchorEl);
      m.addEventListener('click', (e) => {
        const b = (e.target as HTMLElement).closest<HTMLElement>('[data-m]'); if (!b) return;
        closeMenu();
        openPreset(b.dataset.m!);
      });
    }

    function popMenu(anchor: HTMLElement, id: string) {
      closeMenu();
      const v = views.find((x) => x.id === id)!;
      const m = document.createElement('div');
      m.className = 'dv-menu'; m.style.position = 'fixed';
      const groupBtns = groups.map((g) => `<button type="button" data-m="grp:${g.id}"><span class="iconify lucide--folder size-3.5" aria-hidden="true"></span>${esc(g.name)}${v.groupId === g.id ? '<span class="dv-check iconify lucide--check size-3.5" aria-hidden="true"></span>' : ''}</button>`).join('');
      m.innerHTML = `
        <button type="button" data-m="rename"><span class="iconify lucide--pencil size-3.5" aria-hidden="true"></span>Rename</button>
        <button type="button" data-m="dup"><span class="iconify lucide--copy size-3.5" aria-hidden="true"></span>Duplicate</button>
        <div class="dv-menu-sep"></div>
        <div class="dv-menu-label">Move to group</div>
        ${groupBtns}
        ${v.groupId ? '<button type="button" data-m="grp:none"><span class="iconify lucide--folder-minus size-3.5" aria-hidden="true"></span>Remove from group</button>' : ''}
        <button type="button" data-m="grp:new"><span class="iconify lucide--folder-plus size-3.5" aria-hidden="true"></span>New group…</button>
        <div class="dv-menu-sep"></div>
        <button type="button" class="dv-menu-danger" data-m="del"><span class="iconify lucide--trash-2 size-3.5" aria-hidden="true"></span>Delete</button>`;
      placeMenu(m, anchor);
      m.addEventListener('click', (e) => {
        const b = (e.target as HTMLElement).closest<HTMLElement>('[data-m]'); if (!b) return;
        const act = b.dataset.m!;
        if (act === 'rename') startRename(id);
        else if (act === 'dup') { activeId = id; newView(true); }
        else if (act === 'del') deleteView(id);
        else if (act.startsWith('grp:')) { const g = act.slice(4); moveViewToGroup(id, g === 'none' ? null : g); }
        closeMenu();
      });
    }
    function popGroupMenu(anchor: HTMLElement, id: string) {
      closeMenu();
      const m = document.createElement('div');
      m.className = 'dv-menu'; m.style.position = 'fixed';
      m.innerHTML = `
        <button type="button" data-m="rename"><span class="iconify lucide--pencil size-3.5" aria-hidden="true"></span>Rename group</button>
        <div class="dv-menu-sep"></div>
        <button type="button" class="dv-menu-danger" data-m="del"><span class="iconify lucide--folder-x size-3.5" aria-hidden="true"></span>Delete group</button>`;
      placeMenu(m, anchor);
      m.addEventListener('click', (e) => {
        const b = (e.target as HTMLElement).closest<HTMLElement>('[data-m]'); if (!b) return;
        if (b.dataset.m === 'rename') startRenameGroup(id);
        else if (b.dataset.m === 'del') deleteGroup(id);
        closeMenu();
      });
    }
    // The tab-bar "+" menu — New blank preset / Duplicate current, then (below a separator) the user's
    // existing presets that aren't open yet, grouped, so you can add one as a tab. JS-popped so the
    // bar's overflow can't clip it.
    function popAddMenu(anchor: HTMLElement) {
      closeMenu();
      const m = document.createElement('div');
      m.className = 'dv-menu dv-addmenu'; m.style.position = 'fixed';
      const openRow = (v: View) => `<button type="button" data-m="open:${v.id}"><span class="iconify lucide--bookmark size-3.5" aria-hidden="true"></span>${esc(v.name)}</button>`;
      // The existing (not-open) presets, grouped + filtered by the search query. Presets can be many,
      // so the list is searchable + scrollable.
      const listHtml = (q: string) => {
        const query = q.trim().toLowerCase();
        const match = (v: View) => !query || v.name.toLowerCase().includes(query);
        const closed = views.filter((v) => !openIds.includes(v.id));
        let html = '';
        groups.forEach((g) => { const gv = closed.filter((v) => v.groupId === g.id && match(v)); if (gv.length) html += `<div class="dv-menu-label">${esc(g.name)}</div>` + gv.map(openRow).join(''); });
        const ung = closed.filter((v) => !v.groupId && match(v));
        if (ung.length) html += `<div class="dv-menu-label">Ungrouped</div>` + ung.map(openRow).join('');
        return html || '<div class="dv-menu-empty">No presets match.</div>';
      };
      let html = `
        <button type="button" data-m="new"><span class="iconify lucide--file-plus size-3.5" aria-hidden="true"></span>New blank preset</button>
        <button type="button" data-m="dup"><span class="iconify lucide--copy size-3.5" aria-hidden="true"></span>Duplicate current</button>`;
      const hasClosed = views.some((v) => !openIds.includes(v.id));
      if (hasClosed) {
        html += '<div class="dv-menu-sep"></div>';
        html += `<label class="input input-sm dv-addsearch"><span class="iconify lucide--search size-3.5 opacity-50" aria-hidden="true"></span><input type="search" data-dv-addsearch placeholder="Find a preset…" aria-label="Find a preset to open" autocomplete="off" /></label>`;
        html += `<div class="dv-addlist" data-dv-addlist>${listHtml('')}</div>`;
      }
      m.innerHTML = html;
      placeMenu(m, anchor);
      const search = m.querySelector<HTMLInputElement>('[data-dv-addsearch]');
      const listEl = m.querySelector<HTMLElement>('[data-dv-addlist]');
      if (search && listEl) {
        search.addEventListener('input', () => { listEl.innerHTML = listHtml(search.value); });
        setTimeout(() => search.focus(), 0);
      }
      m.addEventListener('click', (e) => {
        const b = (e.target as HTMLElement).closest<HTMLElement>('[data-m]'); if (!b) return; // clicks in the search field keep the menu open
        const act = b.dataset.m!;
        if (act === 'new') newView(false);
        else if (act === 'dup') newView(true);
        else if (act.startsWith('open:')) openPreset(act.slice(5));
        closeMenu();
      });
    }
    function startRename(id: string) {
      const v = views.find((x) => x.id === id)!;
      const tabEl = root.querySelector<HTMLElement>(`[data-dv-tab="${id}"]`);
      if (!tabEl) return;
      const input = document.createElement('input');
      input.className = 'dv-renameinput'; input.value = v.name;
      // A pin-bar pill is a <button>; an <input> nested in a button won't accept typing, so replace
      // the whole pill. Library rows are <div>, so swap just the name span to keep the row chrome.
      if (tabEl.tagName === 'BUTTON') tabEl.replaceWith(input);
      else { const nameEl = tabEl.querySelector<HTMLElement>('.dv-vrow-name, .dv-tab-name'); if (!nameEl) return; nameEl.replaceWith(input); }
      input.focus(); input.select();
      let done = false;
      const commit = () => { if (done) return; done = true; renameView(id, input.value); };
      input.addEventListener('keydown', (e) => { if (e.key === 'Enter') { e.preventDefault(); commit(); } else if (e.key === 'Escape') { done = true; renderViews(); } });
      input.addEventListener('blur', commit);
    }
    function startRenameGroup(id: string) {
      const g = groups.find((x) => x.id === id)!;
      const nameEl = root.querySelector<HTMLElement>(`[data-dv-group="${id}"] .dv-groupname`);
      if (!nameEl) return;
      const input = document.createElement('input');
      input.className = 'dv-renameinput'; input.value = g.name;
      nameEl.replaceWith(input); input.focus(); input.select();
      const commit = () => renameGroup(id, input.value);
      input.addEventListener('keydown', (e) => { if (e.key === 'Enter') { e.preventDefault(); commit(); } if (e.key === 'Escape') renderViews(); });
      input.addEventListener('blur', commit);
    }

    // Folded refinements — the shared control (lib/refineCollapse.ts). NOT the two scope pickers:
    // `Sales CRM` and `Orders` say what this page is showing and the preset is locked to them.
    // `always`: on Data the fold is the DESIGN, not a fallback for a squeezed row (Oleh 2026-08-05
    // — the row was "loaded" and the filters awkward at every width). One Filter button opens the
    // drill; the chips underneath carry what is applied, so nothing is hidden by collapsing it.
    mountRefineCollapse({
      toolbar: q<HTMLElement>('.sch-tb'),
      selectors: ['[data-dg-filterdd]', '[data-facet="dgcomments"]', '[data-dg-fieldsdd]'],
      always: true,
    });

    // View + group interactions (delegated on the shell — bar/rail are re-rendered).
    const shell = root.querySelector<HTMLElement>('[data-dv-shell]')!;
    shell.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      const gkebab = t.closest<HTMLElement>('[data-dv-groupkebab]');
      if (gkebab) { e.stopPropagation(); popGroupMenu(gkebab, gkebab.dataset.dvGroupkebab!); return; }
      const kebab = t.closest<HTMLElement>('[data-dv-kebab]');
      if (kebab) { e.stopPropagation(); popMenu(kebab, kebab.dataset.dvKebab!); return; }
      const addbtn = t.closest<HTMLElement>('[data-dv-addbtn]');
      if (addbtn) { e.stopPropagation(); popAddMenu(addbtn); return; }
      const gcollapse = t.closest<HTMLElement>('[data-dv-collapse]');
      if (gcollapse) { toggleCollapse(gcollapse.dataset.dvCollapse!); return; }
      // The panel toggle and the sheet's dim are owned by lib/listSheet.ts (wired below).
      if (t.closest('[data-dv-newgroup]')) { const g = newGroup(); renderViews(); startRenameGroup(g.id); return; }
      if (t.closest('[data-dv-new]')) { newView(false); (document.activeElement as HTMLElement)?.blur(); return; }
      if (t.closest('[data-dv-dup]')) { newView(true); (document.activeElement as HTMLElement)?.blur(); return; }
      // ✕ on a tab closes it (must be checked before the tab click below, since it lives inside the tab).
      const close = t.closest<HTMLElement>('[data-dv-close]');
      if (close) { e.stopPropagation(); closeTab(close.dataset.dvClose!); (document.activeElement as HTMLElement)?.blur(); return; }
      // A tab click OR a library-row click opens/activates the preset (openPreset adds the tab if absent).
      // `stopPropagation` like every other menu opener above it: a document-level listener closes the
      // open menu on any outside click, and without this the very click that opens it closes it again.
      const moreBtn = t.closest<HTMLElement>('[data-dv-pinmore]');
      if (moreBtn) { e.stopPropagation(); popPinOverflow(moreBtn); return; }
      const tab = t.closest<HTMLElement>('[data-dv-tab]');
      if (tab) { openPreset(tab.dataset.dvTab!); (document.activeElement as HTMLElement)?.blur(); return; }
    });
    // Double-click a tab (or a library row) to rename it in place. The kebab item still works, but a
    // rename reachable only through a menu is one most people never find — and the inline input it
    // opens is easy to miss, which is exactly how it read as "nothing happens" (Oleh 2026-07-24).
    shell.addEventListener('dblclick', (e) => {
      const t = e.target as HTMLElement;
      if (t.closest('[data-dv-close]') || t.closest('[data-dv-kebab]')) return;
      const tab = t.closest<HTMLElement>('[data-dv-tab]');
      if (!tab) return;
      e.preventDefault();
      startRename(tab.dataset.dvTab!);
    });

    // "Find a preset" search (rail library).
    shell.addEventListener('input', (e) => {
      const t = e.target as HTMLElement;
      if (t.matches('[data-dv-search]')) { viewSearch = (t as HTMLInputElement).value; railEl.innerHTML = buildViewList(viewSearch); }
    });
    document.addEventListener('click', (e) => { if (openMenu && !openMenu.contains(e.target as Node)) closeMenu(); });

    // ── Collapse state (persisted) — the library collapses fully; the pin-bar keeps the working set. ──
    // It only records the preference; the repaint is renderViews(), which listSheet calls as the
    // toggle-sync step. Two callers painting the same bar twice per click is how a pin-bar flickers.
    const setCollapsed = (c: boolean) => { root.dataset.collapsed = c ? '1' : '0'; try { localStorage.setItem('dv-collapsed', c ? '1' : '0'); } catch { /* ignore */ } };
    let savedCollapsed: string | null = null;
    try { savedCollapsed = localStorage.getItem('dv-collapsed'); } catch { /* ignore */ }
    root.dataset.collapsed = savedCollapsed === '1' ? '1' : '0';

    // ── The preset library: a column when the section is wide, a SHEET when it is not ──────────
    // The same mechanism Docs and Chat use (lib/listSheet.ts); this console only declares its own
    // selectors and words. Closing on a PICK matters more here than there: choosing a preset rewrites
    // the grid AND the toolbar beside it (Save preset / Discard / Clear all read the active preset),
    // and all of that lives behind the dim — leaving the sheet open would show the user a dimmed
    // result of their own action with the controls that answer it out of reach. Group collapse,
    // rename and the kebabs are deliberately NOT picks: they are list housekeeping, and closing the
    // sheet under them would throw the user out mid-errand.
    wireListSheet({
      root,
      toggle: '[data-dv-panel-toggle]',
      dim: '[data-dv-raildim]',
      pick: '[data-dv-viewrow], [data-dv-new], [data-dv-dup]',
      // The library rows are role=tab divs with no tabindex, so focus goes to the thing that IS
      // focusable and is what you want next in a chooser: "Find a preset".
      firstItem: '[data-dv-search]',
      // The reading surface — see the note in `lib/listSheet.ts`: naming it makes this console's
      // own chrome measured rather than assumed, so the threshold cannot go stale silently.
      content: '.dv-main',
      wideHidden: () => root.dataset.collapsed === '1',
      setWideHidden: setCollapsed,
      labels: PRESET_SHEET_LABELS,
      syncToggle: renderViews,
    });

    // ── Initial paint ─────────────────────────────────────────────────────────
    renderViews();
    applyLoadState();
    void loadActiveView();
  }
  wireDataBrowse();
  document.addEventListener('astro:after-swap', wireDataBrowse);
</script>

