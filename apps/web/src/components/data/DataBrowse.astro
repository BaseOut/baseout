    });

    // Drag-reorder within the same parent group (grip handle).
    let dragPath: string | null = null;
    fbTree.addEventListener('dragstart', (e) => {
      const grip = (e.target as HTMLElement).closest<HTMLElement>('[data-dg-fbgrip]');
      if (!grip) { e.preventDefault(); return; }
      dragPath = grip.dataset.dgPath!;
      e.dataTransfer!.effectAllowed = 'move';
      grip.closest('.dg-fb-row, .dg-fb-grouprow')?.classList.add('dg-fb-dragging');
    });
    fbTree.addEventListener('dragend', () => { dragPath = null; fbTree.querySelectorAll('.dg-fb-dragging').forEach((r) => r.classList.remove('dg-fb-dragging')); });
    fbTree.addEventListener('dragover', (e) => { if (dragPath != null) e.preventDefault(); });
    fbTree.addEventListener('drop', (e) => {
      if (dragPath == null) return;
      e.preventDefault();
      const row = (e.target as HTMLElement).closest<HTMLElement>('.dg-fb-row, .dg-fb-grouprow');
      if (!row) return;
      const src = parsePath(dragPath); const tgt = parsePath(row.dataset.dgPath!);
      if (src.slice(0, -1).join('.') !== tgt.slice(0, -1).join('.')) return; // same parent only
      const par = parentGroup(src); const from = src[src.length - 1]; let to = tgt[tgt.length - 1];
