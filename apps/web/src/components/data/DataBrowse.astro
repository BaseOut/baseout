      const t = e.target as HTMLElement;
      const fieldSel = t.closest<HTMLSelectElement>('[data-dg-fbfield]');
      if (fieldSel) {
        const cond = nodeAtPath(parsePath(fieldSel.dataset.dgPath!)) as Cond;
        const nf = activeTable().fields.find((f) => f.id === fieldSel.value)!;
        const changedFam = family(nf.type) !== family(cond.field.type);
        cond.field = nf;
        if (changedFam) { cond.op = OPS[family(nf.type)][0].v; cond.val = ''; cond.val2 = undefined; }
        commit(); return;
      }
      const opSel = t.closest<HTMLSelectElement>('[data-dg-fbop]');
      if (opSel) { (nodeAtPath(parsePath(opSel.dataset.dgPath!)) as Cond).op = opSel.value; commit(); return; }
      const conjSel = t.closest<HTMLSelectElement>('[data-dg-fbconj]');
      if (conjSel) { groupAtPath(parsePath(conjSel.dataset.dgPath!)).conjunction = conjSel.value as 'and' | 'or'; commit(); return; }
    });
    // Value typing — update the model + grid without re-rendering the tree (keep focus).
    fbTree.addEventListener('input', (e) => {
      const t = e.target as HTMLElement;
      const v1 = t.closest<HTMLInputElement>('[data-dg-fbval]');
      if (v1) { (nodeAtPath(parsePath(v1.dataset.dgPath!)) as Cond).val = v1.value; pager.reset(); renderGrid(); touch(); return; }
      const v2 = t.closest<HTMLInputElement>('[data-dg-fbval2]');
      if (v2) { (nodeAtPath(parsePath(v2.dataset.dgPath!)) as Cond).val2 = v2.value; pager.reset(); renderGrid(); touch(); return; }
    });
    fbTree.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      const dup = t.closest<HTMLElement>('[data-dg-fbdup]');
      if (dup) { const p = parsePath(dup.dataset.dgPath!); const par = parentGroup(p); const idx = p[p.length - 1]; par.children.splice(idx + 1, 0, cloneNode(par.children[idx])); commit(); return; }
      const del = t.closest<HTMLElement>('[data-dg-fbdel]');
      if (del) {
        const p = parsePath(del.dataset.dgPath!); const par = parentGroup(p); par.children.splice(p[p.length - 1], 1);
        // A nested group emptied of its last condition disappears (it can't be re-populated by hand).
