    }
    root.querySelectorAll<HTMLElement>('[data-dg-fieldstab]').forEach((b) => b.addEventListener('click', () => {
      fieldsTab = b.dataset.dgFieldstab as typeof fieldsTab;
      // `role="tab"` means `aria-selected` IS the state — it used to toggle a class only, so a
      // screen reader was told "tab" and never which one was current (catalog a11y note).
      root.querySelectorAll('[data-dg-fieldstab]').forEach((x) => {
        x.classList.toggle('sb-seg-on', x === b);
        x.setAttribute('aria-selected', String(x === b));
      });
      renderFields();
    }));
    fieldsSearch.addEventListener('input', renderFields);
    fieldsList.addEventListener('change', (e) => {
      const t = e.target as HTMLElement; const v = active();
      const idt = t.closest<HTMLInputElement>('[data-dg-recidtoggle]');
      if (idt) { v.showRecId = idt.checked; renderGrid(); touch(); return; }
      const one = t.closest<HTMLInputElement>('[data-dg-col]');
      if (one) { if (one.checked) v.hiddenCols.delete(one.dataset.dgCol!); else v.hiddenCols.add(one.dataset.dgCol!); renderFields(); renderGrid(); touch(); return; }
      const grp = t.closest<HTMLInputElement>('[data-dg-coltype]');
      if (grp) {
        const key = grp.dataset.dgColtype!;
        const match = (f: Field) => (fieldsTab === 'types' ? f.type : family(f.type)) === key;
        activeTable().fields.forEach((f) => { if (match(f)) { if (grp.checked) v.hiddenCols.delete(f.id); else v.hiddenCols.add(f.id); } });
        renderFields(); renderGrid(); touch();
      }
    });
    // ── Column reorder — drag a field row by its grip in the Names tab (primary pinned first) ─────
    // The grip lives inside the row's <label>, so a plain click would toggle the field — swallow it.
    fieldsList.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('[data-dg-fieldgrip]')) { e.preventDefault(); e.stopPropagation(); } });
    let dragFieldId: string | null = null;
    const clearDropHints = () => fieldsList.querySelectorAll('.dg-drop-before, .dg-drop-after').forEach((el) => el.classList.remove('dg-drop-before', 'dg-drop-after'));
    fieldsList.addEventListener('dragstart', (e) => {
      const grip = (e.target as HTMLElement).closest<HTMLElement>('[data-dg-fieldgrip]');
      if (!grip || !grip.hasAttribute('draggable')) { e.preventDefault(); return; }
      const row = grip.closest<HTMLElement>('[data-dg-fieldrow]');
      dragFieldId = row?.dataset.dgFieldrow || null;
      e.dataTransfer!.effectAllowed = 'move';
      row?.classList.add('dg-fieldrow-dragging');
    });
    fieldsList.addEventListener('dragover', (e) => {
      if (dragFieldId == null) return;
      clearDropHints();
      const row = (e.target as HTMLElement).closest<HTMLElement>('[data-dg-fieldrow]');
      if (!row || row.dataset.dgFieldrow === dragFieldId) return;
      e.preventDefault();
      const r = row.getBoundingClientRect();
      const after = (e.clientY - r.top) > r.height / 2;
      row.classList.add(after ? 'dg-drop-after' : 'dg-drop-before');
    });
    fieldsList.addEventListener('drop', (e) => {
      if (dragFieldId == null) return;
      const row = (e.target as HTMLElement).closest<HTMLElement>('[data-dg-fieldrow]');
      if (!row) return;
      e.preventDefault();
      const targetId = row.dataset.dgFieldrow!;
      if (targetId !== dragFieldId) {
        const r = row.getBoundingClientRect();
        const after = (e.clientY - r.top) > r.height / 2;
        const ids = orderedColIds();
        ids.splice(ids.indexOf(dragFieldId), 1);
        const to = ids.indexOf(targetId) + (after ? 1 : 0);
        ids.splice(to, 0, dragFieldId);
        active().colOrder = ids;
        renderFields(); renderGrid(); touch();
      }
      dragFieldId = null;
    });
    fieldsList.addEventListener('dragend', () => { dragFieldId = null; clearDropHints(); fieldsList.querySelectorAll('.dg-fieldrow-dragging').forEach((el) => el.classList.remove('dg-fieldrow-dragging')); });

    // ── + Filter builder (nested condition tree, Airtable model) ─────────────────
    const fdd = q('[data-dg-filterdd]');
    const fpop = q('[data-dg-filterpop]');
    const ftoggle = q('[data-dg-filter-toggle]');
    const fbTree = q('[data-dg-fbtree]');
    // 660px anchored at `left: 0`: wherever the toolbar puts this trigger within 660 of the column's
    // right edge, the panel's far side is off-screen unless something clamps it. Same helper the
    // collapsed Filter uses, so the two paths to this builder place it the same way.
    const openFilter = (o: boolean) => { fpop.hidden = !o; ftoggle.setAttribute('aria-expanded', String(o)); if (o) { renderFilter(); clampBelow(fpop, fdd); } };
    ftoggle.addEventListener('click', (e) => { e.stopPropagation(); openFilter(fpop.hidden); });
    document.addEventListener('click', (e) => {
      if (!fdd.contains(e.target as Node) && !openMenu?.contains(e.target as Node)) openFilter(false);
      if (!root.querySelector('[data-dg-fieldsdd]')!.contains(e.target as Node)) openFields(false);
    });
    /**
     * Escape for the two toolbar popovers (Filter builder · Fields picker), on the shared stack
     * (`lib/escapeStack`) rather than a seventh `document` keydown of its own.
     *
     * THE RETURN VALUE IS THE WHOLE POINT, and it is easy to get wrong here because closing is
     * idempotent: `openFilter(false)` on an already-closed popover is a no-op that still "succeeds".
     * A handler that closed both unconditionally and returned `true` would swallow every Escape on
     * this page for the panel stack and the record drawer underneath it — which is exactly the
     * all-at-once dismissal the stack exists to end, just inverted. So the open state is READ FIRST
     * (`hidden` is what `openFilter`/`openFields` actually toggle), and `false` is returned honestly
     * when neither popover was open, letting the press fall through to whatever is below.
     *
     * Both are closed on one press when both are open: they are siblings in the same toolbar, not
     * stacked over each other, so there is no "topmost" between them to prefer.
     *
     * Not `withinDialog`: these live in the Browse toolbar, under any modal, so a native
     * `<dialog open>` correctly stands them down.
     */
    pushEscape({
      label: 'DataBrowse: filter/fields popovers',
      onEscape: () => {
        const wasOpen = !fpop.hidden || !fieldsPop.hidden;
        if (!wasOpen) return false;
        openFilter(false);
        openFields(false);
        return true;
      },
    });

    // Path = a dot-joined chain of child indices ('' = the root group, '2' = root child 2, '2.1' =
    // child 1 of the group at root index 2). One level of nesting, so a path is 1–2 segments.
    const treeRoot = (): FGroup => active().filterTree;
    const parsePath = (s: string): number[] => (s === '' ? [] : s.split('.').map(Number));
    const groupAtPath = (path: number[]): FGroup => { let g = treeRoot(); for (const i of path) g = g.children[i] as FGroup; return g; };
    const parentGroup = (path: number[]): FGroup => groupAtPath(path.slice(0, -1));
    const nodeAtPath = (path: number[]): FNode => parentGroup(path).children[path[path.length - 1]];
    const newCond = (): Cond => { const f = activeTable().fields[0]; return { kind: 'cond', field: f, op: OPS[family(f.type)][0].v, val: '', val2: undefined }; };
    const commit = () => { pager.reset(); renderFilter(); renderGrid(); touch(); };

    const conjCell = (groupPath: string, i: number, conj: 'and' | 'or') => {
      if (i === 0) return `<span class="dg-fb-conj dg-fb-where">Where</span>`;
      if (i === 1) return `<select class="select select-sm dg-fb-conjsel" data-dg-fbconj data-dg-path="${groupPath}" aria-label="Conjunction"><option value="and" ${conj === 'and' ? 'selected' : ''}>and</option><option value="or" ${conj === 'or' ? 'selected' : ''}>or</option></select>`;
      return `<span class="dg-fb-conj">${conj}</span>`;
    };
    const actsCell = (path: string, label: string) => `<div class="dg-fb-acts">
        <button type="button" class="dg-fb-iconbtn tooltip tooltip-left" data-tip="Duplicate ${label}" data-dg-fbdup data-dg-path="${path}" aria-label="Duplicate ${label}"><span class="iconify lucide--copy size-3.5" aria-hidden="true"></span></button>
        <button type="button" class="dg-fb-iconbtn tooltip tooltip-left" data-tip="Delete ${label}" data-dg-fbdel data-dg-path="${path}" aria-label="Delete ${label}"><span class="iconify lucide--trash-2 size-3.5" aria-hidden="true"></span></button>
        <button type="button" class="dg-fb-grip tooltip tooltip-left" data-tip="Drag to reorder" data-dg-fbgrip data-dg-path="${path}" draggable="true" aria-label="Reorder ${label}"><span class="iconify lucide--grip-vertical size-3.5" aria-hidden="true"></span></button>
      </div>`;
    const condRow = (cond: Cond, path: string, conj: string) => {
      const fields = activeTable().fields;
      const fam = family(cond.field.type);
      const ops = OPS[fam];
      const op = ops.find((o) => o.v === cond.op) || ops[0];
      const fieldSel = `<select class="select select-sm dg-fb-field" data-dg-fbfield data-dg-path="${path}" aria-label="Field">${fields.map((f) => `<option value="${f.id}" ${f.id === cond.field.id ? 'selected' : ''}>${esc(f.name)}</option>`).join('')}</select>`;
      const opSel = `<select class="select select-sm dg-fb-op" data-dg-fbop data-dg-path="${path}" aria-label="Operator">${ops.map((o) => `<option value="${o.v}" ${o.v === cond.op ? 'selected' : ''}>${esc(o.label)}</option>`).join('')}</select>`;
      let valHtml = `<span class="dg-fb-val dg-fb-val-none"></span>`;
      if (!op.noval) {
        const type = fam === 'date' ? 'date' : fam === 'number' ? 'number' : 'text';
        const ph = fam === 'select' && (op.v === 'anyof' || op.v === 'noneof') ? 'value1, value2' : 'Enter a value';
        valHtml = `<input class="input input-sm dg-fb-val" data-dg-fbval data-dg-path="${path}" type="${type}" value="${esc(cond.val)}" placeholder="${ph}" aria-label="Value" />`;
        if (op.two) valHtml += `<span class="dg-fb-and">and</span><input class="input input-sm dg-fb-val" data-dg-fbval2 data-dg-path="${path}" type="${type}" value="${esc(cond.val2 || '')}" placeholder="Enter a value" aria-label="Second value" />`;
      }
      return `<div class="dg-fb-row" data-dg-path="${path}">${conj}<div class="dg-fb-inputs">${fieldSel}${opSel}${valHtml}</div>${actsCell(path, 'condition')}</div>`;
    };
    const groupBody = (group: FGroup, groupPath: string): string => {
      if (!group.children.length) return `<div class="dg-fb-empty">No conditions yet — add one below.</div>`;
      return group.children.map((child, i) => {
        const childPath = groupPath === '' ? String(i) : `${groupPath}.${i}`;
        const conj = conjCell(groupPath, i, group.conjunction);
        if (child.kind === 'cond') return condRow(child, childPath, conj);
        return `<div class="dg-fb-grouprow" data-dg-path="${childPath}">${conj}<div class="dg-fb-group">${groupBody(child, childPath)}<div class="dg-fb-groupfoot"><button type="button" class="btn btn-sm btn-ghost gap-1.5 dg-fb-addin" data-dg-fbaddin data-dg-path="${childPath}"><span class="iconify lucide--plus size-3.5" aria-hidden="true"></span>Add condition</button></div></div>${actsCell(childPath, 'group')}</div>`;
      }).join('');
    };
    function renderFilter() {
      const tree = treeRoot();
      fbTree.innerHTML = groupBody(tree, '');
      const n = countConds(tree);
      ftoggle.classList.toggle('ff-on', n > 0);
      const fbadge = root.querySelector<HTMLElement>('[data-dg-filterbadge]');
      if (fbadge) { fbadge.hidden = n === 0; fbadge.textContent = String(n); }
    }

    // Structural mutations (re-render the whole tree). Value typing is handled separately so it
    // never re-renders mid-keystroke and loses focus.
