    });

    // Footer actions.
    q('[data-dg-fbaddcond]').addEventListener('click', () => { treeRoot().children.push(newCond()); commit(); });
    q('[data-dg-fbaddgroup]').addEventListener('click', () => { treeRoot().children.push({ kind: 'group', conjunction: 'or', children: [newCond()] }); commit(); });

    // ── Sort (header click) ──────────────────────────────────────────────────────
    thead.addEventListener('click', (e) => {
      const th = (e.target as HTMLElement).closest<HTMLElement>('[data-dg-sort]');
      if (!th) return;
