      narrow="fold"
      narrowReason={RPTK_NARROW}
    >
        {/* NARROW CLASSIFICATION — deliberately the SAME shape as the Record-data table above it, so
            the two halves of Data health do not read as two different objects: base leads, the one
            count is the number (Files here, Records there), storage is the second line and the
            structural count sits beside it. */}
        {dataHealth.attachments.byBase.map((b) => (
          <tr data-nrow>
            <td data-m="lead" class="font-medium">{b.baseName}</td>
            <td data-m="sub2" class="text-right tabular-nums text-base-content/65">{nf.format(b.attachmentFieldCount)}<span class="rptk-subcap"> attachment fields</span></td>
            <td data-m="num" class="text-right tabular-nums text-base-content/65">{nf.format(b.fileCount)}<span class="rptk-numcap">files</span></td>
