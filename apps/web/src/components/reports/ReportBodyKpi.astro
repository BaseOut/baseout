  </div>
  {/* `growth="fixed"` IS THE HONEST ANSWER TO THE VESSEL AND NOT TO THE DATA — see the finding
      note at the Data health tables. Schema changes accumulate with the reporting WINDOW, so a
      monthly report on a busy Space can exceed the 25-row floor; `fixed` now warns in production
      rather than throwing, which is the degradation this surface wants, but the row set is not
      bounded by the data model and this call site should not be read as claiming it is.
      No `rowSelector`: these rows carry `data-rpt-entity` and are activated by whichever view
      mounts this body (`ReportDetailView` / `ReportDefinitionView` dispatch `schema:openEntity`).
      The vessel's default `row.click()` would open the entity drawer a second time.
      (Outside the ternary — see the Backup summary note.) */}
  {report.schemaHealth.rows.length > 0 ? (
    <Table
      tableClass="rptk-table"
      name="rptk-schema"
      columns={schemaColumns}
      rowCount={report.schemaHealth.rows.length}
      growth="fixed"
      narrow="fold"
      narrowReason={RPTK_NARROW}
    >
        {/* NARROW CLASSIFICATION — the entity is what the row is ABOUT, so "Pipeline Value" leads;
            the change badge ("Formula changed") is the second line and the location trail
            ("Sales CRM ▸ Companies") takes `sub2`, where the pattern's own `·` separates the two
            facts. No number in this table. The row opens the shared EntityPanel, so nothing here is
            hidden — every cell survives at narrow. */}
        {report.schemaHealth.rows.map((r: SchemaChangeRow) => (
          <tr class="row-clickable" data-nrow data-rpt-entity={r.entityId} tabindex="0" role="button" aria-label={`Open ${r.entityName}`}>
            <td data-m="sub"><Badge size="sm" variant={changeToneOf(r.tone)}>{r.change}</Badge></td>
            <td data-m="lead" class="font-medium">{r.entityName}</td>
