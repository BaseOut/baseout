{/* ── Data health — record data + attachment data (client 2026-07-14; shell) ───────── */}
{shows('dataHealth') && dataHealth && (
  <section id="rpt-sec-datahealth" class="rptk-card rptk-anchor" data-mobile-rows data-rptk-section="dataHealth">
    <div class="rptk-head" data-rptk-toggle role="button" tabindex="0" aria-expanded="true"><span class="iconify lucide--chevron-down size-4 rptk-chev" aria-hidden="true"></span>
      <span class="iconify lucide--database size-4 opacity-70" aria-hidden="true"></span>
