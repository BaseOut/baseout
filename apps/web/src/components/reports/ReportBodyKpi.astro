<script>
  import { wireRowKeys } from '../../lib/wireRowKeys';

  /**
   * D46 — the three report-body tables that painted a focus ring and did nothing.
   *
   * Backup runs, Connection health and Documentation each render `<tr data-nrow role="button"
   * tabindex="0" onclick="…">`. The inline `onclick` made the MOUSE work, so the omission was
   * invisible to anyone not using the keyboard: the row announced itself as a button, took focus,
   * drew the ring, and swallowed Enter. This is the worst shape an affordance failure takes,
   * because the row promised.
   *
   * `[data-rpt-entity]` is excluded rather than covered: those rows (Schema health) are wired by
   * whichever view mounts this body — `ReportDetailView` and `ReportDefinitionView` both dispatch
   * `schema:openEntity` for them — and letting the default `row.click()` fire here as well would
   * open the entity drawer twice from one keypress.
   *
   * Delegated from <body> because the section bodies are MOVED into a `.rptk-body-inner` wrapper by
   * `wrapReportSectionBodies` below, and a tab switch remounts the whole body.
   */
  function initReportBodyRowKeys() {
    wireRowKeys(document.body, { rowSelector: '[data-nrow]:not([data-rpt-entity])' });
  }
  initReportBodyRowKeys();
  document.addEventListener('astro:page-load', initReportBodyRowKeys);

  // Collapse / expand each report section (client 2026-07-14). The whole header is the toggle (chevron +
  // title); keyboard-operable via role=button + Enter/Space, mirroring the row-clickable pattern. Document
  // delegation so it covers every instance (run page + the Most Recent tab) with one listener.
  function onReportSectionToggle(e: Event) {
    const head = (e.target as HTMLElement).closest<HTMLElement>('[data-rptk-toggle]');
    if (!head) return;
    // A facet filter can live IN a section header (Trends "Bases") — clicking it must not collapse.
    if ((e.target as HTMLElement).closest('.ff')) return;
    if (e.type === 'keydown') {
      const k = (e as KeyboardEvent).key;
      if (k !== 'Enter' && k !== ' ') return;
      e.preventDefault();
    }
    const card = head.closest<HTMLElement>('.rptk-card');
    if (!card) return;
    const collapsed = card.toggleAttribute('data-collapsed');
    head.setAttribute('aria-expanded', String(!collapsed));
  }
  document.addEventListener('click', onReportSectionToggle);
  document.addEventListener('keydown', onReportSectionToggle);

  // Wrap each section's body (everything after the header) in .rptk-body > .rptk-body-inner so collapsing
  // animates its height (grid-rows 1fr↔0fr) instead of snapping. Done in JS to keep the section markup
  // clean and uniform across all six sections; nodes are MOVED (listeners + rendered charts preserved).
  function wrapReportSectionBodies() {
    document.querySelectorAll<HTMLElement>('.rptk-card').forEach((card) => {
      if (card.dataset.rptkBodyWrapped) return;
      const head = card.querySelector<HTMLElement>(':scope > .rptk-head');
      if (!head) return;
      card.dataset.rptkBodyWrapped = '1';
      const body = document.createElement('div');
      body.className = 'rptk-body';
      const inner = document.createElement('div');
      inner.className = 'rptk-body-inner';
      body.appendChild(inner);
      let n = head.nextSibling;
      while (n) { const next = n.nextSibling; inner.appendChild(n); n = next; }
      card.appendChild(body);
    });
  }
  wrapReportSectionBodies();
  document.addEventListener('astro:page-load', wrapReportSectionBodies);

  // Sticky section-nav scrollspy: highlight the section currently under the nav, jump on click, and add a
  // shadow once the nav is stuck to the top. Works whether the page or a layout element is the scroller.
  function scrollParentOf(el: HTMLElement): HTMLElement | Window {
    let p = el.parentElement;
    while (p) { const o = getComputedStyle(p).overflowY; if (o === 'auto' || o === 'scroll') return p; p = p.parentElement; }
    return window;
  }
  function initReportNav() {
    const nav = document.querySelector<HTMLElement>('[data-rptk-nav]');
    if (!nav || nav.dataset.navWired) return;
    nav.dataset.navWired = '1';
    const chips = Array.from(nav.querySelectorAll<HTMLElement>('[data-nav-target]'));
    const targets = chips.map((c) => document.getElementById(c.dataset.navTarget || '')).filter(Boolean) as HTMLElement[];
    const setActive = (id: string | null) => chips.forEach((c) => c.setAttribute('aria-current', String(!!id && c.dataset.navTarget === id)));
    chips.forEach((c) => c.addEventListener('click', () => {
      const el = document.getElementById(c.dataset.navTarget || '');
      if (el) { el.scrollIntoView({ behavior: 'smooth', block: 'start' }); setActive(c.dataset.navTarget || null); }
    }));
    let ticking = false;
    const update = () => {
      ticking = false;
      const navRect = nav.getBoundingClientRect();
      nav.classList.toggle('is-stuck', navRect.top <= 9); // sticky top is 8px
      const line = navRect.bottom + 12; // a section is "current" once its top passes just under the nav
      let active: string | null = targets[0]?.id ?? null;
      for (const t of targets) { if (t.getBoundingClientRect().top <= line) active = t.id; }
      setActive(active);
    };
    const onScroll = () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } };
    const scroller = scrollParentOf(nav);
    scroller.addEventListener('scroll', onScroll, { passive: true } as any);
    if (scroller !== window) window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
    update();
  }
  initReportNav();
  document.addEventListener('astro:page-load', initReportNav);
</script>

<style is:global>
  /* Layout A composition only (.rptk-*); every control/badge/table/tile is a catalog primitive. */

  /* The header strip is `.hm-kpis` / `.hm-kpi*` from global.css now — the catalog's one metric-tile
     strip. The nine `.rptk-strip` / `.rptk-tile*` rules that used to sit here were a fourth private
     copy of it, and the two `ds-ok` comments licensing them cited a Home that had already moved.
     The delta is the one thing the shared tile has no slot for; `pattern-report` mandates it, so it
     stays as a documented composition ON the tile rather than a reason to keep a private tile. */
  .rptk-empty-strip { margin-block: 16px 20px; }
  .rptk-delta { margin-left: 4px; font-size: var(--t-11); font-weight: 500; letter-spacing: normal; } /* ds-ok: pattern-metric-tiles delta */
  .rptk-kpis {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin-block: 16px 20px;
    border: 1px solid var(--color-base-300);
    border-radius: .85rem;
    background: var(--color-base-100);
    overflow: hidden;
  }
  .rptk-kpis.hm-kpis-3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .rptk-kpis .hm-kpi { display: flex; flex-direction: column; justify-content: space-between; gap: .2rem; min-width: 0; min-height: 104px; padding: 1.05rem 1.25rem 1.1rem; }
  .rptk-kpis .hm-kpi + .hm-kpi { border-left: 1px dashed oklch(from var(--color-base-content) l c h / .16); }
  .rptk-kpis .hm-kpi-top { display: flex; align-items: center; justify-content: space-between; gap: .5rem; }
  .rptk-kpis .hm-kpi-k { font-size: .76rem; font-weight: 500; color: oklch(from var(--color-base-content) l c h / .64); }
  .rptk-kpis .hm-kpi-ic { font-size: 1.2rem; color: var(--color-primary); flex: none; }
  .rptk-kpis .hm-kpi-v { font-size: 1.65rem; font-weight: 740; letter-spacing: -.02em; line-height: 1.05; font-variant-numeric: tabular-nums; }
  .rptk-kpis .hm-kpi-sub { font-size: .75rem; color: oklch(from var(--color-base-content) l c h / .64); display: inline-flex; align-items: center; gap: .22rem; }

  /* The narrow row's borrowed column labels — hidden above 1280, where a real <thead> says this. */
  .rptk-numcap, .rptk-subcap { display: none; }

  .rptk-card { border: 1px solid var(--color-base-300); border-radius: var(--r-12); background: var(--color-base-100); overflow: hidden; box-shadow: 0 1px 0 oklch(0 0 0 / .05); }
  /* The Trends card hosts the Bases dropdown in its header — let the menu escape the card's clip. */
  .rptk-card[data-rptk-section="trends"] { overflow: visible; }
  .rptk-head { display: flex; align-items: center; gap: 8px; padding: 14px 16px; border-bottom: 1px solid var(--color-base-300); cursor: pointer; user-select: none; }
  .rptk-head:hover { background: oklch(from var(--color-base-200) l c h / .35); }
  .rptk-title { font-size: var(--t-14); font-weight: 650; }

  /* Collapse / expand — the whole head is the toggle; a leading chevron is the disclosure indicator.
     The body is wrapped (in JS) in .rptk-body > .rptk-body-inner so it animates height via the grid-rows
     0fr↔1fr trick — a smooth open/close instead of an instant jump. */
  .rptk-chev { flex: none; color: oklch(from var(--color-base-content) l c h / .65); transition: transform .2s ease; }
  .rptk-card[data-collapsed] .rptk-chev { transform: rotate(-90deg); }
  .rptk-card[data-collapsed] .rptk-head { border-bottom-color: transparent; }
  @media (prefers-reduced-motion: reduce) { .rptk-chev { transition: none; } }

  /* Section aggregate rides INLINE on the header line (uses its empty space), left of the status badge —
     keeps the unique numbers, drops the extra row. */
  .rptk-headsub { display: inline-flex; flex-wrap: wrap; align-items: baseline; gap: 8px; margin-left: 12px; min-width: 0; }
  .rptk-sub-item { display: inline-flex; align-items: baseline; gap: 4px; font-size: var(--t-12); }
  .rptk-sub-sep { margin-right: 4px; color: oklch(from var(--color-base-content) l c h / .35); }
  .rptk-sub-label { color: oklch(from var(--color-base-content) l c h / .65); }
  .rptk-sub-val { font-weight: 600; }
  .rptk-sub-delta { font-size: var(--t-11); } /* ds-ok: delta echoes pattern-metric-tiles */

  /* THE COLUMN RULES ARE NOT HERE ANY MORE — all five of them are in the `is:global` block at the
     end of this file, together with their narrow overrides. `Table.astro` renders the `<thead>`
     now, so a `<th>` carries the VESSEL's `data-astro-cid-…` and none of this component's: a scoped
     `.rptk-table :is(th, td)` would have kept working on the `td` half and stopped matching every
     header, silently, with all four gates green
     (`infra-astro-scoped-styles-child-component`). The `td` halves travel with them, because
     splitting one table's metrics across two blocks by whether the selector happens to name `th`
     is how the next reader edits the half that is not in effect.
     The column-label TYPE was already gone from here: it was a hand-copy of `.tbl-colhead`
     (global.css:809) that had drifted to weight 600 against the shared 700. */

  .rptk-empty { margin: 12px 16px; width: auto; }

  /* Attention strip — triage jump-links to the sections that need a look.
     `flex-wrap` is NOT here any more because it never did anything: daisyUI's `.alert` is a GRID
     with `grid-auto-flow: column`, so a flex property on it is inert at every width. Same shape as
     `.rd-fail-alert` (BackupRunDetailView) — a rule that reads as correct and computes as nothing.
     The narrow block below is where the stacking actually happens. */
  .rptk-attention { align-items: center; gap: 8px; }
  .rptk-attention-lead { font-weight: 650; font-size: var(--t-13); }
  .rptk-attention-list { display: inline-flex; flex-wrap: wrap; gap: 8px; }
  /* `min-height: 28px` is the SM floor, and this chip was 26 (2026-08-13). It is a LINK to a
     section — a real target — and the two chip families beside it disagreed by a pixel and a half:
     attention 26.0, nav 26.5, every `btn-sm` around them 28. Padding stays 2px/8px so the shape
     does not grow; the floor is met by the box, which is what a finger lands on. */
  .rptk-attention-chip { display: inline-flex; align-items: center; gap: 4px; font-size: var(--t-12); font-weight: 500;
    min-height: 28px; padding: 2px 8px; border-radius: 999px; background: var(--color-base-100); border: 1px solid var(--color-base-300); }
  .rptk-attention-chip:hover { border-color: var(--color-warning); }
  .rptk-attention-count { font-size: var(--t-11); color: oklch(from var(--color-base-content) l c h / .65); } /* ds-ok: chip count echoes pattern-metric-tiles label scale */

  /* Section help affordance — a quiet ? that explains the section on hover (daisyUI tooltip). */
  /* An interactive icon CONTROL, so neither the text rung nor the decoration rung fits: it has to be
     findable at rest AND change on hover. Raising the rest state to the .65 floor and taking hover to
     FULL strength keeps the delta that a straight swap would have erased (.45 → .65 with hover already
     at .65 makes hover a no-op). */
  .rptk-help { display: inline-flex; color: oklch(from var(--color-base-content) l c h / .65); cursor: help; }
  .rptk-help:hover { color: var(--color-base-content); }

  /* Jump targets clear the sticky section-nav. */
  .rptk-anchor { scroll-margin-top: 72px; }

  /* Sticky section-nav — a scroll-following index of the report's sections. */
  /* The scope statement. Muted, one line, above the index — it is a fact about the document, not a
     warning about it, so it does not take an alert. */
  .rptk-scope { display: flex; align-items: center; gap: 8px; margin-bottom: 12px; font-size: var(--t-12); color: oklch(from var(--color-base-content) l c h / .65); }

  .rptk-nav { position: sticky; top: 8px; z-index: 20; display: flex; flex-wrap: wrap; align-items: center; gap: 8px;
    padding: 8px; border: 1px solid var(--color-base-300); border-radius: 999px;
    background: oklch(from var(--color-base-100) l c h / .85); backdrop-filter: blur(8px);
    transition: box-shadow .2s ease, border-color .2s ease; }
  .rptk-nav.is-stuck { box-shadow: 0 6px 20px oklch(0 0 0 / .18); border-color: oklch(from var(--color-base-content) l c h / .16); }
  /* Same SM floor as the attention chip above: this was 26.5, beside `btn-sm` at 28. */
  .rptk-nav-chip { display: inline-flex; align-items: center; justify-content: center; gap: 4px; font-size: var(--t-12); font-weight: 500;
    min-height: 28px; padding: 4px 12px; border-radius: 999px; color: oklch(from var(--color-base-content) l c h / .65);
    cursor: pointer; border: 1px solid transparent; white-space: nowrap; transition: background .15s, color .15s; }
  .rptk-nav-chip:hover { background: var(--color-base-200); color: var(--color-base-content); }
  .rptk-nav-chip[aria-current="true"] { background: var(--color-primary); color: var(--color-primary-content); }
  .rptk-nav-dot { width: 6px; height: 6px; border-radius: 50%; flex: none; }
  .rptk-nav-dot-warning { background: var(--color-warning); }
  .rptk-nav-dot-error { background: var(--color-error); }
  .rptk-nav-dot-neutral { background: oklch(from var(--color-base-content) l c h / .45); }
  .rptk-nav-chip[aria-current="true"] .rptk-nav-dot { background: currentColor; }

  /* Trends — a responsive grid of full charts, all shown at once, driven by one shared Bases filter. */
  .rptk-trend-range { font-size: var(--t-11); color: oklch(from var(--color-base-content) l c h / .65); }
  /* The shared Bases filter sits in the section header (no extra row) next to the range. */
  .rptk-trend-controls { display: inline-flex; align-items: center; gap: 12px; }
  .rptk-trend-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; padding: 16px; }
  @media (max-width: 720px) { .rptk-trend-grid { grid-template-columns: 1fr; } }
  .rptk-trend-card { border: 1px solid var(--color-base-300); border-radius: var(--r-12); background: var(--color-base-100); overflow: hidden; }
  .rptk-trend-sum { padding: 12px 12px 4px; }
  .rptk-trend-info { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; width: 100%; min-width: 0; }
  .rptk-trend-label { display: inline-flex; align-items: center; gap: 4px; font-size: var(--t-12); color: oklch(from var(--color-base-content) l c h / .65); }
  .rptk-trend-val { font-size: var(--t-16); font-weight: 650; }
  .rptk-trend-delta { margin-left: 6px; font-size: var(--t-11); font-weight: 500; } /* ds-ok: delta echoes pattern-metric-tiles */
  .rptk-trend-full { padding: 0 8px 8px; }

  /* Data health — record + attachment sub-blocks, each a labelled header over a table. */
  .rptk-dh-sub { display: flex; align-items: center; padding: 8px 16px; background: oklch(from var(--color-base-200) l c h / .45); border-bottom: 1px solid var(--color-base-300); }
  .rptk-dh-sub-sep { border-top: 1px solid var(--color-base-300); }
  .rptk-dh-head { display: inline-flex; align-items: center; gap: 8px; font-size: var(--t-12); font-weight: 650; width: 100%; }
  .rptk-dh-total { margin-left: auto; font-weight: 500; color: oklch(from var(--color-base-content) l c h / .65); }

  /* ── Below the 1280 product boundary ──────────────────────────────────────────────────────────
     Scoped HERE and not in global.css, for the specificity reason BackupsListView and
     BackupRunDetailView both record: Astro stamps every selector in this block with a
     `[data-astro-cid-…]` attribute, so `.rptk-table :is(th, td)` above computes as (0,4,1) while
     the shared `[data-mobile-rows] …` rules compute as (0,2,2). The shared sheet LOSES while
     reading as correct in both files, so each view undoes its own rules, after the rule it undoes. */
  @media (max-width: 1279.98px) {
    .rptk-kpis,
    .rptk-kpis.hm-kpis-3 { grid-template-columns: 1fr 1fr; }
    .rptk-kpis .hm-kpi:nth-child(odd) { border-left: 0; }
    .rptk-kpis .hm-kpi:nth-child(n+3) { border-top: 1px dashed oklch(from var(--color-base-content) l c h / .16); }

    /* THE TWO RULES THAT CAUSED THE CLIPPING, both undone here rather than softened.
       `nowrap` is a desktop contract — a column that cannot wrap can only grow — and the 200px
       first column was sized to fit the longest status badge across four tables so they would share
       a vertical guideline. Below 1280 there are no columns to align: the badge is the row's second
       line, not a column, so a 200px reservation for it is 200px of a 349px row spent on nothing. */
    /* The three column rules that used to be undone here moved to the `is:global` block with the
       base rules they undo — the pair has to stay together and in that order, since a media query
       changes WHEN a rule is considered and never whether it wins. */
    /* The narrow row has no <thead>, so an unlabelled 128,400 means nothing — the column header's
       own word moves into the cell (catalog `pattern-mobile-row`), the same `*-numcap` span the
       Backups log, the run pages, Home and Restore history all use. */
    .rptk-numcap { display: block; font-size: var(--t-11); font-weight: 500; color: oklch(from var(--color-base-content) l c h / .65); }
    .rptk-subcap { display: inline; }
    /* The row's own right-alignment goes with the columns it was aligning. `sub`/`sub2`/`lead` are
       positions on a left-reading line now; a right-aligned `sub2` would push the location trail
       away from the middot that introduces it. `num` keeps its right edge (the shared rule sets it). */
    [data-nrow] > [data-m='lead'],
    [data-nrow] > [data-m='sub'],
    [data-nrow] > [data-m='sub2'],
    [data-nrow] > [data-m='why'] { text-align: left; }

    /* THE SECTION INDEX STOPS FOLLOWING YOU. Measured before deciding, at 375: the six chips need
       746px laid end to end against 349px of room, so they wrap to THREE rows — a 114px bar, 14% of
       an 812px viewport, pinned at `top: 8px` over the document at 0.85 alpha with an 8px blur. At
       500 it is still two rows and 79px. Scrolled to the middle of the report, the element sitting
       under it was the report's own "Needs a look" triage alert: the index was covering the one
       line it exists to route you to.
       The two alternatives were measured and rejected. ONE HORIZONTAL ROW: 746px of chips dragged
       through a 349px window is 2.1 screens of sideways travel, and `pattern-mobile-row` forbids
       exactly that shape ("a horizontal drag on a touch surface reads as a swipe gesture") — plus
       a scroller with no affordance is how the tables above got into this state. A COLLAPSE: a new
       bespoke disclosure control with nothing in the catalog behind it, which is the case for
       stopping and asking rather than inventing one.
       Static is the third option and the cheapest true one: every chip stays a full tap target, the
       document gets its 114px back, and the index is read once at the top — which is what an index
       is for. The pill radius goes with it: 999px on a three-line box is what makes it read as a
       blob rather than as a card, so it takes `.rptk-card`'s own 12px. `is-stuck` is still toggled
       by the scrollspy (it measures `top`), so its shadow is cancelled rather than left to fire on
       an element that is no longer stuck.

       ── AND STATIC WAS NOT ENOUGH (Oleh, 2026-08-13). THE INDEX IS GONE BELOW 1280. ────────────
       Oleh, on the un-stuck version: *«вона юзлес по факту — або приберіть її повністю і хай юзер
       скролить, або вона має бути закріплена до верхньої частини»*. Two answers were offered and
       both were measured at 390 before choosing:

         · STICKY, AS IT PAINTS TODAY — six chips wrap to THREE rows, **118px**. Pinned under the
           app bar (`--topbar-h` = 60) that is **178px of permanent chrome on an 844px viewport,
           21%**, over a document that is 4,077px / 4.8 screens tall. A fifth of the screen
           spent, forever, on an index.
         · STICKY, FORCED TO ONE ROW — 46px, which sounds affordable until you measure the row:
           the six chips need **843px** end to end against **366px** of room. The index would
           itself need horizontal panning. A navigation control you have to navigate is not a
           cheaper index; it is a second scroll axis added to save travel on the first.

       · REMOVED — 0px of chrome, and what is actually lost is one jump. Measured section offsets
         at 390: 903 · 1195 · 1419 · 1711 · 1976 · 3582. **Five of the six sections sit inside the
         first 2.4 screens**, i.e. within a flick of each other; only Data health at 3582 is a real
         distance, and it is the LAST section, which is where scrolling ends up anyway.

       So the index is removed, not restyled. It stays in the DOM and keeps its scrollspy for the
       desktop render — the boundary is expressed in CSS everywhere else in this app and a second
       authority in JS is how a control and its rule come to disagree. `display: none` also stops
       the scrollspy pointlessly toggling `is-stuck` on a zero-height box. */
    .rptk-nav { display: none; }
    /* Nothing is pinned, so a jump no longer has to clear anything. `scroll-margin-top` stays:
       the section ids are still addressable from a link, and the app bar above is still sticky. */
    .rptk-anchor { scroll-margin-top: 12px; }

    /* THE CARD HAS ONE INSET, AND THE ROWS NOW USE IT (2026-08-13).
       `pattern-mobile-row` sets `padding: 12px 4px` on the row and the views that adopted it say why
       in their own words: 4px is right *where the CONTAINER supplies the inset*. Here the container
       supplies nothing — `.rptk-card` has no padding, so every other child of the card insets itself
       by 16 (`.rptk-head` 12px/16px · `.rptk-empty` margin 12px/16px · `.rptk-dh-sub` 8px/16px ·
       `.rptk-trend-grid` 16px) and only the table rows inset by 4.
       Measured at 390 before: the header's title/aggregate start at x 29 and its status badge ends
       at 361, while the row's name starts at x 17 and its chevron ends at 373. So a section headed
       one place read 12px further left and 12px further right than the rows underneath it — the
       ragged left edge in Oleh's screenshot. At 430 the same pair is 29/401 against 17/413.
       16px here makes the whole card one column: 29 and 361 at every level, at both widths. */
    .rptk-card [data-nrow] { padding-inline: 16px; }

    /* THE STATUS BADGE GOES BACK ON THE TITLE LINE.
       The header is chevron+glyph · title · help · aggregate · badge, and below 1280 it wraps. The
       aggregate takes `flex-basis: 100%`, and because the badge follows it in the DOM the badge was
       pushed to a THIRD line, alone, right-aligned by its own `ml-auto` — 98px of header at both 390
       and 430, and a lone pill floating under a sentence reads as a stray button rather than as this
       section's status. Order, not markup: the aggregate moves after the badge in the FLEX order, so
       line one is `title … 1 issue` (measured 259px of content against 364px of room at 390 — it
       fits with 105 to spare) and line two is the aggregate at the title's own left edge.
       The badge belongs beside the title because it qualifies the title, not the aggregate. */
    .rptk-head { flex-wrap: wrap; }
    .rptk-headsub { margin-left: 0; flex-basis: 100%; order: 1; }

    /* ONE TRAILING ELEMENT PER ROW, AND IT IS THE CHEVRON.
       `pattern-mobile-row` gives `go` "the chevron OR the row's single trailing action" — this
       document put BOTH there. On the Google Drive row that made `go` 111.6px wide inside a 364px
       row: the lead was squeezed from 316px to 220px, the row grew from 68.9px to 83.9px tall, and a
       labelled `Reconnect` sat between the base name and the chevron, vertically centred across two
       text lines that neither of its neighbours share. That is the button that "wraps oddly".
       The secondary actions are the ones that go, not the chevron: the chevron addresses the row's
       OWN subject (`/destinations/detail?id=…`, `/backups/run?id=…`), while both hidden actions are
       generic list links (`/sources`, `/backups`) reachable from the page the chevron opens — the
       same argument this file already used for hiding Tables/Fields. The row keeps `role="button"`
       and its handler, so nothing becomes unreachable.
       REJECTED: a full-width action line under the row. It needs a fifth area in the shared
       `data-m` vocabulary, which is a catalog change made from one view for one row.

       THE HOOK IS A LOCAL CLASS (`rptk-rowact`), because the two shared ones cannot do it: the
       backup rows wrap their icon action in `.row-actions` and the connection row's `Reconnect` is
       a bare anchor-button inside `.row-end`, so a wrapper-based rule hid one of the two and left
       the wide one — the one that was wrong. Three row actions carry the class; measured after,
       not asserted (`go` 111.6 → 16, lead 236 → 348 at 430).

       AND THE FIRST TWO ATTEMPTS AT THIS RULE NEVER RAN AT ALL, which is worth more than the rule.
       An earlier revision of this comment closed ITSELF half-way through — it quoted a comment
       terminator as prose, and CSS comments do not nest, so the sequence ended the comment where it
       appeared. The remaining prose then parsed as CSS and swallowed the rule under it: the text sat
       in the style element, the rule was absent from document.styleSheets, Element.matches()
       returned true for the selector, and the button kept computing display:flex. Both gates
       stayed green throughout — a CSS parse error is invisible to every one of them. The only
       instrument that showed it was reading the computed value and then looking for the rule in
       the parsed sheet rather than in the file. */
    .rptk-card [data-nrow] > [data-m='go'] .rptk-rowact { display: none; }

    /* A ROW WITH NO CHEVRON MUST NOT RESERVE THE GAP FOR ONE.
       Data health's rows carry no `go` cell, but the shared four-track grid still charges them its
       12px column gap, so their numbers ended at 361 while… they happened to match the section total
       at 361 only because the row also had 4px of padding. With the card's 16px inset above, the
       phantom track would have pushed them to 349 — 12px shy of the `Record data · 24,700 records`
       total they sit under. Three tracks, no phantom gap, one right edge at 361. */
    .rptk-card [data-nrow]:not(:has(> [data-m='go'])) {
      grid-template-columns: auto minmax(0, 1fr) auto;
      grid-template-areas: 'lead lead num' 'sub sub2 num' 'why why why';
    }

    /* An em-dash where a value would be is COLUMN furniture — the shared sheet already drops it from
       `why` for exactly this reason, and `sub2` needed the same rule: the failed Operations row read
       `Failed · —`, a middot introducing nothing. The dash wears `row-nil`, the marker that rule
       already uses, so one vocabulary covers both lines. */
    .rptk-card [data-nrow] > [data-m='sub2']:has(> .row-nil:only-child) { display: none; }
    /* The Trends filter is the same story one card down. */
    .rptk-trend-controls { margin-left: 0; flex-basis: 100%; justify-content: space-between; }

    /* THE TRIAGE LINE STACKS. `.alert`'s `grid-auto-flow: column` gave the three children three
       columns of 16px / 33.7px / 266px, so at 390 the words "Needs a look" were folded into a
       **34px** column and broke as "Needs" / "a look" beside the chips they introduce. This is the
       identical defect `.rd-fail-alert` records, and it is why the fix is on `grid-auto-flow` and
       not on the `flex-wrap` that was sitting above doing nothing. Rows now: the glyph and the
       label on line one, the chips beneath them at the label's own left edge (column 2), which is
       where the run page put its verb for the same reason. */
    .rptk-attention { grid-auto-flow: row; grid-template-columns: auto 1fr; gap: 8px 12px; align-items: start; }
    .rptk-attention-list { grid-column: 2; }
  }
</style>

{/* The collapse-animation wrappers are created in JS (document.createElement), so they never carry Astro's
    scoped-style attribute — their CSS must be GLOBAL to apply. Unique .rptk- prefix keeps it namespaced. */}
<style is:global>
  .rptk-body { display: grid; grid-template-rows: 1fr; transition: grid-template-rows .24s ease; }
  .rptk-body-inner { overflow: hidden; min-height: 0; }
  .rptk-card[data-collapsed] .rptk-body { grid-template-rows: 0fr; }
  @media (prefers-reduced-motion: reduce) { .rptk-body { transition: none; } }

  /* ── THE SIX TABLES' COLUMN RULES, GLOBAL BECAUSE THE `<th>` IS NO LONGER THIS FILE'S ──────────
     Moved out of the scoped block above when the six `<thead>`s became `Table.astro` calls. The
     `.rptk-` prefix is unique to this component, so `is:global` costs no reach.

     SPECIFICITY, RE-CHECKED RATHER THAN ASSUMED, because the scoped block used to rely on Astro's
     cid attributes to out-specify the shared sheet. Unscoped, `.rptk-card:not([data-rptk-section])
     .rptk-table :is(th, td):first-child` still computes as (0,4,1) — `:not()` takes its argument's
     specificity and `:is()` takes its most specific one — against `[data-mobile-rows] [data-nrow]
     > *` at (0,2,0), so the `min-width` relationship is unchanged. `white-space` is set by no
     shared rule at all, so (0,1,1) is uncontested. The narrow overrides keep their position AFTER
     the rules they undo, which is what makes them win at equal specificity.

     Column headers — the vertical guideline: muted caps, numeric columns right-aligned + tabular. */
  .rptk-table :is(th, td) { white-space: nowrap; }

  /* Cross-section column alignment: the four status-badge tables (Backup / Connection / Schema / Docs —
     the sections with no data-rptk-section marker) share ONE grid so columns line up down the page.
     A fixed first (badge) column fits the longest status badge; the second (name) column absorbs the
     slack; numeric + chevron columns shrink to content and right-align. Data health keeps its own shape. */
  .rptk-card:not([data-rptk-section]) .rptk-table :is(th, td):first-child { min-width: 200px; width: 200px; }
  .rptk-card:not([data-rptk-section]) .rptk-table :is(th, td):nth-child(2) { width: 100%; }

  @media (max-width: 1279.98px) {
    /* THE TWO RULES THAT CAUSED THE CLIPPING, both undone here rather than softened.
       `nowrap` is a desktop contract — a column that cannot wrap can only grow — and the 200px
       first column was sized to fit the longest status badge across four tables so they would share
       a vertical guideline. Below 1280 there are no columns to align: the badge is the row's second
