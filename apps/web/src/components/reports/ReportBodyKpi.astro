    </div>

    {/* Record data */}
    <div class="rptk-dh-sub">
      <div class="rptk-dh-head"><span class="iconify lucide--rows-3 size-3.5 opacity-60" aria-hidden="true"></span>Record data<span class="rptk-dh-total tabular-nums">{nf.format(dataHealth.records.total)} records</span></div>
    </div>
    {/* THE ONE PLACE THE `growth` QUESTION HAS NO HONEST ANSWER IN THIS VOCABULARY, recorded here
