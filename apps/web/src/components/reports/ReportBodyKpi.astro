---
/**
 * ReportBodyKpi — Report-detail layout A ("KPI band + tables"). See storybook `pattern-report`.
 *
 * One at-a-glance KPI band (the header metric-tile strip) is the ONLY place the headline numbers
 * live; the per-section aggregates are demoted from nested metric boxes to a single muted summary
 * LINE, so numbers are not duplicated as scattered tiles. Every section is a real table WITH column
 * headers and right-aligned tabular numbers, sharing a left anchor (status badge) and a right anchor
 * (numeric columns + chevron) — that shared grid is what gives the report its vertical guidelines.
 *
 * Presentational only: schema rows carry data-rpt-entity and the parent (ReportDetailView) wires
 * the shared EntityPanel + export; every badge/table/tile here is a catalog primitive.
 */
import type {
  ReportDetail, ReportStat, SectionStat,
  BackupRow, ConnectionRow, SchemaChangeRow, DocRow, ReportTrendMetric,
} from '../../lib/reports/types';
import type { ReportSectionKey } from '../../lib/reports/types';
import { SECTION_LABEL, SECTION_ORDER } from '../../lib/reports/view2';
import {
  nf, docWhen, deltaClass, toneBadgeOf, toneDotOf, sectionEmptyAlert, changeToneOf, backupBadge, connBadge, connUrl,
  UNKNOWN_BADGE,
} from '../../lib/reports/view';
import { getTrendBases, hasRenderableDataHealth } from '../../lib/reports/render-guards';
import Table from '../ui/Table.astro';
import TrendChart from '../ui/TrendChart.astro';
import Badge from '../ui/Badge.astro';
import FacetFilter from '../schema/FacetFilter.astro';
import { entityIconClass } from '../schema/entityIcon';

interface Props {
  report: ReportDetail;
  /**
   * The sections this report's DEFINITION covers. Absent = render everything, which is what a
   * standalone run document does when nothing scoped it.
   *
   * IT WAS ABSENT ENTIRELY UNTIL 2026-08-11, and the fixture said so in a comment: *"these render
   * all four sections; making a scoped report render ONLY its `sections` is a small follow-up"*.
   * So `Schema Health on Sales CRM` — a definition whose whole identity is one section on one base —
   * produced runs carrying Backup summary, Connection health, Documentation, Trends and Data health.
   * **A definition nothing honours is decoration.** The preview on the definition page scoped
   * correctly the whole time, which is the proof the data was there and only the run body ignored it.
   */
  sections?: ReportSectionKey[] | null;
  /**
   * Base ids the definition is scoped to; null/absent = every base. A row that names no base (a
   * connection, a doc) is never filtered out — it is not about a base, so scoping it to one would
   * drop information the report is still responsible for.
   */
  baseScope?: string[] | null;
  /** Display names for `baseScope`, so the scope note names bases rather than ids. */
  baseScopeNames?: string[] | null;
}
const { report, sections: defSections = null, baseScope = null, baseScopeNames = null } = Astro.props;

// One predicate, read by the nav, the attention strip and every section below — so a section cannot
// be advertised in the index and then not rendered, which is the failure mode of filtering markup in
// six places.
const shows = (key: ReportSectionKey): boolean => !defSections || defSections.includes(key);

// Trends + Data health helpers.
const metricIcon: Record<ReportTrendMetric['key'], string> = {
  records: 'lucide--rows-3', tables: 'lucide--table-2', fields: 'lucide--tag',
  attachments: 'lucide--paperclip', automations: 'lucide--zap', interfaces: 'lucide--layout-panel-left',
};
function fmtBytes(n: number): string {
  if (n < 1024) return `${n} B`;
  const u = ['KB', 'MB', 'GB', 'TB']; let i = -1; let v = n;
  do { v /= 1024; i++; } while (v >= 1024 && i < u.length - 1);
  return `${v.toFixed(1)} ${u[i]}`;
}
const fmtVal = (v: number, unit: 'count' | 'bytes') => (unit === 'bytes' ? fmtBytes(v) : nf.format(v));

// Shared base filter for the Trends charts — one "Bases" facet controls the per-base lines across ALL 6
// charts at once (client 2026-07-14: one shared filter, scales to many bases). Overall is a toggle too.
const trendBases = getTrendBases(report.trends);
const trendBaseItems = ['Overall', ...trendBases].map((n) => ({ value: n, label: n }));
const dataHealth = hasRenderableDataHealth(report.dataHealth) ? report.dataHealth : null;
const generating = report.generationState === 'running';

// Triage: any non-healthy section becomes a jump-link chip in the attention strip under the KPI band.
// A healthy report has an empty `attention`, so the strip does not render at all.
const sections = [
  { key: 'backups' as ReportSectionKey, name: 'Backup summary', icon: 'lucide--database-backup', anchor: 'rpt-sec-backup', help: 'Which bases were backed up this period, with record counts and size.', sec: report.backupSummary },
  { key: 'connections' as ReportSectionKey, name: 'Connection health', icon: 'lucide--plug-zap', anchor: 'rpt-sec-conn', help: 'Whether each source and destination stayed connected, and any outage window.', sec: report.connectionHealth },
  { key: 'schema' as ReportSectionKey, name: 'Schema health', icon: 'lucide--list-tree', anchor: 'rpt-sec-schema', help: 'Structural changes to your bases and the health score (Green/Amber/Red) for the period.', sec: report.schemaHealth },
  { key: 'docs' as ReportSectionKey, name: 'Documentation updates', icon: 'lucide--file-text', anchor: 'rpt-sec-docs', help: 'Docs created or updated in this period.', sec: report.documentation },
].filter((s) => shows(s.key));
const attention = sections.filter((s) => s.sec.tone !== 'success');

// Sticky section-nav (long reports can run very tall). One chip per PRESENT section; a non-healthy
// section shows a tone dot. Scrollspy marks the current one; clicking jumps to it.
const navSections: { name: string; icon: string; anchor: string; tone?: string }[] = [
  ...sections.map((s) => ({ name: s.name, icon: s.icon, anchor: s.anchor, tone: s.sec.tone })),
  ...(shows('trends') && report.trends && report.trends.metrics.length > 0 ? [{ name: 'Trends', icon: 'lucide--trending-up', anchor: 'rpt-sec-trends' }] : []),
  ...(shows('dataHealth') && dataHealth ? [{ name: 'Data health', icon: 'lucide--database', anchor: 'rpt-sec-datahealth' }] : []),
];

// The scope note. A scoped report must SAY it is scoped, or a reader cannot tell a one-section report
// from a full one that happened to have nothing to say in the other five.
// ONLY WHEN THE REPORT IS ACTUALLY NARROWED. A definition that covers all six sections and all bases
// is not scoped, and the first version printed "6 sections · All bases · Everything outside that is
// not collected for it" on the full report — a sentence that is true, says nothing, and trains the
// reader to skip the line on the report where it matters. Narrowed means a strict subset of the
// sections, or a base scope at all.
const narrowedSections = !!defSections && defSections.length < SECTION_ORDER.length;
const narrowedBases = !!baseScope && baseScope.length > 0;
const scopeNote =
  narrowedSections || narrowedBases
    ? [
        narrowedSections && defSections ? (defSections.length === 1 ? SECTION_LABEL[defSections[0]] : `${defSections.length} of ${SECTION_ORDER.length} sections`) : 'All sections',
        narrowedBases && baseScope
          ? (baseScopeNames && baseScopeNames.length > 0 ? baseScopeNames.join(', ') : `${baseScope.length} base${baseScope.length === 1 ? '' : 's'}`)
          : 'All bases',
      ].join(' · ')
    : null;

// Backup summary: surface per-base structural counts (Tables/Fields) when the run carries them
// (client 2026-07-14). Reports without structural data keep the lean Records/Size table.
const showBackupStructural = report.backupSummary.rows.some((r: BackupRow) => r.tables != null || r.fields != null);

/**
 * THE SIX REPORT-BODY TABLES, AS COLUMN DATA (catalog `table`).
 *
 * Six hand-written `<thead>` one-liners stood here. None of them was sortable, so none carried a
 * `data-sort-col` to drift — what they carried instead was FOUR `<th aria-hidden="true"></th>`,
 * the chevron column, which is not "unlabelled" but actively removed from the accessibility tree
 * while the cell under it holds the row's only exit. `srLabel` is the vessel's answer and it is
 * not optional.
 *
 * ONE NARROW REASON, SHARED, because it is one decision. `pattern-mobile-row` is declared by the
 * enclosing `.rptk-card` — the section, not the table, is the unit that folds here — and the
 * vessel's `narrow="fold"` re-states it on each wrapper so the answer is readable at the call site
 * instead of only on an ancestor 40 lines up. Restating a `data-mobile-rows` an ancestor already
 * carries changes no computed value: the shared rules are `[data-mobile-rows] …` descendant
 * selectors, which already matched through the section.
 */
const RPTK_NARROW = 'A report is a DOCUMENT, read top to bottom on whatever screen the email opened on, and its tables are 4–7 columns of one fact each — a status, a name, a count, a stamp. Nobody compares values down a column of a monthly summary; they read a row. Measured at 375 before the fold existed, the six tables clipped 281 · 386 · 149 · 248 · 33 · 16px, and because `.rptk-card` had `overflow: hidden` none of it scrolled — the Documentation row rendered its date 199px past a card edge, present in the DOM and unreachable by any means.';

const backupColumns = [
  { label: 'Status' },
  { label: 'Base' },
  ...(showBackupStructural
    ? [{ label: 'Tables', align: 'end' as const }, { label: 'Fields', align: 'end' as const }]
    : []),
  { label: 'Records', align: 'end' as const },
  { label: 'Size', align: 'end' as const },
  { label: '', srLabel: 'Open the backup run' },
];
const connectionColumns = [
  { label: 'Status' },
  { label: 'Connection' },
  { label: 'Incident', align: 'end' as const },
  { label: '', srLabel: 'Open the connection' },
];
const schemaColumns = [
  { label: 'Change' },
  { label: 'Entity' },
  { label: 'Location', align: 'end' as const },
  { label: '', srLabel: 'Open the entity' },
];
const docsColumns = [
  { label: 'Action' },
  { label: 'Document' },
  { label: 'Updated', align: 'end' as const },
  { label: '', srLabel: 'Open in Schema docs' },
];
const dhRecordColumns = [
  { label: 'Base' },
  { label: 'Tables', align: 'end' as const },
  { label: 'Fields', align: 'end' as const },
  { label: 'Records', align: 'end' as const },
  { label: 'Size', align: 'end' as const },
];
const dhAttachmentColumns = [
  { label: 'Base' },
  { label: 'Attachment fields', align: 'end' as const },
  { label: 'Files', align: 'end' as const },
  { label: 'Size', align: 'end' as const },
];
---

{/* THE SCOPE, STATED. A scoped report has to say it is scoped, or a reader cannot tell a
    one-section report from a full one that had nothing to say in the other five — which is exactly
    the reading a silently-truncated document invites. */}
{scopeNote && (
  <p class="rptk-scope">
    <span class="iconify lucide--filter size-3.5" aria-hidden="true"></span>
    <span>This report covers <b>{scopeNote}</b>. Everything outside that is not collected for it.</span>
  </p>
)}

{/* Sticky section-nav — ABOVE the metrics so it reads as the report's index at a glance; it sticks to
    the top as you scroll, tracks the current section (scrollspy), and jumps on click. */}
{navSections.length > 1 && (
  <nav class="rptk-nav" aria-label="Report sections" data-rptk-nav>
    {navSections.map((s) => (
      <button type="button" class="rptk-nav-chip" data-nav-target={s.anchor}>
        <span class:list={['iconify size-3.5', s.icon]} aria-hidden="true"></span>
        <span class="rptk-nav-name">{s.name}</span>
        {s.tone && s.tone !== 'success' && <span class:list={['rptk-nav-dot', `rptk-nav-dot-${s.tone}`]} aria-hidden="true"></span>}
      </button>
    ))}
  </nav>
)}

{/* Header status strip — THE shared metric-tile strip (`.hm-kpis`), not a fourth private copy of it.
    `pattern-metric-tiles` is unambiguous: "a small row of headline metrics is ALWAYS this strip".
    This file hand-rolled `.rptk-strip` / `.rptk-tile*` and licensed it with two `ds-ok` comments
    claiming it "matches Home `.hm-kpi`" — against values Home CHANGED on 2026-07-31 when the strip
    was lifted into global.css and rounded onto the 4px grid. So the claim decayed into its opposite:
    the copy kept 1.05/1.25rem padding and a .76rem label against the catalog's 16/20px and 12px.

    The cost was not cosmetic. The shared strip carries a measured 2-across breakpoint at 767.98px;
    a copy inherits nothing. Measured at 500 the four tiles were 118px wide with "Schema health" and
    "Docs updated" wrapping onto two lines each, and at 375 the tile was 87px while "Degraded" needs
    94px — the tone tile's own word was wider than the tile holding it.

    The inline `grid-template-columns` is gone with it: an inline style beats a media query, so
    keeping it would have re-broken the 2-across rule the moment it was inherited. The strip's column
    count is the catalog's own `.hm-kpis-3` modifier, and 4 is the default.

    The delta stays — `pattern-report` requires it ("a number without a delta is decoration") and the
    tile pattern has no slot for it, so it is a documented composition of the two, not a new tile.

    X08-F7 (2026-08-14) — THE TONE DOT'S FILL COMES FROM `toneDotOf`, A MAP OF STATIC LITERALS. It
    was `` `bg-${s.tone === 'neutral' ? 'base-content/40' : s.tone}` ``; Tailwind scans source text
    and never sees a string assembled at runtime, so the utility was never emitted and the `neutral`
    branch painted an 8px hole — its computed fill measured fully TRANSPARENT while the `warning` and
    `success` branches came back as real amber and green on the same host in the same call. Reason,
    measurements and why not `@source inline` are on `toneDot` in `lib/reports/view.ts`.
    This note lives HERE rather than beside the tone branch below on purpose: an Astro comment as the
    first child of a `{cond ? ( … ) : ( … )}` branch is an SSR-500 with an EMPTY BODY, and neither
    `astro check` nor `ds-lint` sees it (`infra-astro-comment-in-expression-ssr500` — this is
    occurrence 7, caught by `pnpm smoke`). Do not move it inside the ternary. */}
<div class:list={['hm-kpis rptk-kpis', report.strip.length === 3 && 'hm-kpis-3']} hidden={report.strip.length === 0}>
  {report.strip.map((s: ReportStat) => (
    <div class="hm-kpi">
      <div class="hm-kpi-top"><span class="hm-kpi-k">{s.label}</span><span class:list={['iconify hm-kpi-ic', s.icon]} aria-hidden="true"></span></div>
      {s.tone ? (
        <span class="hm-kpi-v inline-flex items-center gap-1.5"><span class:list={['size-2 rounded-full', toneDotOf(s.tone)]}></span>{s.value}</span>
      ) : (
        <span class="hm-kpi-v">{s.value}{s.delta && <span class:list={['rptk-delta', deltaClass(s.delta)]}>{s.delta.text}</span>}</span>
      )}
      {s.sub && <span class="hm-kpi-sub">{s.sub}</span>}
    </div>
  ))}
</div>

{report.strip.length === 0 && (
  <div role="status" class="alert alert-soft rptk-empty-strip">
    <span class="iconify lucide--info size-4" aria-hidden="true"></span>
    <span>{generating ? 'This run is still generating. Headline metrics appear when it finishes.' : 'No headline metrics for this window yet.'}</span>
  </div>
)}

{/* Attention strip — the report's triage line: jump straight to the sections that need a look.
    Only rendered when something is off; a clean report skips it entirely. */}
{attention.length > 0 && (
  <div role="alert" class="alert alert-warning alert-soft rptk-attention">
    <span class="iconify lucide--triangle-alert size-4" aria-hidden="true"></span>
    <span class="rptk-attention-lead">Needs a look</span>
    <span class="rptk-attention-list">
      {attention.map((s) => (
        <a href={`#${s.anchor}`} class="rptk-attention-chip"><span class:list={['iconify size-3.5', s.icon]} aria-hidden="true"></span>{s.name}<span class="rptk-attention-count">{s.sec.statusLabel}</span></a>
      ))}
    </span>
  </div>
)}

{/* ── Backup summary ─────────────────────────────────────────────────────────── */}
{/* `data-mobile-rows` (catalog `pattern-mobile-row`) — the report document had NO narrow form at
    all: six tables, `white-space: nowrap` on every cell, a hard 200px first column on four of them,
    and `.rptk-card { overflow: hidden }` around the lot. That last part is why nothing looked
    broken: the tables did not scroll sideways, they were CLIPPED. Measured at 375 the Documentation
    row put its title at x 213–428 and its "Jul 10, 2026 · Reese D." at x 428–562 against a card
    edge at 363 — the date column was 199px past the edge, rendered and unreachable. That is the
    "text drifting" in the ACTION / DOCUMENT / UPDATED screenshot, and its cause is a fixed column
    against nowrap, not padding. Clip at 375: 281 · 386 · 149 · 248 · 33 · 16px across the six. */}
<section id="rpt-sec-backup" class="rptk-card rptk-anchor" data-mobile-rows hidden={!shows('backups')}>
  <div class="rptk-head" data-rptk-toggle role="button" tabindex="0" aria-expanded="true"><span class="iconify lucide--chevron-down size-4 rptk-chev" aria-hidden="true"></span>
    <span class="iconify lucide--database-backup size-4 opacity-70" aria-hidden="true"></span>
    <span class="rptk-title">Backup summary</span>
    <span class="rptk-help tooltip tooltip-right" data-tip="Which bases were backed up this period, with record counts and size."><span class="iconify lucide--circle-help size-3.5" aria-hidden="true"></span></span>
    {report.backupSummary.stats.length > 0 && (
      <span class="rptk-headsub">
        {report.backupSummary.stats.map((st: SectionStat, i: number) => (
          <span class="rptk-sub-item">{i > 0 && <span class="rptk-sub-sep">·</span>}<span class="rptk-sub-label">{st.label}</span><span class="rptk-sub-val tabular-nums">{st.value}</span>{st.delta && <span class:list={['rptk-sub-delta tabular-nums', deltaClass(st.delta)]}>{st.delta.text}</span>}</span>
        ))}
      </span>
    )}
    <Badge size="sm" class="ml-auto" dot variant={toneBadgeOf(report.backupSummary.tone)}>{report.backupSummary.statusLabel}</Badge>
  </div>
  {/* `growth="fixed"` — one row per base in the report's scope. NOT because the set is small, but
      because the set is BOUNDED by the Space's bases and this is a document: a paged section cannot
      exist in the PDF/HTML export the same markup produces. See the note at the Data health tables
      for the case this answer does not cover honestly.
      No `rowSelector`: Enter/Space is already delegated once from `<body>` in this file's script
      (the `[data-nrow]:not([data-rpt-entity])` mount), and adding the vessel's mount on top of it
      would give one keypress two `row.click()` calls.
      THE COMMENT SITS OUTSIDE THE TERNARY ON PURPOSE — an Astro comment as the first child of a
      `{cond ? ( … )}` branch is an SSR 500 with an EMPTY BODY, which every static gate passes
      (`infra-astro-comment-in-expression-ssr500`; caught here by `curl`, on the first try). */}
  {report.backupSummary.rows.length > 0 ? (
    <Table
      tableClass="rptk-table"
      name="rptk-backups"
      columns={backupColumns}
      rowCount={report.backupSummary.rows.length}
      growth="fixed"
      narrow="fold"
      narrowReason={RPTK_NARROW}
    >
        {report.backupSummary.rows.map((r: BackupRow) => {
          const bm = backupBadge[r.outcome] ?? UNKNOWN_BADGE;
          // D07 — one address. A `failed` row used to jump to `?state=failed`, a URL naming no run,
          // so the report's own failed row and every other failed run in the product landed on the
          // same page. It goes to ITS run; with no run id there is nothing to address and the log
          // is the honest landing. (Written as a JS comment, not `{/* */}`: an Astro comment as the
          // first child of a `return (` makes the return two root children and 500s the route.)
          //
          // NARROW CLASSIFICATION — the base NAME leads, which is the same choice the backup run
          // pages made on 2026-08-12, so a per-base backup row reads identically whether you meet it
          // in a report or on the run it summarizes. Status is the second line, Records is the ONE
          // number (it is what "how much was written" means on every other surface) and Size takes
          // `sub2`. Tables/Fields go off: they are reachable in this same document's Data health
          // section and on the run page this row opens — checked before hiding them.
          return (
            <tr class="row-clickable" data-nrow role="button" tabindex="0" onclick={`window.location='${r.runId ? `/backups/run?id=${r.runId}` : '/backups'}'`}>
              <td data-m="sub"><Badge variant={bm.badge}>{bm.label}</Badge></td>
              <td data-m="lead" class="font-medium">{r.baseName}</td>
              {showBackupStructural && <><td data-m="off" class="text-right tabular-nums text-base-content/65">{r.tables != null ? nf.format(r.tables) : '—'}</td><td data-m="off" class="text-right tabular-nums text-base-content/65">{r.fields != null ? nf.format(r.fields) : '—'}</td></>}
              <td data-m="num" class="text-right tabular-nums text-base-content/65">{r.records !== null ? nf.format(r.records) : '—'}<span class="rptk-numcap">records</span></td>
              <td data-m="sub2" class="text-right tabular-nums text-base-content/65">{r.volume ?? <span class="row-nil">—</span>}</td>
              <td data-m="go" class="text-right"><span class="row-end">
                {r.outcome === 'failed' ? (
                  <span class="row-actions">
                    <a href="/backups" class="btn btn-ghost btn-sm btn-square tooltip tooltip-left rptk-rowact" data-tip="Rerun in Backups" onclick="event.stopPropagation()" aria-label="Rerun in Backups"><span class="iconify lucide--rotate-ccw size-4 opacity-70" aria-hidden="true"></span></a>
                  </span>
                ) : r.destinationUrl && (
                  <span class="row-actions">
                    <a href={r.destinationUrl} target="_blank" rel="noopener noreferrer" class="btn btn-ghost btn-sm btn-square tooltip tooltip-left rptk-rowact" data-tip={`Open in ${r.destinationName ?? 'storage'}`} onclick="event.stopPropagation()" aria-label={`Open in ${r.destinationName ?? 'storage'}`}><span class="iconify lucide--folder-open size-4 opacity-70" aria-hidden="true"></span></a>
                  </span>
                )}
                <span class="row-go" aria-hidden="true"><span class="iconify lucide--chevron-right size-4"></span></span>
              </span></td>
            </tr>
          );
        })}
    </Table>
  ) : (
    <div role="alert" class:list={['alert alert-soft rptk-empty', sectionEmptyAlert[report.backupSummary.tone]]}>
      <span class="iconify lucide--circle-check size-4" aria-hidden="true"></span><span>{report.backupSummary.emptyLine}</span>
    </div>
  )}
</section>

{/* ── Connection health ─────────────────────────────────────────────────────── */}
<section id="rpt-sec-conn" class="rptk-card rptk-anchor" data-mobile-rows hidden={!shows('connections')}>
  <div class="rptk-head" data-rptk-toggle role="button" tabindex="0" aria-expanded="true"><span class="iconify lucide--chevron-down size-4 rptk-chev" aria-hidden="true"></span>
    <span class="iconify lucide--plug-zap size-4 opacity-70" aria-hidden="true"></span>
    <span class="rptk-title">Connection health</span>
    <span class="rptk-help tooltip tooltip-right" data-tip="Whether each source and destination stayed connected, and any outage window."><span class="iconify lucide--circle-help size-3.5" aria-hidden="true"></span></span>
    <Badge size="sm" class="ml-auto" dot variant={toneBadgeOf(report.connectionHealth.tone)}>{report.connectionHealth.statusLabel}</Badge>
  </div>
  {/* `growth="fixed"` — one row per source and destination bound to this Space. That set is
      bounded by the connection caps the account model already enforces, not by the reporting
      window. (Outside the ternary — see the Backup summary note.) */}
  {report.connectionHealth.rows.length > 0 ? (
    <Table
      tableClass="rptk-table"
      name="rptk-connections"
      columns={connectionColumns}
      rowCount={report.connectionHealth.rows.length}
      growth="fixed"
      narrow="fold"
      narrowReason={RPTK_NARROW}
    >
        {report.connectionHealth.rows.map((r: ConnectionRow) => {
          const cm = connBadge[r.status] ?? UNKNOWN_BADGE;
          const url = connUrl(r.kind, r.connectionId);
          // NARROW CLASSIFICATION — the connection's name leads, its status badge is the second
          // line, and the incident takes `why`: it is a SENTENCE ("Disconnected Jul 8 – Jul 9 (auth
          // expired)"), which is exactly the full-width wrapping line that area was added for. This
          // table has no number, so `num` stays empty and its auto track collapses. The em-dash for
          // "no incident" wears `row-nil`, which is the marker the shared rule uses to drop an empty
          // `why` line rather than printing a dash on its own row.
          return (
            <tr class={url ? 'row-clickable' : undefined} data-nrow role={url ? 'button' : undefined} tabindex={url ? 0 : undefined} onclick={url ? `window.location='${url}'` : undefined}>
              <td data-m="sub"><Badge variant={cm.badge}>{cm.label}</Badge></td>
              <td data-m="lead" class="font-medium">{r.name}<Badge size="sm" class="ml-1.5 capitalize">{r.kind}</Badge></td>
              <td data-m="why" class="text-right text-base-content/65">{r.incident ?? <span class="row-nil">—</span>}</td>
              <td data-m="go" class="text-right"><span class="row-end">
