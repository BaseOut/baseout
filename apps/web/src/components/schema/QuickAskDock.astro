---
/**
 * QuickAskDock — the global quick-ask chat, as a PANEL KIND in the one shared stack.
 *
 * It used to be its own modal right drawer: a `position: fixed` scrim at z-60, a `position: fixed`
 * aside at z-61, its own left-edge grip with its own persisted width, and Esc/scrim/× closing it.
 * That made the chat the one thing on the right that behaved differently from everything else on the
 * right (Oleh, 2026-08-06: «щоб цей чат відкривався рівнозначно до будь-якої іншої панельки»). It is
 * now a `chat:` kind registered with `components/ui/panelHostRegistry.ts`, so it parks to a 46px
 * strip, counts toward the cap, reorders, resizes on the shared grip, is evicted with the undo toast
 * and is saved/restored under `panels:<section>` exactly like a record, a file or an entity sheet.
 *
 * ONE INSTANCE. The id is the constant `chat:quick` — there is one assistant, not one per thread —
 * so `panelKey` is constant and a second launcher press lands on the stack's own reuse path:
 * un-park, focus, flash. That is what every other kind does when you pick something already open.
 *
 * ── The controller-binding problem, and how it is solved ─────────────────────────────────────────
 * A panel's markup is CLONED from the `<template>` below at open time and destroyed on close, so the
 * old shape — «bind `[data-scd-*]` inside my own root, once, at module init» — has nothing to bind to
 * at init and would leave listeners on a detached corpse after the first close. Every in-sheet read
 * is therefore DELEGATED FROM THE PANEL ELEMENT (`p.el`), attached in `buildPanel` and never
 * unbound: a listener on the element itself dies with the element, which is the only unbinding that
 * cannot be forgotten. Per-panel STATE (the context chips) lives on the panel object, not in a
 * module closure, for the same reason.
 *
 * The one listener that cannot live on a panel is the LAUNCHER delegate — `[data-sch-ask]` sits in
 * the page header, outside every panel — so it is bound once per MODULE (not once per page) and
 * reaches the stack through the lazy `host` proxy. Binding it per page was the corpse the old file
 * actually had: `astro:after-swap` re-ran the wiring, the document survived the swap, and the
 * previous page's listener stayed behind toggling a class on a detached root.
 *
 * Opened by any `[data-sch-ask]` launcher on the page; Expand ⤢ still jumps to the page's full Chat
 * tab (`[data-tab="chat"]`) — the only route there. With `browseItem`, the Add-context picker offers
 * "Current Browse view", a chip built from the live Browse state (table + active filter count).
 */
import { AIRTABLE_FIELD_ICONS, airtableIconKey } from './airtableFieldIcons';
import { entityIconClass } from './entityIcon';
import type { ChatThread, ChatRef } from './schemaChatTypes';
import type { SchemaEntity } from './schemaEntities';

interface Props {
  threads: ChatThread[];
  index: SchemaEntity[];
  docs: { id: string; title: string }[];
  /** What the assistant is about — placeholder copy ("schema" | "data"). */
  noun?: string;
  /** Offer "Current Browse view" in the Add-context picker (Data page). */
  browseItem?: boolean;
}
const { threads, index, docs, noun = 'schema', browseItem = false } = Astro.props;

// The compact panel lists the same NON-ARCHIVED threads the full Chat tab rail uses and
// swaps the shown exchange on select (presentational — the full Chat tab owns real history).
const scdThreads = threads.filter((t) => !t.archived).map((t) => ({ id: t.id, title: t.title, messages: t.messages }));
const scdCurrent = scdThreads[0];
// Quiet reference-chip icon (kept simple; the full Chat tab has the rich set).
const scdRefIcon = (r: ChatRef) =>
  r.kind === 'doc' ? 'lucide--file-text'
  : r.kind === 'record' ? 'lucide--circle-dot concept-ic-record'
  // Was diverging from the canon: a bare `lucide--database` / `lucide--eye` without their
  // `concept-ic-*` class, and `lucide--hash` for a FIELD where the app's field glyph is a tag.
  : entityIconClass(r.entityKind || 'table');

// Add-context picker — the same browsable + searchable list the full Chat composer uses.
const scdFieldIcon = (type?: string) => {
  const k = type ? airtableIconKey(type) : null;
  return k ? `<svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true">${AIRTABLE_FIELD_ICONS[k]}</svg>` : '';
};
const scdCtxIcon = (e: SchemaEntity) =>
  e.kind === 'field' ? scdFieldIcon(e.fieldType) || '<span class="iconify lucide--tag"></span>'
  : e.kind === 'table' ? '<span class="iconify lucide--table-2 concept-ic-table"></span>'
  : e.kind === 'view' ? '<span class="iconify lucide--eye concept-ic-view"></span>'
  : '<span class="iconify lucide--database"></span>';
const scdCtxSearch = (e: SchemaEntity) => [e.name, e.tableName, e.baseName].filter(Boolean).join(' ').toLowerCase();
const scdCtxGroups = [
  { label: 'Bases', items: index.filter((e) => e.kind === 'base' && !e.removed) },
  { label: 'Tables', items: index.filter((e) => e.kind === 'table' && !e.removed) },
  { label: 'Fields', items: index.filter((e) => e.kind === 'field' && !e.removed) },
  // view-schema-details: a view is askable context like anything else — omitting it here would
  // make views silently unreachable from the assistant's picker, with no error.
  { label: 'Views', items: index.filter((e) => e.kind === 'view' && !e.removed) },
];
---

{/* NO ROOT, NO SCRIM, NO OWN GRIP (2026-08-06) — see the note at the top of this file. What is left
    is this kind's sheet TEMPLATE; the host owns the frame, the control column, the toast and the
    three stack verbs. The template's presence on the page is also this kind's mount signal and its
    `canOpen` test, so a section that does not render the dock can never restore a chat panel. */}
<template data-scd-tpl>
  <aside class="scd-sheet" data-ps-panel data-scd-panel role="dialog" aria-modal="false" aria-label="Assistant">
    <div class="scd-grip" data-ps-grip aria-hidden="true"><span class="scd-grip-line"></span></div>
    {/* Anchor lock scrim — shown on the anchor during a reorder drag ("docked, can't be reordered"). */}
    <div class="scd-lock" aria-hidden="true"><span class="iconify lucide--lock size-5"></span><span>Docked to the page</span></div>
    <div class="scd-top">
      {/* THE HOLD SLOT (pattern-multi-panel-drawer), 1:1 with the record / file / entity sheets:
          Pin first, then the drag grip. Never both, and both ALWAYS laid out. */}
      <button type="button" class="btn btn-sm btn-ghost btn-square scd-detach tooltip tooltip-bottom" data-ps-detach aria-label="Pin this panel so the next thing you open lands beside it" data-tip="Pin — next panel opens beside"><span class="iconify lucide--pin size-3.5" aria-hidden="true"></span></button>
      <button type="button" class="btn btn-sm btn-ghost btn-square scd-reorder tooltip tooltip-bottom" data-ps-reorder aria-label="Drag to reorder" data-tip="Drag to reorder"><span class="iconify lucide--grip-vertical size-4" aria-hidden="true"></span></button>
      {scdThreads.length > 0 ? (
        <div class="dropdown scd-threadmenu">
          <div tabindex="0" role="button" class="scd-threadbtn tooltip tooltip-bottom" data-tip="Switch chat" aria-label="Switch chat">
            <span class="iconify lucide--sparkles size-4 scd-threadmark" aria-hidden="true"></span>
            <span class="scd-threadttl" data-scd-current>{scdCurrent.title}</span>
            <span class="iconify lucide--chevron-down size-3.5 scd-threadchev" aria-hidden="true"></span>
          </div>
          <ul tabindex="0" class="dropdown-content scd-threadlist">
            {scdThreads.map((t) => (
              <li>
                <button type="button" class="scd-threaditem" data-scd-pick={t.id} data-scd-title={t.title}>
                  <span class="iconify lucide--message-square size-3.5" aria-hidden="true"></span>
                  <span class="scd-threaditem-ttl">{t.title}</span>
                </button>
              </li>
            ))}
          </ul>
        </div>
      ) : (
        <span class="scd-ttl"><span class="iconify lucide--sparkles size-4" aria-hidden="true"></span><span class="scd-threadttl">Assistant</span></span>
      )}
      <div class="scd-acts">
        {/* Content-level verbs stay with the content. The three STACK verbs below them
            (Collapse / Close) carry the neutral `data-ps-*` hooks the host answers for every kind. */}
        <button type="button" class="btn btn-sm btn-ghost btn-square scd-act tooltip tooltip-bottom" data-scd-new data-tip="New chat" aria-label="New chat"><span class="iconify lucide--plus size-4" aria-hidden="true"></span></button>
        <button type="button" class="btn btn-sm btn-ghost btn-square scd-act tooltip tooltip-bottom" data-scd-expand data-tip="Open full chat" aria-label="Open full chat"><span class="iconify lucide--arrow-up-right size-4" aria-hidden="true"></span></button>
        <button type="button" class="btn btn-sm btn-ghost btn-square scd-park tooltip tooltip-bottom" data-ps-park aria-label="Collapse to strip" data-tip="Collapse"><span class="iconify lucide--chevrons-left size-4" aria-hidden="true"></span></button>
        <button type="button" class="btn btn-sm btn-ghost btn-square scd-x tooltip tooltip-left" data-ps-close aria-label="Close" data-tip="Close"><span class="iconify lucide--x size-4" aria-hidden="true"></span></button>
      </div>
    </div>
    <div class="scd-scope" data-scd-scope><span class="scd-chip scd-chip-whole" data-scd-whole><span class="iconify lucide--database size-3.5" aria-hidden="true"></span>Whole Space</span></div>
    <div class="scd-convo" data-scd-convo>
      {scdThreads.map((t) => (
        <div class="scd-thread" data-scd-thread={t.id} hidden={t.id !== scdCurrent.id}>
          {t.messages.map((m) => (
            m.role === 'user' ? (
              <div class="scd-msg-user">{m.text}</div>
            ) : m.convertedDoc ? (
              <div class="scd-msg-doc"><span class="iconify lucide--file-plus-2 size-3.5" aria-hidden="true"></span><span>Saved as a doc · <strong>{m.convertedDoc.title}</strong></span></div>
            ) : (
              <div class="scd-msg-ai">
                <div class="scd-msg-ai-body">
                  <div class="scd-msg-ai-text">{m.text}</div>
                  {m.refs && m.refs.length > 0 && (
                    <div class="scd-refs">
                      <span class="scd-refs-lbl">References</span>
                      {m.refs.map((r) => (
                        <span class="scd-refchip"><span class={`iconify ${scdRefIcon(r)} size-3.5`} aria-hidden="true"></span>{r.name}</span>
                      ))}
                    </div>
                  )}
                </div>
              </div>
            )
          ))}
        </div>
      ))}
      <div class="scd-newempty" data-scd-empty hidden>
        <span class="iconify lucide--sparkles size-5" aria-hidden="true"></span>
        <p class="scd-newempty-ttl">Ask anything about your {noun}</p>
        <p class="scd-newempty-sub">Start a new question below, or switch to an existing chat.</p>
      </div>
    </div>
    <div class="scd-composer">
      <div class="scd-box">
        <div class="scd-input">Ask about your {noun}…</div>
        <div class="scd-bar">
          <div class="dropdown dropdown-top scd-addctxwrap">
            <div tabindex="0" role="button" class="scd-addctx" data-scd-addctx><span class="iconify lucide--plus size-3.5" aria-hidden="true"></span>Add context</div>
            <div tabindex="0" class="dropdown-content scd-addctx-pop">
              <label class="input input-sm scd-addctx-search">
                <span class="iconify lucide--search size-3.5 opacity-50" aria-hidden="true"></span>
                <input type="text" data-scd-ctx-search placeholder="Search bases, tables, fields, views, docs…" aria-label="Search context" autocomplete="off" />
              </label>
              <div class="scd-addctx-list">
                {browseItem && (
                  <>
                    <div class="scd-addctx-sec" data-scd-ctx-sec>Browse</div>
                    <button type="button" class="scd-addctx-item" data-scd-add-browse data-search="current browse view filters table">
                      <span class="scd-addctx-ic"><span class="iconify lucide--sliders-horizontal size-3.5" aria-hidden="true"></span></span>
                      <span class="scd-addctx-item-name">Current Browse view</span>
                      <span class="scd-addctx-item-path">table + filters</span>
                    </button>
                  </>
                )}
                {scdCtxGroups.map((g) => g.items.length > 0 && (
                  <>
                    <div class="scd-addctx-sec" data-scd-ctx-sec>{g.label}</div>
                    {g.items.map((e) => (
                      <button type="button" class="scd-addctx-item" data-scd-add-ent={e.id} data-ent-name={e.name} data-search={scdCtxSearch(e)}>
                        <span class="scd-addctx-ic" set:html={scdCtxIcon(e)}></span>
                        <span class="scd-addctx-item-name">{e.name}</span>
                        {(e.tableName ?? e.baseName) && <span class="scd-addctx-item-path">{e.tableName ?? e.baseName}</span>}
                      </button>
                    ))}
                  </>
                ))}
                {docs.length > 0 && <div class="scd-addctx-sec" data-scd-ctx-sec>Docs</div>}
                {docs.map((d) => (
                  <button type="button" class="scd-addctx-item" data-scd-add-doc={d.id} data-doc-title={d.title} data-search={d.title.toLowerCase()}>
                    <span class="scd-addctx-ic"><span class="iconify lucide--file-text size-3.5" aria-hidden="true"></span></span>
                    <span class="scd-addctx-item-name">{d.title}</span>
                  </button>
                ))}
                <div class="scd-addctx-empty" data-scd-ctx-empty hidden>No match.</div>
              </div>
            </div>
          </div>
          <span class="scd-credits"><span class="iconify lucide--zap size-3.5" aria-hidden="true"></span>~2 credits</span>
          <span class="scd-send"><span class="iconify lucide--arrow-up size-4" aria-hidden="true"></span></span>
        </div>
      </div>
      <p class="scd-disclaimer">AI can make mistakes. Verify important details against your {noun}.</p>
    </div>
  </aside>
</template>

<script>
  import { registerPanelKind, host, type HostPanel } from '../ui/panelHostRegistry';

  /** Ids are ALWAYS kind-prefixed; one stack holds chat, record, asset, run and entity sheets. */
  const PREFIX = 'chat:';
  /** ONE instance — there is one assistant, not one per thread. `panelKey` is this constant. */
  const CHAT_ID = 'chat:quick';

  /** A `.scd-sheet`. The context chips are PER PANEL, not in a module closure — see the file header. */
  type ChatP = HostPanel & { ctx: Map<string, { name: string; icon: string }> };

  // ── The launcher delegate: once per MODULE, never per page ─────────────────────────────────
  // `[data-sch-ask]` lives in the page header, outside every panel, so it cannot hang off `p.el`.
  // Binding it inside the per-page wiring is what left a corpse behind: the document survives an
  // `astro:after-swap`, so the previous page's copy stayed bound. It reaches the stack through the
  // lazy `host` proxy, which resolves whichever host is mounted at CLICK time, and is a no-op on a
  // page with no host at all.
  let launcherBound = false;
  function bindLauncher() {
    if (launcherBound) return;
    launcherBound = true;
    document.addEventListener('click', (ev) => {
      if (!(ev.target as HTMLElement).closest('[data-sch-ask]')) return;
      // Always BESIDE, never `open()`: `open()` reuses the anchor, and the anchor is the record or
      // file the user is reading — the chat is a companion to it, never a replacement for it. Beside
      // is also the path that un-parks, focuses and FLASHES an already-open panel, which is how the
      // second press of the launcher reads as "it is already here" instead of doing nothing.
      host.openBeside(host.focused(), CHAT_ID);
    });
  }

  function wireQuickAsk() {
    bindLauncher();
    // The sheet TEMPLATE is this kind's mount signal — there is no `.scd` root any more.
    const tpl = document.querySelector<HTMLTemplateElement>('[data-scd-tpl]');
    if (!tpl || tpl.dataset.scdWired) return;
    tpl.dataset.scdWired = '1';

    /**
     * Every in-sheet read, delegated FROM THE PANEL ELEMENT. Two listeners per panel, both on
     * `p.el`, so closing the panel unbinds them by construction — there is nothing left to forget.
     */
    function wirePanel(p: ChatP) {
      const q = <T extends HTMLElement>(sel: string) => p.el.querySelector<T>(sel);

      const showThread = (id: string | null) => {
        p.el.querySelectorAll<HTMLElement>('[data-scd-thread]').forEach((el) => { el.hidden = el.dataset.scdThread !== id; });
        const empty = q<HTMLElement>('[data-scd-empty]'); if (empty) empty.hidden = id !== null;
        const convo = q<HTMLElement>('[data-scd-convo]'); if (convo) convo.scrollTop = 0;
      };
      const renderCtx = () => {
        const scope = q<HTMLElement>('[data-scd-scope]');
        scope?.querySelectorAll('[data-scd-ctxchip]').forEach((c) => c.remove());
        scope?.toggleAttribute('data-has-ctx', p.ctx.size > 0);
        p.ctx.forEach((v, key) => {
          const chip = document.createElement('span');
          chip.className = 'scd-ctxchip';
          chip.dataset.scdCtxchip = key;
          chip.innerHTML = `${v.icon}<span class="scd-ctxchip-name">${v.name}</span><button type="button" class="scd-ctxchip-x" data-scd-ctx-remove aria-label="Remove ${v.name}"><span class="iconify lucide--x size-3" aria-hidden="true"></span></button>`;
          scope?.appendChild(chip);
        });
      };

      p.el.addEventListener('click', (ev) => {
        // A parked strip is the HOST's click (it expands it); nothing in here should read it.
        if (p.collapsed) return;
        const t = ev.target as HTMLElement;

        // Expand ⤢ — the only route to the full Chat tab. The panel closes first: the tab IS the
        // chat, so leaving a chat panel open over it would show the same conversation twice.
        if (t.closest('[data-scd-expand]')) {
          host.closePanel(p);
          document.querySelector<HTMLButtonElement>('[data-tab="chat"]')?.click();
          return;
        }
        // Thread switcher: pick a thread → swap the shown title + exchange; New chat → blank it
        // (presentational — the full Chat tab owns real history). Blur closes the daisyUI dropdown.
        const pick = t.closest<HTMLElement>('[data-scd-pick]');
        if (pick) {
          const cur = q<HTMLElement>('[data-scd-current]'); if (cur) cur.textContent = pick.dataset.scdTitle ?? '';
          showThread(pick.dataset.scdPick ?? null);
          (document.activeElement as HTMLElement | null)?.blur();
          return;
        }
        if (t.closest('[data-scd-new]')) {
          const cur = q<HTMLElement>('[data-scd-current]'); if (cur) cur.textContent = 'New chat';
          showThread(null);
          (document.activeElement as HTMLElement | null)?.blur();
          return;
        }
        // "Current Browse view" — read the LIVE Browse state (table + active filter count) the grid
        // mirrors onto its root (data-page spec: the widget attaches data scopes).
        if (t.closest('[data-scd-add-browse]')) {
          const dg = document.querySelector<HTMLElement>('[data-databrowse]');
          const table = dg?.dataset.dgCtxTable || 'Browse';
          const n = Number(dg?.dataset.dgCtxFilters || 0);
          const name = n > 0 ? `Browse: ${table} · ${n} filter${n === 1 ? '' : 's'}` : `Browse: ${table}`;
          p.ctx.set('view:browse', { name, icon: '<span class="iconify lucide--sliders-horizontal" aria-hidden="true"></span>' });
          renderCtx();
          (document.activeElement as HTMLElement | null)?.blur();
          return;
        }
        const item = t.closest<HTMLElement>('[data-scd-add-ent],[data-scd-add-doc]');
        if (item) {
          const isDoc = item.hasAttribute('data-scd-add-doc');
          const id = (isDoc ? item.dataset.scdAddDoc : item.dataset.scdAddEnt) || '';
          const key = (isDoc ? 'doc:' : 'ent:') + id;
          const name = (isDoc ? item.dataset.docTitle : item.dataset.entName) || id;
          const icon = item.querySelector<HTMLElement>('.scd-addctx-ic')?.innerHTML || '';
          if (!p.ctx.has(key)) p.ctx.set(key, { name, icon });
          renderCtx();
          (document.activeElement as HTMLElement | null)?.blur();
          return;
        }
        const rm = t.closest<HTMLElement>('[data-scd-ctx-remove]');
        if (rm) {
          const chip = rm.closest<HTMLElement>('[data-scd-ctxchip]');
          if (chip?.dataset.scdCtxchip) { p.ctx.delete(chip.dataset.scdCtxchip); renderCtx(); }
        }
      });

      // Picker search filters items + hides empty section headers. `input` bubbles, so this is the
      // same one-listener-on-the-panel deal as the clicks.
      p.el.addEventListener('input', (ev) => {
        const search = (ev.target as HTMLElement).closest<HTMLInputElement>('[data-scd-ctx-search]');
        if (!search) return;
        const query = search.value.trim().toLowerCase();
        let shown = 0;
        p.el.querySelectorAll<HTMLElement>('.scd-addctx-item').forEach((it) => {
          const ok = !query || (it.dataset.search || '').includes(query);
          it.hidden = !ok;
          if (ok) shown++;
        });
        p.el.querySelectorAll<HTMLElement>('[data-scd-ctx-sec]').forEach((sec) => {
          let any = false;
          let n = sec.nextElementSibling as HTMLElement | null;
          while (n && !n.hasAttribute('data-scd-ctx-sec') && !n.hasAttribute('data-scd-ctx-empty')) {
            if (n.classList.contains('scd-addctx-item') && !n.hidden) { any = true; break; }
            n = n.nextElementSibling as HTMLElement | null;
          }
          sec.hidden = !any;
        });
        const empty = q<HTMLElement>('[data-scd-ctx-empty]'); if (empty) empty.hidden = shown > 0;
      });
    }

    function buildPanel(): ChatP {
      const el = tpl!.content.firstElementChild!.cloneNode(true) as HTMLElement;
      const p: ChatP = {
        el, kind: PREFIX, ctx: new Map(),
        uid: 0, anchor: false, w: 0, seq: 0, collapsed: false,
      };
      wirePanel(p);
      return p;
    }

    // ── This component's KIND, registered with the ONE host ───────────────────────────────────
    registerPanelKind<ChatP>({
      prefix: PREFIX,
      // The shared 360 floor (pattern-side-panel-width) — a conversation column, same as a record.
      minw: 360,
      buildPanel,
      // No content id to load: `chat:quick` is the whole identity of this kind.
      loadInto: () => {},
      // Deliberately a NO-OP. The sheet arrives complete from the template clone, and `render` is
      // also what the stack calls when you re-open something already open — rebuilding the body
      // there would throw away the thread you had switched to and the context chips you had added.
      render: () => {},
      panelKey: () => CHAT_ID,
      // False wherever the dock is not rendered, so a saved arrangement can never try to rebuild a
      // panel whose template does not exist on this page. Read from the LIVE document rather than
      // the captured `tpl`: the registry is a module singleton and survives a soft navigation.
      canOpen: (id) => id === CHAT_ID && !!document.querySelector('[data-scd-tpl]'),
      onMissing: () => host.toast('The assistant is not available on this page.', null),
      // Escape belongs to an open picker before it belongs to the panel: the thread switcher and the
      // Add-context popover are daisyUI focus-dropdowns, so blurring is what shuts them.
      onEsc: (p) => {
        const a = document.activeElement as HTMLElement | null;
        if (a && p.el.contains(a) && a.closest('.dropdown')) { a.blur(); return true; }
        return false;
      },
      // Listeners live on `p.el` and die with it; what is left is this panel's own state.
      onDestroy: (p) => p.ctx.clear(),
      detachedText: 'Pinned — the assistant stays put. The next thing you open starts a fresh anchor beside it.',
    });
  }
  wireQuickAsk();
  document.addEventListener('astro:after-swap', wireQuickAsk);
</script>

<style is:global>
  /* GLOBAL, under a unique `.scd-` prefix — the whole sheet is CLONED FROM A TEMPLATE and injected
     into the host's DOM at open time, which Astro's scoped styles never reach. This block used to be
     scoped and was correct only because the dock rendered in place; moving one rule back into a
     scoped block would silently unstyle the panel with every gate green. */

  /* The sheet. Geometry constants (the 46px strip, `--panel-w`) are the stack controller's.
     NO resting box-shadow here, deliberately: sheets are siblings in one stack, so a leftward
     shadow (`-12px 0 …`) falls ON the neighbouring sheet, not on the page. `border-left` already
     separates a sheet from what is behind it. Only the stack's LEFTMOST surface casts a shadow —
