  .rl-toast-alert { border: 1px solid var(--color-base-300); background: var(--color-base-100); box-shadow: 0 10px 30px oklch(0 0 0 / .2); font-size: var(--t-14); padding: 8px 12px; }
  .rl-toast-alert .iconify { color: var(--color-success); }
  .rl-empty { display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; gap: .5rem; padding: 3rem 2rem; border: 1px dashed var(--color-base-300); border-radius: var(--r-12); }
  .rl-empty-ic { width: 3rem; height: 3rem; border-radius: var(--r-8); display: grid; place-items: center; background: var(--color-base-200); }
  .rl-empty-ic .iconify { font-size: 1.4rem; color: oklch(from var(--color-base-content) l c h / .65); }
  .rl-empty-title { font-size: var(--t-16); font-weight: 650; }
  .rl-empty-sub { font-size: var(--t-14); color: oklch(from var(--color-base-content) l c h / .65); max-width: 46ch; }

  /* detail panel (right; entity chips open the shared EntityPanel which stacks over this) */
  /* below the shared EntityPanel (z-60) so a chip click-through stacks the sidebar cleanly on top */
  /* Non-modal (drawer canon): the wrapper lets clicks through so the page stays live behind the panel. */
  .rl-detail { position: fixed; inset: 0; z-index: 50; pointer-events: none; }
  .rl-detail[hidden] { display: none; }
  .rl-detail-scrim { position: absolute; inset: 0; } /* no dimming; inherits pointer-events:none from .rl-detail */
  .rl-detail-panel { position: absolute; top: 0; right: 0; height: 100%; width: var(--drawer-w); background: var(--color-base-100); border-left: 1px solid var(--color-base-300); box-shadow: -12px 0 34px oklch(0 0 0 / .22); display: flex; flex-direction: column; pointer-events: auto; }
  /* Canonical header (mirrors EntityPanel .ep-head): a column of Row 1 (icon + name + close) and
     Row 2 (location crumbs). Identity meta moved OUT to the body's first element. */
  .rl-detail-head { display: flex; flex-direction: column; gap: 8px; padding: 12px 16px; border-bottom: 1px solid var(--color-base-300); }
  .rl-detail-headrow { display: flex; align-items: center; gap: 8px; min-height: 32px; }
  .rl-detail-ic { display: grid; place-items: center; width: 2rem; height: 2rem; border-radius: var(--r-8); background: var(--color-base-200); flex: none; }
  /* Tile glyph reads at opacity .8 (matching .ep-head-ic / .sb-drawer-titleic) so all four
     drawer tiles look identical, rather than muting via a base-content/.7 colour. */
  .rl-detail-ic .iconify, .rl-detail-ic svg { opacity: .8; }
  .rl-detail-type { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: var(--t-16); font-weight: 650; letter-spacing: -0.15px; line-height: 1.2; }
  /* Crumb-segment styling comes from the shared .sb-crumb* (styles/global.css); this keeps the row
     from overflowing the header, matching .ep-crumbs. */
  .rl-detail-crumbs { min-width: 0; overflow: hidden; }
  .rl-detail-crumbs[hidden] { display: none; }
  /* Identity meta line — FIRST body element (canonical), styled like EntityPanel .ep-body-meta:
     status dot+label · readable cardinality. */
  .rl-dbody-meta { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; font-size: var(--t-12); color: oklch(from var(--color-base-content) l c h / .65); }
  .rl-meta-sep { opacity: .4; }
  /* Validity as a coloured dot + label (Browse-panel identity), not plain text. */
  .rl-dstatus { display: inline-flex; align-items: center; gap: 4px; font-weight: 550; color: oklch(from var(--color-base-content) l c h / .85); }
  .rl-dot { width: 8px; height: 8px; border-radius: 999px; flex: none; }
  .rl-dot-green { background: var(--color-success); }
  .rl-dot-red { background: var(--color-error); }
  .rl-dot-primary { background: var(--color-primary); }
  .rl-detail-body { padding: 1rem; overflow-y: auto; display: flex; flex-direction: column; gap: 1rem; }

