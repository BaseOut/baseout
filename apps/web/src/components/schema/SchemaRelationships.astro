  .rl-refs { display: inline-flex; align-items: center; gap: .25rem; flex-wrap: wrap; min-width: 0; }
  .rl-more { display: inline-flex; }
  .rl-more-trig { font-weight: 500; }
  .rl-moremenu { z-index: 40; width: 14rem; max-width: 78vw; max-height: 60vh; overflow-y: auto; padding: 4px; background: var(--color-base-100); border-radius: var(--r-12); box-shadow: 0 8px 24px oklch(0 0 0 / .18); border: 1px solid var(--color-base-300); }
  .rl-moremenu li > button { display: flex; align-items: center; gap: 8px; font-size: var(--t-13); }
  .rl-refmenu-ic { flex: none; display: inline-grid; place-items: center; width: 14px; opacity: .7; }
  .rl-refmenu-ic svg { width: 13px; height: 13px; }
  .rl-refmenu-t { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  /* Cardinality mono token — sized to the same 1.5rem/24px height as the default badge so it
