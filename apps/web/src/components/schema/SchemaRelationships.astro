  .rl-card { display: inline-flex; align-items: center; height: 1.5rem; font-family: var(--font-mono, ui-monospace, monospace); font-size: var(--t-14); color: oklch(from var(--color-base-content) l c h / .65); background: var(--color-base-200); border-radius: var(--r-6); padding: 0 .5rem; }
  .rl-actions { display: inline-flex; align-items: center; gap: .25rem; flex: none; justify-content: flex-end; }

  /* flat table — mirrors Browse's flat (table text-sm · roomy padding-block · hover Open→) */
  /* Chrome is the shared `.tbl-frame` on the element itself. */
  .rl-ftable { margin: 0; }
  .rl-ftable thead th { font-weight: 700; white-space: nowrap; }
  .rl-ftable th.rl-ft-r, .rl-ftable td.rl-ft-r { text-align: right; }
  .rl-ftable tbody td { padding-block: 1rem; vertical-align: middle; white-space: nowrap; }
  .rl-td-muted { color: oklch(from var(--color-base-content) l c h / .65); }
  /* .rl-frow hover/cursor now from shared .row-clickable */
  .rl-frow[hidden] { display: none; }
  .rl-ftype { display: inline-flex; align-items: center; gap: .5rem; color: oklch(from var(--color-base-content) l c h / .65); }
  .rl-ftype .iconify { opacity: .6; }
  /* trailing action column — Open→ for declared (hover), Confirm/Dismiss for inferred (hover), right-aligned */
  .rl-ft-act { text-align: right; }
  .rl-frow .rl-actions { justify-content: flex-end; }

  /* Tree / Flat view toggle styling now lives in the shared .sch-tb-modes (global.css). */

