     sixth child to be forgotten. */
  .rl-help-tt .tooltip-content { width: 290px; max-width: 290px; text-align: left; white-space: normal; padding: 12px 12px; border: 1px solid var(--color-base-300); border-radius: var(--r-12); box-shadow: 0 12px 32px oklch(0 0 0 / .24); color: var(--color-base-content); z-index: 80; text-transform: none; letter-spacing: normal; font-weight: 400; font-size: var(--t-13); }
  .rl-help-lead { font-size: var(--t-13); line-height: 1.45; color: oklch(from var(--color-base-content) l c h / .85); margin: 0; }
  .rl-help-legend { list-style: none; margin: .5rem 0; padding: 0; display: flex; flex-direction: column; gap: .5rem; }
  .rl-help-legend li { display: flex; align-items: flex-start; gap: .5rem; font-size: var(--t-12); line-height: 1.4; color: oklch(from var(--color-base-content) l c h / .85); }
  .rl-help-legend li .rl-status { flex: none; margin-top: .25rem; }
  .rl-help-legend b { font-weight: 600; color: var(--color-base-content); }
  .rl-help-note { font-size: var(--t-12); line-height: 1.45; color: oklch(from var(--color-base-content) l c h / .65); margin: .5rem 0 0; padding-top: .5rem; border-top: 1px solid var(--color-base-300); }
  .rl-help-note b { color: var(--color-base-content); font-weight: 600; }

  /* nomatch + empty */
  .rl-nomatch { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: .5rem; padding: 2.25rem 1.5rem; text-align: center; font-size: var(--t-14); color: oklch(from var(--color-base-content) l c h / .65); }
  .rl-nomatch[hidden] { display: none; }
  .rl-nomatch p { margin: 0; }

