  .rl-dismiss { color: oklch(from var(--color-base-content) l c h / .65); }

  /* row "open detail" affordance — a quiet chevron that appears on hover */

  /* glossary tooltip ("How this works") — a rich hover card, same pattern as Health methodology */
  .rl-help-trigger { cursor: help; display: inline-grid; place-items: center; margin-left: 4px; vertical-align: middle; opacity: .5; }
