  .rl-c-rel { overflow: visible; }
  /* .rl-row hover/cursor now from shared .row-clickable */
  .rl-row:focus-visible { outline: 2px solid var(--color-primary); outline-offset: -2px; }
  .rl-row[hidden] { display: none; }
  .rl-row[data-removed-row="1"], .rl-frow[data-removed-row="1"] { opacity: .55; }
  /* Type chip — a solid, legible category chip (NOT the faint badge-soft, which read as disabled). */
  .rl-type-badge { gap: .25rem; font-weight: 500; background: var(--color-base-200); color: oklch(from var(--color-base-content) l c h / .85); border: 1px solid var(--color-base-300); white-space: nowrap; }
  .rl-type-badge .iconify { opacity: .7; }
  .rl-c-status { white-space: normal; }
  .rl-badge { gap: .25rem; white-space: nowrap; }
  /* Status cell: badges sit inline when they fit, wrap with a real gap (never overlap) when they don't. */
  .rl-status-cell { display: inline-flex; flex-wrap: wrap; gap: 4px; align-items: center; }
  .rl-c-act { text-align: right; }

  /* ── NARROW (see `data-narrow-pan` in global.css) ───────────────────────────────────────────
     Same `table-layout: fixed` defect as Automations, and here it took out the column the tab is
     ABOUT: 10.5 + 7 + 14 + 6rem of declared width is 600px, so at 459 the relationship pair — the
     one cell that names what relates to what — resolved to 0 and painted over its neighbours.
     Floors are content-measured: the widest pair is 309px (`Pipeline Value → Amount`), so 12rem is
     a floor rather than a target and long pairs simply make the row wider. */
  @media (max-width: 1279.98px) {
    /* `fixed` kept and given a definite width, for the reason spelled out in SchemaAutomations:
       one <table> per base, and `auto` lets each one pick its own columns, so the same column sits
       at a different x in every group. 13 + 7 + 4.5 + 8 + 3 = 35.5rem. */
    .rl-tbl { width: 35.5rem; min-width: 100%; }
    .rl-tbl thead th, .rl-tbl td { padding: 8px 12px; }
    .rl-th-rel    { width: 13rem; }
    .rl-th-type   { width: 7rem; }
    .rl-th-card   { width: 4.5rem; }
    .rl-th-status { width: 8rem; }
    .rl-th-act    { width: 3rem; }
    /* The pair KEEPS its wrap, and that is a reversal of what this block first said. `nowrap` read
       well and cost 574px for one column, taking the tree to 1020 against 459 — and unlike the
       changelog sentence beside it, a pair cannot be truncated, because the half that would be cut
       is the half that says what it relates TO. Wrapping is the only lossless narrow form it has:
       two or three short lines instead of one long row. Tree 620 instead of 1020. */
    /* `.rl-c-rel` carries `overflow: visible` at desktop so a B-side chip can breathe past the cell
       edge into space the wide layout has going spare. At 459 there is no spare space, and the chip
       simply painted over the TYPE column beside it — the last row of Oleh's screenshot, where
       `Amount · Deals` sits on top of `Formulas`. Wrapping is the fix rather than clipping: the
       B-side is a LIST, so a row with two of them wants two lines, not one and a half of one. */
    .rl-c-rel { overflow: hidden; }
    .rl-c-rel .rl-pair { flex-wrap: wrap; row-gap: 4px; }
  }
  .rl-dash { color: oklch(from var(--color-base-content) l c h / .35); }

  /* status dot (flat view + the "How this works" legend) */
  .rl-status { width: .6rem; height: .6rem; border-radius: 999px; flex: none; display: inline-block; }
  .rl-status-valid { background: var(--color-success); }
  .rl-status-invalid { background: oklch(from var(--color-base-content) l c h / .35); }
  .rl-status-inferred { background: transparent; border: 1.5px dashed color-mix(in oklch, var(--color-primary) 60%, var(--color-base-content)); }
  .rl-frow[data-removed-row="1"] .rl-status { background: oklch(from var(--color-base-content) l c h / .35); }
  .rl-pair { display: inline-flex; align-items: center; gap: .5rem; min-width: 0; }
  .rl-ent { display: inline-flex; align-items: center; gap: .25rem; min-width: 0; }
  .rl-ent-ic { display: inline-grid; place-items: center; width: 14px; flex: none; color: oklch(from var(--color-base-content) l c h / .65); }
  .rl-ent-ic svg { width: 13px; height: 13px; }
  .rl-ent-ic .iconify { font-size: .82rem; }
  .rl-ent-name { font-weight: 560; font-size: var(--t-14); min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .rl-ent-sub { color: oklch(from var(--color-base-content) l c h / .65); font-weight: 400; }
  .rl-arrow { color: oklch(from var(--color-base-content) l c h / .65); flex: none; font-size: var(--t-14); }

  /* B1 (Dan 2026-07-06) — multi-field reference summary: a formula/rollup row lists ALL its
