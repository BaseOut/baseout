---
/**
 * Table — the ONE table vessel (catalog: `table`, `pattern-audit-table`).
 *
 * WHY A COMPONENT AND NOT A CLASS, measured in this repo on this date. The lens with a component has
 * **1** implementation; the lens with a class has **9**. `TablePager.astro` is one file behind 13
 * mounts and its own header records why: the construction "was hand-copied into four surfaces before
 * Schema needed it on five more; it is a component now… there is no second pager left to drift
 * from." The table header had exactly the same offer — `.tbl-colhead` for the type, `wireTableSort`
 * for the behaviour, both shipped, both documented — and produced **9 constructions across 24 files
 * that declare a `<th>`**, plus a tenth (`SchemaInterfaces.astro:357`) that is not a table at all.
 * The same authors, the same week, the same catalog. A class is an invitation; a component is the
 * only door.
 *
 * SO THE VESSEL'S JOB IS NOT TO LOOK RIGHT. It is to make the wrong thing unreachable. A caller
 * cannot write a `<th>` — it passes `columns` and the vessel renders the header — which is what
 * removes, by construction rather than by review:
 *
 *   1. THE HEADER. `scope="col"` on every cell and `.tbl-colhead` on the row: measured at **0**
 *      `scope` and **0** `aria-sort` tree-wide before this file. A sortable column is a real
 *      `<button>`, so the sort is reachable by keyboard — `SchemaInterfaces` made its sortable
 *      columns `<span>`s and its sort could not be reached at all. `data-sort-col` is the column's
 *      ARRAY INDEX, computed here, so it cannot drift from the `sortValue(row, col)` switch that
 *      reads it — hand-numbering 0…8 twice in two files was the standing invitation.
 *   2. ROW ACTIVATION. `lib/wireRowKeys` (D46) is mounted by the vessel, not remembered by the
 *      caller. A row is a button; the lead cell is a link.
 *   3. THE NARROW ANSWER. `narrow` defaults to `pan` (`specs/16-responsive.md` §5, and Oleh has
 *      rejected the fold twice). A fold is reachable only by naming itself AND writing a
 *      `narrowReason` — `contract.ts` throws without one. Column count decides nothing.
 *   4. THE PAGER. `growth` has no default, so the question "can this set grow?" cannot go
 *      unanswered the way it did on six surfaces; `paged` without a pager throws, and `fixed` is
 *      checked against the row count so it cannot be used to opt out.
 *   5. ATTRIBUTE FORWARDING, from the start. `Badge.astro` had to be repaired the same day because
 *      it dropped `data-tip`, `role` and `aria-label` on migration and turned "move onto the
 *      catalog" into an accessibility regression. `...rest` is here before the first caller.
 *
 * WHAT THE VESSEL DOES **NOT** OWN, and must not grow into: the nine constructions' column widths,
 * cell content, prose clamps and per-surface narrow floors. Those are per-surface facts. The vessel
 * owns structure, header, sort, keyboard, narrow strategy and pager — the things that must be
 * identical — and a caller keeps its own `class` on the wrapper and its own classes on its columns.
 *
 * SCOPED-STYLE TRAP, for the next migrator (`infra-astro-scoped-styles-child-component`). The
 * `<th>`s are rendered HERE, so they carry this component's `data-astro-cid-…`, not the caller's;
 * the `<td>`s arrive through the slot and carry the caller's. A caller's scoped rule that targets a
 * `th` therefore stops matching the moment it migrates, silently, with every gate green. Both proof
 * migrations moved exactly those selectors into an `is:global` block behind their existing unique
 * prefix. Do the same, and check with a computed value rather than by reading the diff.
 */
import TablePager from './TablePager.astro';
import { assertTableContract, type TableColumn, type TableGrowth, type TableNarrow } from '../../lib/table/contract';

interface Props {
  /** The columns, in order. Their INDEX is the `data-sort-col` a sorter reads — never hand-written. */
  columns: TableColumn[];
  /** How many rows the caller is about to render. Checked against `growth`. */
  rowCount: number;
  /** `paged` (the set grows) or `fixed` (bounded by the data model). No default — see contract.ts. */
  growth: TableGrowth;
  /**
   * The `lib/runLog` / `createPager` prefix (`bl`, `rh`, …). When given, the vessel emits the two
   * hooks that controller queries — `data-<hook>-tablewrap` and `data-<hook>-body` — so a caller
   * cannot mount the wiring against a hook it forgot to write.
   */
  hook?: string;
  /** Narrow strategy. `pan` unless argued otherwise. */
  narrow?: TableNarrow;
  /** Required when `narrow` is not `pan`. */
  narrowReason?: string;
  /** Required when `growth` is `unpaged` — why this table correctly has no pager of its own. */
  growthReason?: string;
  /** Rows that Enter/Space must activate, e.g. `.bl-row`. Omit for a table with no clickable rows. */
  rowSelector?: string;
  /** Renders a `TablePager` under the table. Required when `growth` is `paged`. */
  pager?: { sizes: number[]; selected: number };
  /** Classes on the scrolling wrapper — where a caller's column floors live. */
  class?: string;
  /** Classes on the `<table>` itself, on top of the shared `table text-sm`. */
  tableClass?: string;
  /** Names this table in a contract error. Defaults to `hook` or `unnamed`. */
  name?: string;
  /** Anything else — `data-*` hooks, `aria-label`, `role` — is forwarded to the wrapper verbatim. */
  [key: string]: unknown;
}

const {
  columns,
  rowCount,
  growth,
  hook,
  narrow = 'pan',
  narrowReason,
  growthReason,
  rowSelector,
  pager,
  class: className = '',
  tableClass = '',
  name,
  ...rest
} = Astro.props;

const where = name ?? hook ?? 'unnamed';
assertTableContract({ columns, rowCount, growth, narrow, narrowReason, growthReason, hasPager: !!pager }, where);

// The wrapper's hooks. `data-table` is what `mountAllTableA11y` finds; the `hook`-derived pair is
// what `lib/runLog.ts` queries, emitted here so the two can never disagree.
const wrapAttrs: Record<string, string> = { 'data-table': where };
if (hook) wrapAttrs[`data-${hook}-tablewrap`] = '';
if (narrow === 'pan') wrapAttrs['data-narrow-pan'] = '';
if (narrow === 'fold') wrapAttrs['data-mobile-rows'] = '';
if (rowSelector) wrapAttrs['data-row-selector'] = rowSelector;

const bodyAttrs: Record<string, string> = {};
if (hook) bodyAttrs[`data-${hook}-body`] = '';
---

{/* `.tbl-wrap` carries NO declarations anywhere and that is deliberate: the wrapper's paint and its
    column floors are the caller's (`.bl-tablewrap`, `.rh-tablewrap`), and a shared class with rules
    on it would start absorbing per-surface metrics — which is the one way this vessel turns back
    into nine. It exists as a stable name to grep and as the anchor for anything that later must be
    true of EVERY table. `data-table` is the behavioural hook; this is the structural one. */}
<div class:list={['tbl-wrap', className]} {...wrapAttrs} {...rest}>
  <table class:list={['table text-sm', tableClass]}>
    {/* THE HEADER, rendered once, here. `.tbl-colhead` carries the 11px small-caps label type
        (global.css, `ds-ok` there and nowhere else) and re-inherits it into the `<button>` a
        sortable column now is — without that re-inheritance the UA stylesheet resets the control's
        font and the sortable columns render in sentence case beside the static ones. */}
    <thead class="tbl-colhead">
      <tr>
        {columns.map((col, i) => (
          <th
            scope="col"
            class:list={[col.align === 'end' && 'text-right', col.class]}
            aria-sort={col.sort ? 'none' : undefined}
          >
            {col.sort ? (
              <button type="button" class="tbl-sortbtn" data-sort-col={i}>{col.label}{col.label ? '' : <span class="sr-only">{col.srLabel}</span>}</button>
            ) : col.label ? (
              col.label
            ) : (
              <span class="sr-only">{col.srLabel}</span>
            )}
            {/* The header affordance, OUTSIDE the sort button on purpose: a legend card rendered
                inside the button would become part of the sort's click target and of its accessible
                name. `contract.ts` refuses a second column claiming this slot, because a named slot
                rendered twice drops one copy in silence. */}
            {col.labelSlot && <slot name="col-extra" />}
          </th>
        ))}
      </tr>
    </thead>
    <tbody {...bodyAttrs}><slot /></tbody>
  </table>
</div>
{/* The no-match / empty slot sits BETWEEN the table and the pager on every log that has one, so the
    vessel owns that order too rather than leaving two surfaces to agree on it by hand. */}
<slot name="empty" />
{pager && <TablePager name={hook ?? where} sizes={pager.sizes} selected={pager.selected} />}

<script>
  import { mountAllTableA11y } from '../../lib/table/tableA11y';
  import { wireRowKeys } from '../../lib/wireRowKeys';

  /**
   * Mounted by the VESSEL, not by the caller. `runLog.ts` already calls `wireRowKeys` for the two
   * logs, and `wireRowKeys` is idempotent per (root, selector) — so this is the belt for every
   * table that does NOT go through a controller, which is most of the nine constructions. The three
   * report-body tables are the recorded case: they painted `role="button"` rows and forgot the
   * keyboard block entirely, which is the worst affordance failure available.
   */
  function mountTables() {
    mountAllTableA11y();
    document.querySelectorAll<HTMLElement>('[data-table][data-row-selector]').forEach((el) => {
      wireRowKeys(el, { rowSelector: el.dataset.rowSelector as string });
    });
  }
  mountTables();
  document.addEventListener('astro:page-load', mountTables);
</script>

<style is:global>
  /* `is:global` with the `.tbl-` prefix the shared table rules already use: a sortable header is a
     real control and two of the nine constructions build their header as runtime innerHTML, which a
     scoped block would never reach (`feedback-astro-global-style-runtime-html`).

     The button is the ONLY new surface this vessel introduces. It is deliberately not a `.btn`:
     daisyUI's button carries its own height, padding and background, all of which would repaint the
     column band. What it needs is to stop being a UA button and start being the label it replaced —
     and then to be visibly focusable, which is the whole reason it exists. */
  .tbl-colhead th > .tbl-sortbtn {
    display: inline;
    padding: 0;
    margin: 0;
    border: 0;
    background: none;
    text-align: inherit;
    cursor: pointer;
  }
  /* THE FOCUS RING IS THE POINT. `data-sort-col` gave the header a pointer cursor and a caret, and
     nothing at all to a keyboard: sort was mouse-only on every table in the app. 2px offset so the
     ring clears the caret the `::after` draws beside the label. */
  .tbl-colhead th > .tbl-sortbtn:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
    border-radius: var(--r-4);
  }
</style>
