---
import '../styles/global.css';
import '@fortawesome/fontawesome-free/css/fontawesome.min.css';
import '@fortawesome/fontawesome-free/css/solid.min.css';
import '@fortawesome/fontawesome-free/css/brands.min.css';
import { ClientRouter } from 'astro:transitions';
import { env } from 'cloudflare:workers';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'OpenSide UI',
  description = 'Admin dashboard template built with Astro and Tailwind CSS',
} = Astro.props;

// Embedded-mode re-boot payload (shared-embed-protocol): after a full-page
// navigation inside a host iframe, the page must re-handshake with the host.
// The client no-ops instantly when embed mode isn't active (sessionStorage).
const embedBoot = {
  allowedAncestors:
    (env as unknown as { PUBLIC_EMBED_ALLOWED_ANCESTORS?: string })
      .PUBLIC_EMBED_ALLOWED_ANCESTORS ?? '',
  authenticated: !!Astro.locals.user,
};
---
<!doctype html>
<html lang="en" data-theme="baseout-light" data-font-family="urbanist" class="group/html" style="color-scheme: light dark" transition:animate="none">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/android-chrome-192.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/android-chrome-512.png" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    <ClientRouter />
    <script is:inline>
      function applyTheme() {
        var stored = null;
        try { stored = localStorage.getItem('theme'); } catch (e) { /* private mode */ }
        var prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
        var isDark = stored === 'dark' || (!stored && prefersDark);
        document.documentElement.setAttribute('data-theme', isDark ? 'baseout' : 'baseout-light');
      }
      applyTheme();
      document.addEventListener('astro:after-swap', applyTheme);
    </script>
    <script is:inline>
      // Viewer timezone for SSR timestamps (lib/server-timezone.ts reads this
      // cookie in middleware). Session-agnostic and non-sensitive: an IANA id
      // like "America/Chicago". SameSite=Lax + 1y; refreshed on every load so
      // travel/DST-zone moves catch up on the next navigation.
      try {
        var tz = Intl.DateTimeFormat().resolvedOptions().timeZone;
        if (tz) {
          document.cookie = 'bo_tz=' + encodeURIComponent(tz) +
            '; path=/; max-age=31536000; samesite=lax';
        }
      } catch (e) { /* no Intl zone — server falls back to UTC */ }
    </script>
  </head>
  <body class="font-sans text-base-content antialiased">
    <div id="nav-pending" class="nav-pending" hidden></div>
    <script is:inline>
      document.addEventListener('astro:before-preparation', function () {
        var el = document.getElementById('nav-pending');
        if (el) el.removeAttribute('hidden');
      });
      document.addEventListener('astro:after-swap', function () {
        var el = document.getElementById('nav-pending');
        if (el) el.setAttribute('hidden', '');
      });
      document.addEventListener('astro:page-load', function () {
        var el = document.getElementById('nav-pending');
        if (el) el.setAttribute('hidden', '');
      });
    </script>
    <slot />
    <script type="application/json" id="embed-reboot" set:html={JSON.stringify(embedBoot)} />
    <script>
      import { initEmbedClient } from '../lib/embed/client'
      const el = document.getElementById('embed-reboot')
      if (el?.textContent) {
        const cfg = JSON.parse(el.textContent) as { allowedAncestors: string; authenticated: boolean }
        initEmbedClient(cfg)
      }
    </script>

    {/* ── BELOW THE 390 FLOOR ──────────────────────────────────────────────────────────────────────
        MOVED HERE FROM `SidebarLayout.astro` (S36-F3 / D35). It sat in the app shell, so the three
        routes a signed-out person can reach — `/login`, `/register`, `/welcome` — were the three
        WITHOUT the gate, i.e. the routes most likely to be opened narrow first were the ones that
        declined to say so. Both shells render this Layout, so putting it here makes the floor ONE
        rule instead of two, which was the alternative and the reason it drifted in the first place.

        It is rendered ALWAYS and shown by CSS alone — no cookie, no script, no server guess — because
        a viewport narrower than the floor is the one state that must be right on the first paint,
        before anything has had a chance to load. Last in the DOM and `position: fixed`, so nothing
        can paint over it.

        Inside Airtable's extension panel this never appears: the Blocks SDK enforces a declared
        `ViewportConstraint minSize` and draws its own. This is the browser window and the Chrome
        extension, where nobody enforces a minimum for us. */}
    <div id="too-narrow" role="alert">
      <span class="iconify lucide--move-horizontal size-6 opacity-60" aria-hidden="true"></span>
      <p class="text-base font-semibold">This window is too narrow.</p>
      <p class="text-sm opacity-70">Baseout needs at least 390px across. Widen the window and it comes straight back.</p>
    </div>
  </body>
</html>

<style>
  html, body {
    margin: 0;
    width: 100%;
    min-height: 100%;
  }
  .nav-pending {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    z-index: 9999;
    pointer-events: none;
    background: var(--color-primary);
    transform-origin: 0 50%;
    animation: nav-pending-slide 1.1s ease-in-out infinite;
  }
  @keyframes nav-pending-slide {
    0% { transform: scaleX(0.12); opacity: 1; }
    55% { transform: scaleX(0.72); opacity: 1; }
    100% { transform: scaleX(1); opacity: 0.35; }
  }
</style>
