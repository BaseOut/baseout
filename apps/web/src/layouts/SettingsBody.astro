---
/**
 * Settings hub body — server:defer so the shell swaps before token/2FA/AI queries.
 */
import { and, desc, eq } from 'drizzle-orm';
import { getBool } from '@baseout/db-schema';
import SettingsView, {
  type SettingsTokensProps,
  type SettingsAiKeysProps,
} from '../views/SettingsView.astro';
import type { TokenRowView } from '../views/ApiTokensPanel.astro';
import type { SecurityPanelProps } from '../lib/auth/types';
import {
  apiTokens,
  aiProviderKeys,
  AI_PROVIDERS,
  backupConfigurations,
  connections,
  platforms,
  type AiProvider,
} from '../db/schema';
import { usersWithTwoFactor } from '../lib/two-factor/adapter-schema';
import { resolveEntitlements } from '../lib/entitlements/resolve';

const { account, db } = Astro.locals;
const orgId = account?.organization?.id;
if (!orgId || !db || !account) return Astro.redirect('/login');

const active = Astro.url.searchParams.get('tab') ?? 'account';

// Owner/admin manage; members see a read-only list (design D2).
const role = account.membership?.role ?? 'member';
const canManage = role === 'owner' || role === 'admin';

const spaces = account.spaces ?? [];
const spaceNameById = new Map(spaces.map((s) => [s.id, s.name]));

const fmt = (d: Date | null) => (d ? d.toISOString().slice(0, 10) : '—');

// ── API tokens (web-api-tokens): org-scoped, DISPLAY columns only (never token_hash) ──
const now = new Date();
const tokenRows: TokenRowView[] = (
  await db
    .select({
      id: apiTokens.id,
      name: apiTokens.name,
      tokenPrefix: apiTokens.tokenPrefix,
      scopes: apiTokens.scopes,
      spaceId: apiTokens.spaceId,
      isActive: apiTokens.isActive,
      expiresAt: apiTokens.expiresAt,
      lastUsedAt: apiTokens.lastUsedAt,
      createdAt: apiTokens.createdAt,
    })
    .from(apiTokens)
    .where(eq(apiTokens.organizationId, orgId))
    .orderBy(desc(apiTokens.createdAt))
).map((t) => {
  const expired = t.expiresAt !== null && t.expiresAt.getTime() <= now.getTime();
  const status: TokenRowView['status'] = !t.isActive ? 'revoked' : expired ? 'expired' : 'active';
  return {
    id: t.id,
    name: t.name,
    tokenPrefix: t.tokenPrefix,
    scopes: t.scopes,
    spaceLabel: t.spaceId === null ? 'All Spaces' : (spaceNameById.get(t.spaceId) ?? 'Unknown Space'),
    status,
    expires: fmt(t.expiresAt),
    lastUsed: fmt(t.lastUsedAt),
    created: fmt(t.createdAt),
  };
});

const spaceOptions = [
  { value: '', label: 'All Spaces' },
  ...spaces.map((s) => ({ value: s.id, label: s.name })),
];
const expiryOptions = [
  { value: '', label: 'No expiry' },
  { value: '30', label: '30 days' },
  { value: '90', label: '90 days' },
  { value: '365', label: '1 year' },
];
// Must stay in lockstep with ALLOWED_SCOPES in src/pages/api/tokens/index.ts.
const scopeOptions = [
  { value: 'org:read', label: 'Organization (org:read)' },
  { value: 'backups:read', label: 'Backups (backups:read)' },
  { value: 'schema:read', label: 'Schema (schema:read)' },
];

const tokens: SettingsTokensProps = {
  canManage,
  tokenRows,
  spaceOptions,
  expiryOptions,
  scopeOptions,
};

// ── AI keys (shared-ai-byok): Plus+ entitlement gate (fail-closed), DISPLAY columns only ──
let entitled = false;
const resolution = await resolveEntitlements(db, orgId);
if (resolution) {
  try {
    entitled = getBool(resolution.entitlements, 'byo_ai_key');
  } catch {
    entitled = false;
  }
}
const formDisabled = !entitled || !canManage;

const keyRows = await db
  .select({
    provider: aiProviderKeys.provider,
    label: aiProviderKeys.label,
    modelDefault: aiProviderKeys.modelDefault,
    lastFour: aiProviderKeys.lastFour,
    status: aiProviderKeys.status,
    lastValidatedAt: aiProviderKeys.lastValidatedAt,
  })
  .from(aiProviderKeys)
  .where(eq(aiProviderKeys.organizationId, orgId))
  .orderBy(aiProviderKeys.provider);

type KeyRow = (typeof keyRows)[number];
// One display row per provider — the active key wins over disabled/invalid.
const byProvider = new Map<string, KeyRow>();
for (const r of keyRows) {
  const existing = byProvider.get(r.provider);
  if (!existing || r.status === 'active') byProvider.set(r.provider, r);
}

const PROVIDER_META: Record<AiProvider, { label: string; keyPlaceholder: string; modelPlaceholder: string }> = {
  anthropic: { label: 'Anthropic', keyPlaceholder: 'sk-ant-…', modelPlaceholder: 'claude-opus-4-…' },
  openai: { label: 'OpenAI', keyPlaceholder: 'sk-…', modelPlaceholder: 'gpt-4o-…' },
  cloudflare: { label: 'Cloudflare Workers AI', keyPlaceholder: 'API token', modelPlaceholder: '@cf/meta/llama-…' },
};

const aiKeys: SettingsAiKeysProps = {
  entitled,
  canManage,
  formDisabled,
  providerCards: AI_PROVIDERS.map((id) => ({
    id,
    meta: PROVIDER_META[id],
    key: byProvider.get(id) ?? null,
  })),
};

let autoAddFutureBases = false;
if (account.space?.id) {
  const [config] = await db
    .select({ autoAddFutureBases: backupConfigurations.autoAddFutureBases })
    .from(backupConfigurations)
    .where(eq(backupConfigurations.spaceId, account.space.id))
    .limit(1);
  autoAddFutureBases = config?.autoAddFutureBases ?? false;
}

let twoFactorEnabled = false;
try {
  const [tf] = await db
    .select({ twoFactorEnabled: usersWithTwoFactor.twoFactorEnabled })
    .from(usersWithTwoFactor)
    .where(eq(usersWithTwoFactor.id, account.user.id))
    .limit(1);
  twoFactorEnabled = tf?.twoFactorEnabled ?? false;
} catch {
  twoFactorEnabled = false;
}

const [airtableConn] = await db
  .select({
    displayName: connections.displayName,
    createdAt: connections.createdAt,
    status: connections.status,
  })
  .from(connections)
  .innerJoin(platforms, eq(platforms.id, connections.platformId))
  .where(and(eq(connections.organizationId, orgId), eq(platforms.slug, 'airtable')))
  .limit(1);

const security: SecurityPanelProps = {
  twoFactorEnabled,
  enrollment: {
    qrSrc: '',
    manualSecret: '',
    accountLabel: `Baseout: ${account.user.email}`,
  },
  backupCodes: Array.from({ length: 10 }, () => ''),
  identity: {
    provider: 'airtable',
    linked: Boolean(airtableConn),
    accountEmail: airtableConn?.displayName ?? undefined,
    linkedAt: airtableConn?.createdAt?.toISOString().slice(0, 10),
  },
};

const space = account.space
  ? { id: account.space.id, name: account.space.name, autoAddFutureBases }
  : null;
---

  <SettingsView
    active={active}
    user={account.user}
    org={account.organization}
    space={space}
    security={security}
    tokens={tokens}
    aiKeys={aiKeys}
  />
