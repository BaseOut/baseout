---
import { env } from 'cloudflare:workers';
import Layout from './Layout.astro';
import Sidebar from '../components/patterns/AppShellSidebar.astro';
import Header  from '../components/patterns/AppShellHeader.astro';
import Inbox   from '../components/layout/Inbox.astro';
import ConnectionHealthBanner from '../components/patterns/ConnectionHealthBanner.astro';
import ConnectionHealthPill from '../components/patterns/ConnectionHealthPill.astro';
import { getPageContext } from '../lib/config';
import { getConnectionHealthSummary } from '../lib/integrations';
import { deriveBannerProps } from '../lib/connection-health';
import { createBackupEngine } from '../lib/backup-engine';
import { fetchInboxItems } from '../lib/inbox-feed';
import type { ConnectionBannerProps } from '../components/patterns/connection-health-banner';
import type { NavItem, UserInfo, Breadcrumb } from '../lib/types';
import { attentionCount, type InboxItem } from '../components/layout/inbox';

interface Props {
  // <head>
  title?: string;
  description?: string;

  // Sidebar
  brandName?:      string;
  version?:        string;
  currentSpace?:   string;
  spaces?:         { id: string; name: string }[];
  navItems?:       NavItem[];
  footerNavItems?: NavItem[];
  user?:           UserInfo;
  organization?:   { id: string; name: string; slug: string } | null;

  // Header
  pageTitle?:          string;
  breadcrumbs?:        Breadcrumb[];

  // Inbox — the notification center (see the `pattern-inbox` storybook entry).
  // When omitted, the layout fans the engine-brokered feed out across the
  // account's Spaces itself (web-notifications-inbox §5.1); pass an explicit
  // array to override (previews/fixtures).
  inboxItems?:         InboxItem[];

  // Page interior re-renders on Space switch when true.
  // Default false: switch updates the sidebar pill but leaves the page body alone.
  spaceScoped?:        boolean;
}

const ctx = getPageContext(Astro.locals);
const spacesState = {
  list: ctx.spaces,
  activeSpaceId: Astro.locals.account?.space?.id ?? null,
};

// App-wide connection-health banner, derived from the active org's connection
// status. Guarded + best-effort: a banner-read failure must never break the
// shell, so it degrades to no banner rather than throwing on every page.
let bannerProps: ConnectionBannerProps | null = null;
try {
  const orgId = Astro.locals.account?.organization?.id;
  if (orgId && Astro.locals.db) {
    bannerProps = deriveBannerProps(await getConnectionHealthSummary(Astro.locals.db, orgId));
  }
} catch {
  bannerProps = null;
}

// Inbox feed — engine-brokered per-Space alerts, fanned out IN PARALLEL across
// the account's Spaces and merged newest-first with Space labels
// (web-notifications-inbox §5.1). Guarded + best-effort like the banner above:
// no account (marketing/auth pages) or no engine binding ⇒ skip entirely;
// any failure or timeout degrades to [] and the panel's designed zero-states —
// the feed must never block or error a page render.
let resolvedInboxItems: InboxItem[] = Astro.props.inboxItems ?? [];
if (Astro.props.inboxItems === undefined) {
  try {
    const accountSpaces = Astro.locals.account?.organization
      ? (Astro.locals.account.spaces ?? [])
      : [];
    if (accountSpaces.length > 0 && env.BACKUP_ENGINE && env.BACKUP_ENGINE_INTERNAL_TOKEN) {
      const engine = createBackupEngine({
        binding: env.BACKUP_ENGINE,
        internalToken: env.BACKUP_ENGINE_INTERNAL_TOKEN,
      });
      resolvedInboxItems = await fetchInboxItems(
        engine,
        accountSpaces.map((s) => ({ id: s.id, name: s.name })),
      );
    }
  } catch {
    resolvedInboxItems = [];
  }
}

const {
  title,
  description,

  brandName     = ctx.productName,
  version       = ctx.productVersion,
  currentSpace  = ctx.currentSpace ?? undefined,
  spaces        = ctx.spaces,
  navItems      = ctx.navItems,
  footerNavItems = ctx.footerNavItems,
  user          = ctx.user,

  pageTitle,
  breadcrumbs,

  spaceScoped   = false,
} = Astro.props;

const currentPath = Astro.url.pathname;
const resolvedTitle = title ?? (pageTitle ? `${pageTitle} | ${brandName}` : brandName);
// First-paint truth for the sidebar's needs-decision badge; the client's
// sync() takes over from there (same element, same semantics).
const inboxAttentionCount = attentionCount(resolvedInboxItems, new Date());
---

<Layout title={resolvedTitle} description={description}>
  <div class="flex min-h-screen relative">
    <input type="checkbox" id="layout-sidebar-toggle-trigger" class="hidden" aria-label="Toggle sidebar" />
    <input type="checkbox" id="layout-sidebar-hover-trigger" class="hidden" aria-label="Collapse sidebar to rail" />
    <div id="layout-sidebar-hover" class="bg-base-300 h-screen w-1"></div>

    <div id="layout-sidebar" class="sidebar-menu flex flex-col" transition:persist="baseout-sidebar">
      <Sidebar
        brandName={brandName}
        version={version}
        currentSpace={currentSpace}
        spaces={spaces}
        navItems={navItems}
        footerNavItems={footerNavItems}
        user={user}
        organization={null}
        currentPath={currentPath}
        inboxCount={inboxAttentionCount}
      />
    </div>

    <label for="layout-sidebar-toggle-trigger" id="layout-sidebar-backdrop"></label>

    <div class="relative flex flex-1 flex-col min-w-0">
      {/* The Inbox OVERLAYS the work area from its left edge — it never pushes the
          page narrower (at 1280px that hid ~340px of the Backups table). Still
          non-modal: no scrim, no focus trap, the page behind stays interactive. */}
      <Inbox items={resolvedInboxItems} />

      <Header>
        {bannerProps?.state === 'broken' && (
          <ConnectionHealthPill slot="topbar-status" {...bannerProps} />
        )}
      </Header>

      {bannerProps && <ConnectionHealthBanner {...bannerProps} bleed />}

      <script
        type="application/json"
        id="page-header-state"
        is:inline
        set:html={JSON.stringify({ title: pageTitle ?? null, breadcrumbs: breadcrumbs ?? [] }).replace(/</g, '\\u003c')}
      />

      <script
        type="application/json"
        id="spaces-state"
        is:inline
        set:html={JSON.stringify(spacesState).replace(/</g, '\\u003c')}
      />

      <main id="layout-content" class="flex-1 p-6 md:p-8" data-space-scoped={spaceScoped ? 'true' : 'false'}>
        <slot />
      </main>
    </div>
  </div>
</Layout>

<script is:inline>
  // Auto-close sidebar on mobile navigation (View Transitions)
  document.addEventListener('astro:after-swap', function() {
    var el = document.getElementById('layout-sidebar-toggle-trigger');
    if (el && window.innerWidth < 1024) {
      el.checked = false;
    }
  });
</script>

<script>
  import { $spaces } from '../stores/spaces';

  const el = document.getElementById('spaces-state');
  if (el?.textContent) {
    $spaces.set(JSON.parse(el.textContent));
  }
</script>
