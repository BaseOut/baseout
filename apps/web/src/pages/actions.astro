---
/**
 * /actions — the Actions section (web-actions). Landing page only; the one place Baseout will
 * write to a customer's Airtable. No runtime here — the action engine is V2 (PRD §10; Backlog
 * V2.7/V2.10) and will require a write-scope Airtable token, which Baseout does not request today.
 *
 * Promotes the ui-only design (ui-only@7502f81) into the live app: the SidebarLayout shell +
 * ActionsView, fed the drafted example operations. The feedback form is a no-JS placeholder
 * (GET → submitted state); wire it to a real POST + store when persistence lands. Space-scoped
 * shell like every interior page; auth via middleware.
 */
import SidebarLayout from '../layouts/SidebarLayout.astro';
import ActionsView from '../views/ActionsView.astro';
import { getBreadcrumbs } from '../lib/config';
import { ACTION_EXAMPLES } from '../lib/actions';

const breadcrumbs = getBreadcrumbs('/actions');
const q = Astro.url.searchParams.get('state');
const state = q === 'submitted' ? 'submitted' : q === 'failed' ? 'failed' : 'idle';
---

<SidebarLayout pageTitle="Actions" breadcrumbs={breadcrumbs} spaceScoped={true}>
  <ActionsView examples={ACTION_EXAMPLES} state={state} />
</SidebarLayout>
