---
import SidebarLayout from '../layouts/SidebarLayout.astro';
import BackupsBody from '../layouts/BackupsBody.astro';
import { getBreadcrumbs } from '../lib/config';

const breadcrumbs = getBreadcrumbs('/backups');
---

<SidebarLayout pageTitle="Backups" breadcrumbs={breadcrumbs} spaceScoped={true}>
  <BackupsBody server:defer>
    <div class="flex min-h-[40vh] items-center justify-center" slot="fallback">
      <span class="loading loading-spinner loading-lg" aria-label="Loading Backups"></span>
    </div>
  </BackupsBody>
</SidebarLayout>
