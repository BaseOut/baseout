---
/**
 * /data — shell first; engine-backed body loads via server:defer.
 */
import SidebarLayout from '../layouts/SidebarLayout.astro';
import DataBody from '../layouts/DataBody.astro';
import { getBreadcrumbs } from '../lib/config';

const breadcrumbs = getBreadcrumbs('/data');
---

<SidebarLayout pageTitle="Data" breadcrumbs={breadcrumbs} spaceScoped={true}>
  <DataBody server:defer>
    <div class="flex min-h-[40vh] items-center justify-center" slot="fallback">
      <span class="loading loading-spinner loading-lg" aria-label="Loading Data"></span>
    </div>
  </DataBody>
</SidebarLayout>
