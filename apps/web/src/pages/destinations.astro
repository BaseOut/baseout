---
/**
 * Account-level Destinations registry (production, honest-pending).
 *
 * The design assumes account-level, reusable Destinations (Airbyte model). In
 * baseout's backend destinations are PER-SPACE — one row per (space, provider
 * type) with the PRIMARY selected by backup_configurations.storage_type
 * (shared-multi-destinations); the account-level model remains a follow-up
 * (web-nav-ia-restructure / shared-destinations "Engineer"). This renders the
 * current Space's destinations mapped into the registry shape, with a notice.
 *
 * PROMOTION NOTE (Phase 7.3 / web-destinations, ui-only@7c7202d7 via ecdde1d5):
 * the promoted registry is a READ table + notice (one family with SourcesView).
 * The per-Space swap-primary control and the "what you can connect" provider
 * grid the legacy view carried are NOT part of the account-level redesign and
 * are DROPPED from this surface — the StoragePicker in the per-Space Backups
 * config still owns primary selection, and account-level connect/reconnect
 * lands with shared-destinations. The working `api/connections/storage/*`
 * OAuth routes are unchanged (see DestinationsView.legacy.astro for the
 * rollback that wired swap-primary here).
 */
import SidebarLayout from '../layouts/SidebarLayout.astro';
import DestinationsView from '../views/DestinationsView.astro';
import { getBreadcrumbs } from '../lib/config';
import { EMPTY_INTEGRATIONS_STATE, getIntegrationsState } from '../lib/integrations';
import { toDestinationSummaries } from '../lib/registry-mappers';

const breadcrumbs = getBreadcrumbs('/destinations');
const { account, db } = Astro.locals;
const orgId = account?.organization?.id ?? null;
const spaceId = account?.space?.id ?? null;
const spaceName = account?.space?.name ?? 'this Space';

const state =
  orgId && spaceId && db ? await getIntegrationsState(db, orgId, spaceId) : EMPTY_INTEGRATIONS_STATE;

const destinations = toDestinationSummaries(state, spaceId ?? 'space', spaceName);

const notice =
  'Account-level Destinations (reused across Spaces) are on the roadmap. Today destinations are per-Space — connect several and pick which one is Primary (where backups write) from the Space Backups settings.';
---

<SidebarLayout pageTitle="Destinations" breadcrumbs={breadcrumbs}>
  <DestinationsView destinations={destinations} notice={notice} />
</SidebarLayout>
