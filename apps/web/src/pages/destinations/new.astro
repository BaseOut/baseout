---
/**
 * Add an account-level destination. Honest-pending: a destination is per-Space
 * today, so "add" ultimately connects a destination for the active Space via the
 * existing per-provider OAuth routes (BYOS) / managed local-fs connect.
 *
 * PROMOTION NOTE (Phase 7.3 / web-destinations, ui-only@7c7202d7 via ecdde1d5):
 * the promoted add view is the fork's type-picker + create form (one family with
 * SourceAddView). Its client handler navigates to /destinations?status=added —
 * it does NOT yet POST to the `api/connections/storage/*` authorize routes; real
 * account-level connect lands with shared-destinations. Until then the working
 * per-Space connect wiring lives in DestinationAddView.legacy.astro (the
 * rollback target) and the Space Backups config. Storage API contracts are
 * untouched.
 */
import SidebarLayout from '../../layouts/SidebarLayout.astro';
import DestinationAddView from '../../views/DestinationAddView.astro';
import { getBreadcrumbs } from '../../lib/config';

const selectedType = Astro.url.searchParams.get('type');
const breadcrumbs = getBreadcrumbs('/destinations');
---

<SidebarLayout pageTitle="Add destination" breadcrumbs={breadcrumbs}>
  <DestinationAddView selectedType={selectedType} />
</SidebarLayout>
