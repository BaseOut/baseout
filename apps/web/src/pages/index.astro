---
import SidebarLayout from '../layouts/SidebarLayout.astro';
import HomeBody from '../layouts/HomeBody.astro';
import { getBreadcrumbs } from '../lib/config';

const breadcrumbs = getBreadcrumbs('/');
---

<SidebarLayout pageTitle="Home" breadcrumbs={breadcrumbs} spaceScoped={true}>
  <HomeBody server:defer>
    <div class="flex min-h-[40vh] items-center justify-center" slot="fallback">
      <span class="loading loading-spinner loading-lg" aria-label="Loading Home"></span>
    </div>
  </HomeBody>
</SidebarLayout>
