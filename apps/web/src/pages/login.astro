---
import { env } from 'cloudflare:workers';
import AuthLayout from '../layouts/AuthLayout.astro';
import LoginView from '../views/LoginView.astro';
import { getProductName } from '../lib/config';
import { resolveLoginCallback } from '../lib/return-to';

const productName = getProductName();

// Optional cross-app return target (e.g. the admin console sends staff here to
// authenticate). Validated against an allowlist to prevent open redirects; the
// safe value is handed to the magic-link flow as its callbackURL. A deployed
// admin origin (vars.ADMIN_APP_URL) resolves to the relative
// /api/admin/handoff wrapper — see resolveLoginCallback for why.
const adminAppUrl = (env as unknown as { ADMIN_APP_URL?: string }).ADMIN_APP_URL;
const returnTo = resolveLoginCallback(Astro.url.searchParams.get('returnTo'), {
  dev: import.meta.env.DEV,
  allowedOrigins: adminAppUrl ? [adminAppUrl] : undefined,
});

// OAuth/SSO failure landing (web-auth-airtable-sso): better-auth redirects
// auth errors here as ?error=<code> (onAPIError.errorURL). Render a
// non-technical message — no partial account state exists at this point.
const authErrorCode = Astro.url.searchParams.get('error');
const authErrorMessage = authErrorCode
  ? authErrorCode === 'access_denied'
    ? 'Sign-in was cancelled. You can try again, or sign in with your email below.'
    : 'We could not complete that sign-in. Try again, or sign in with your email below.'
  : null;

// "Continue with Airtable" gating (web-auth-airtable-sso): the button renders
// only when the genericOAuth provider is actually registered server-side —
// mirrors auth-factory.ts's condition exactly (real login-app creds OR stub
// mode). Absent creds ⇒ SSO hidden, zero behavior change (login-app pending).
const e = env as unknown as {
  AIRTABLE_LOGIN_OAUTH_CLIENT_ID?: string;
  AIRTABLE_LOGIN_OAUTH_CLIENT_SECRET?: string;
  AIRTABLE_STUBS_ENABLED?: string;
};
const ssoEnabled =
  Boolean(e.AIRTABLE_LOGIN_OAUTH_CLIENT_ID && e.AIRTABLE_LOGIN_OAUTH_CLIENT_SECRET) ||
  e.AIRTABLE_STUBS_ENABLED === '1';
---

<AuthLayout title={`Sign In — ${productName}`}>
  <LoginView returnTo={returnTo ?? ''} authErrorMessage={authErrorMessage} ssoEnabled={ssoEnabled} />
</AuthLayout>
