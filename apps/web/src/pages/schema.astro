---
/**
 * /schema — Browse on the document (prefetch-warmable). Health/Changelog/Relationships via SchemaAux.
 */
import SidebarLayout from '../layouts/SidebarLayout.astro';
import SchemaBody from '../layouts/SchemaBody.astro';
import SchemaAux from '../layouts/SchemaAux.astro';
import { getBreadcrumbs } from '../lib/config';

const breadcrumbs = getBreadcrumbs('/schema');
---

<SidebarLayout pageTitle="Schema" breadcrumbs={breadcrumbs} spaceScoped={true}>
  <SchemaBody />
  <SchemaAux server:defer />
</SidebarLayout>
