---
/**
 * /settings — unified Settings hub. Data loads in SettingsBody via server:defer
 * so ClientRouter can swap the shell before token/2FA/AI queries finish.
 */
import SidebarLayout from '../layouts/SidebarLayout.astro';
import SettingsBody from '../layouts/SettingsBody.astro';
import { getBreadcrumbs } from '../lib/config';

const breadcrumbs = getBreadcrumbs('/settings');
---

<SidebarLayout pageTitle="Settings" breadcrumbs={breadcrumbs}>
  <SettingsBody server:defer>
    <div class="flex min-h-[40vh] items-center justify-center" slot="fallback">
      <span class="loading loading-spinner loading-lg" aria-label="Loading Settings"></span>
    </div>
  </SettingsBody>
</SidebarLayout>
