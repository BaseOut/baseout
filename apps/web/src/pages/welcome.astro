---
import AuthLayout from '../layouts/AuthLayout.astro';
import WelcomeView from '../views/WelcomeView.astro';
import AuthAssociationView from '../views/AuthAssociationView.astro';
import { getProductName } from '../lib/config';
import { resolveOrganizationsForEmail } from '../lib/signup/domain-association';
import { resolveRuntimeEnv } from '../lib/runtime-env';
import { env } from 'cloudflare:workers';

const productName = getProductName();
const user = Astro.locals.user;

const referralOptions = [
  { value: 'google', label: 'Google' },
  { value: 'twitter_x', label: 'Twitter / X' },
  { value: 'friend', label: 'Friend' },
  { value: 'podcast', label: 'Podcast' },
  { value: 'other', label: 'Other' },
];

// Domain-association fork (web-signup-domain-association). New signups reach
// /welcome pre-terms (the onboarding gate forces them here). When the verified
// email domain is non-public and matches an existing Organization, offer the
// join-or-create fork FIRST; `?step=own` (chosen "create my own" / "continue")
// or `?joined=<org>` (returning from a submitted join request) skips straight to
// the details form. The resolver is best-effort — any failure falls back to the
// standard own-account form so onboarding never breaks.
const step = Astro.url.searchParams.get('step');
const joined = Astro.url.searchParams.get('joined');
let matchedOrg: { id: string; name: string } | null = null;
let matchedDomain: string | null = null;
if (step !== 'own' && !joined && Astro.locals.db && user?.email) {
  try {
    const result = await resolveOrganizationsForEmail(
      Astro.locals.db,
      user.email,
      resolveRuntimeEnv({
        BASEOUT_ENV: (env as { BASEOUT_ENV?: string }).BASEOUT_ENV,
        BASEOUT_DEV: (env as { BASEOUT_DEV?: string }).BASEOUT_DEV,
      }),
    );
    if (result.organizations.length > 0) {
      matchedOrg = { id: result.organizations[0].id, name: result.organizations[0].name };
      matchedDomain = result.domain;
    }
  } catch {
    matchedOrg = null;
  }
}
const showAssociation = matchedOrg !== null && matchedDomain !== null;
---

<AuthLayout title={`Welcome — ${productName}`}>
  {showAssociation ? (
    <AuthAssociationView
      organizationId={matchedOrg!.id}
      organizationName={matchedOrg!.name}
      domain={matchedDomain!}
    />
  ) : (
    <WelcomeView email={user?.email} referralOptions={referralOptions} pendingJoinOrg={joined} />
  )}
</AuthLayout>
