---
/**
 * AuthAssociationView — the domain fork shown when a new signup's email domain
 * already has a Baseout organization.
 *
 * Promoted from ui-only@7c7202d7 (web-login-methods). Spec:
 * web-signup-domain-association (Decision 3). Three things it must get right:
 *  · It is a FORK, not a gate — two equal-weight cards, neither styled as the
 *    obvious default. There is no `btn-primary` on this screen on purpose.
 *  · The screen is IDENTICAL whichever path the user arrived by (magic link or SSO).
 *  · A pending request NEVER blocks. Asking to join shows a banner and the user
 *    continues into their own account; approval arrives later in the inbox.
 *
 * WIRED TO THE REAL backend (web-signup-domain-association):
 *  · Mounted by /welcome (the only pre-terms gate-exempt route) when
 *    resolveOrganizationsForEmail() matches a non-public domain org.
 *  · "Request to join" → POST /api/onboarding/join-request { organizationId }
 *    (the real, gate-exempt endpoint), then continues to the details form with a
 *    pending banner (?step=own&joined=<org>).
 *  · "Create my own account" / "Continue" → /welcome?step=own (the existing
 *    onboarding form, whose submit already posts /api/onboarding/complete).
 *
 * HONEST GATE: `adminName` is not exposed by any client contract today (the server
 * computes admin emails only, for notifications), so the approver is rendered as
 * the generic "an admin"; and only the highest-priority matched org is offered
 * (the endpoint returns up to 3 — multi-org offer is a shared-* follow-up).
 */
import Button from '../components/ui/Button.astro';
import { getProductName } from '../lib/config';
import type { AuthAssociationViewProps } from '../lib/auth/types';

interface Props extends AuthAssociationViewProps {
  /** The matched org's id — POSTed to /api/onboarding/join-request. */
  organizationId: string;
}

const {
  organizationId,
  organizationName,
  domain,
  adminName,
  pending = false,
  entryPath = 'magic-link',
} = Astro.props;

const productName = getProductName();
const approver = adminName ? `${adminName} (admin)` : 'an admin';
const approverSentence = approver.charAt(0).toUpperCase() + approver.slice(1);
---

<div
  class="auth-card-inner"
  data-assoc-root
  data-entry-path={entryPath}
  data-pending={pending ? 'true' : 'false'}
  data-org-id={organizationId}
  data-org-name={organizationName}
>
  <div class="auth-form-logo">
    <img
      src="/images/brand/horizontal-blue.svg"
      alt={productName}
      class="auth-form-logo-img auth-form-logo-light"
    />
    <img src="/images/brand/horizontal-cyan.svg" alt="" class="auth-form-logo-img auth-form-logo-dark" />
  </div>

  <div class="text-center mb-5">
    <h2 class="auth-card-title">We found an existing organization</h2>
    <p class="auth-card-subtitle">
      <strong>{organizationName}</strong> already uses {productName} for <strong>{domain}</strong>.
      Choose how you want to continue.
    </p>
  </div>

  <div data-assoc-banner class:list={[!pending && 'hidden']}>
    <div role="alert" class="alert alert-soft alert-info mb-4">
      <span class="iconify lucide--clock size-4" aria-hidden="true"></span>
      <span>
        Your request to join {organizationName} is with {approver}. You don't have to wait — keep
        setting up your own account, and we'll tell you in your inbox when it's approved.
      </span>
    </div>
  </div>

  <div class="flex flex-col gap-4">
    <div class="card rounded-box border border-base-300 bg-base-100 p-4" data-assoc-card="join">
      <div class="flex items-center gap-2">
        <span class="iconify lucide--users size-4 text-base-content/65" aria-hidden="true"></span>
        <h3 class="text-sm font-semibold">Join {organizationName}</h3>
        <span
          class:list={['badge badge-ghost badge-sm ml-auto', !pending && 'hidden']}
          data-assoc-pending-badge
        >
          Requested
        </span>
      </div>
      <p class="mt-2 mb-4 text-sm text-base-content/65">
        You share their Spaces, connections and backup history. {approverSentence} approves the
        request — usually the same day.
      </p>
      <Button
        variant="secondary"
        size="sm"
        class="w-full"
        data-assoc-join
        disabled={pending}
      >
        {pending ? 'Request sent' : `Request to join ${organizationName}`}
      </Button>
      <div
        data-assoc-error
        class="fieldset-label text-error flex items-center gap-1 mt-2 hidden"
        role="alert"
      >
        <span class="iconify lucide--circle-alert size-4" aria-hidden="true"></span>
        <span data-assoc-error-text></span>
      </div>
    </div>

    <div class="card rounded-box border border-base-300 bg-base-100 p-4" data-assoc-card="own">
      <div class="flex items-center gap-2">
        <span class="iconify lucide--building-2 size-4 text-base-content/65" aria-hidden="true"></span>
        <h3 class="text-sm font-semibold">Create my own account</h3>
      </div>
      <p class="mt-2 mb-4 text-sm text-base-content/65">
        A separate organization with its own Spaces, connections and billing. Nothing is shared with
        {organizationName}. You can still be invited later.
      </p>
      <Button variant="secondary" size="sm" href="/welcome?step=own" class="w-full">
        Create my own account
      </Button>
    </div>
  </div>

  <div class="auth-footer mt-auto">
    <p class:list={['auth-footer-text', !pending && 'hidden']} data-assoc-continue>
      <a href="/welcome?step=own" class="auth-footer-link">Continue setting up your own account</a>
    </p>
    <p class="auth-footer-text">
      Wrong company? <a href="/login" class="auth-footer-link">Use a different email</a>
    </p>
  </div>
</div>

<script>
  import { setButtonLoading } from '../lib/ui';

  function init() {
    const root = document.querySelector<HTMLElement>('[data-assoc-root]');
    if (!root) return;

    const joinBtn = root.querySelector<HTMLButtonElement>('[data-assoc-join]');
    const errorEl = root.querySelector<HTMLElement>('[data-assoc-error]');
    const errorText = root.querySelector<HTMLElement>('[data-assoc-error-text]');
    if (!joinBtn || !errorEl || !errorText) return;

    const orgId = root.dataset.orgId ?? '';
    const orgName = root.dataset.orgName ?? '';

    const showError = (msg: string) => {
      errorText.textContent = msg;
      errorEl.classList.remove('hidden');
    };

    // "Request to join" — the real, gate-exempt endpoint. Requesting must never
    // strand the user: on success (or an already-pending / already-member state)
    // we continue into the own-account onboarding form, which now shows the
    // pending banner (?joined=<org>). A pending request never blocks.
    joinBtn.addEventListener('click', async () => {
      if (!orgId) return;
      errorEl.classList.add('hidden');
      setButtonLoading(joinBtn, true);
      const proceed = () => {
        window.location.href = `/welcome?step=own&joined=${encodeURIComponent(orgName)}`;
      };
      try {
        const res = await fetch('/api/onboarding/join-request', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'include',
          body: JSON.stringify({ organizationId: orgId }),
        });
        if (res.ok) return proceed();

        const body = (await res.json().catch(() => ({}))) as { error?: string; until?: string | null };
        // An existing request or membership is not a failure — carry on to the
        // pending/own-account view rather than stranding the user.
        if (body.error === 'pending_exists' || body.error === 'already_member') return proceed();
        if (body.error === 'cooldown') {
          showError('You recently asked to join. Try again later, or create your own account below.');
        } else {
          showError('Could not send the request. Create your own account below, or try again.');
        }
        setButtonLoading(joinBtn, false);
      } catch {
        showError('Could not send the request. Create your own account below, or try again.');
        setButtonLoading(joinBtn, false);
      }
    });
  }

  init();
  document.addEventListener('astro:after-swap', init);
</script>
