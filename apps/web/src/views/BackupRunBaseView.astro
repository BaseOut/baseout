---
/**
 * BackupRunBaseView — one base inside one backup run, drilled down to its tables.
 *
 * This is the leaf of the audit trail: Backups → a run → THIS base. It answers
 * "for this base, in this run, exactly what did we capture?" — every table with
 * its Fields · Records · Views · Attachments, plus the base's status/timing,
 * where its output landed, and any attachments that failed.
 *
 * Distinct from /schema (a run-agnostic view of base STRUCTURE). This page is
 * tied to a single run: counts are what the engine wrote on that run, including
 * remaining-vs-total while it is still in flight.
 *
 * Tables, fields, views and record counts come straight from Airtable metadata +
 * the backup engine; nothing here is synthesized. Harness feeds a fixture.
 */
import { fmtDateTime, fmtDuration } from '../lib/time';
import Drawer from '../components/ui/Drawer.astro';
import RunBackupNowModal from '../components/backups/RunBackupNowModal.astro';
interface FailedAttachment {
  table: string;
  file: string;
  reason: string;
  /** A failure retrying cannot fix (over the size limit, source file gone). Marked, and excluded
   *  from the retry count — see the run page, which carries the identical contract. */
  permanent?: boolean;
}
interface TableRun {
  id: string;
  name: string;
  status: 'ok' | 'failed' | 'running' | 'pending';
  fields: number;
  records: number;
  recordsRemaining: number | null; // set while running
  views: number;
  attachments: number;
  attachmentsRemaining: number | null;
  failed: number; // failed attachment count in this table
}
interface BaseDetail {
  runId: string;
  runState: string; // harness round-trip for the back link
  atBaseId: string; // Airtable base id (appXXXXXXXXXXXXXX)
  name: string;
  status: 'ok' | 'failed' | 'running' | 'pending';
  startedAt: string | null;
  completedAt: string | null;
  depth: { schema: boolean; data: boolean; attachments: boolean };
  destKind: 'file' | 'database';
  destProvider: string; // e.g. "Google Drive" — named in the folder-link tooltip
  destIcon: string | null; // brand mark for the destination provider (falls back to a folder icon)
  folder: string | null; // human path shown to the user
  folderUrl: string | null; // deep link into the user's storage (provider returns the folder id on write)
  dbRef: string | null;
  error: string | null;
  tables: TableRun[];
  failedAttachments: FailedAttachment[];
}
interface Props {
  base: BaseDetail;
  /** Active Space — powers the real Run-backup-now modal (POST /api/spaces/:id/backup-runs). */
  spaceId?: string | null;
}
const { base, spaceId = null } = Astro.props;

const nf = new Intl.NumberFormat('en-US');
const running = base.status === 'running';
const failed = base.status === 'failed';
const unreached = base.status === 'pending';
const plural = (n: number, one: string, many: string) => (n === 1 ? one : many);
// Attachments a retry could actually fix — permanent failures are marked and skipped.
const retryableAttachments = base.failedAttachments.filter((f) => !f.permanent);

const totalFields = base.tables.reduce((s, t) => s + t.fields, 0);
const totalRecords = base.tables.reduce((s, t) => s + t.records, 0);
const totalViews = base.tables.reduce((s, t) => s + t.views, 0);
const totalAttachments = base.tables.reduce((s, t) => s + t.attachments, 0);

/*
 * The summary tiles as DATA, so the "nothing was captured" guard is applied by rule rather than by
 * hand. Every one of these is a CAPTURED count — including Tables, which is the number of tables
 * this run wrote, not the number the base happens to contain.
 */
const summaryStats: { label: string; value: number }[] = [
  { label: 'Tables', value: base.tables.length },
  { label: 'Fields', value: totalFields },
  { label: 'Records', value: totalRecords },
  { label: 'Views', value: totalViews },
  { label: 'Attachments', value: totalAttachments },
];
// "Nothing written" is DERIVED from what the counts say, never asserted from the status: a base
// that failed part-way through still wrote what it wrote, and a claim of "nothing" beside a
// non-zero Records tile is the asserted-claim shape this audit exists to remove.
const wroteNothing = totalRecords + totalAttachments === 0;
const hasDestination = base.destKind === 'file' ? !!base.folder : !!base.dbRef;

const durationStr = (start: string | null, end: string | null): string =>
  fmtDuration(start, end) ?? '—';
const absTime = (iso: string | null): string => fmtDateTime(iso) || '—';

// Status → catalog badge (soft tint + colored text; neutral = ghost). Same map
// shape as BackupRunDetailView / BackupsListView so the whole audit trail agrees.
const baseStatusMeta: Record<string, { label: string; badge: string }> = {
  ok: { label: 'Backed up', badge: 'badge-soft badge-success' },
  running: { label: 'Running', badge: 'badge-soft badge-primary' },
  failed: { label: 'Failed', badge: 'badge-soft badge-error' },
  pending: { label: 'Pending', badge: 'badge-ghost' },
};
const bsm = baseStatusMeta[base.status] ?? baseStatusMeta.pending;

const tableStatusMeta: Record<string, { label: string; badge: string }> = {
  ok: { label: 'Backed up', badge: 'badge-soft badge-success' },
  running: { label: 'Running', badge: 'badge-soft badge-primary' },
  failed: { label: 'Failed', badge: 'badge-soft badge-error' },
  pending: { label: 'Pending', badge: 'badge-ghost' },
};
// Problems first on the ascending (first) click — the same status convention as the run detail.
const tableStatusRank: Record<string, number> = { failed: 0, pending: 1, running: 2, ok: 3 };

const depthChips = [
  { label: 'Schema', on: base.depth.schema },
  { label: 'Data', on: base.depth.data },
  { label: 'Attachments', on: base.depth.attachments },
];

const backHref = `/backups/run?id=${base.runId}&state=${base.runState}`;
const airtableHref = `https://airtable.com/${base.atBaseId}`;
---

<div class="mx-auto max-w-[1200px]" data-base-detail>
  {/* Breadcrumbs — daisyUI primitive (catalog) + a ghost square back button */}
  <div class="flex items-center gap-2">
    <a href={backHref} class="btn btn-sm btn-square btn-ghost" aria-label="Back to backup run"><span class="iconify lucide--arrow-left size-4" aria-hidden="true"></span></a>
    <div class="breadcrumbs text-sm py-0">
      <ul>
        <li><a href="/backups">Backups</a></li>
        <li><a href={backHref}>Backup run</a></li>
        <li>{base.name}</li>
      </ul>
    </div>
  </div>

  {/* Header */}
  <header class="rb-head">
    <div class="min-w-0">
      <div class="flex items-center gap-2.5 flex-wrap">
        <h1 class="text-title">{base.name}</h1>
        <span class={`badge ${bsm.badge}`}>{running && <span class="loading loading-spinner loading-xs"></span>}{bsm.label}</span>
      </div>
      <p class="text-sm text-base-content/60 mt-1">
        Base in this run ·
        {running
          ? <> started <span class="mono-data">{absTime(base.startedAt)}</span> · <span class="text-warning font-medium">in progress</span></>
          : failed
            ? <> attempted <span class="mono-data">{absTime(base.startedAt)}</span> · stopped before completing</>
            : unreached
              ? <> not reached — the run stopped before this base started</>
              : <> backed up <span class="mono-data">{absTime(base.completedAt)}</span> · <span class="mono-data">{durationStr(base.startedAt, base.completedAt)}</span></>}
      </p>
    </div>
    {/* Read-only audit leaf. Restore this base from the backup (client Q3) is the meaningful
        action when it backed up; Open in Airtable is the convenience jump.

        Emphasis, per `decision-button-system`: Restore is SOFT here, which is what it already
        was on the run-detail page one level up — the same action rendered at two different
        weights on two pages of one trail was the drift. Soft is right for both: this is a
        read-only log, and Restore leads to the Restore flow rather than performing anything.
        Open in Airtable steps down again to ghost, so the two are no longer peers. Sizing is
        `btn-sm` — the surface has no single standing call-to-action, so the md carve-out in
        `decision-density-sm-is-default` does not apply. */}
    <div class="flex items-center gap-2 shrink-0">
      {/* THE SCOPE TRAVELS (D05 item 2). This link used to drop the base, so a person who
          drilled Backups → run → Sales CRM and pressed Restore landed on a form preselected
          to whatever happened to be first. `atBaseId` is the handle this page holds; the
          restore form accepts either it or its own base id. */}
      {!failed && (
        <a href={`/restore?run=${base.runId}&base=${base.atBaseId}`} class="btn btn-sm btn-soft btn-primary"><span class="iconify lucide--rotate-ccw size-4" aria-hidden="true"></span>Restore</a>
      )}
      <a href={airtableHref} target="_blank" rel="noreferrer" class="btn btn-sm btn-ghost"><span class="iconify lucide--external-link size-4" aria-hidden="true"></span>Open in Airtable</a>
    </div>
  </header>

  {/* THE FAILURE, ABOVE THE CONTENT IT EXPLAINS (catalog `alert`, usageDo) — the same position
      and the same voice as the run page one level up. It used to sit BELOW the table, so a failed
      base opened on a stats strip and the reader met the counts before the reason. The sentence is
      the run's one canonical string, rendered again here rather than reworded. */}
  {failed && base.error && (
    <div role="alert" class="alert alert-soft alert-error">
      <span class="iconify lucide--circle-alert size-4" aria-hidden="true"></span>
      <span class="flex-1"><b>{`${base.name} was not backed up in this run.`}</b>{' '}{base.error}</span>
      <button type="button" class="btn btn-sm btn-ghost" onclick="document.getElementById('run-backup-now-modal').showModal()"><span class="iconify lucide--play size-4" aria-hidden="true"></span>Run backup now</button>
    </div>
  )}

  {/* Failed-attachments banner — catalog Alert (soft) */}
  {base.failedAttachments.length > 0 && (
    <div role="alert" class="alert alert-soft alert-warning">
      <span class="iconify lucide--triangle-alert size-4" aria-hidden="true"></span>
      <span><b>{base.failedAttachments.length} attachment{base.failedAttachments.length === 1 ? '' : 's'}</b> in this base couldn't be backed up. Every table below was otherwise captured.</span>
      <button type="button" class="btn btn-sm btn-ghost" data-open-failed>Review</button>
    </div>
  )}

  {/* Summary — catalog Stats primitive + a bespoke meta panel */}
  <section class="rb-summary">
    {/* Every tile takes the SAME guard from ONE list (see `summaryStats`). Five hand-written tiles
        is how Tables kept printing "1" beside four em-dashes for a base that never started — the
        leaf then contradicted the run page, which prints `—` in every captured column for that
        same base. A guard applied by hand is a guard that will be forgotten on the sixth tile. */}
    <div class="stats w-full border border-base-300 bg-base-100">
      {summaryStats.map((stat) => (
        <div class="stat">
          <div class="stat-title">{stat.label}</div>
          <div class="stat-value text-2xl tabular-nums">{unreached ? '—' : nf.format(stat.value)}</div>
        </div>
      ))}
    </div>
    <div class="rb-meta">
      <div class="rb-meta-row">
        {/* "Captured" was a claim the chips could not keep — they are the depth the run was ASKED
            for. What it took is the stats strip beside them. Same relabel as the run page. */}
        <span class="rb-meta-k">Depth requested</span>
        <div class="flex flex-wrap gap-1.5">{depthChips.map((d) => (
          d.on
            ? <span class="badge badge-soft badge-primary badge-sm">{d.label}</span>
            : <span class="badge badge-ghost badge-sm">{d.label}</span>
        ))}</div>
      </div>
      <div class="rb-meta-row">
        <span class="rb-meta-k">Destination</span>
        {unreached || !hasDestination
          ? <span class="rb-meta-v text-base-content/55">{unreached ? '—' : wroteNothing ? '— nothing written' : '—'}</span>
          : base.destKind === 'file'
            ? <a href={base.folderUrl ?? '#'} target="_blank" rel="noreferrer" data-tip={`${base.folder} — open in ${base.destProvider} (new tab)`} class="rb-folder mono-data tooltip tooltip-left">{base.destIcon ? <img src={base.destIcon} alt="" width="15" height="15" class="rb-dest-ic" /> : <span class="iconify lucide--folder"></span>}<span class="rb-folder-path">{base.folder}</span><span class="iconify lucide--external-link rb-ext"></span></a>
            : <span class="rb-db mono-data"><span class="iconify lucide--database"></span><span class="rb-folder-path tooltip tooltip-left" data-tip={base.dbRef}>{base.dbRef}</span></span>}
      </div>
    </div>
  </section>

  {/* Per-table breakdown — catalog table (same elements as the run-detail table) */}
  <section class="rb-panel">
    <div class="rb-panel-head">
      <h2>Tables in this base</h2>
      <span class="rb-hint">Counts recorded as the engine wrote each table</span>
    </div>
    {/* `data-mobile-rows` — the LAST table on the backups trail with no narrow form at all. Not one
        missing attribute like the run page above it: this one had no `data-nrow`, no `data-m` on any
        of its six cells, and nothing declared here, so at 540 it was six desktop columns inside 459px
        scrolling 161px sideways. Classified the same way its parent page classifies its own rows, so
        a table reads identically whichever depth you opened it from: name leads, the status badge is
        the second line, Records is the one number (the run page's rule — it is what "how much was
        written" means), and Fields / Views / Attachments go off. Nothing becomes unreachable: the
        per-row `N failed` badge is a shortcut into the drawer that the page-level Review button in
        the alert above opens too. */}
    <div class="rb-tablewrap" data-mobile-rows>
      {/* THE ONE TABLE (catalog `table`): `.tbl-colhead` type + `wireTableSort` behaviour. */}
      <table class="table text-sm">
        <thead class="tbl-colhead">
          <tr>
            <th data-sort-col="0">Table</th><th data-sort-col="1">Status</th>
            <th class="text-right" data-sort-col="2">Fields</th><th class="text-right" data-sort-col="3">Records</th>
            <th class="text-right" data-sort-col="4">Views</th><th class="text-right" data-sort-col="5">Attachments</th>
          </tr>
        </thead>
        <tbody data-rb-body>
          {base.tables.map((t) => {
            const tsm = tableStatusMeta[t.status] ?? tableStatusMeta.pending;
            const isRunning = t.status === 'running';
            /* Only a table that never STARTED has no counts. A failed table wrote what it wrote
               before it stopped, so its cells print that number. */
            const notStarted = t.status === 'pending';
            return (
              <tr
                class="rb-row"
                data-nrow
                data-name={t.name.toLowerCase()}
                data-rank={tableStatusRank[t.status] ?? 9}
                data-fields={t.fields}
                data-records={notStarted ? -1 : t.records}
                data-views={t.views}
                data-attachments={notStarted ? -1 : t.attachments}
              >
                <td data-m="lead" class="font-medium"><span class="rb-tname"><span class="iconify lucide--table-2"></span>{t.name}</span></td>
                <td data-m="sub"><span class={`badge ${tsm.badge}`}>{isRunning && <span class="loading loading-spinner loading-xs"></span>}{tsm.label}</span></td>
                <td data-m="off" class="text-right tabular-nums">{notStarted ? '—' : nf.format(t.fields)}</td>
                <td data-m="num" class="text-right tabular-nums">{isRunning && t.recordsRemaining != null
                  ? <span>{nf.format(t.records)} <span class="text-base-content/55">/ {nf.format(t.records + t.recordsRemaining)}</span></span>
                  : notStarted ? '—' : nf.format(t.records)}</td>
                <td data-m="off" class="text-right tabular-nums">{notStarted ? '—' : nf.format(t.views)}</td>
                <td data-m="off" class="text-right tabular-nums">{isRunning && t.attachmentsRemaining != null
                  ? <span>{nf.format(t.attachments)} <span class="text-base-content/55">/ {nf.format(t.attachments + t.attachmentsRemaining)}</span></span>
                  : notStarted ? '—' : nf.format(t.attachments)}
                  {t.failed > 0 && <button type="button" class="badge badge-soft badge-error badge-sm ml-1.5 cursor-pointer" data-open-failed>{t.failed} failed</button>}
                </td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
  </section>

  {/* IDS LIVE HERE (catalog `pattern-copy-id`) — the prose above names the base by its display
      name; the machine handles sit in the foot, and the run id carries the copy control. */}
  <p class="rb-foot">
    Base <code class="mono-data">{base.atBaseId}</code>
    {' · part of run '}
    <span class="rb-id">
      <code class="mono-data">{base.runId}</code>
      <button type="button" class="rb-copyid tooltip tooltip-right" data-copy-id={base.runId} data-tip="Copy id" aria-label="Copy run id"><span class="iconify lucide--copy size-3.5" aria-hidden="true"></span></button>
    </span>
    {' · table, field and view counts come from Airtable metadata; record & attachment counts from the backup engine.'}
  </p>

  {/* The recovery the failed-base alert offers — web's REAL credits-warning confirm (POST
      /api/spaces/:id/backup-runs), not the fork's navigation-only `confirmHref` prototype. */}
  {failed && spaceId && <RunBackupNowModal spaceId={spaceId} redirectTo="/backups" />}

  {/* Failed-attachments slide-over — catalog Drawer (opened by the Review button / row chips). */}
  <Drawer id="failed-drawer-base" title="Failed attachments" subtitle={`${base.failedAttachments.length} file${base.failedAttachments.length === 1 ? '' : 's'} in ${base.name} couldn't be backed up.`}>
    <ul class="rb-fail-list">
      {base.failedAttachments.map((f) => (
        <li class="rb-fail">
          <span class="rb-fail-ic"><span class="iconify lucide--file-x"></span></span>
          <div class="min-w-0 flex-1">
            <p class="rb-fail-name">{f.file}{f.permanent && <span class="badge badge-soft badge-neutral badge-sm ml-1.5">Won't retry</span>}</p>
            <p class="rb-fail-loc">{f.table}</p>
            <p class="rb-fail-reason">{f.reason}</p>
          </div>
        </li>
      ))}
    </ul>
    <Fragment slot="footer">
      {/* `btn-sm` per `decision-density-sm-is-default`; the label carries scope and count, and
          permanently-failed files are marked above and excluded from it. */}
      <label for="failed-drawer-base" class="btn btn-sm btn-ghost">Close</label>
      <button type="button" class="btn btn-sm btn-primary" disabled={retryableAttachments.length === 0}>
        <span class="iconify lucide--rotate-cw size-4" aria-hidden="true"></span>
        {retryableAttachments.length > 0 ? `Retry ${retryableAttachments.length} ${plural(retryableAttachments.length, 'attachment', 'attachments')}` : 'Nothing to retry'}
      </button>
    </Fragment>
  </Drawer>
</div>

<style>
  [data-base-detail] { display: flex; flex-direction: column; gap: 16px; }
  .rb-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem; flex-wrap: wrap; }

  /* Summary — catalog Stats on the left, a bespoke meta panel on the right */
  .rb-summary { display: grid; grid-template-columns: 2fr 1fr; gap: 1rem; }
  @media (max-width: 760px) { .rb-summary { grid-template-columns: 1fr; } }
  /* daisyUI stats rounds to --radius-box (6px); lift it to match the neighbouring
     bespoke panels (.rb-meta / .rb-panel use .85rem) so every card on the page agrees. */
  .rb-summary .stats { border-radius: .85rem; }
  .rb-meta { border: 1px solid var(--color-base-300); border-radius: .85rem; background: var(--color-base-100); padding: 16px 20px; display: flex; flex-direction: column; gap: .75rem; }
  .rb-meta-row { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
  .rb-meta-k { font-size: var(--t-12); font-weight: 650; text-transform: uppercase; letter-spacing: .04em; color: oklch(from var(--color-base-content) l c h / .65); }
  .rb-meta-v { font-size: var(--t-14); font-weight: 550; }

  /* Panel + table (the table itself is the daisyUI primitive — same as the run detail) */
  .rb-panel { border: 1px solid var(--color-base-300); border-radius: .85rem; background: var(--color-base-100); padding: 16px 20px 20px; }
  .rb-panel-head { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; margin-bottom: 1rem; flex-wrap: wrap; }
  .rb-panel-head h2 { font-size: var(--t-16); font-weight: 650; }
  .rb-hint { font-size: var(--t-12); color: oklch(from var(--color-base-content) l c h / .65); }
  .rb-tablewrap { overflow-x: auto; }
  .rb-tablewrap :is(th, td) { white-space: nowrap; }
  .rb-tname { display: inline-flex; align-items: center; gap: 8px; }
  .rb-tname .iconify { font-size: .95rem; color: oklch(from var(--color-base-content) l c h / .45); }

  /* Destination — a 12px muted path that truncates; the full path is recoverable through the
     catalog `tooltip`, never the native `title`. The database ref puts its `data-tip` on the
     ELLIPSIS span rather than the wrapper: the tooltip controller suppresses a tip that merely
     repeats the visible label, and only exempts it when the element carrying `data-tip` is the
     one actually overflowing. Hover lifts it to the primary colour. In this meta panel it fills
     the column width. */
  .rb-folder, .rb-db { display: inline-flex; align-items: center; gap: 4px; max-width: 100%; min-width: 0; font-size: var(--t-12); color: oklch(from var(--color-base-content) l c h / .65); }
  .rb-folder-path { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; min-width: 0; }
  .rb-folder:hover { color: var(--color-primary); }
  .rb-folder:hover .rb-folder-path { text-decoration: underline; }
  .rb-folder .iconify, .rb-db .iconify { font-size: .9rem; flex: none; }
  .rb-dest-ic { width: 15px; height: 15px; object-fit: contain; flex: none; }
  .rb-ext { font-size: var(--t-12) !important; flex: none; opacity: 0; transition: opacity .12s ease; color: oklch(from var(--color-primary) l c h / .85); }
  .rb-folder:hover .rb-ext { opacity: 1; }

  .rb-foot { font-size: var(--t-12); color: oklch(from var(--color-base-content) l c h / .65); }
  .rb-foot code { font-size: var(--t-12); padding: 0 4px; border-radius: 4px; background: oklch(from var(--color-base-content) l c h / .08); }
  /* Copyable id (catalog `pattern-copy-id`) — identical anatomy to `.rd-copyid` on the run page. */
  .rb-id { display: inline-flex; align-items: center; gap: 4px; vertical-align: middle; }
  .rb-copyid { display: inline-grid; place-items: center; width: 20px; height: 20px; flex: none; border: 0; background: none; border-radius: 5px; cursor: pointer; color: oklch(from var(--color-base-content) l c h / .55); transition: color .4s ease, background-color .4s ease; }
  .rb-copyid:hover { background: oklch(from var(--color-base-content) l c h / .08); color: var(--color-base-content); }
  .rb-copyid.is-copied { color: var(--color-success); }

  /* Slide-over */
  /* Failed-attachments list — the slotted content of the catalog Drawer. */
  .rb-fail-list { display: flex; flex-direction: column; gap: 4px; }
  .rb-fail { display: flex; gap: 12px; padding: 12px 0; border-bottom: 1px solid oklch(from var(--color-base-300) l c h / .65); }
  .rb-fail:last-child { border-bottom: 0; }
  .rb-fail-ic { width: 1.9rem; height: 1.9rem; border-radius: .45rem; display: grid; place-items: center; flex: none; background: oklch(from var(--color-error) l c h / .16); color: var(--color-error); }
  .rb-fail-name { font-size: var(--t-13); font-weight: 600; overflow-wrap: anywhere; }
  .rb-fail-loc { font-size: var(--t-12); color: oklch(from var(--color-base-content) l c h / .65); margin-top: .05rem; }
  .rb-fail-reason { font-size: var(--t-12); color: var(--color-error); margin-top: 4px; }

  /* Light-theme contrast: the drawer's small red reason text uses the raw error token,
     which fails WCAG AA as small text on white. Darken it on light only (status badges
     now use daisyUI badge-soft, which carries its own per-theme contrast). */
  :global([data-theme="baseout-light"]) .rb-fail-reason { color: oklch(from var(--color-error) calc(l - 0.06) c h); }
</style>

<script>
  import { wireTableSort } from '../components/schema/tableSort';
  import { wireCopyId } from '../components/backups/copyId';

  function wireBaseDetail() {
    const root = document.querySelector<HTMLElement>('[data-base-detail]');
    if (!root) return;
    // Run ID → clipboard (catalog `pattern-copy-id`).
    wireCopyId(root);
    // Click-to-sort on the per-table breakdown — the shared sorter and the shared caret.
    const body = root.querySelector<HTMLElement>('[data-rb-body]');
    if (body) {
      const num = (row: HTMLElement, key: string) => Number(row.dataset[key] ?? -1);
      wireTableSort(
        root,
        () => [{
          headers: Array.from(root.querySelectorAll<HTMLElement>('thead [data-sort-col]')),
          container: body,
          items: () => Array.from(body.querySelectorAll<HTMLElement>('.rb-row')),
        }],
        (row, col) => {
          if (col === 0) return row.dataset.name || '';
          if (col === 1) return num(row, 'rank');
          if (col === 2) return num(row, 'fields');
          if (col === 3) return num(row, 'records');
          if (col === 4) return num(row, 'views');
          if (col === 5) return num(row, 'attachments');
          return '';
        },
      );
    }
    // Failed-attachments slide-over = the catalog Drawer: open it by checking its toggle;
    // close (×, overlay, Close label) + Esc are handled by the component.
    const toggle = document.getElementById('failed-drawer-base') as HTMLInputElement | null;
    root.querySelectorAll('[data-open-failed]').forEach((b) =>
      b.addEventListener('click', () => { if (toggle) toggle.checked = true; }),
    );
  }
  wireBaseDetail();
  document.addEventListener('astro:after-swap', wireBaseDetail);
</script>
