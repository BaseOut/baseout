---
/**
 * DataView — the Data page (/data). Space-scoped, read-only. Schema's sibling: it browses
 * backed-up *rows* where Schema browses *structure*, so it deliberately reuses Schema's
 * shell — the same tab grammar (`.sch-tabbar` / `.sch-panel` + `wireSectionTabs`), the same
 * empty/soon states, the same freshness stamp.
 *
 * PHASE-1 SHELL (web-data-page 2.1, promoted from ui-only@8d9d1cd via /ui-sync): the page,
 * nav, tabs, freshness stamp, and empty state are live; every panel renders its designed
 * soon-state until its backend ships (server-data-browse §3 read routes; the comments read
 * route rides server-comments' read-path follow-up). Header/tabbar/empty markup and DOM
 * hooks (`data-dataview`, `data-tab`/`data-panel` names browse|changelog|comments|docs|chat)
 * are verbatim from the fork's DataView, so the full panel promotion later swaps CONTENT
 * inside the panels without touching ids, tab wiring, or deep links (`?tab=` is already
 * addressable via sectionTabs).
 */
import SoonTab from './schema/SoonTab.astro';

interface Props {
  /** True once at least one completed backup captured tables for this Space. */
  hasData: boolean;
  /** When the browsed data was last synced (latest succeeded backup run). */
  lastSyncedAt?: string | null;
}
const { hasData, lastSyncedAt = null } = Astro.props;

// Freshness stamp — the whole page reflects one synced backup, so it lives at the title
// level (once), right-aligned, exactly like Schema's "Schema as of …".
const fmtStamp = (iso: string) => {
  const d = new Date(iso);
  return Number.isNaN(d.getTime())
    ? iso
    : d.toLocaleString('en-US', { month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' });
};
---

<div class="sch" data-dataview>
  {/* Page header — title + the page-wide freshness stamp (applies to every tab). */}
  <header class="sch-head">
    <div class="min-w-0">
      <h1 class="text-title">Data</h1>
      <p class="text-sm text-base-content/60 mt-1 max-w-xl">Browse, trace, and search the records inside your backups. Read-only.</p>
    </div>
    <div class="sch-head-r">
      {hasData && lastSyncedAt && (
        <p class="sch-stamp tooltip tooltip-left" data-tip="Data is captured at backup time and may drift from Airtable until the next run.">
          <span class="iconify lucide--refresh-cw size-3.5" aria-hidden="true"></span>
          Synced as of {fmtStamp(lastSyncedAt)}
        </p>
      )}
    </div>
  </header>

  {hasData ? (
    <>
      {/* Tab bar — same daisyUI `tabs tabs-border` pattern as Schema, flat 5-tab row. */}
      <div class="sch-tabbar" role="tablist" aria-label="Data sections">
        <div class="sch-gtabs tabs tabs-border">
          <button type="button" class="tab tab-active" role="tab" data-tab="browse"><span class="iconify lucide--table-2 size-4" aria-hidden="true"></span>Browse</button>
          <button type="button" class="tab" role="tab" data-tab="changelog"><span class="iconify lucide--history size-4" aria-hidden="true"></span>Changelog</button>
          <button type="button" class="tab" role="tab" data-tab="comments"><span class="iconify lucide--message-square-text size-4" aria-hidden="true"></span>Comments</button>
          <button type="button" class="tab" role="tab" data-tab="docs"><span class="iconify lucide--book-text size-4" aria-hidden="true"></span>Docs</button>
          <button type="button" class="tab" role="tab" data-tab="chat"><span class="iconify lucide--messages-square size-4" aria-hidden="true"></span>Chat</button>
        </div>
      </div>

      {/* Panels — full width. Phase 1 renders the designed soon-states; each panel's real
          content lands with its backend (never fixture data in prod — /ui-sync Stage 3). */}
      <div class="sch-panel" data-panel="browse">
        <SoonTab
          icon="lucide--table-2"
          title="Record browsing is on its way"
          description="The grid over your backed-up rows — filters, sorts, and record detail — lands with the data read API. Your records are already captured; this is where you'll open them."
        />
      </div>

      <div class="sch-panel" data-panel="changelog" hidden>
        <SoonTab
          icon="lucide--history"
          title="Data changelog is on its way"
          description="Run-over-run record changes — created, updated, deleted, with per-field before → after — appear here once the data change feed ships."
        />
      </div>

      <div class="sch-panel" data-panel="comments" hidden>
        <SoonTab
          icon="lucide--message-square-text"
          title="Comments explorer is on its way"
          description="Record comments are already captured with your backups, including edits and deletions. Browsing them — by record, author, and thread — lands here soon."
        />
      </div>

      <div class="sch-panel" data-panel="docs" hidden>
        <SoonTab
          icon="lucide--book-text"
          title="Data docs are on its way"
          description="The same documentation surface Schema has, scoped to your records — tag records in documents and see them referenced here."
        />
      </div>

      <div class="sch-panel" data-panel="chat" hidden>
        <SoonTab
          icon="lucide--messages-square"
          title="Data chat is on its way"
          description="Ask questions about the records inside your backups. Ships with the data read API and the AI controls."
        />
      </div>
    </>
  ) : (
    <div class="sch-empty">
      <span class="sch-empty-ic"><span class="iconify lucide--database"></span></span>
      <p class="sch-empty-title">Data appears after your first backup</p>
      <p class="sch-empty-sub">Once a backup completes, the records inside it show up here to browse, trace, and search. Start one from the Backups page.</p>
      <a href="/backups" class="btn btn-primary btn-sm mt-1"><span class="iconify lucide--archive size-4" aria-hidden="true"></span>Go to Backups</a>
    </div>
  )}
</div>

<script>
  // Tab toggle — the shared controller (pattern-section-tabs): URL-addressable
  // (`/data?tab=comments`), replaceState on change, `app:tabchange` dispatch.
  import { wireSectionTabs } from '../components/ui/sectionTabs';

  function wireDataTabs() {
    const root = document.querySelector<HTMLElement>('[data-dataview]');
    if (!root) return;
    wireSectionTabs({ root });
  }
  wireDataTabs();
  document.addEventListener('astro:after-swap', wireDataTabs);
</script>
