---
/**
 * DataView — the Data page (/data). Space-scoped, read-only. Schema's sibling: it browses
 * backed-up *rows* where Schema browses *structure*, so it deliberately reuses Schema's
 * shell — the same tab grammar (`.sch-tabbar` / `.sch-panel` + `wireSectionTabs`), the same
 * empty/soon states, the same freshness stamp.
 *
 * Slice A: all six tabs are real — Records / Attachments / Comments / Changelog over
 * `lib/data-browse/map` + engine reads; Docs / Chat reuse Schema `DocsTab` / `ChatTab` with
 * `scope="data"` (web-data-docs-chat). managed_pg / static gates are honest (never fixtures).
 * No EntityPanel / QuickAskDock / fork SchemaDocs / SchemaChat.
 *
 * DOM hooks (`data-dataview`, `data-tab`/`data-panel`) keep `browse|changelog|comments|docs|chat`
 * and add `attachments` so `?tab=` deep links stay stable. `data-schema-docs` + `data-space-id`
 * satisfy ChatTab's existing spaceId contract (same attribute SchemaView uses).
 */
import DataBrowse from '../components/data/DataBrowse.astro';
import DataChangelog from '../components/data/DataChangelog.astro';
import DataComments from '../components/data/DataComments.astro';
import DataMedia from '../components/data/DataMedia.astro';
import LockedTab from '../components/data/LockedTab.astro';
import StaticImport from '../components/data/StaticImport.astro';
import RecordPanel from '../components/data/RecordPanel.astro';
import MediaPanel from '../components/data/MediaPanel.astro';
import PanelHost from '../components/ui/PanelHost.astro';
import EmptyState from '../components/ui/EmptyState.astro';
import DocsTab from './schema/DocsTab.astro';
import ChatTab from './schema/ChatTab.astro';
import type { DocsTabEntity } from '../components/islands/DocsTab';
import type { SchemaDocSummary } from '../lib/backup-engine';
import type { SchemaDocsLevel } from '../lib/capabilities/tier-capabilities';
import type {
  DataBase,
  DataTable,
  DataRecord,
  DataComment,
  DataChangeEntry,
  MediaAsset,
  DataMode,
} from '../components/data/dataTypes';

interface Props {
  /** True once at least one completed backup captured tables for this Space. */
  hasData: boolean;
  /** When the browsed data was last synced (latest succeeded backup run). */
  lastSyncedAt?: string | null;
  /** Latest succeeded run id (optional freshness / deep-link context). */
  lastSyncedRunId?: string | null;
  /** True when this Space's backend serves the Data read API (managed_pg). */
  managedPg?: boolean;
  /** Backup configuration mode — static Spaces get LockedTab / StaticImport. */
  mode?: DataMode;
  bases?: DataBase[];
  tables?: DataTable[];
  records?: DataRecord[];
  /** Page-1 captured record comments across the Space (server-comments-read). */
  comments?: DataComment[];
  changelog?: DataChangeEntry[];
  /** Per-run TRUE totals for the changelog rollup. */
  runTotals?: Record<string, { created: number; updated: number; deleted: number }>;
  /** Every captured attachment across the Space (media-library). */
  assets?: MediaAsset[];
  /** Which table Browse opens on (defaults to the first). */
  landingTableId?: string;
  /** Active Space id — Browse client cursor fetches against `/api/spaces/:spaceId/data/records`. */
  spaceId?: string | null;
  /** Primary field id per table (for mapping proxy record pages). */
  primaryByTable?: Record<string, string | undefined>;
  /** SSR page-1 `nextCursor` for the landing table (`null` = no further pages). */
  recordsNextCursor?: string | null;
  /** Async surface state for Browse (SSR page-1 is `ready`). */
  loadState?: 'ready' | 'loading' | 'error';
  /** Schema Docs entitlement (Features §7) — gates the Docs tab. */
  docsLevel?: SchemaDocsLevel;
  /** Pro+ AI chat entitlement — gates ChatTab (inherits existing Pro empty state). */
  aiEnabled?: boolean;
  /** Space-wide documents for DocsTab (listDocuments). */
  docs?: SchemaDocSummary[];
  /** Docs entity picker rows (from dataToSchema.buildDataDocsEntities). */
  docEntities?: DocsTabEntity[];
  /** Chat context bases (from dataToSchema.dataBasesToHealthBases). */
  healthBases?: { baseId: string; name: string }[];
}
const {
  hasData,
  lastSyncedAt = null,
  lastSyncedRunId = null,
  managedPg = false,
  mode = 'dynamic',
  bases = [],
  tables = [],
  records = [],
  comments = [],
  changelog = [],
  runTotals = {},
  assets = [],
  landingTableId,
  spaceId = null,
  primaryByTable = {},
  recordsNextCursor,
  loadState = 'ready',
  docsLevel = 'none',
  aiEnabled = false,
  docs = [],
  docEntities = [],
  healthBases = [],
} = Astro.props;

const isStatic = mode === 'static';
// Live record-data panels only when the Space can serve managed_pg reads and is not static-only.
const showData = hasData && managedPg && !isStatic;
const showDocs = showData && docsLevel !== 'none' && !!spaceId;

const fmtStamp = (iso: string) => {
  const d = new Date(iso);
  return Number.isNaN(d.getTime())
    ? iso
    : d.toLocaleString('en-US', { month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' });
};
---

<div
  class="sch"
  data-dataview
  data-schema-docs
  data-space-id={spaceId ?? undefined}
  data-mode={mode}
  data-managed-pg={managedPg ? '1' : '0'}
>
  <header class="sch-head">
    <div class="min-w-0">
      <h1 class="text-title">Data</h1>
      <p class="text-sm text-base-content/60 mt-1 max-w-xl">Browse, trace, and search the records inside your backups. Read-only.</p>
    </div>
    <div class="sch-head-r">
      {hasData && lastSyncedAt && (
        <p class="sch-stamp tooltip tooltip-left" data-tip="Data is captured at backup time and may drift from Airtable until the next run." data-run-id={lastSyncedRunId ?? undefined}>
          <span class="iconify lucide--refresh-cw size-3.5" aria-hidden="true"></span>
          Synced as of {fmtStamp(lastSyncedAt)}
        </p>
      )}
    </div>
  </header>

  {hasData ? (
    <>
      {/* Tab bar — ui-only clustered construction (`pattern-section-nav`). Keys stay flat for
          `wireSectionTabs` / `?tab=` deep links; grouping is presentation only. */}
      <div class="sch-tabbar" role="tablist" aria-label="Data sections">
        <div class="sch-group">
          <span class="sch-glabel">Data Elements</span>
          <div class="sch-gtabs tabs tabs-border">
            <button type="button" class="tab tab-active" role="tab" data-tab="browse"><span class="iconify lucide--table-2 size-4" aria-hidden="true"></span>Records</button>
            <button type="button" class="tab" role="tab" data-tab="attachments"><span class="iconify lucide--paperclip size-4" aria-hidden="true"></span>Attachments</button>
            <button type="button" class="tab" role="tab" data-tab="comments"><span class="iconify lucide--message-square-text size-4" aria-hidden="true"></span>Comments</button>
          </div>
        </div>
        <span class="sch-tabdiv" aria-hidden="true"></span>
        <div class="sch-group">
          <span class="sch-glabel">Between backups</span>
          <div class="sch-gtabs tabs tabs-border">
            <button type="button" class="tab" role="tab" data-tab="changelog"><span class="iconify lucide--history size-4" aria-hidden="true"></span>Changelog</button>
          </div>
        </div>
        <span class="sch-tabdiv" aria-hidden="true"></span>
        <div class="sch-group">
          <span class="sch-glabel">Knowledge</span>
          <div class="sch-gtabs tabs tabs-border">
            <button type="button" class="tab" role="tab" data-tab="docs"><span class="iconify lucide--book-text size-4" aria-hidden="true"></span>Docs</button>
            <button type="button" class="tab" role="tab" data-tab="chat"><span class="iconify lucide--messages-square size-4" aria-hidden="true"></span>Chat</button>
          </div>
        </div>
      </div>

      {/* Records (Browse) — real grid, StaticImport, or managed-Postgres gate. */}
      <div class="sch-panel" data-panel="browse">
        {isStatic ? (
          <StaticImport bases={bases} tables={tables} records={records} />
        ) : showData ? (
          <DataBrowse
            spaceId={spaceId ?? undefined}
            bases={bases}
            tables={tables}
            records={records}
            comments={comments}
            landingTableId={landingTableId}
            primaryByTable={primaryByTable}
            recordsNextCursor={recordsNextCursor}
            loadState={loadState}
          />
        ) : (
          <EmptyState
            icon="lucide--database"
            title="Record browsing is available on managed Postgres Spaces"
            description="The record browser reads your rows from a Baseout-managed Postgres store. This Space backs up to a different destination, so there's nothing to query here yet. Switch it to a managed Postgres backend to browse, trace, and search records."
            actionHref="/backups"
            actionLabel="Go to Backups"
          />
        )}
      </div>

      {/* Attachments — captured files, LockedTab, or managed-Postgres gate. */}
      <div class="sch-panel" data-panel="attachments" hidden>
        {isStatic ? (
          <LockedTab title="Attachments need a dynamic backup" what="Files attached to records and comments are downloaded from Airtable at backup time. Your Space stores static files you uploaded, so there is nothing to fetch — switch to a dynamic backup to see them." />
        ) : showData ? (
          <DataMedia bases={bases} tables={tables} assets={assets} records={records} lastSyncedAt={lastSyncedAt ?? undefined} />
        ) : (
          <EmptyState
            icon="lucide--paperclip"
            title="Attachments are available on managed Postgres Spaces"
            description="Files captured from your records and comments are indexed in a Baseout-managed Postgres store. This Space backs up elsewhere, so there's nothing to list here yet."
          />
        )}
      </div>

      {/* Changelog — run-over-run changes, LockedTab, or managed-Postgres gate. */}
      <div class="sch-panel" data-panel="changelog" hidden>
        {isStatic ? (
          <LockedTab title="Change tracking needs a dynamic backup" what="The Changelog compares every backup in a live database. Your Space stores static files, so there's nothing to diff — switch to a dynamic backup to see what changed between runs." />
        ) : showData ? (
          <DataChangelog bases={bases} tables={tables} changelog={changelog} records={records} runTotals={runTotals} now={lastSyncedAt ?? undefined} />
        ) : (
          <EmptyState
            icon="lucide--history"
            title="The data changelog is available on managed Postgres Spaces"
            description="Run-over-run record changes — created, updated, deleted — are computed in a Baseout-managed Postgres store. This Space backs up to a different destination, so there's nothing to diff here yet."
          />
        )}
      </div>

      {/* Comments — captured record comments (server-comments-read), LockedTab, or managed-Postgres gate. */}
      <div class="sch-panel" data-panel="comments" hidden>
        {isStatic ? (
          <LockedTab title="Comments need a dynamic backup" what="Record comments are read from Airtable at backup time. Your Space stores static files, so there are no comments to capture — switch to a dynamic backup to see them." />
        ) : showData ? (
          <DataComments bases={bases} tables={tables} comments={comments} records={records} lastSyncedAt={lastSyncedAt ?? undefined} />
        ) : (
          <EmptyState
            icon="lucide--message-square-text"
            title="Comments are available on managed Postgres Spaces"
            description="Record comments captured with your backups — including edits and deletions — are indexed in a Baseout-managed Postgres store. This Space backs up to a different destination, so there's nothing to browse here yet."
          />
        )}
      </div>

      {/* Docs — Schema DocsTab scoped to data (web-data-docs-chat). */}
      <div class="sch-panel" data-panel="docs" hidden>
        {isStatic ? (
          <LockedTab title="Data docs need a dynamic backup" what="Documenting your records queries a live database. Your Space stores static files, so there's nothing to tag — switch to a dynamic backup to document your data." />
        ) : docsLevel === 'none' ? (
          <EmptyState
            icon="lucide--book-text"
            title="Data Docs is a Launch-plan feature"
            description="Upgrade to Launch or above to document the records inside your backups."
            actionHref="/settings"
            actionLabel="View plans"
          />
        ) : showDocs ? (
          <DocsTab
            spaceId={spaceId!}
            docs={docs}
            aiEnabled={aiEnabled}
            entities={docEntities}
            scope="data"
          />
        ) : (
          <EmptyState
            icon="lucide--book-text"
            title="Data docs are available on managed Postgres Spaces"
            description="Documents are stored alongside your managed Postgres backup. This Space backs up elsewhere, so there's nothing to document here yet."
          />
        )}
      </div>

      {/* Chat — Schema ChatTab scoped to data; Pro+ gate inherited. */}
      <div class="sch-panel" data-panel="chat" hidden>
        {isStatic ? (
          <LockedTab title="Data chat needs a dynamic backup" what="Chatting about your records queries a live database. Your Space stores static files, so there's nothing to query — switch to a dynamic backup to ask about your data." />
        ) : showData ? (
          <ChatTab
            hasSchema={tables.length > 0}
            aiEnabled={aiEnabled}
            healthBases={healthBases}
            scope="data"
          />
        ) : (
          <EmptyState
            icon="lucide--messages-square"
            title="Data chat is available on managed Postgres Spaces"
            description="Asking about your records queries a Baseout-managed Postgres store. This Space backs up elsewhere, so there's nothing to chat about here yet."
          />
        )}
      </div>
    </>
  ) : (
    <EmptyState
      icon="lucide--database"
      title="Data appears after your first backup"
      description="Once a backup completes, the records inside it show up here to browse, trace, and search. Start one from the Backups page."
      actionHref="/backups"
      actionLabel="Go to Backups"
    />
  )}
</div>

{/* ONE panel stack for the live record-data tabs (Oleh's law). No EntityPanel / QuickAskDock. */}
{showData && <PanelHost mincontent={700} />}
{showData && <RecordPanel bases={bases} tables={tables} records={records} comments={comments} mode={mode} lastSyncedAt={lastSyncedAt ?? undefined} />}
{showData && <MediaPanel mode={mode} />}

<script>
  import { wireSectionTabs } from '../components/ui/sectionTabs';

  function wireDataTabs() {
    const root = document.querySelector<HTMLElement>('[data-dataview]');
    if (!root) return;
    wireSectionTabs({ root, searchSelector: '[data-sch-search]' });
  }
  wireDataTabs();
  document.addEventListener('astro:after-swap', wireDataTabs);
</script>
