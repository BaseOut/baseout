---
/**
 * LoginView — the passwordless sign-in surface (also serves register via `mode`).
 *
 * Markup converged from ui-only@4073f919 (web-auth-convergence). Two paths, visually
 * ranked, no method tabs: "Continue with Airtable" sits ABOVE the magic-link form when
 * SSO is configured, and the magic-link form keeps the one solid primary. Baseout is
 * passwordless — there is deliberately no password affordance anywhere on this surface.
 *
 * The Airtable mark is a brand logo, the one exemption to the Lucide-only rule.
 *
 * WIRED TO THE REAL better-auth FLOW (web-login-methods; do not take the fork fixture):
 *  · magic link → authClient.signIn.magicLink({ email, callbackURL }) (auth-client.ts)
 *  · callbackURL is the server-validated cross-app `returnTo` (return-to.ts) or /welcome
 *  · ?error landing (web-auth-airtable-sso onAPIError.errorURL='/login') → authErrorMessage
 *  · "Continue with Airtable" starts genericOAuth via POST /api/auth/sign-in/oauth2
 *    (better-auth returns { url } JSON — there is no GET start route), rendered ONLY
 *    when SSO is configured server-side (ssoEnabled) — honest gating: the login OAuth
 *    app is still pending (web-auth-airtable-sso), so absent creds ⇒ hidden.
 */
import TextInput from '../components/ui/TextInput.astro';
import Button from '../components/ui/Button.astro';
import { getProductName } from '../lib/config';
import { AIRTABLE_GLYPH } from '../components/schema/airtableGlyph';
import type { LoginViewProps } from '../lib/auth/types';

interface Props extends LoginViewProps {
  /** Server-validated cross-app return target (return-to.ts); '' when absent. */
  returnTo?: string;
  /** Non-technical SSO/OAuth failure message from ?error, or null. */
  authErrorMessage?: string | null;
  /** True when the Airtable SSO provider is configured server-side (auth-factory.ts). */
  ssoEnabled?: boolean;
}

const {
  mode = 'login',
  returnTo = '',
  authErrorMessage = null,
  ssoEnabled = false,
} = Astro.props;

const productName = getProductName();
const isRegister = mode === 'register';

const heading = isRegister ? 'Create your account' : 'Welcome back';
const subheading = isRegister
  ? 'Start protecting your data in minutes'
  : 'Sign in to your account to continue';
---

<div class="auth-card-inner" data-login-root data-mode={mode} data-return-to={returnTo}>
  <div class="auth-form-logo">
    <img
      src="/images/brand/horizontal-blue.svg"
      alt={productName}
      class="auth-form-logo-img auth-form-logo-light"
    />
    <img src="/images/brand/horizontal-cyan.svg" alt="" class="auth-form-logo-img auth-form-logo-dark" />
  </div>

  <div data-login-form>
    <div class="text-center mb-5">
      <h2 class="auth-card-title">{heading}</h2>
      <p class="auth-card-subtitle">{subheading}</p>
    </div>

    {authErrorMessage && (
      <div role="alert" class="alert alert-soft alert-info mb-4">
        <span class="iconify lucide--info size-4" aria-hidden="true"></span>
        <span>{authErrorMessage}</span>
      </div>
    )}

    {ssoEnabled && (
      <>
        <button type="button" class="btn btn-soft btn-primary btn-sm w-full gap-2" data-login-airtable>
          <span class="auth-provider-mark" aria-hidden="true" set:html={AIRTABLE_GLYPH}></span>
          <span data-login-airtable-label>Continue with Airtable</span>
        </button>
        <p class="auth-form-note text-center">
          Uses your Airtable account email — doesn't connect your data. You choose which bases
          {productName} can read later, in {isRegister ? 'setup' : 'your Space'}.
        </p>

        <div class="auth-divider mt-4">
          <span class="auth-divider-line"></span>
          <span class="auth-divider-label">or</span>
          <span class="auth-divider-line"></span>
        </div>
      </>
    )}

    <form id="login-form" class="auth-form mt-4" novalidate>
      {/*
        The refusal slot is `.auth-form-note`, NOT `fieldset-label` (Oleh, batch D2).
        `.fieldset-label` carries colour, `display:flex` and a gap — and no font-size at all. Its
        12px comes from the `.fieldset` PARENT daisyUI sets to `.75rem`, which this element does not
        have: it is a sibling of the field, not a child of its fieldset. So it inherited the card's
        16px/24px and the refusal painted a THIRD larger than the 12px note two lines below it.
        `.auth-form-note` is this family's one caption rung and adds no new size declaration.
      */}
      <div class="auth-field">
        <TextInput
          type="email"
          name="email"
          label="Work email"
          icon="mail"
          size="sm"
          placeholder="name@company.com"
          autocomplete="email"
          autofocus
          required
        />

        <p id="login-error" class="auth-form-note text-error flex items-center gap-1 hidden" role="alert">
          <span class="iconify lucide--circle-alert size-4" aria-hidden="true"></span>
          <span id="login-error-text"></span>
        </p>
      </div>

      <Button variant="primary" size="sm" type="submit" class="w-full mt-1">
        Send sign-in link
      </Button>
      <p class="auth-form-note text-center">We email you a link — no password to remember or reset.</p>
    </form>
  </div>

  <div data-login-sent class="hidden">
    <div class="text-center mb-5">
      <h2 class="auth-card-title">Check your email</h2>
      <p class="auth-card-subtitle">
        If an account exists for <span data-login-sent-email class="font-medium"></span>,
        we sent a sign-in link. The link expires in 5 minutes.
      </p>
    </div>
    <p class="auth-card-subtitle mt-4">
      Didn't receive it?
      <button type="button" data-login-again class="auth-footer-link">Try a different email</button>
    </p>
  </div>

  <div class="auth-footer mt-auto">
    <p class="auth-footer-text">
      {isRegister ? 'Already have an account?' : "Don't have an account?"}
      <a href={isRegister ? '/login' : '/register'} class="auth-footer-link">
        {isRegister ? 'Sign in' : 'Register'}
      </a>
    </p>
    <p class="auth-copyright">&copy; {new Date().getFullYear()} {productName.toUpperCase()}</p>
  </div>
</div>

<script>
  import { showFormError, hideFormError } from '../lib/auth-utils';
  import { authClient } from '../lib/auth-client';
  import { setButtonLoading } from '../lib/ui';

  function init() {
    const root = document.querySelector<HTMLElement>('[data-login-root]');
    if (!root) return;

    // Server-validated cross-app return target (empty string when absent or
    // rejected by the open-redirect guard). Used as the magic-link / SSO
    // callbackURL so staff bounced here from the admin console land back there.
    const returnTo = root.dataset.returnTo || '';

    const formPanel = root.querySelector<HTMLElement>('[data-login-form]');
    const sentPanel = root.querySelector<HTMLElement>('[data-login-sent]');
    const sentEmail = root.querySelector<HTMLElement>('[data-login-sent-email]');
    const againBtn = root.querySelector<HTMLButtonElement>('[data-login-again]');
    const loginForm = root.querySelector<HTMLFormElement>('#login-form');
    const loginError = root.querySelector<HTMLElement>('#login-error');
    const loginErrorText = root.querySelector<HTMLElement>('#login-error-text');
    const submitBtn = loginForm?.querySelector<HTMLButtonElement>('button[type="submit"]');
    const ssoBtn = root.querySelector<HTMLButtonElement>('[data-login-airtable]');

    if (!loginForm || !loginError || !loginErrorText || !submitBtn || !formPanel || !sentPanel || !sentEmail || !againBtn) {
      return;
    }

    const ssoLabel = ssoBtn?.querySelector<HTMLElement>('[data-login-airtable-label]') ?? null;
    const ssoLabelText = ssoLabel?.textContent ?? '';

    // "Continue with Airtable" — better-auth genericOAuth (providerId 'airtable').
    // The start route is a POST that returns { url } JSON (no GET redirect route),
    // so we fetch it (credentials:'include' keeps the PKCE/state cookie) and then
    // navigate to the returned Airtable consent URL. web-auth-airtable-sso.
    if (ssoBtn) {
      ssoBtn.addEventListener('click', async () => {
        if (ssoLabel) ssoLabel.textContent = 'Taking you to Airtable…';
        setButtonLoading(ssoBtn, true);
        try {
          const res = await fetch('/api/auth/sign-in/oauth2', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            credentials: 'include',
            body: JSON.stringify({ providerId: 'airtable', callbackURL: returnTo || '/welcome' }),
          });
          const data = (await res.json().catch(() => null)) as { url?: string } | null;
          if (res.ok && data?.url) {
            window.location.assign(data.url);
            return;
          }
          showFormError(loginError, loginErrorText, 'Could not start Airtable sign-in. Use your email below, or try again.');
          if (ssoLabel) ssoLabel.textContent = ssoLabelText;
          setButtonLoading(ssoBtn, false);
        } catch {
          showFormError(loginError, loginErrorText, 'Could not start Airtable sign-in. Use your email below, or try again.');
          if (ssoLabel) ssoLabel.textContent = ssoLabelText;
          setButtonLoading(ssoBtn, false);
        }
      });
    }

    // Pressing Back from Airtable's consent screen restores this page from
    // bfcache with the SSO button still disabled+spinning; the module does not
    // re-execute on a bfcache restore, so reset the controls by hand.
    window.addEventListener('pageshow', (e) => {
      if (!e.persisted) return;
      if (ssoBtn) setButtonLoading(ssoBtn, false);
      if (ssoLabel) ssoLabel.textContent = ssoLabelText;
      setButtonLoading(submitBtn, false);
    });

    /*
     * THE FORM CAN NOW SAY NO (audit S36-F2 + email-format refusal).
     *
     * `novalidate` is kept — validating in script is the legitimate half of that attribute, because
     * the refusal has to land in `#login-error` where the rest of the product's refusals land rather
     * than in a browser bubble we cannot write or style.
     *
     * The shape test is deliberately permissive (design D3): one @, no spaces, a dot in the domain.
     * It exists to catch a typo before we confirm "we sent a sign-in link" for an address that cannot
     * receive one — UX, NOT a security boundary. Server-side validation is unchanged (§3.3).
     */
    const EMAIL_SHAPE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

    loginForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const emailInput = loginForm.querySelector<HTMLInputElement>('input[name="email"]');
      const email = (new FormData(loginForm).get('email') as string)?.trim().toLowerCase() ?? '';

      const refusal = !email
        ? 'Enter your work email.'
        : !EMAIL_SHAPE.test(email)
          ? 'Enter a valid email.'
          : '';
      if (refusal) {
        showFormError(loginError, loginErrorText, refusal);
        emailInput?.focus();
        return;
      }
      hideFormError(loginError);

      setButtonLoading(submitBtn, true);
      try {
        const { error } = await authClient.signIn.magicLink({
          email,
          callbackURL: returnTo || '/welcome',
        });

        if (error) {
          showFormError(loginError, loginErrorText, error.message ?? 'Could not send sign-in link. Try again.');
          return;
        }

        sentEmail.textContent = email;
        formPanel.classList.add('hidden');
        sentPanel.classList.remove('hidden');
      } finally {
        setButtonLoading(submitBtn, false);
      }
    });

    againBtn.addEventListener('click', () => {
      sentPanel.classList.add('hidden');
      formPanel.classList.remove('hidden');
      // `reset()` clears the field but not the refusal above it: coming back to a blank input with a
      // stale "Enter a valid email." over it reads as a refusal of the empty box.
      hideFormError(loginError);
      loginForm.reset();
      loginForm.querySelector<HTMLInputElement>('input[name="email"]')?.focus();
    });
  }

  init();
  document.addEventListener('astro:after-swap', init);
</script>
