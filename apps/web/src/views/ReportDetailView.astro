---
/**
 * ReportDetailView — one report. This shell owns the back link, the header (window · generated ·
 * trigger), the Export control, the mounted parity EntityPanel, and the wiring script; the body is
 * ReportBodyKpi (a KPI band + per-section tables with column headers). See storybook `pattern-report`.
 *
 * UX PARITY: schema references open the SAME shared EntityPanel used by Schema/Docs — this view mounts
 * it and a Schema-health row dispatches `schema:openEntity`. Runs/docs navigate; connections link to
 * their Source/Destination detail (C4). ASSUMPTION(reports C1): the report is its own route
 * /reports/[id], not a drawer.
 */
import { fmtDay, fmtDayShort, fmtRelative } from '../lib/time';
import type { ReportDetail, ReportSectionKey, ReportDefinition } from '../lib/reports/types';
import { windowLabel } from '../lib/reports/view2';
import type { SchemaEntity, SchemaDoc } from '../components/schema/schemaEntities';
import EntityPanel from '../components/schema/EntityPanel.astro';
import PanelHost from '../components/ui/PanelHost.astro';
import ReportBodyKpi from '../components/reports/ReportBodyKpi.astro';
import Badge from '../components/ui/Badge.astro';

interface Props {
  report: ReportDetail;
  /** The parent report DEFINITION this run belongs to — drives the breadcrumb back to that report. */
  parentReportId?: string | null;
  parentReportName?: string | null;
  /**
   * The parent definition's SCOPE. A run document is the definition's output, so it renders what the
   * definition asked for and nothing else — until 2026-08-11 it rendered everything, which made a
   * report called "Schema Health on Sales CRM" arrive carrying five sections it excludes.
   * Null (a run with no definition behind it) still renders in full, which is correct: nothing
   * scoped it.
   */
  parentSections?: ReportSectionKey[] | null;
  /** The definition's window rule — what the header states instead of assuming one. */
  parentWindow?: ReportDefinition['window'] | null;
  parentBaseScope?: string[] | null;
  parentBaseNames?: string[] | null;
  /** Schema entity data for the mounted parity EntityPanel (omit → no panel, e.g. an empty report). */
  schemaIndex?: SchemaEntity[];
  docs?: SchemaDoc[];
  changelog?: any[];
  automations?: any[];
  interfaces?: any[];
  chatThreads?: any[];
  aiState?: 'ready' | 'locked' | 'no-credits';
  /** Active Space id for artifact download. */
  spaceId?: string | null;
}
const {
  report, parentReportId = null, parentReportName = null,
  parentSections = null, parentBaseScope = null, parentBaseNames = null, parentWindow = null,
  schemaIndex = [], docs = [], changelog = [], automations = [],
  interfaces = [], chatThreads = [], aiState = 'ready',
  spaceId = null,
} = Astro.props;

// `windowDates`, not `windowLabel`. This was `const windowLabel` — the same name as the exported
// `windowLabel()` in lib/reports/view2.ts, which computes something ELSE (the window's plain-English
// kind) and which nothing imported. One name, two meanings, one of them shadowing the other in a
// file that never imported it: the collision is exactly why the header below could hard-code a
// window while a function that knew the real one sat unused two files away.
const windowDates = `${fmtDayShort(report.windowStart)} – ${fmtDay(report.windowEnd)}`;
// D09 — `genWhen()` was a private 5th copy of the relative formatter; the only thing it
// owned was the word for "no timestamp", which is exactly why fmtRelative returns null.
const genWhen = (iso: string | null): string => fmtRelative(iso) ?? 'not generated';
const triggerText = report.trigger.kind === 'scheduled'
  ? `Scheduled${report.trigger.by ? ` · ${report.trigger.by}` : ''}`
  : `Run now${report.trigger.by ? ` · ${report.trigger.by}` : ''}`;
---

<div class="mx-auto max-w-[1200px] rpt" data-rpt data-space-id={spaceId ?? ''} data-run-id={report.id}>
  {/* Breadcrumbs — daisyUI primitive (catalog) + a ghost square back button, matching the
     Backups run pages. Back goes up one level: to the parent report if known, else the list. */}
  <div class="flex items-center gap-2">
    <a href={parentReportId ? `/reports/${parentReportId}` : '/reports'} class="btn btn-sm btn-square btn-ghost" aria-label="Back"><span class="iconify lucide--arrow-left size-4" aria-hidden="true"></span></a>
    <div class="breadcrumbs text-sm py-0">
      <ul>
        <li><a href="/reports">Reports</a></li>
        {parentReportId && parentReportName && <li><a href={`/reports/${parentReportId}`}>{parentReportName}</a></li>}
        <li>{windowDates}</li>
      </ul>
    </div>
  </div>

  <header class="rpt-head">
    <div class="min-w-0">
      <h1 class="text-title">{windowDates}{report.adHoc && <Badge size="sm" class="ml-2 align-middle">Ad hoc</Badge>}</h1>
      {/* THE WINDOW IS READ, NOT ASSERTED. This said "Since the last report." for every scheduled
          run — a sentence true of one of the three window kinds, printed for all of them, so a
          report on a rolling 30-day window described itself as something it is not. `windowLabel()`
          existed the whole time and had zero importers. Falls back to the dates when no definition
          is behind the run, which is the honest thing to say about a run with no window rule. */}
      <p class="text-sm text-base-content/65 mt-1">{report.adHoc ? 'Ad-hoc report — this window does not advance the report schedule.' : (parentWindow ? `${windowLabel(parentWindow)}.` : `Covers ${windowDates}.`)}</p>
      <div class="rpt-meta">
        <span class="inline-flex items-center gap-1"><span class="iconify lucide--clock size-3.5 opacity-60" aria-hidden="true"></span>Generated {genWhen(report.generatedAt)}</span>
        <span class="rpt-meta-sep">·</span>
        <span class="inline-flex items-center gap-1">
          <span class:list={['iconify size-3.5 opacity-60', report.trigger.kind === 'scheduled' ? 'lucide--calendar-clock' : 'lucide--play']} aria-hidden="true"></span>
          {/* Reports v2: the schedule belongs to the parent report (no separate Schedules page), so the
              schedule name is plain text — you arrived here from that report's run history. */}
          {report.trigger.kind === 'scheduled' && report.trigger.by ? (
            <>Scheduled · {report.trigger.by}</>
          ) : (
            triggerText
          )}
        </span>
      </div>
    </div>
    {/* Export: daisyUI dropdown, stubbed (no backend in the preview).
        SIZE, 2026-08-11: `btn-sm`, which is what every other export trigger in the app measures —
        the shared `ExportControl` (catalog `pattern-export-control`) renders `btn btn-sm` and this
        one was the tree's only md export. `ds-audit` had been flagging it since the sizing rule was
        written; the documented md exception is a page-header CTA, and an Export dropdown beside a
        run's title is a secondary affordance, not the page's verb.
        STILL OPEN: this is a SECOND implementation of a documented pattern. `ExportControl` handles
        csv/json with a row-selector contract, and this one is pdf/html over a whole document, so
        converging them is a real piece of work rather than a rename — recorded, not pretended. */}
    <div class="dropdown dropdown-end shrink-0">
      <div tabindex="0" role="button" class="btn btn-sm btn-soft btn-primary gap-1.5"><span class="iconify lucide--download size-4" aria-hidden="true"></span>Export<span class="iconify lucide--chevron-down size-3 opacity-50" aria-hidden="true"></span></div>
      <ul tabindex="0" class="dropdown-content rpt-export-menu">
        <li><button type="button" data-rpt-export="pdf"><span class="iconify lucide--file-text size-4 opacity-70" aria-hidden="true"></span><span class="rpt-export-label">Export PDF</span><span class="rpt-export-sub">Print-faithful archive</span></button></li>
        <li><button type="button" data-rpt-export="html"><span class="iconify lucide--code size-4 opacity-70" aria-hidden="true"></span><span class="rpt-export-label">Export HTML</span><span class="rpt-export-sub">Self-contained · keeps live links</span></button></li>
      </ul>
    </div>
  </header>

  <div class="flex flex-col gap-5"><ReportBodyKpi report={report} sections={parentSections} baseScope={parentBaseScope} baseScopeNames={parentBaseNames} /></div>
</div>

{/* The ONE panel host (decision-one-stack-one-entity-one-drawer). This view used to drive the second,
    standalone stack inside EntityPanel — the last one in the app — so a report's drawer had no Split
    View, no space cap, no shared ＋ picker and its own toast. Same guard the panel already used: with
    no schema index there is nothing a panel could ever hold.
    `tablegap` is left at the 64 default. It is the width reserved to the LEFT of the stack, and
    Schema's 150 buys peek at a TREE gutter (indent · chevrons · kind glyphs) that says where you
    are. A report is a centred `max-w-[1200px]` column of KPI cards with no left gutter to read, so
    150 here would reserve 86px of empty margin and shrink the panels for nothing. */}
{/* mincontent 720 — same document body as the definition view's Most Recent tab, same floor. */}
{schemaIndex.length > 0 && <PanelHost section="reports" mincontent={720} />}

{/* The shared entity detail panel — mounted here so a schema reference opens EXACTLY the Schema/Docs
    drawer. It contributes the `entity:` kind to the host above and renders no chrome of its own.
    Only mounted when we have the schema index (an empty report has no schema to open). */}
{schemaIndex.length > 0 && (
  <EntityPanel index={schemaIndex} docs={docs} changelog={changelog} automations={automations} interfaces={interfaces} chatThreads={chatThreads} aiState={aiState} />
)}

<script>
  import { wireRowKeys } from '../lib/wireRowKeys';

  function initReportDetail() {
    // Parity: a schema-health row (in either layout body) opens the shared EntityPanel.
    document.querySelectorAll<HTMLElement>('[data-rpt-entity]').forEach((row) => {
      if (row.dataset.rptWired) return;
      row.dataset.rptWired = '1';
      const open = () => {
        const id = row.dataset.rptEntity;
        if (id) document.dispatchEvent(new CustomEvent('schema:openEntity', { detail: { id } }));
      };
      row.addEventListener('click', open);
    });
    // D46 — the keyboard half comes from the ONE implementation, delegated from <body> so a row
    // that a section collapse/expand or a tab switch repaints is covered by construction. The
    // per-row `keydown` copy that stood inside the loop above is gone; the click loop stays because
    // it is not a row-activation contract, it is what makes the row clickable at all.
    wireRowKeys(document.body, {
      rowSelector: '[data-rpt-entity]',
      onActivate: (row) => {
        const id = row.dataset.rptEntity;
        if (id) document.dispatchEvent(new CustomEvent('schema:openEntity', { detail: { id } }));
      },
    });
    // Export is stubbed in the preview — say so, don't pretend a file was produced.
    document.querySelectorAll<HTMLElement>('[data-rpt-export]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const fmt = (btn.dataset.rptExport || '') as 'pdf' | 'html';
        const live = document.getElementById('rpt-live');
        const root = document.querySelector<HTMLElement>('[data-rpt]');
        const spaceId = root?.dataset.spaceId || '';
        const runId = root?.dataset.runId || '';
        if (!spaceId || !runId || (fmt !== 'pdf' && fmt !== 'html')) {
          if (live) live.textContent = 'Export is unavailable for this run.';
          (document.activeElement as HTMLElement | null)?.blur();
          return;
        }
        window.open(
          `/api/spaces/${encodeURIComponent(spaceId)}/reports/runs/${encodeURIComponent(runId)}/artifact?format=${fmt}`,
          '_blank',
          'noopener',
        );
        (document.activeElement as HTMLElement | null)?.blur();
      });
    });
  }
  initReportDetail();
  document.addEventListener('astro:page-load', initReportDetail);
</script>
<div id="rpt-live" class="sr-only" role="status" aria-live="polite"></div>

<style>
  /* Shell composition only (.rpt-*); the layout bodies own their own .rptk-/.rptl- styles. */
  .rpt { display: flex; flex-direction: column; gap: 1.25rem; }
  .rpt-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem; flex-wrap: wrap; padding: 4px 0 8px; }
  .rpt-head h1 { font-size: var(--t-24); font-weight: 700; letter-spacing: -0.02em; line-height: 1.2; }
  .rpt-meta { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; margin-top: 8px; font-size: var(--t-12); color: oklch(from var(--color-base-content) l c h / .65); }
  .rpt-meta-sep { opacity: .4; }
  .rpt-schedlink { color: var(--color-primary); }
  .rpt-schedlink:hover { text-decoration: underline; }

  .rpt-export-menu { z-index: 20; margin-top: 4px; width: 18rem; border: 1px solid var(--color-base-300); border-radius: var(--r-12); background: var(--color-base-100); padding: 4px; box-shadow: 0 10px 28px oklch(0 0 0 / .14); }
  .rpt-export-menu > li > button { display: flex; align-items: center; gap: .5rem; width: 100%; padding: 8px 8px; border-radius: var(--r-8); font-size: var(--t-14); }
  .rpt-export-menu > li > button:hover { background: oklch(from var(--color-base-200) l c h / .65); }
  .rpt-export-label { white-space: nowrap; }
  .rpt-export-sub { margin-left: auto; flex: 0 1 auto; min-width: 0; text-align: right; font-size: var(--t-11); line-height: 1.3; color: oklch(from var(--color-base-content) l c h / .65); }
</style>
