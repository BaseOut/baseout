---
/**
 * ReportsView — the Reports page (v2). The list is now NAMED report DEFINITIONS, not generated
 * artifacts: each row is a saved report (its sections + scope + window + one embedded schedule), and
 * opening it goes to the report page (/reports/[id]) with its run History and its Settings. The old
 * separate "Schedules" tab is gone — the schedule lives ON the report (1:1). See storybook `pattern-report`.
 *
 * Model (CONFIRMED by the client 2026-07-13): report = definition + one embedded schedule + run history;
 * the Schedules tab folds in; a Space auto-has a default "Full <Space> Report".
 *
 * Everything is from the catalog: `table` + pattern-audit-table + the shared row-clickable/.row-actions/
 * .row-go + click-to-sort (tableSort.ts). Composition (.rpl) is bespoke.
 */
import type { ReportDefinition, ReportCadence } from '../lib/reports/types';
import { cadenceLabel, scopeLabel, SECTION_LABEL, CADENCE_LABEL } from '../lib/reports/view2';
import { describeReportDeletion, REPORT_DELETE_CONFIRM_LABEL } from '../lib/reports/deleteReport';
import FacetFilter from '../components/schema/FacetFilter.astro';
import Table from '../components/ui/Table.astro';
import ConfirmModal from '../components/ui/ConfirmModal.astro';
import { CONFIRM_DESTRUCTIVE } from '../lib/ui';
import UndoToast from '../components/ui/UndoToast.astro';
import Badge from '../components/ui/Badge.astro';
import type { ReportBadgeVariant } from '../lib/reports/view';

interface Props {
  definitions?: ReportDefinition[];
  /** base id → display name, for the scope summary. */
  baseNames?: Record<string, string>;
  hasBackups?: boolean;
  /** Active Space id for Run / Delete / Export proxies. */
  spaceId?: string | null;
}
const { definitions = [], baseNames = {}, hasBackups = true, spaceId = null } = Astro.props;


/**
 * THE COLUMNS, AS DATA (catalog `table`). Five hand-numbered `data-sort-col="0"…"4"` values stood
 * here as `<th>`s and were kept in step with the `getAttribute('data-sort-${col}')` reader by
 * nothing but the author's memory; the index is the array position now. The sixth column was
 * `<th></th>` — a column a screen reader announces as an empty cell before every row's only exit —
 * and `srLabel` is not optional in the vessel.
 */
const columns = [
  { label: 'Report', sort: true },
  { label: 'Scope', sort: true },
  { label: 'Schedule', sort: true },
  { label: 'Last run', sort: true },
  { label: 'Delivery', sort: true },
  { label: '', srLabel: 'Open report' },
];

function since(iso: string | null): string {
  if (!iso) return '—';
  const m = Math.round((Date.now() - new Date(iso).getTime()) / 60000);
  if (m < 1) return 'just now';
  if (m < 60) return `${m}m ago`;
  const h = Math.round(m / 60);
  if (h < 24) return `${h}h ago`;
  return `${Math.round(h / 24)}d ago`;
}
const statusMeta: Record<string, { label: string; badge: ReportBadgeVariant; rank: number }> = {
  healthy: { label: 'Healthy', badge: 'success', rank: 0 },
  issues: { label: 'Issues', badge: 'warning', rank: 1 },
  failed: { label: 'Failed', badge: 'error', rank: 2 },
};
/**
 * D43 — the fallback is a NEW neutral entry, never an alias onto an existing status. Reference
 * implementation and the full argument: `SourcesView.astro:36-51`.
 *
 * This was `?? statusMeta.issues`: a run whose status this UI does not recognise was reported as
 * **Issues**, which asserts the report ran and found problems. Both halves of that may be false.
 * Neutral paint is the `Badge` primitive's `default`, which is `badge-ghost` (17.4:1) — never
 * `badge-soft badge-neutral`, measured 1.34:1 dark / 4.35:1 light (X08-F6). It ranks last:
 * `Unknown` is not a problem to triage first.
 *
 * These entries name a VARIANT now, not a daisyUI class list. The rows pass it to `<Badge>`, so the
 * contrast decision above is enforced by the primitive instead of by everyone remembering it.
 */
const statusUnknown: { label: string; badge: ReportBadgeVariant; rank: number } = { label: 'Unknown', badge: 'default', rank: 3 };
const metaOf = (s: string) => statusMeta[s] ?? statusUnknown;

// Facet option sets, derived from the definitions actually present so filters only offer real values.
// A team can accumulate many reports (different members, bases, cadences); the toolbar keeps the list
// navigable. Cadence + Last-run are single-valued per report → multi-select (visibility) facets; Base is
// a single-select because a report can cover several bases (or all).
const CADENCE_ORDER: ReportCadence[] = ['data_backup', 'schema_backup', 'weekly', 'monthly'];
const presentCadences = new Set(definitions.map((d) => d.schedule?.cadence).filter(Boolean) as ReportCadence[]);
const cadenceOpts = CADENCE_ORDER.filter((c) => presentCadences.has(c)).map((c) => ({ value: c, label: CADENCE_LABEL[c] }));

const scopedBaseIds = Array.from(new Set(definitions.flatMap((d) => d.baseScope ?? []).concat(Object.keys(baseNames))));
const baseOpts = scopedBaseIds.map((id) => ({ value: id, label: baseNames[id] || id }));

const STATUS_ORDER = ['healthy', 'issues', 'failed'] as const;
const presentStatuses = new Set(definitions.map((d) => d.runs[0]?.status).filter(Boolean));
const anyNoRun = definitions.some((d) => !d.runs[0]);
// D06 — one consequence per deletable report, derived from the definition (run count, schedule,
// recipients), never asserted. Built here so the row markup stays a lookup and the script stays a
// transport: `describeReportDeletion` is the ONLY writer of this copy, on both report surfaces.
const delCopy: Record<string, ReturnType<typeof describeReportDeletion>> = Object.fromEntries(
  definitions.filter((d) => !d.isDefault).map((d) => [d.id, describeReportDeletion(d)]),
);

const statusOpts = [
  ...STATUS_ORDER.filter((s) => presentStatuses.has(s)).map((s) => ({ value: s, label: statusMeta[s].label })),
  ...(anyNoRun ? [{ value: 'none', label: 'No runs yet' }] : []),
];
---

<div class="mx-auto max-w-[1200px] rpl" data-rpl data-space-id={spaceId ?? ''}>
  <header class="page-head">
    <div class="page-head-txt">
      <h1 class="text-title">Reports</h1>
      <p class="text-sm text-base-content/65 mt-1">Each report is a saved definition — the sections it covers, the bases it scopes to, and its delivery schedule. Open one for its run history and settings.</p>
    </div>
    {/* D17 — an empty state never adds a SECOND primary. With no backups the page degrades
        wholesale and the degrade carries the one exit (`Go to Backups`); a `+ New report` in the
        header beside it would be a second primary offering to build a report over nothing. */}
    {/* 32px, like every other button in the app. This wore the bare `btn` (40px) under a `ds-ok`
        citing the page-header `md` exception — a carve-out Oleh's ruling 1 DELETED. The comment is
        removed rather than left in place: an exception note that still names a rescinded rule is an
        instruction to the next reader to put the 40 back. */}
    {hasBackups && <a href="/reports/new" class="btn btn-primary btn-sm shrink-0"><span class="iconify lucide--plus size-4" aria-hidden="true"></span>New report</a>}
  </header>

  {/* D17 — TWO states here, not three. The deleted third was `hasBackups && definitions.length === 0`
      ("Create your first report", `+ New report` at btn-lg). It is DELETED rather than restyled,
      because the confirmed model (2026-07-13) is that a Space auto-has a default "Full <Space>
      Report" from creation — so a Space with backups and zero report definitions is not a state the
      product can reach, and a screen inviting you to create your first report contradicted the row
      the same page would have been listing. The one genuinely reachable zero-data condition is "no
      backups", and that is the wholesale degrade below. */}
  {hasBackups ? (
    <section class="rpl-panel tbl-frame" data-rpl-list>
      {/* Toolbar — search + faceted filters, same construction as the Backups list (shared FacetFilter /
          daisyUI input), so every list in the app filters identically. Applied client-side over the
          loaded definitions for the prototype; the real app pushes these to the query. */}
      <div class="sch-tb">
        <label class="input input-sm rpl-search">
          <span class="iconify lucide--search size-4 opacity-50" aria-hidden="true"></span>
          <input type="search" data-rpl-search class="grow" placeholder="Search reports…" aria-label="Search reports" />
        </label>

        {baseOpts.length > 0 && <FacetFilter label="Base" name="rplbase" groups={[{ items: baseOpts }]} />}
        {cadenceOpts.length > 0 && <FacetFilter label="Schedule" name="rplcadence" groups={[{ items: cadenceOpts }]} />}
        {statusOpts.length > 0 && <FacetFilter label="Last run" name="rplstatus" groups={[{ items: statusOpts }]} />}

        <button type="button" class="btn btn-sm btn-ghost gap-1" data-rpl-clear hidden>
          <span class="iconify lucide--x size-3.5" aria-hidden="true"></span>Clear
        </button>
        <div class="ml-auto text-sm text-base-content/65">Showing <span class="mono-data" data-rpl-shown>0</span> of <span class="mono-data" data-rpl-total>0</span></div>
      </div>

      {/* THE ONE TABLE (catalog `table`) — `Table.astro`, not a hand-built one. The `<thead>`, the
          five `data-sort-col` indices, `data-mobile-rows` and the `TablePager` below all left this
          file; three things this list never had arrive with them: `scope="col"` on every header, a
          live `aria-sort`, and a sortable column that is a real `<button>` rather than a `<th>`
          reachable only with a mouse. The `.rpl-sort` block that repainted the shared caret as a
          literal ↕/▲/▼ text glyph was already deleted; the vessel is what stops a tenth one.

          `narrow="fold"` — below 1280 this same table becomes the shared narrow row
          (`pattern-mobile-row`), keeping its ids, `data-sort-*` keys, role and handler, so search,
          the facets and click-sort all keep running with no second controller. */}
      <Table
        class="rpl-tablewrap"
        name="rpl"
        columns={columns}
        rowCount={definitions.length}
        growth="paged"
        rowSelector="[data-rpl-row]"
        narrow="fold"
        narrowReason="A saved report is identified by its NAME, not by comparing values down a column: the other five cells are one scope string, one cadence string, one relative stamp and one delivery count, none of which anybody scans vertically. Measured at 500 before the fold existed, 362px was hidden — Schedule, Last run and Delivery — with the row's own action cell 346px outside the client box. Panning to reach a report's own overflow menu is worse than reading the report as a two-line row."
        pager={{ sizes: [10, 20, 50], selected: 20 }}
      >
            {definitions.map((d) => {
              const last = d.runs[0] ?? null;
              const sm = last ? metaOf(last.status) : null;
              const href = `/reports/${d.id}`;
              return (
                <tr
                  class="rpl-row row-clickable"
                  data-nrow
                  role="button"
                  tabindex="0"
                  data-rpl-row
                  data-scope={d.baseScope ? d.baseScope.join(' ') : 'all'}
                  data-cadence={d.schedule?.cadence ?? ''}
                  data-status={last ? last.status : 'none'}
                  data-search={`${d.name} ${scopeLabel(d, baseNames)} ${cadenceLabel(d.schedule)}`.toLowerCase()}
                  data-sort-0={d.name.toLowerCase()}
                  data-sort-1={scopeLabel(d, baseNames).toLowerCase()}
                  data-sort-2={cadenceLabel(d.schedule).toLowerCase()}
                  data-sort-3={last?.generatedAt ? new Date(last.generatedAt).getTime() : 0}
                  data-sort-4={d.schedule?.lastDelivery ? d.schedule.lastDelivery.delivered : (d.schedule?.recipients.length ?? 0)}
                  onclick={`window.location='${href}'`}
                >
                  <td data-m="lead" class="font-medium">
                    <span class="inline-flex items-center gap-2">
                      <span class="iconify lucide--file-chart-column size-4 opacity-70" aria-hidden="true"></span>
                      {d.name}
                      {d.isDefault && <Badge size="sm">Default</Badge>}
                    </span>
                  </td>
                  <td data-m="off" class="text-base-content/65">{scopeLabel(d, baseNames)}</td>
                  <td data-m="sub" class="text-base-content/65">{cadenceLabel(d.schedule)}</td>
                  <td data-m="sub2">
                    {last && sm ? (
                      <span class="inline-flex items-center gap-2"><Badge size="sm" variant={sm.badge}>{sm.label}</Badge><span class="text-base-content/65">{since(last.generatedAt)}</span></span>
                    ) : (
                      <span class="text-base-content/65">No runs yet</span>
                    )}
                  </td>
                  <td data-m="off" class="text-base-content/65">
                    {d.schedule && d.schedule.lastDelivery ? (
                      <span class="inline-flex items-center gap-1"><span class="iconify lucide--mail-check size-3.5 opacity-70" aria-hidden="true"></span><span class="tabular-nums">Delivered {d.schedule.lastDelivery.delivered}/{d.schedule.lastDelivery.sent}</span></span>
                    ) : d.schedule ? (
                      <span class="tabular-nums">{d.schedule.recipients.length} recipient{d.schedule.recipients.length === 1 ? '' : 's'}</span>
                    ) : (
                      <span class="text-base-content/65">Manual</span>
                    )}
                  </td>
                  {/* Shared row trailing: hover reveals Run now + Export + a ⋯ (Duplicate / Delete). The
                      chevron / whole row opens the report. Delete is omitted for the default report. */}
                  <td data-m="go" class="text-right"><span class="row-end">
                    <span class="row-actions">
                      <button type="button" class="btn btn-ghost btn-sm btn-square tooltip tooltip-left" data-tip="Run now" data-rpl-run={d.id} onclick="event.stopPropagation()" aria-label={`Run ${d.name} now`}><span class="iconify lucide--play size-4 opacity-70" aria-hidden="true"></span></button>
                      <div class="dropdown dropdown-end" onclick="event.stopPropagation()">
                        <div tabindex="0" role="button" class="btn btn-ghost btn-sm btn-square tooltip tooltip-left" data-tip="Export last run" aria-label="Export last run"><span class="iconify lucide--download size-4 opacity-70" aria-hidden="true"></span></div>
                        <ul tabindex="0" class="dropdown-content row-menu-panel">
                          <li><button type="button" data-rpl-export="pdf"><span class="iconify lucide--file-text size-3.5 opacity-70"></span>Export PDF</button></li>
                          <li><button type="button" data-rpl-export="html"><span class="iconify lucide--code size-3.5 opacity-70"></span>Export HTML</button></li>
                        </ul>
                      </div>
                      <div class="dropdown dropdown-end row-menu" onclick="event.stopPropagation()">
                        <div tabindex="0" role="button" class="btn btn-ghost btn-sm btn-square" aria-label="Report actions"><span class="iconify lucide--ellipsis size-4" aria-hidden="true"></span></div>
                        <ul tabindex="0" class="dropdown-content row-menu-panel">
                          <li><button type="button" data-rpl-dup={d.id}><span class="iconify lucide--copy size-3.5 opacity-70"></span>Duplicate</button></li>
                          {/* D06 — the consequence is computed ONCE per report, in the frontmatter,
                              by the same `describeReportDeletion()` the report page uses. The row
                              carries the finished sentences; the script only transports them into
                              the one dialog. Writing them in JS would put a second author on the
                              copy, which is the defect P13 named. */}
                          {!d.isDefault && <li><button type="button" class="text-error" data-rpl-del={d.id} data-del-lead={delCopy[d.id]?.lead} data-del-conseq={delCopy[d.id]?.consequence} data-del-toast={delCopy[d.id]?.toast}><span class="iconify lucide--trash-2 size-3.5"></span>Delete</button></li>}
                        </ul>
                      </div>
                    </span>
                    <span class="row-go" aria-hidden="true"><span class="iconify lucide--chevron-right size-4"></span></span>
                  </span></td>
                </tr>
              );
            })}
        {/* No rows match the active filters (distinct from the no-reports-at-all empty state
            below). It is the vessel's `empty` slot now, which is what puts it between the table
            and the pager — a saved report per member, per base, per cadence is a set that grows
            with the team, so `growth="paged"` is the honest answer and the pager comes with it.
            20 matches the Backups list, the other "rows of records you scan" surface. */}
        <div class="rpl-nomatch" data-rpl-nomatch hidden slot="empty">
          <span class="rpl-nomatch-ic"><span class="iconify lucide--search-x" aria-hidden="true"></span></span>
          <p class="rpl-nomatch-title">No reports match these filters</p>
          <button type="button" class="btn btn-sm btn-ghost" data-rpl-clear>Clear filters</button>
        </div>
      </Table>
    </section>
  ) : (
    <section class="rpl-empty">
      <span class="rpl-empty-ic"><span class="iconify lucide--archive"></span></span>
      <p class="rpl-empty-title">Reports appear after your first backup</p>
      <p class="rpl-empty-sub">A report summarizes backup activity, connection health and schema changes, so there is nothing to report until this Space has backed up at least once.</p>
      <a href="/backups" class="btn btn-primary btn-sm mt-1"><span class="iconify lucide--archive size-4" aria-hidden="true"></span>Go to Backups</a>
    </section>
  )}

  {/* D06 — ONE dialog for the whole list. A report is a definition plus a live external mailing, so
      deleting it is externally visible and takes a confirm (catalog `confirm-modal`); the definition
      itself is restorable for a few seconds, so it also takes an Undo (catalog `pattern-undo-toast`).
      Both halves are stated in the alert, which is what stops the pair reading as ceremony.
      The title is the same question for every row — the report's own name is in the lead sentence,
      so nothing here has to be rewritten by script except the two derived sentences. */}
  <ConfirmModal id="rpl-del-modal" title="Delete this report?" cancelLabel="Keep it" confirmLabel={REPORT_DELETE_CONFIRM_LABEL} confirmClass={CONFIRM_DESTRUCTIVE} confirmIcon="lucide--trash-2">
    <p class="text-sm text-base-content/65" data-rpl-del-lead></p>
    <div role="alert" class="alert alert-soft alert-warning mt-3">
      <span class="iconify lucide--triangle-alert size-4" aria-hidden="true"></span>
      <span data-rpl-del-conseq></span>
    </div>
  </ConfirmModal>

  <UndoToast />
</div>

<script>
  import { wireTableSort } from '../components/schema/tableSort';
  import { showUndoToast } from '../components/ui/undoToast';
  import { createPager } from '../components/ui/tablePager';
  import { mountRefineCollapse } from '../lib/refineCollapse';
  // See BackupsListView: `.sch-tb` markup without `watchToolbars` is the pattern's look and none of
  // its behaviour.
  import { watchToolbars } from '../lib/toolbarFit';
  import { generateReport, deleteReport } from '../lib/reports/clientApi';

  function initReportsView() {
    const rootEl = document.querySelector<HTMLElement>('.rpl');
    if (!rootEl || rootEl.dataset.rplWired) return;
    rootEl.dataset.rplWired = '1';
    const list = rootEl.querySelector<HTMLElement>('[data-rpl-list]');
    if (!list) return;

    const rows = Array.from(list.querySelectorAll<HTMLTableRowElement>('[data-rpl-row]'));
    // D46 — `lib/wireRowKeys` is the ONE Enter/Space implementation, and it is MOUNTED BY THE
    // VESSEL now (`Table.astro` passes `rowSelector` straight into it). The call that stood here
    // rooted on `[data-rpl-list]`, an ancestor of the table; leaving it in place beside the
    // vessel's own mount would give one keypress two handlers — `wireRowKeys` idempotence is keyed
    // per (root, selector) and neither handler stops propagation, so Enter would have called
    // `row.click()` twice and navigated twice. Deleted, not duplicated. `requireRole` still keeps
    // the previous `role === 'button'` test, and the nested-interactive stand-down is what stops
    // Enter on the row's own overflow menu from also navigating.

    const tbody = list.querySelector<HTMLElement>('tbody')!;
    // `thead [data-sort-col]`, NOT `th[data-sort-col]`: the vessel puts the attribute on the
    // `<button>` inside the header cell, which is what makes the sort reachable by keyboard.
    const headers = Array.from(list.querySelectorAll<HTMLElement>('thead [data-sort-col]'));
    // Declared before wireTableSort so its onSorted can reach it: a new order means page 1 is a
    // different set of rows, which is the case `onSorted` exists for.
    const pager = createPager({
      root: rootEl, name: 'rpl', sizes: [10, 20, 50], defaultSize: 20,
      storageKey: 'reports-rpl-pagesize', onChange: () => render(),
    });
    wireTableSort(
      list,
      () => [{ headers, container: tbody, items: () => rows }],
      (item, col) => {
        // Read the raw attribute: `data-sort-0` does NOT map to dataset.sort0 (a digit after the
        // hyphen isn't camel-cased), so dataset access would silently return undefined and no-op the sort.
        const v = (item as HTMLElement).getAttribute(`data-sort-${col}`) || '';
        const n = Number(v);
        return Number.isFinite(n) && v !== '' ? n : String(v);
      },
      // A new order means page 1 is a different set of rows — and `rows` must be re-taken from the
      // DOM first. wireTableSort reorders the <tbody>; this array does not follow on its own, so
      // without the re-take the pager would slice the OLD order while the table displayed the new
      // one, and page 1 would show a scattered 20 rather than the first 20.
      () => { reorder(); pager.reset(); render(); },
    );
    const reorder = () => {
      rows.splice(0, rows.length, ...Array.from(tbody.querySelectorAll<HTMLTableRowElement>('[data-rpl-row]')));
    };

    // Search + faceted filtering — same contract as the Backups list. Base is single-select (a report can
    // cover many bases, so we match by inclusion); Schedule/Last-run are multi-select visibility facets.
    const searchEl = rootEl.querySelector<HTMLInputElement>('[data-rpl-search]');
    const shownEl = rootEl.querySelector<HTMLElement>('[data-rpl-shown]');
    const totalEl = rootEl.querySelector<HTMLElement>('[data-rpl-total]');
    const clearEls = Array.from(rootEl.querySelectorAll<HTMLElement>('[data-rpl-clear]'));
    const noMatch = rootEl.querySelector<HTMLElement>('[data-rpl-nomatch]');
    const tableWrap = rootEl.querySelector<HTMLElement>('.rpl-tablewrap');
    const hidden: Record<string, Set<string>> = { rplcadence: new Set(), rplstatus: new Set() };
    // Base is a multi-select (toggle) facet — a report can cover several bases (or all), so we match by
    // set intersection with the still-selected bases (a base is "selected" when NOT in baseHidden).
    let baseHidden = new Set<string>();
    const totalBases = rootEl.querySelectorAll('.ff[data-facet="rplbase"] [data-facet-opt]').length;
    const anyFilter = () => hidden.rplcadence.size > 0 || hidden.rplstatus.size > 0 || baseHidden.size > 0 || !!(searchEl?.value || '').trim();
    const matches = (row: HTMLElement) => {
      if (hidden.rplcadence.has(row.dataset.cadence as string)) return false;
      if (hidden.rplstatus.has(row.dataset.status as string)) return false;
      if (baseHidden.size > 0) {
        const sc = row.dataset.scope || '';
        if (sc === 'all') { if (baseHidden.size >= totalBases) return false; } // all-scope hidden only when no base is selected
        else if (!sc.split(' ').filter(Boolean).some((b) => !baseHidden.has(b))) return false;
      }
      const q = (searchEl?.value || '').trim().toLowerCase();
      if (q && !(row.dataset.search || '').includes(q)) return false;
      return true;
    };
    const render = () => {
      // Filter first, then window — the pager's contract is that it slices the ALREADY filtered and
      // sorted list, never the raw rows (components/ui/tablePager.ts). `rows` is in DOM order, which
      // wireTableSort has already reordered if a header was clicked.
      const matched = rows.filter(matches);
      const win = new Set(pager.window(matched));
      rows.forEach((r) => { r.style.display = win.has(r) ? '' : 'none'; });
      const shown = matched.length;
      if (shownEl) shownEl.textContent = String(shown);
      if (totalEl) totalEl.textContent = String(rows.length);
      const empty = shown === 0;
      if (noMatch) noMatch.hidden = !empty;
      if (tableWrap) tableWrap.style.display = empty ? 'none' : '';
      clearEls.forEach((el) => (el.hidden = !anyFilter()));
    };
    // Every search / filter change is a new result set, so page 1 is the only honest page.
    searchEl?.addEventListener('input', () => { pager.reset(); render(); });
    document.addEventListener('facetchange', (ev) => {
      const d = (ev as CustomEvent).detail || {};
      if (d.name === 'rplbase') baseHidden = new Set<string>(d.hidden || []);
      else if (d.name in hidden) hidden[d.name] = new Set<string>(d.hidden || []);
      else return;
      pager.reset();
      render();
    });
    clearEls.forEach((el) => el.addEventListener('click', () => {
      if (searchEl) searchEl.value = '';
      hidden.rplcadence = new Set(); hidden.rplstatus = new Set(); baseHidden = new Set();
      document.dispatchEvent(new CustomEvent('facetreset'));
      pager.reset();
      render();
    }));

    // Row actions — Run / Delete hit the real proxies; Export needs a run id (open the report).
    const live = document.getElementById('rpl-live');
    const say = (msg: string) => { if (live) live.textContent = msg; };
    const spaceId = rootEl.dataset.spaceId || '';
    list.querySelectorAll<HTMLElement>('[data-rpl-run]').forEach((b) => b.addEventListener('click', async (e) => {
      e.stopPropagation();
      const id = b.dataset.rplRun || '';
      if (!spaceId || !id) { say('Run failed — missing Space or report id.'); return; }
      const res = await generateReport(spaceId, id, b as HTMLButtonElement);
      if (!res.ok) { say(`Could not queue: ${res.error}`); return; }
      showUndoToast('Report queued. Open it to watch History.', null);
      window.setTimeout(() => window.location.reload(), 1200);
    }));
    list.querySelectorAll<HTMLElement>('[data-rpl-export]').forEach((b) => b.addEventListener('click', () => {
      say('Open the report (or a run) to export PDF/HTML — the list row does not carry a run artifact.');
    }));
    list.querySelectorAll<HTMLElement>('[data-rpl-dup]').forEach((b) => b.addEventListener('click', () => {
      say('Duplicate is not wired yet — use New report and copy settings.');
    }));
    /**
     * DELETE — confirm, then undo (audit D06).
     *
     * It used to delete the row on the click, silently, with a live-region line nobody sees. A
     * report carries a live external mailing, so the act is externally visible and asks first; the
     * sentences it asks with are server-rendered onto the trigger by `describeReportDeletion`, so
     * this handler never authors copy.
     *
     * The removal is PROVISIONAL until the undo window closes — that is what makes the toast honest
     * rather than a dead button (`pattern-undo-toast`). Undo restores the row at its original index
     * in both the DOM and the pager's row array, so filtering and paging behave as if nothing
     * happened. On commit we DELETE via the proxy.
     */
    const delModal = document.getElementById('rpl-del-modal') as HTMLDialogElement | null;
    const delLead = rootEl.querySelector<HTMLElement>('[data-rpl-del-lead]');
    const delConseq = rootEl.querySelector<HTMLElement>('[data-rpl-del-conseq]');
    let pending: { row: HTMLTableRowElement; index: number; after: Element | null; toast: string; id: string } | null = null;

    list.querySelectorAll<HTMLElement>('[data-rpl-del]').forEach((b) => b.addEventListener('click', () => {
      const row = b.closest('tr') as HTMLTableRowElement | null;
      if (!row || !delModal) return;
      if (delLead) delLead.textContent = b.dataset.delLead || '';
      if (delConseq) delConseq.textContent = b.dataset.delConseq || '';
      pending = {
        row,
        index: rows.indexOf(row),
        after: row.nextElementSibling,
        toast: b.dataset.delToast || 'Report deleted',
        id: b.dataset.rplDel || '',
      };
      delModal.showModal();
    }));

    delModal?.addEventListener('close', () => {
      if (delModal.returnValue !== 'confirm' || !pending) { pending = null; return; }
      const { row, index, after, toast, id } = pending;
      pending = null;
      const parent = row.parentElement;
      if (index >= 0) rows.splice(index, 1);
      row.remove();
      render();
      showUndoToast(
        toast,
        { label: 'Undo', run: () => {
          if (!parent) return;
          if (after && after.parentElement === parent) parent.insertBefore(row, after);
          else parent.appendChild(row);
          if (index >= 0) rows.splice(index, 0, row);
          render();
          say('Deletion undone. The report is back in the list.');
        } },
        async () => {
          if (!spaceId || !id) { say('Delete failed — missing ids.'); return; }
          const res = await deleteReport(spaceId, id);
          if (!res.ok) {
            say(`Could not delete: ${res.error}`);
            // restore row on failure
            if (!parent) return;
            if (after && after.parentElement === parent) parent.insertBefore(row, after);
            else parent.appendChild(row);
            if (index >= 0) rows.splice(index, 0, row);
            render();
            return;
          }
          say('Report deleted.');
        },
      );
    });

    /**
     * The three facets fold into one `Filter` button — the seventh surface to make this call, and
     * Reports was the last log in the app without it.
     *
     * The cost was visible rather than theoretical. Oleh's 500px screenshot has THREE 30px buttons
     * carrying a chevron and nothing else: `FacetFilter`'s label is a `tb-word`, hidden below 1280
     * on the rule that the control's own glyph still says what it is — and a facet has no glyph, so
     * on this surface the rule stripped the only thing each button had. Measured here: `Base`,
     * `Schedule` and `Last run`, all three unreadable. Folding removes the condition instead of
     * patching the symptom, because inside the panel every facet is a full row with its name spelled
     * out. Identical call to `BackupsListView`, `SchemaBrowse`, `SchemaChangelog`, `DataBrowse`,
     * `DataChangelog`, `DataComments` and `DataMedia`.
     */
    const tb = rootEl.querySelector<HTMLElement>('.sch-tb');
    if (tb) mountRefineCollapse({ toolbar: tb, selectors: ['[data-facet]'], always: true });

    render();
  }
  initReportsView();
  watchToolbars();
  document.addEventListener('astro:page-load', () => { initReportsView(); watchToolbars(); });
</script>
