---
/**
 * SchemaView — Schema page shell (Phase 13 Slices 2–3).
 *
 * Fork chrome (ui-only@4073f919): sch-headwrap, AccessScopeNote subtitle,
 * as-of stamp, soft-primary ask launcher, D17 wholesale empty, clustered tab bar.
 * PanelHost + EntityPanel (Slice 1) + UndoToast. Tab bodies: SchemaBrowse
 * (Slice 3) + remaining live `*Tab` modules until later slices.
 */
import AccessScopeNote from '../components/integrations/AccessScopeNote.astro'
import PanelHost from '../components/ui/PanelHost.astro'
import UndoToast from '../components/ui/UndoToast.astro'
import EntityPanel from '../components/schema/EntityPanel.astro'
import RelationshipPanel from '../components/schema/RelationshipPanel.astro'
import SchemaBrowse from '../components/schema/SchemaBrowse.astro'
import ChangelogTab from './schema/ChangelogTab.astro'
import RelationshipsTab from './schema/RelationshipsTab.astro'
import VisualizeTab from './schema/VisualizeTab.astro'
import HealthTab from './schema/HealthTab.astro'
import DocsTabPanel from './schema/DocsTab.astro'
import ChatTab from './schema/ChatTab.astro'
import AutomationsTab from './schema/AutomationsTab.astro'
import InterfacesTab from './schema/InterfacesTab.astro'
import type { DocsTabEntity } from '../components/islands/DocsTab'
import type {
  SchemaDocSummary,
  SchemaEntityBase,
  SchemaEntityField,
  SchemaEntityTable,
  SchemaEntityView,
} from '../lib/backup-engine'
import type { SchemaDocsLevel } from '../lib/capabilities/tier-capabilities'
import type { SchemaRelationship } from '../lib/schema-docs/adapt-relationships'
import { isRemoved } from '../lib/schema-docs/deleted-filter'
import {
  mapDocSummariesToSchemaDocs,
  mapEngineToEntityIndex,
} from '../lib/schema-docs/map-entity-index'
import { asOfWhen } from '../lib/time'

interface Props {
  spaceId: string
  level: SchemaDocsLevel
  docs: SchemaDocSummary[]
  schema: {
    bases: SchemaEntityBase[]
    tables: SchemaEntityTable[]
    fields: SchemaEntityField[]
    views: SchemaEntityView[]
  }
  /** Engine relationships mapped for tip SchemaRelationships + RelationshipPanel. */
  relationships?: SchemaRelationship[]
  /** at_bases workspace identity keyed by Airtable base id (for Visualize grouping). */
  baseWorkspaces?: Record<string, { workspaceId?: string | null; workspaceName?: string | null }>
  state: 'ok' | 'not_ready' | 'unconfigured' | 'error'
  /** When the schema was last captured (latest succeeded backup). Freshness stamp. */
  lastBackupAt?: string | null
  /** Optional run id for the stamp (D09) — omit rather than invent. */
  lastBackupRunId?: string | null
}

const {
  spaceId,
  level,
  docs,
  schema,
  relationships = [],
  baseWorkspaces = {},
  state: _state,
  lastBackupAt = null,
  lastBackupRunId = null,
} = Astro.props

const hasSchema = schema.bases.length > 0
const aiEnabled = level === 'manual_ai'
const aiState = aiEnabled ? 'ready' : level === 'none' ? 'locked' : 'no-credits'

const healthBases = schema.bases.filter((b) => !isRemoved(b.status))

const entities: DocsTabEntity[] = [
  ...schema.bases.map((b) => ({ type: 'base' as const, id: b.baseId, label: b.name })),
  ...schema.tables.map((t) => ({ type: 'table' as const, id: t.tableId, label: t.name })),
  ...schema.fields.map((f) => ({ type: 'field' as const, id: f.fieldId, label: f.name })),
  ...schema.views.map((v) => ({ type: 'view' as const, id: v.viewId, label: v.name })),
]

const schemaIndex = mapEngineToEntityIndex(schema, docs)
const panelDocs = mapDocSummariesToSchemaDocs(docs)
const browseBases = schema.bases.map((b) => {
  const ws = baseWorkspaces[b.baseId]
  return {
    id: b.baseId,
    name: b.name,
    workspaceId: ws?.workspaceId ?? undefined,
    workspaceName: ws?.workspaceName ?? undefined,
  }
})
const relTables = schema.tables
  .filter((t) => !isRemoved(t.status))
  .map((t) => ({ id: t.tableId, name: t.name, baseId: t.baseId }))

const stampWhen = lastBackupAt ? asOfWhen(lastBackupAt) : ''
const asOfStamp = lastBackupRunId && stampWhen
  ? `As of ${lastBackupRunId} · ${stampWhen}`
  : stampWhen
    ? `As of ${stampWhen}`
    : ''
---

<section class="sch" data-schema data-schema-docs data-space-id={spaceId}>
  <div class="sch-headwrap">
    <header class="sch-head">
      <div class="min-w-0">
        <h1 class="text-title">Schema</h1>
        <p class="text-sm text-base-content/65 mt-1 sch-headsub">
          Your Airtable structure, visualized — tables, fields, and how they link. <AccessScopeNote variant="mark" />.
        </p>
      </div>
      <div class="sch-head-r">
        {lastBackupAt && hasSchema && (
          <div class="sch-stampwrap">
            <p
              class="sch-stamp tooltip tooltip-left"
              data-tip={`${asOfStamp} — Schema is captured at backup time and may drift from Airtable until the next run.`}
            >
              <span class="iconify lucide--history size-3.5" aria-hidden="true"></span>
              {lastBackupRunId && <span class="sch-stamp-run">As of {lastBackupRunId} ·</span>}
              <span class="sch-stamp-when">{stampWhen}</span>
            </p>
          </div>
        )}
        {hasSchema && (
          <button
            type="button"
            class="btn btn-sm btn-soft btn-primary btn-square tooltip tooltip-left"
            data-sch-ask
            data-tip="Ask about your schema"
            aria-label="Ask about your schema"
          >
            <span class="iconify lucide--sparkles size-4" aria-hidden="true"></span>
          </button>
        )}
      </div>
    </header>
  </div>

  {!hasSchema ? (
    <section class="sch-empty sch-degrade">
      <span class="sch-empty-ic"><span class="iconify lucide--list-tree"></span></span>
      <p class="sch-empty-title">Schema appears after your first backup</p>
      <p class="sch-empty-sub">
        Once a backup completes, every base, table, and field shows up here to browse, visualize, and
        track. Start one from the Backups page.
      </p>
      <a href="/backups" class="btn btn-primary btn-sm mt-1">
        <span class="iconify lucide--archive size-4" aria-hidden="true"></span>Go to Backups
      </a>
    </section>
  ) : (
    <>
      <div class="sch-tabbar" role="tablist" aria-label="Schema sections">
        <div class="sch-group">
          <span class="sch-glabel">Explore</span>
          <div class="sch-gtabs tabs tabs-border">
            <button type="button" class="tab tab-active" role="tab" data-tab="browse">
              <span class="iconify lucide--list-tree size-4" aria-hidden="true"></span>Browse
            </button>
            <button type="button" class="tab" role="tab" data-tab="visualize">
              <span class="iconify lucide--workflow size-4" aria-hidden="true"></span>Visualize
            </button>
            <button type="button" class="tab" role="tab" data-tab="relationships">
              <span class="iconify lucide--waypoints size-4" aria-hidden="true"></span>Relationships
            </button>
          </div>
        </div>
        <span class="sch-tabdiv" aria-hidden="true"></span>
        <div class="sch-group">
          <span class="sch-glabel">App layer</span>
          <div class="sch-gtabs tabs tabs-border">
            <button type="button" class="tab" role="tab" data-tab="automations">
              <span class="iconify lucide--zap size-4" aria-hidden="true"></span>Automations
            </button>
            <button type="button" class="tab" role="tab" data-tab="interfaces">
              <span class="iconify lucide--layout-panel-left size-4" aria-hidden="true"></span>Interfaces
            </button>
          </div>
        </div>
        <span class="sch-tabdiv" aria-hidden="true"></span>
        <div class="sch-group">
          <span class="sch-glabel">Monitor</span>
          <div class="sch-gtabs tabs tabs-border">
            <button type="button" class="tab" role="tab" data-tab="changelog">
              <span class="iconify lucide--history size-4" aria-hidden="true"></span>Changelog
            </button>
            <button type="button" class="tab" role="tab" data-tab="health">
              <span class="iconify lucide--heart-pulse size-4" aria-hidden="true"></span>Health
            </button>
          </div>
        </div>
        <span class="sch-tabdiv" aria-hidden="true"></span>
        <div class="sch-group">
          <span class="sch-glabel">Knowledge</span>
          <div class="sch-gtabs tabs tabs-border">
            <button type="button" class="tab" role="tab" data-tab="docs">
              <span class="iconify lucide--book-text size-4" aria-hidden="true"></span>Docs
            </button>
            <button type="button" class="tab" role="tab" data-tab="chat">
              <span class="iconify lucide--messages-square size-4" aria-hidden="true"></span>Chat
            </button>
          </div>
        </div>
      </div>

      <div class="sch-panel" data-panel="browse">
        <SchemaBrowse index={schemaIndex} bases={browseBases} docs={panelDocs} chatThreads={[]} />
      </div>

      <div class="sch-panel" data-panel="visualize" hidden>
        <VisualizeTab
          spaceId={spaceId}
          level={level}
          hasSchema={hasSchema}
          schema={schema}
          baseWorkspaces={baseWorkspaces}
        />
      </div>

      <div class="sch-panel" data-panel="relationships" hidden>
        <RelationshipsTab hasSchema={hasSchema} relationships={relationships} bases={browseBases} />
      </div>

      <div class="sch-panel" data-panel="automations" hidden>
        <AutomationsTab hasSchema={hasSchema} level={level} healthBases={healthBases} schema={schema} />
      </div>

      <div class="sch-panel" data-panel="interfaces" hidden>
        <InterfacesTab hasSchema={hasSchema} level={level} healthBases={healthBases} schema={schema} />
      </div>

      <div class="sch-panel" data-panel="changelog" hidden>
        <ChangelogTab hasSchema={hasSchema} healthBases={healthBases} schema={schema} />
      </div>

      <div class="sch-panel" data-panel="health" hidden>
        <HealthTab hasSchema={hasSchema} aiEnabled={aiEnabled} healthBases={healthBases} />
      </div>

      <div class="sch-panel" data-panel="docs" hidden>
        <DocsTabPanel spaceId={spaceId} docs={docs} aiEnabled={aiEnabled} entities={entities} />
      </div>

      <div class="sch-panel" data-panel="chat" hidden>
        <ChatTab hasSchema={hasSchema} aiEnabled={aiEnabled} healthBases={healthBases} />
      </div>

      <PanelHost section="schema" tablegap={150} mincontent={800} />
      <UndoToast />
      <EntityPanel
        index={schemaIndex}
        docs={panelDocs}
        changelog={[]}
        automations={[]}
        interfaces={[]}
        chatThreads={[]}
        aiState={aiState}
      />
      {hasSchema && (
        <RelationshipPanel relationships={relationships} tables={relTables} bases={browseBases} />
      )}
    </>
  )}
</section>

<script>
  import { wireSectionTabs } from '../components/ui/sectionTabs'
  import { watchToolbars } from '../lib/toolbarFit'

  function wireSchemaShell() {
    const root = document.querySelector<HTMLElement>('[data-schema-docs]')
    if (!root) return
    wireSectionTabs({
      root,
      searchSelector: '[data-entity-search] input, .es-input, [data-sch-search]',
    })
    watchToolbars()
    const chatTab = root.querySelector<HTMLButtonElement>('[data-tab="chat"]')
    root.querySelectorAll<HTMLButtonElement>('[data-sch-ask]').forEach((btn) => {
      btn.addEventListener('click', () => chatTab?.click())
    })
  }
  wireSchemaShell()
  document.addEventListener('astro:after-swap', () => {
    wireSchemaShell()
    watchToolbars()
  })
</script>

<script>
  document.addEventListener('open-entity-detail', ((e: CustomEvent) => {
    const d = e.detail as { id?: string }
    if (!d?.id) return
    document.dispatchEvent(new CustomEvent('schema:openEntity', { detail: { id: d.id } }))
  }) as EventListener)
</script>

<script>
  // Browse CSV export — answers patterns/ExportControl `schema:export` from SchemaBrowse.
  import { formatCsv } from '../lib/csv'
  import { downloadTextFile } from '../lib/ui'
  import type { SchemaEntity } from '../components/schema/schemaEntities'

  const ENTITY_EXPORT_HEADER = ['base', 'table', 'field', 'type', 'description', 'status'] as const

  function entityCsvRow(e: SchemaEntity): string[] {
    const base = e.kind === 'base' ? e.name : e.baseName
    const table = e.kind === 'table' ? e.name : (e.tableName ?? '')
    const field = e.kind === 'field' || e.kind === 'view' ? e.name : ''
    const type = e.kind === 'field' ? (e.fieldType ?? 'field') : e.kind
    const description = e.airtableDescription ?? e.aiDescription ?? e.userDescription ?? ''
    const status = e.removed ? 'removed' : 'active'
    return [base, table, field, type, description, status]
  }

  document.addEventListener('schema:export', (e) => {
    const ev = e as CustomEvent<{ tab: string; scope: 'filtered' | 'all'; filename: string }>
    if (ev.detail?.tab !== 'browse') return
    const indexEl = document.querySelector('[data-ep-index]')
    if (!indexEl) return
    ev.preventDefault()
    const index = JSON.parse(indexEl.textContent || '[]') as SchemaEntity[]
    const byId = new Map(index.map((ent) => [ent.id, ent]))
    const infos =
      ev.detail.scope === 'all'
        ? index.filter((ent) => ent.kind !== 'space')
        : Array.from(document.querySelectorAll<HTMLElement>('.br-row[data-entity-open], .br-trow[data-entity-open]'))
            .filter((el) => el.offsetParent !== null)
            .map((el) => byId.get(el.dataset.entityOpen ?? ''))
            .filter((ent): ent is SchemaEntity => Boolean(ent))
    const bom = Boolean(
      document.querySelector<HTMLInputElement>('[data-export-tab="browse"] [data-export-bom]')?.checked,
    )
    downloadTextFile(ev.detail.filename, formatCsv([...ENTITY_EXPORT_HEADER], infos.map(entityCsvRow), { bom }))
  })
</script>
