---
/**
 * SourceAddView — add an account-level Airtable source.
 *
 * Tip visual (ui-only@4073f919): AccessScopeNote, `.sb-segtrack` method control, connect-failure
 * Alert via `failureCopy`. Real OAuth preserved: POST `/api/connections/airtable/start` (not the
 * fork's fixture `/api/sources` redirect). PAT stays honestly gated (unsupported).
 *
 * ONE FAMILY WITH DestinationAddView (audit D12) — same `.reg-*` vocabulary when that twin lands.
 */
import TextInput from '../components/ui/TextInput.astro';
import AccessScopeNote from '../components/integrations/AccessScopeNote.astro';
import Alert from '../components/ui/Alert.astro';
import { connectFailure } from '../lib/connect/failureCopy';

interface Props {
  /** 'oauth' | 'pat' preselected method */
  method?: string | null;
  /**
   * Connect failure code from the OAuth round-trip (`?error=` on returnTo).
   * One region above the actions — `lib/connect/failureCopy`, never a second field-level error.
   */
  connectError?: string | null;
}
const { method = null, connectError = null } = Astro.props;
const sel = method === 'pat' ? 'pat' : 'oauth';
const failure = connectFailure(connectError, 'Airtable');
---

<div class="mx-auto max-w-3xl space-y-6">
  <a href="/sources" class="back-link"><span class="iconify lucide--arrow-left" aria-hidden="true"></span> Sources</a>

  <header class="flex items-center gap-3">
    <img src="/airtable.svg" alt="" width="36" height="36" class="reg-logo" />
    <div>
      <h1 class="text-xl font-bold tracking-tight leading-tight">Add an Airtable source</h1>
      <p class="text-sm text-base-content/65 leading-tight mt-0.5">Connect once, reuse across Spaces.</p>
    </div>
  </header>

  <div class="reg-form">
    <div class="reg-field">
      <TextInput
        label="Name"
        name="name"
        size="sm"
        placeholder="e.g. Ops Airtable"
        hint="A label to tell this connection apart from your other Airtable accounts. (Account-level naming lands with shared-sources — OAuth does not send this yet.)"
      />
    </div>

    <AccessScopeNote />

    <div class="reg-connect" data-reg-connect>
      <span class="reg-label" id="src-method-label">Connection method</span>
      <div role="radiogroup" aria-labelledby="src-method-label" class="sb-segtrack">
        <label class="sb-seg"><input type="radio" name="method" value="oauth" class="sr-only" checked={sel === 'oauth'} />OAuth</label>
        <label class="sb-seg"><input type="radio" name="method" value="pat" class="sr-only" checked={sel === 'pat'} />Personal access token</label>
      </div>

      <div data-method="oauth" class="mt-4">
        <p class="reg-hint">You approve read-only access on Airtable, then return here.</p>
        {failure && (
          <Alert variant="error" class="mt-4" title={failure.message}>
            <span class="block text-xs opacity-75" data-reg-form-error-code>Reference: {failure.code}</span>
          </Alert>
        )}
        <form method="POST" action="/api/connections/airtable/start" class="mt-4" data-airtable-connect data-astro-reload>
          <input type="hidden" name="returnTo" value="/sources/new" />
          <div class="reg-actions">
            <a href="/sources" class="btn btn-sm btn-ghost">Cancel</a>
            <button type="submit" class="btn btn-sm btn-primary" data-airtable-connect-btn>
              <span class="iconify lucide--plug size-4" aria-hidden="true"></span>
              Authorize Airtable
            </button>
          </div>
        </form>
      </div>

      <div data-method="pat" class="mt-4">
        <TextInput
          label="Personal access token"
          name="token"
          type="password"
          size="sm"
          placeholder="pat••••••••••••••"
          autocomplete="off"
          class="reg-mono"
          hint="Create a read-only token in Airtable's builder hub with the scopes above."
          disabled
        />
        <p class="mt-2 text-xs text-warning">Personal access tokens aren't supported yet — use OAuth above for now.</p>
        {failure && (
          <Alert variant="error" class="mt-4" title={failure.message}>
            <span class="block text-xs opacity-75">Reference: {failure.code}</span>
          </Alert>
        )}
        <div class="reg-actions">
          <a href="/sources" class="btn btn-sm btn-ghost">Cancel</a>
          <button type="button" class="btn btn-sm btn-primary" disabled>Coming soon</button>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .back-link { display: inline-flex; align-items: center; gap: .25rem; font-size: var(--t-13); font-weight: 500; color: oklch(from var(--color-base-content) l c h / .65); text-decoration: none; }
  .back-link:hover { color: var(--color-base-content); }
  .back-link .iconify { font-size: .95rem; }
  .reg-logo { border-radius: var(--r-8, 8px); flex: none; }

  .reg-form { display: flex; flex-direction: column; gap: 1.25rem; max-width: 30rem; }
  .reg-field { display: flex; flex-direction: column; }
  .reg-label { display: block; font-size: var(--t-13); font-weight: 600; }
  .reg-hint { font-size: var(--t-12); color: oklch(from var(--color-base-content) l c h / .65); }
  .reg-mono { font-family: ui-monospace, monospace; }
  .reg-actions { display: flex; align-items: center; justify-content: flex-end; gap: .5rem; margin-top: 1rem; }

  .reg-connect .sb-segtrack { margin-top: 8px; }

  .reg-connect:has(input[value="oauth"]:checked) [data-method="pat"] { display: none; }
  .reg-connect:has(input[value="pat"]:checked) [data-method="oauth"] { display: none; }
</style>

<script>
  import { setButtonLoading } from '../lib/ui';

  // Spinner while the browser redirects to Airtable's consent screen.
  document.addEventListener('submit', (event) => {
    const form = (event.target as HTMLElement | null)?.closest('[data-airtable-connect]');
    if (!(form instanceof HTMLFormElement)) return;
    const btn = form.querySelector('[data-airtable-connect-btn]');
    if (btn instanceof HTMLButtonElement) setButtonLoading(btn, true);
  });
</script>
