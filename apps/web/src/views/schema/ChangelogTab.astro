---
/**
 * Changelog tab (Phase 13 Slice 4) — tip SchemaChangelog chrome + engine-mapped
 * entries (SSR from schema.astro via adaptChangelogEntries).
 */
import EmptyState from '../../components/ui/EmptyState.astro'
import SchemaChangelog from '../../components/schema/SchemaChangelog.astro'
import type { TipChangelogEntry } from '../../lib/schema-docs/adapt-changelog'

interface Props {
  hasSchema: boolean
  entries: TipChangelogEntry[]
  baseId?: Record<string, string>
  tableId?: Record<string, string>
  baseWorkspace?: Record<string, { workspaceId?: string; workspaceName?: string }>
  asOf?: string | null
}

const {
  hasSchema,
  entries,
  baseId = {},
  tableId = {},
  baseWorkspace = {},
  asOf = null,
} = Astro.props
---

{!hasSchema ? (
  <EmptyState
    icon="lucide--history"
    title="No schema history yet"
    description="Changelog entries appear once a backup has captured this Space’s schema."
  />
) : (
  <SchemaChangelog
    entries={entries}
    baseId={baseId}
    tableId={tableId}
    baseWorkspace={baseWorkspace}
    asOf={asOf}
  />
)}
