---
/**
 * Health tab (Phase 13 Slice 4) — tip SchemaHealth chrome + engine-mapped
 * BaseHealth[] (SSR from schema.astro via adaptHealthOverview). Insights empty
 * until insights APIs ship. Pro+ space prompt save + rerun hit live proxies.
 */
import EmptyState from '../../components/ui/EmptyState.astro'
import SchemaHealth from '../../components/schema/SchemaHealth.astro'
import type { TipBaseHealth } from '../../lib/schema-docs/adapt-health'

interface Props {
  hasSchema: boolean
  health: TipBaseHealth[]
  aiState: 'ready' | 'locked' | 'no-credits'
  overrideTargets?: { id: string; label: string; kind: string }[]
}

const { hasSchema, health, aiState, overrideTargets = [] } = Astro.props
---

{!hasSchema ? (
  <EmptyState
    icon="lucide--heart-pulse"
    title="No schema to score"
    description="Health scores appear once a backup has captured this Space’s schema."
  />
) : (
  <SchemaHealth health={health} aiState={aiState} overrideTargets={overrideTargets} />
)}
