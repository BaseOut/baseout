---
/**
 * Relationships tab (Phase 13 Slice 4) — tip SchemaRelationships chrome +
 * engine-mapped SchemaRelationship[] (SSR from schema.astro). Confirm/Dismiss/
 * Declare stay on live relationship-mutate proxies via schemaRelationships.ts.
 */
import EmptyState from '../../components/ui/EmptyState.astro'
import SchemaRelationships from '../../components/schema/SchemaRelationships.astro'
import type { SchemaRelationship } from '../../lib/schema-docs/adapt-relationships'

interface Props {
  hasSchema: boolean
  relationships: SchemaRelationship[]
  bases: { id: string; name: string; workspaceId?: string; workspaceName?: string }[]
}

const { hasSchema, relationships, bases } = Astro.props
---

{!hasSchema ? (
  <EmptyState
    icon="lucide--share-2"
    title="No schema to relate"
    description="Relationships appear once a backup has captured this Space’s schema."
  />
) : (
  <SchemaRelationships relationships={relationships} bases={bases} />
)}
