---
/**
 * Coming-soon panel for Schema/Data tabs whose backing slice hasn't shipped yet.
 * Never an error, never fixture data — EmptyState vessel (D17) + one line of what's coming.
 */
import EmptyState from '../../components/ui/EmptyState.astro';

interface Props {
  icon: string;
  title: string;
  description: string;
}

const { icon, title, description } = Astro.props;
---

<EmptyState icon={icon} title={title} description={description} class="min-h-[300px]" />
