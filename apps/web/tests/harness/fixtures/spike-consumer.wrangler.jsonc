// Wrangler config for the spike consumer Worker (see spike-consumer.ts).
// Loaded only by createTestHarness() in tests/harness/ — never deployed.
//
// The `services` entry names the apps/server test Worker by its wrangler
// `name` ("baseout-server-test"); the harness resolves it to the server
// Worker running in the same test server, standing in for the deployed
// `SERVER → baseout-server-dev` binding in wrangler.jsonc.example.
{
  "$schema": "../../../node_modules/wrangler/config-schema.json",
  "name": "spike-consumer",
  "main": "./spike-consumer.ts",
  "compatibility_date": "2026-04-22",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    // Matches the SERVER_INTERNAL_TOKEN the test passes to the server Worker.
    "SERVER_INTERNAL_TOKEN": "test-only-internal-token-min-32-chars-aaaa"
  },
  "services": [{ "binding": "SERVER", "service": "baseout-server-test" }]
}
