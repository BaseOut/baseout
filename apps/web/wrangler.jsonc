// apps/web — PROPOSED replacement for wrangler.jsonc.example (3 named envs).
//
// ENV MODEL (2026-08-27 revision — reverses shared-worker-previews):
//   Top level      = shared, non-deployable config ONLY. Every deploy and every
//                    `wrangler dev` MUST pass `--env <dev|staging|production>`.
//   Script names are DERIVED, not declared: `name` lives only at the top level
//   and wrangler appends the env (appendEnvName in its source), so:
//     env.dev        -> baseout-web-dev         (staging account)
//     env.staging    -> baseout-web (pinned bare — Workers Builds name override; staging account, `staging` branch)
//     env.production -> baseout-web-production  (SEPARATE production account)
//   Never set `name` inside an env block — it would override the derivation and
//   silently decouple these from the service bindings that reference them.
//
// Wrangler does NOT inherit vars, secrets, hyperdrive, kv_namespaces,
// send_email, or services into env blocks — each env restates its full set.
// `secrets.required` is likewise per-env (schema: "not automatically
// inherited from the top level environment").
// https://developers.cloudflare.com/workers/wrangler/configuration/#environments
//
// THIS FILE IS COMMITTED AND AUTHORITATIVE. It is not generated, and there is no
// wrangler.jsonc.example — the file wrangler reads is the file you review.
// The only reason a template ever existed was localConnectionString needing a
// real credential at config-parse time; that is now injected as an env var by
// scripts/dev.mjs instead. Deployed Workers ignore localConnectionString
// entirely (they connect via the Hyperdrive `id`).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Required at top level even though nothing deploys from here; every env
  // overrides it. Never deploy without --env.
  "name": "baseout-web",
  // No `main` — the @astrojs/cloudflare adapter owns the worker entry.
  "compatibility_date": "2026-04-22",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_compat_populate_process_env"
  ],
  // Astro 6 unified entrypoint. This is a MODULE SPECIFIER, not a file path — it
  // resolves through node_modules, so it exists before the build and the
  // Cloudflare Vite plugin's main-must-exist check passes. (Astro 5 pointed main
  // at a build output like dist/_worker.js/index.js, which cannot work here: the
  // plugin reads this config at the START of the build.)
  // Per the @astrojs/cloudflare docs, the deploy flow is then
  //   CLOUDFLARE_ENV=<env> astro build && wrangler deploy
  "main": "@astrojs/cloudflare/entrypoints/server",
  "observability": {
    "enabled": false,
    "logs": {
      "enabled": false
    }
  },
  "dev": {
    "port": 4331
  },
  "env": {
    // ───────────────────────────── DEV ─────────────────────────────
    // ⚠ ACTION REQUIRED — the dev script is renamed baseout-dev -> baseout-web-dev,
    // so its workers.dev origin changes to baseout-web-dev.openside.workers.dev.
    // The OLD origin is a REGISTERED OAuth redirect URI with Airtable, Google,
    // Box, Dropbox and Microsoft (oauth-setup.md §3). Register the new origin
    // with all five providers BEFORE cutover, or every Connect flow breaks —
    // and update oauth-setup.md §3/§4 in the same change (CLAUDE.md §3.7).
    "dev": {
      "account_id": "33857e356899b7369fb01c18ace8d780",
      "vars": {
        "EMAIL_FROM": "Baseout <auth@mail.baseout.dev>",
        // auth-factory reads this as the magic-link origin; `pnpm dev`
        // overrides to https://baseout.local:4331 via `wrangler dev --var`.
        "PUBLIC_AUTH_BASE_URL": "https://baseout.local",
        "PUBLIC_EMBED_ALLOWED_ANCESTORS": "https://airtable.com, https://*.airtableblocks.com, chrome-extension://*",
        "ADMIN_APP_URL": "https://admin.baseout.local",
        // Gates /api/internal/test/last-verification for Playwright. NEVER production.
        "E2E_TEST_MODE": "true",
        // Launch state: off. "1" enforces plan entitlements on storage Connect.
        // Local-dev marker. import.meta.env.DEV is baked false by the Astro
        // production build that `pnpm dev` runs, so middleware needs a RUNTIME
        // signal to enable DEV_TRUSTED_ORIGINS (else local sign-in 403s).
        // Present ONLY here — staging/production must never see it.
        "BASEOUT_DEV": "true",
        "BASEOUT_ENV": "dev",
        "ENTITLEMENT_ENFORCEMENT": "0"
        // Optional dev-only overrides, uncomment as needed:
        // "AIRTABLE_STUBS_ENABLED": "true",
        // "DEV_SKIP_STRIPE": "true",
        // "PUBLIC_SUPPORT_URL": "http://localhost:4342",
        // "STRIPE_TRIAL_PRICE_ID": "price_...",
      },
      // baseout-dev-pg. Shared with baseout-server-dev + baseout-admin-dev —
      // one 15-conn origin pool against dev PG's ~19 usable. Do NOT create a
      // second config for a sibling Worker (2026-07-08 saturation incident).
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          // No localConnectionString, in any env, deliberately. The local
          // Postgres string for wrangler's Hyperdrive emulation comes from
          // CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE in
          // .dev.vars (Node's --env-file loads it; the spawned wrangler
          // inherits it). One mechanism, no credential in the committed file,
          // and a missing value produces wrangler's explicit "set this or
          // localConnectionString" error rather than a silent bad connection.
          "id": "00000000000000000000000000000000"
        }
      ],
      "kv_namespaces": [
        {
          "binding": "SESSION"
        }
      ],
      // Adapter-injected binding, non-inheritable — declared per env now that
      // we deploy the source config rather than the adapter's output.
      "images": {
        "binding": "IMAGES"
      },
      "send_email": [
        {
          "name": "EMAIL",
          "remote": true
        }
      ],
      // `remote: true` is required for the binding to resolve to the deployed
      // sibling during local `wrangler dev --remote`; without it wrangler 4.x
      // leaves it unbound and .fetch() returns 403.
      // ⚠ SEQUENCING: this targets apps/server's env.dev script, which must be
      // DEPLOYED before web's dev worker can resolve the binding (`remote: true`
      // resolves to a real deployed sibling). Deploy it first:
      //   pnpm --filter @baseout/server run deploy:dev
      // Until then a web dev/deploy fails with CF 10143 "Worker not found".
      // `remote: true` is required for the binding to resolve during local
      // `wrangler dev --remote`; without it wrangler 4.x leaves it unbound and
      // .fetch() returns 403.
      "services": [
        {
          "binding": "BACKUP_ENGINE",
          "service": "baseout-server-dev",
          "remote": true
        }
      ]
    },
    // ─────────────────────────── STAGING ───────────────────────────
    // The "production build" of the staging account, tracking the `staging`
    // branch in Workers Builds. Same account as dev, so it needs a distinct
    // script name and its own -staging resources.
    "staging": {
      // Workers Builds deploys onto the Worker the build is connected to and
      // overrides any other name via WRANGLER_CI_OVERRIDE_NAME. The connected
      // Workers are unsuffixed, so this env must produce the bare name or the
      // deploy silently lands on a different Worker than the config describes.
      // Production lives in its own account, so the two cannot collide.
      "name": "baseout-web",
      "routes": [
        {
          "pattern": "console.baseout.dev",
          "custom_domain": true
        }
      ],
      // account_id intentionally omitted — Workers Builds runs inside the
      // owning account and supplies it. Pinning it here can only create a
      // mismatch, since production builds read this same file in a
      // different account. env.dev keeps its pin for local wrangler use.
      "vars": {
        "EMAIL_FROM": "Baseout <auth@mail.baseout.dev>",
        "PUBLIC_AUTH_BASE_URL": "https://console.baseout.dev",
        "PUBLIC_EMBED_ALLOWED_ANCESTORS": "https://airtable.com, https://*.airtableblocks.com, chrome-extension://*",
        "ADMIN_APP_URL": "https://admin.baseout.dev",
        // Playwright targets staging.
        "E2E_TEST_MODE": "true",
        "BASEOUT_ENV": "staging",
        "ENTITLEMENT_ENFORCEMENT": "0"
      },
      // ⚠ ONE canonical list, byte-identical in env.staging and env.production.
      // `secrets` is NOT inherited from the top level (wrangler treats it like
      // `vars`), so it MUST be restated per env — a top-level-only block
      // validates nothing on a --env deploy and warns. `pnpm secrets:check`
      // asserts the two lists match; CI fails on drift.
      // env.dev deliberately has NO block: dev secrets come from .dev.vars
      // and are not deploy-gated.
      "secrets": {
        "required": [
          "ADMIN_HANDOFF_SECRET",
          "AIRTABLE_LOGIN_OAUTH_CLIENT_ID",
          "AIRTABLE_LOGIN_OAUTH_CLIENT_SECRET",
          "AIRTABLE_OAUTH_CLIENT_ID",
          "AIRTABLE_OAUTH_CLIENT_SECRET",
          "BACKUP_ENGINE_INTERNAL_TOKEN",
          "BASEOUT_ENCRYPTION_KEY",
          "BETTER_AUTH_SECRET",
          "BOX_OAUTH_CLIENT_ID",
          "BOX_OAUTH_CLIENT_SECRET",
          "DROPBOX_OAUTH_CLIENT_ID",
          "DROPBOX_OAUTH_CLIENT_SECRET",
          // Gates the /api/internal/test/* Playwright bypass endpoints that
          // E2E_TEST_MODE=true (vars above) exposes on this env — without it
          // they 401 with no deploy-time warning. Staging-only; production
          // carries neither the var nor this secret.
          "E2E_TEST_TOKEN",
          "GOOGLE_DRIVE_OAUTH_CLIENT_ID",
          "GOOGLE_DRIVE_OAUTH_CLIENT_SECRET",
          "MICROSOFT_OAUTH_CLIENT_ID",
          "STRIPE_SECRET_KEY"
        ]
      },
      // PROVISION: baseout-staging-pg. Hyperdrive canNOT be auto-created
      // (it stores origin credentials) and `id` is schema-required:
      //   wrangler hyperdrive create baseout-staging-pg --connection-string "$STAGING_DB_URL"
      // PROVISION: `id` is omitted on purpose — wrangler HARD-ERRORS until it is
      // filled in. Do NOT use "id": "" — that silently DROPS the binding and
      // the Worker deploys with no database at all (verified on 4.112).
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          "id": "ec6bd3583c3441569eff3a4b0d11ef30"
        }
      ],
      // PROVISION: wrangler kv namespace create baseout-staging-session
      // (or delete the "id" line and let wrangler auto-provision — it will
      // name it after the Worker and rewrite this file on deploy).
      "kv_namespaces": [
        {
          "binding": "SESSION"
        }
      ],
      // Adapter-injected binding, non-inheritable — declared per env now that
      // we deploy the source config rather than the adapter's output.
      "images": {
        "binding": "IMAGES"
      },
      "send_email": [
        {
          "name": "EMAIL"
        }
      ],
      "services": [
        {
          "binding": "BACKUP_ENGINE",
          "service": "baseout-server"
        }
      ]
    },
    // ───────────────────────── PRODUCTION ──────────────────────────
    // Lives in its OWN Cloudflare account. Every resource id below must be
    // re-provisioned there — ids from the staging account are not valid.
    "production": {
      // Workers Builds deploys onto the Worker the build is connected to and
      // overrides any other name via WRANGLER_CI_OVERRIDE_NAME. The connected
      // Workers are unsuffixed, so this env must produce the bare name or the
      // deploy silently lands on a different Worker than the config describes.
      // Production lives in its own account, so the two cannot collide.
      "name": "baseout-web",
      "routes": [
        {
          "pattern": "console.baseout.com",
          "custom_domain": true
        }
      ],
      // PROVISION: production account id (wrangler whoami in that account).
      // account_id intentionally omitted — supplied by Workers Builds in the
      // production account. Never pin it: this file is read by both accounts.
      "vars": {
        "EMAIL_FROM": "Baseout <login@mail.baseout.dev>",
        "PUBLIC_AUTH_BASE_URL": "https://console.baseout.com",
        "PUBLIC_EMBED_ALLOWED_ANCESTORS": "https://airtable.com, https://*.airtableblocks.com, chrome-extension://*",
        "ADMIN_APP_URL": "https://admin.baseout.com",
        // NO E2E_TEST_MODE — dev/staging only.
        "BASEOUT_ENV": "production",
        "ENTITLEMENT_ENFORCEMENT": "0"
      },
      // ⚠ ONE canonical list, byte-identical in env.staging and env.production.
      // `secrets` is NOT inherited from the top level (wrangler treats it like
      // `vars`), so it MUST be restated per env — a top-level-only block
      // validates nothing on a --env deploy and warns. `pnpm secrets:check`
      // asserts the two lists match; CI fails on drift.
      // env.dev deliberately has NO block: dev secrets come from .dev.vars
      // and are not deploy-gated.
      "secrets": {
        "required": [
          "ADMIN_HANDOFF_SECRET",
          "AIRTABLE_LOGIN_OAUTH_CLIENT_ID",
          "AIRTABLE_LOGIN_OAUTH_CLIENT_SECRET",
          "AIRTABLE_OAUTH_CLIENT_ID",
          "AIRTABLE_OAUTH_CLIENT_SECRET",
          "BACKUP_ENGINE_INTERNAL_TOKEN",
          "BASEOUT_ENCRYPTION_KEY",
          "BETTER_AUTH_SECRET",
          "BOX_OAUTH_CLIENT_ID",
          "BOX_OAUTH_CLIENT_SECRET",
          "DROPBOX_OAUTH_CLIENT_ID",
          "DROPBOX_OAUTH_CLIENT_SECRET",
          "GOOGLE_DRIVE_OAUTH_CLIENT_ID",
          "GOOGLE_DRIVE_OAUTH_CLIENT_SECRET",
          "MICROSOFT_OAUTH_CLIENT_ID",
          "STRIPE_SECRET_KEY"
        ]
      },
      // PROVISION in the production account: baseout-live-pg.
      // PROVISION: `id` is omitted on purpose — wrangler HARD-ERRORS until it is
      // filled in. Do NOT use "id": "" — that silently DROPS the binding and
      // the Worker deploys with no database at all (verified on 4.112).
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE"
        }
      ],
      // PROVISION in the production account: baseout-live-session.
      // NOTE: a new namespace = every existing session invalidated at cutover.
      "kv_namespaces": [
        {
          "binding": "SESSION",
          "id": ""
        }
      ],
      // Adapter-injected binding, non-inheritable — declared per env now that
      // we deploy the source config rather than the adapter's output.
      "images": {
        "binding": "IMAGES"
      },
      "send_email": [
        {
          "name": "EMAIL"
        }
      ],
      "services": [
        {
          "binding": "BACKUP_ENGINE",
          "service": "baseout-server"
        }
      ]
    }
  }
}