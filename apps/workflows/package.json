{
  "name": "@baseout/workflows",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Trigger.dev v3 task project. Runs on Trigger.dev's Node runner (NOT in a Cloudflare Worker). Enqueued from apps/server via the @trigger.dev/sdk binding.",
  "main": "./trigger/tasks/index.ts",
  "exports": {
    ".": "./trigger/tasks/index.ts",
    "./tasks/_ping": "./trigger/tasks/_ping.ts",
    "./tasks/backup-base.task": "./trigger/tasks/backup-base.task.ts"
  },
  "scripts": {
    "build": "pnpm run build:deps && pnpm run typecheck",
    "build:deps": "pnpm --filter \"@baseout/workflows^...\" run build",
    "build:dev": "pnpm run build",
    "build:production": "pnpm run build",
    "build:staging": "pnpm run build",
    "deploy": "npx trigger.dev@4.5.7 deploy",
    "deploy:production": "npx trigger.dev@4.5.7 deploy --env prod",
    "deploy:staging": "npx trigger.dev@4.5.7 deploy --env staging",
    "dev": "npx trigger.dev@4.5.7 dev start --env-file .dev.vars",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.105.0",
    "@baseout/db-schema": "workspace:*",
    "@baseout/shared": "workspace:*",
    "@trigger.dev/sdk": "4.5.7",
    "aws4fetch": "^1.0.20",
    "papaparse": "^5.5.3"
  },
  "devDependencies": {
    "@trigger.dev/build": "4.5.7",
    "@types/node": "^22.0.0",
    "@types/papaparse": "^5.5.2",
    "typescript": "^5.6.0",
    "vitest": "^4.1.5",
    "wrangler": "^4.124.0"
  }
}
