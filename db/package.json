{
  "name": "@baseout/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Master-DB migration lineage + runner. See root CLAUDE.md \u00a73.9.",
  "scripts": {
    "db:check": "node --env-file-if-exists=.dev.vars --env-file-if-exists=../apps/web/.dev.vars scripts/check-migrations.mjs",
    "db:down": "node tunnel/down.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate.mjs",
    "db:migrate:tunnel": "TUNNEL=1 node scripts/migrate.mjs",
    "db:seed": "node --env-file=.dev.vars --import tsx/esm seed/seed.ts",
    "db:seed:entitlements": "node --env-file=.dev.vars --import tsx/esm seed/seed-entitlements.ts",
    "db:status": "node tunnel/down.mjs --status",
    "db:test": "node scripts/test-connection.mjs",
    "db:tunnel:login": "node -e \"import('cloudflared').then(m=>require('child_process').spawnSync(m.bin,['access','login',process.env.DB_TUNNEL_HOSTNAME||'db.baseout.dev'],{stdio:'inherit'}))\"",
    "db:up": "node tunnel/up.mjs"
  },
  "devDependencies": {
    "cloudflared": "^0.7.3",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.16.3",
    "postgres": "^3.4.5",
    "tsx": "^4.21.0"
  }
}
