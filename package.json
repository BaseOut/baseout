{
  "name": "baseout",
  "private": true,
  "version": "0.0.0",
  "description": "Baseout monorepo \u2014 backup, restore, and data intelligence layer for Airtable",
  "packageManager": "pnpm@11.1.1",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 run build",
    "cron:check": "node apps/server/scripts/check-cron-config.mjs",
    "db:check": "pnpm --filter @baseout/db run db:check",
    "db:down": "pnpm --filter @baseout/db run db:down",
    "db:generate": "pnpm --filter @baseout/db run db:generate",
    "db:migrate": "pnpm --filter @baseout/db run db:migrate",
    "db:migrate:tunnel": "pnpm --filter @baseout/db run db:migrate:tunnel",
    "db:seed": "pnpm --filter @baseout/db run db:seed",
    "db:seed:entitlements": "pnpm --filter @baseout/db run db:seed:entitlements",
    "db:status": "pnpm --filter @baseout/db run db:status",
    "db:test": "pnpm --filter @baseout/db run db:test",
    "db:up": "pnpm --filter @baseout/db run db:up",
    "design": "pnpm --filter @baseout/design dev",
    "dev": "pnpm --filter @baseout/web --filter @baseout/server --filter @baseout/workflows --parallel --no-bail run dev",
    "dev:admin": "pnpm --filter @baseout/admin dev",
    "dev:all": "pnpm --filter @baseout/web --filter @baseout/server --filter @baseout/workflows --parallel run dev",
    "dev:api": "pnpm --filter @baseout/api dev",
    "dev:design": "pnpm --filter @baseout/design dev",
    "dev:hooks": "pnpm --filter @baseout/hooks dev",
    "dev:remote": "BACKUP_REMOTE=1 pnpm --filter @baseout/web dev",
    "dev:server": "pnpm --filter @baseout/server dev",
    "dev:sql": "pnpm --filter @baseout/sql dev",
    "dev:support": "pnpm --filter @baseout/support dev",
    "dev:web": "pnpm --filter @baseout/web dev",
    "dev:workflows": "pnpm --filter @baseout/workflows dev",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yaml,yml,astro}\"",
    "lint": "pnpm -r --parallel run lint",
    "openspec:changes": "node scripts/openspec-changes.mjs",
    "secrets:check": "node scripts/check-wrangler-secrets.mjs",
    "spec:sync-status": "node scripts/spec-sync-status.mjs",
    "storybook:reconcile": "node scripts/storybook-reconcile.mjs",
    "support:docs-check": "node scripts/support-docs-register.mjs --check",
    "support:docs-register": "node scripts/support-docs-register.mjs",
    "support:snapshots": "node scripts/support-snapshots.mjs",
    "test": "pnpm -r --parallel run test",
    "typecheck": "pnpm -r --workspace-concurrency=1 run typecheck",
    "ui:sync-check": "node scripts/ui-sync-status.mjs --check",
    "ui:sync-drift": "node scripts/sync-drift.mjs",
    "ui:sync-status": "node scripts/ui-sync-status.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "eslint": "^10.2.1",
    "lat.md": "^0.11.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.59.1"
  }
}
